// Test: Conditional expression type inference

fun if_expr() : int {
   val x = if true then 1 else 2;
   return x;
}

fun if_stmt() : int {
   mem result;
   if (true) {
      result = 10;
   } else {
      result = 20;
   }
   return result;
}

fun nested_if() : int {
   val x = 5;
   val y = if x > 0 then
              if x > 10 then 100 else 50
           else 0;
   return y;
}
