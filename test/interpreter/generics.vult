fun add_const('a : int, b) {
  return a + b;
}

fun change(x : 't) : bool {
  mem pre : 't;
  val result = pre <> x;
  pre = x;
  return result;
}

fun main() : int {
  // Test constant parameter specialization
  val x = add_const(1, 2); // 1 + 2 = 3
  val y = add_const(10, 5); // 10 + 5 = 15

  // Test type parameter specialization
  val c1 = change(1.0); // real specialization: pre=0.0, 0.0<>1.0 = true
  val c2 = change(1);   // int specialization: pre=0, 0<>1 = true

  if (x == 3 && y == 15 && c1 && c2) {
    return 1;
  }
  return -1;
}
