// Test: Generic functions with shared type parameters
// When the same type parameter is used multiple times, it enforces
// that those arguments must have the same type.

// Test 1: Same type parameter for multiple arguments
fun first_of_pair(a : 't, b : 't) : 't {
  return a;
}

fun add_same_type(a : 't, b : 't) : 't {
  return a + b;
}

// Test 2: Mixed type parameters - type param names can match arg names
// a and c must be same type ('a), b is independent ('b)
fun mixed_types(a : 'a, b : 'b, c : 'a) : 'a {
  return a + c;
}

fun select_first_or_third(flag : bool, a : 'a, b : 'b, c : 'a) : 'a {
  if (flag) return a;
  return c;
}

// Test 3: Three type parameters with partial sharing
// a,c share 'x; b,d share 'y; e is 'z
fun complex_types(a : 'x, b : 'y, c : 'x, d : 'y, e : 'z) : 'z {
  return e;
}

// Test 4: Type parameter in return type matches argument
fun identity_first(a : 't, b : 'u) : 't {
  return a;
}

fun identity_second(a : 't, b : 'u) : 'u {
  return b;
}

// Test 5: Generic with mem using shared types
fun accumulate(x : 't, y : 't) : 't {
  mem acc : 't;
  acc = acc + x + y;
  return acc;
}

// Test 6: Nested calls with shared types
fun inner_add(x : 't, y : 't) : 't {
  return x + y;
}

fun outer_add(a : 'a, b : 'b, c : 'a) : 'a {
  return inner_add(a, c);
}

// Test functions

fun test_same_type_pair() : int {
  // int, int -> int (returns first)
  val r1 = first_of_pair(10, 20);
  // real, real -> real (returns first)
  val r2 = first_of_pair(1.5, 2.5);

  if (r1 == 10 && r2 > 1.4 && r2 < 1.6) {
    return 100;
  }
  return -1;
}

fun test_add_same_type() : int {
  // int + int
  val r1 = add_same_type(3, 4);
  // real + real
  val r2 = add_same_type(1.5, 2.5);

  if (r1 == 7 && r2 > 3.9 && r2 < 4.1) {
    return 200;
  }
  return -2;
}

fun test_mixed_types() : int {
  // 'a=int, 'b=real, returns int (a + c = 1 + 2 = 3)
  val r1 = mixed_types(1, 3.14, 2);
  // 'a=real, 'b=bool, returns real (a + c = 1.0 + 2.0 = 3.0)
  val r2 = mixed_types(1.0, true, 2.0);

  if (r1 == 3 && r2 > 2.9 && r2 < 3.1) {
    return 300;
  }
  return -3;
}

fun test_select_first_or_third() : int {
  // Select first (flag=true): 'a=int, 'b=real
  val r1 = select_first_or_third(true, 10, 3.14, 20);
  // Select third (flag=false): 'a=int, 'b=bool
  val r2 = select_first_or_third(false, 10, true, 30);

  if (r1 == 10 && r2 == 30) {
    return 400;
  }
  return -4;
}

fun test_complex_types() : int {
  // 'x=int, 'y=real, 'z=bool: returns e (bool)
  val r1 = complex_types(1, 2.0, 3, 4.0, true);
  // 'x=real, 'y=int, 'z=int: returns e (int)
  val r2 = complex_types(1.0, 2, 3.0, 4, 42);

  if (r1 && r2 == 42) {
    return 500;
  }
  return -5;
}

fun test_identity_functions() : int {
  // identity_first: 't=int, 'u=real -> returns int
  val r1 = identity_first(100, 3.14);
  // identity_second: 't=int, 'u=real -> returns real
  val r2 = identity_second(100, 3.14);
  // identity_first: 't=bool, 'u=int -> returns bool
  val r3 = identity_first(true, 50);

  if (r1 == 100 && r2 > 3.1 && r2 < 3.2 && r3) {
    return 600;
  }
  return -6;
}

fun test_accumulate() : int {
  // First call: acc=0, acc = 0 + 5 + 3 = 8
  val r1 = accumulate(5, 3);

  if (r1 == 8) {
    return 700;
  }
  return -7;
}

fun test_nested_calls() : int {
  // outer_add calls inner_add(a, c) where a and c are both 'a type
  // 'a=int, 'b=real: inner_add(10, 30) = 40
  val r1 = outer_add(10, 3.14, 30);
  // 'a=real, 'b=int: inner_add(1.5, 2.5) = 4.0
  val r2 = outer_add(1.5, 100, 2.5);

  if (r1 == 40 && r2 > 3.9 && r2 < 4.1) {
    return 800;
  }
  return -8;
}

// Main test - runs all tests and returns sum on success
fun main() : int {
  return test_same_type_pair()
       + test_add_same_type()
       + test_mixed_types()
       + test_select_first_or_third()
       + test_complex_types()
       + test_identity_functions()
       + test_accumulate()
       + test_nested_calls();
}
