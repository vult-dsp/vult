// Comprehensive test for generic functions

// Test 1: Generic type parameter with state
fun change(x : 't) : bool {
  mem pre : 't;
  val result = pre <> x;
  pre = x;
  return result;
}

// Test 2: Constant parameter generic
fun add_const('n : int, x : int) : int {
  return n + x;
}

// Test 4: Generic with state called multiple times (each call site gets own instance)
fun test_change_state() : int {
  // First call site - its own instance
  val a1 = change(10);   // pre=0, 0<>10 = true, pre becomes 10
  val a2 = change(10);   // This is a DIFFERENT instance! pre=0, 0<>10 = true

  // Each call site gets its own instance in Vult semantics
  // So both a1 and a2 should be true
  if (a1 && a2) {
    return 100;
  }
  return -1;
}

// Test 5: Constant parameter specialization
fun test_const_param() : int {
  val x = add_const(10, 5);   // Specialized: 10 + 5 = 15
  val y = add_const(20, 3);   // Specialized: 20 + 3 = 23

  if (x == 15 && y == 23) {
    return 300;
  }
  return -3;
}

// Test 7: Multiple different type specializations
fun test_multi_type() : int {
  val i1 = change(1);      // int specialization
  val i2 = change(2);      // int specialization (different call site)
  val r1 = change(1.0);    // real specialization
  val r2 = change(2.0);    // real specialization (different call site)

  // All should be true since each call site has fresh state
  if (i1 && i2 && r1 && r2) {
    return 400;
  }
  return -4;
}

// Main test - runs all tests and returns sum on success
fun main() : int {
  val t1 = test_change_state();
  val t3 = test_const_param();
  val t4 = test_multi_type();

  // All tests pass: 100 + 300 + 400 = 800
  if (t1 == 100 && t3 == 300 && t4 == 400) {
    return 800;
  }
  return t1 + t3 + t4;  // Return partial result for debugging
}
