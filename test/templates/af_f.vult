
fun process(input:real) @[pdtilde] {
   mem x = x + 1;
   return input * input;
   }
and noteOn(note:int,velocity:int,channel:int) @[pdmessage] { }
and noteOff(note:int,channel:int) @[pdmessage] { }
and controlChange(control:int,value:int,channel:int) @[pdmessage] { }
and default() @[pdmessage] { }


