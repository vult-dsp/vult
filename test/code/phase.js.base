
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.eps  = function()           { return 1e-18 };
this.pi   = function()           { return 3.1415926535897932384; }
this.clip = function(x,low,high) { return x<low?low:(x>high?high:x); };
this.not  = function(x)          { return x==0?1:0; };
this.real = function(x)          { return x; };
this.int_  = function(x)         { return x|0; };
this.sin  = function(x)          { return Math.sin(x); };
this.cos  = function(x)          { return Math.cos(x); };
this.abs  = function(x)          { return Math.abs(x); };
this.exp  = function(x)          { return Math.exp(x); };
this.floor = function(x)          { return Math.floor(x); };
this.tan  = function(x)          { return Math.tan(x); };
this.tanh = function(x)          { return Math.tanh(x); };
this.pow  = function(a,b)         { return Math.pow(a,b); };
this.sqrt = function(x)          { return x; };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
this.Util_edge_type_alloc = function () {
   var _ctx = {};
   _ctx.pre = false;
   return _ctx;
};

this.Util_change_type_alloc = function () {
   var _ctx = {};
   _ctx.pre_x = 0.0;
   return _ctx;
};

this.Util_dcblock_type_alloc = function () {
   var _ctx = {};
   _ctx.x1 = 0.0;
   _ctx.y1 = 0.0;
   return _ctx;
};

this.Util_smooth_type_alloc = function () {
   var _ctx = {};
   _ctx.x = 0.0;
   return _ctx;
};

this.Util_average2_type_alloc = function () {
   var _ctx = {};
   _ctx.x0 = 0.0;
   return _ctx;
};

this.Util_cvToPitch = function (cv) {
   return (24.0 + (120.0 * cv));
};

var Util_pitchToRate_1024_c0 = {};
var Util_pitchToRate_1024_c1 = {};
var Util_pitchToRate_1024_c2 = {};
this.Util_pitchToRate_1024_raw_c0 = function (index) {
   return Util_pitchToRate_1024_c0[index];
};

this.Util_pitchToRate_1024_raw_c1 = function (index) {
   return Util_pitchToRate_1024_c1[index];
};

this.Util_pitchToRate_1024_raw_c2 = function (index) {
   return Util_pitchToRate_1024_c2[index];
};

this.Util_pitchToRate_1024 = function (pitch) {
   var index = this.clip(this.float_to_int((pitch * 0.244094)), (0|0), (31|0));
   return (Util_pitchToRate_1024_c0[index] + (pitch * (Util_pitchToRate_1024_c1[index] + (Util_pitchToRate_1024_c2[index] * pitch))));
};

var Util_cvToRate_1024_c0 = {};
var Util_cvToRate_1024_c1 = {};
var Util_cvToRate_1024_c2 = {};
this.Util_cvToRate_1024_raw_c0 = function (index) {
   return Util_cvToRate_1024_c0[index];
};

this.Util_cvToRate_1024_raw_c1 = function (index) {
   return Util_cvToRate_1024_c1[index];
};

this.Util_cvToRate_1024_raw_c2 = function (index) {
   return Util_cvToRate_1024_c2[index];
};

this.Util_cvToRate_1024 = function (cv) {
   var index = this.clip(this.float_to_int((cv * 34.444444)), (0|0), (31|0));
   return (Util_cvToRate_1024_c0[index] + (cv * (Util_cvToRate_1024_c1[index] + (Util_cvToRate_1024_c2[index] * cv))));
};

this.Phase_default = function (_ctx) {
   _ctx.rate = this.Util_cvToRate_1024(0.0);
};

this.Phase_process_type_alloc = function () {
   var _ctx = {};
   _ctx.inst_1b08a = this.Util_change_type_alloc();
   _ctx.inst_2048a = this.Util_edge_type_alloc();
   _ctx.phase = 0.0;
   _ctx.rate = 0.0;
   this.Phase_default(_ctx);
   return _ctx;
};

this.Phase_noteOn_type_alloc = function (_ctx) {
   return this.Phase_process_type_alloc();
};

this.Phase_noteOff_type_alloc = function (_ctx) {
   return this.Phase_process_type_alloc();
};

this.Phase_controlChange_type_alloc = function (_ctx) {
   return this.Phase_process_type_alloc();
};

this.Phase_default_type_alloc = function (_ctx) {
   return this.Phase_process_type_alloc();
};

this.Util_edge = function (_ctx, x) {
   var ret = (x && (_ctx.pre == false));
   _ctx.pre = x;
   return ret;
};

this.Util_change = function (_ctx, x) {
   var v = (_ctx.pre_x != x);
   _ctx.pre_x = x;
   return v;
};

this.Util_map = function (x, x0, x1, y0, y1) {
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))));
};

this.Util_dcblock = function (_ctx, x0) {
   var y0 = (x0 + ((-_ctx.x1) + (0.995 * _ctx.y1)));
   _ctx.x1 = x0;
   _ctx.y1 = y0;
   return y0;
};

this.Util_smooth = function (_ctx, input) {
   _ctx.x = ((0.005 * (input + (-_ctx.x))) + _ctx.x);
   return _ctx.x;
};

this.Util_average2 = function (_ctx, x1) {
   var result = (0.5 * (x1 + _ctx.x0));
   _ctx.x0 = x1;
   return result;
};

this.Util_cubic_clipper = function (x) {
   if ((x <= -0.666667)) {
      return -0.666667;
   } else {
      if ((x >= 0.666666)) {
         return 0.666666;
      } else {
         return (x + (-0.333334 * (x * (x * x))));
      }
   }
};

var Util_pitchToRate_c0 = {};
var Util_pitchToRate_c1 = {};
var Util_pitchToRate_c2 = {};
this.Util_pitchToRate_raw_c0 = function (index) {
   return Util_pitchToRate_c0[index];
};

this.Util_pitchToRate_raw_c1 = function (index) {
   return Util_pitchToRate_c1[index];
};

this.Util_pitchToRate_raw_c2 = function (index) {
   return Util_pitchToRate_c2[index];
};

this.Util_pitchToRate = function (pitch) {
   var index = this.clip(this.float_to_int((pitch * 0.244094)), (0|0), (31|0));
   return (Util_pitchToRate_c0[index] + (pitch * (Util_pitchToRate_c1[index] + (Util_pitchToRate_c2[index] * pitch))));
};

var Util_cvToRate_c0 = {};
var Util_cvToRate_c1 = {};
var Util_cvToRate_c2 = {};
this.Util_cvToRate_raw_c0 = function (index) {
   return Util_cvToRate_c0[index];
};

this.Util_cvToRate_raw_c1 = function (index) {
   return Util_cvToRate_c1[index];
};

this.Util_cvToRate_raw_c2 = function (index) {
   return Util_cvToRate_c2[index];
};

this.Util_cvToRate = function (cv) {
   var index = this.clip(this.float_to_int((cv * 141.111111)), (0|0), (127|0));
   return (Util_cvToRate_c0[index] + (cv * (Util_cvToRate_c1[index] + (Util_cvToRate_c2[index] * cv))));
};

this.Util_pitchToCv = function (pitch) {
   return (-0.2 + (0.008333 * pitch));
};

var Util_cvToperiod_c0 = {};
var Util_cvToperiod_c1 = {};
var Util_cvToperiod_c2 = {};
this.Util_cvToperiod_raw_c0 = function (index) {
   return Util_cvToperiod_c0[index];
};

this.Util_cvToperiod_raw_c1 = function (index) {
   return Util_cvToperiod_c1[index];
};

this.Util_cvToperiod_raw_c2 = function (index) {
   return Util_cvToperiod_c2[index];
};

this.Util_cvToperiod = function (cv) {
   var index = this.clip(this.float_to_int((cv * 31.0)), (0|0), (31|0));
   return (Util_cvToperiod_c0[index] + (cv * (Util_cvToperiod_c1[index] + (Util_cvToperiod_c2[index] * cv))));
};

var Util_cvTokHz_c0 = {};
var Util_cvTokHz_c1 = {};
var Util_cvTokHz_c2 = {};
this.Util_cvTokHz_raw_c0 = function (index) {
   return Util_cvTokHz_c0[index];
};

this.Util_cvTokHz_raw_c1 = function (index) {
   return Util_cvTokHz_c1[index];
};

this.Util_cvTokHz_raw_c2 = function (index) {
   return Util_cvTokHz_c2[index];
};

this.Util_cvTokHz = function (cv) {
   var index = this.clip(this.float_to_int((cv * 31.0)), (0|0), (31|0));
   return (Util_cvTokHz_c0[index] + (cv * (Util_cvTokHz_c1[index] + (Util_cvTokHz_c2[index] * cv))));
};

this.Phase_process = function (_ctx, cv, reset) {
   if (this.Util_change(_ctx.inst_1b08a, cv)) {
      _ctx.rate = this.Util_cvToRate_1024(cv);
   }
   if (this.Util_edge(_ctx.inst_2048a, (reset > 0.5))) {
      _ctx.phase = 0.0;
   } else {
      _ctx.phase = (_ctx.phase + _ctx.rate);
   }
   if ((_ctx.phase > 1024.0)) {
      _ctx.phase = (-1024.0 + _ctx.phase);
   } else {
      _ctx.phase = _ctx.phase;
   }
   return (0.000976 * _ctx.phase);
};

this.Phase_noteOn = function (_ctx, note, velocity, channel) {
};

this.Phase_noteOff = function (_ctx, note, channel) {
};

this.Phase_controlChange = function (_ctx, control, value, channel) {
};

