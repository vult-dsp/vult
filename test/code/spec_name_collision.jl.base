function Spec_name_collision_test_distinct_specializations()
   _record_0 = (; first = Int32(11) )
   ra = Spec_name_collision_keep_Review_sig_a_b_c(_record_0)
   _record_1 = (; second = Int32(22) )
   rb = Spec_name_collision_keep_Review_sig_a_b_c_b37a7a88(_record_1)
