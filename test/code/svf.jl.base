function Saturate_soft_tanh_table_raw_c2(index)
   return @inbounds Saturate_soft_tanh_table_c2[index + 1]
end

function Saturate_soft_tanh_table(x)
   index = clamp(trunc(Int32, ((x + Float32(24.0)) * Float32(5.0))), Int32(0), Int32(240))
   return (@inbounds Saturate_soft_tanh_table_c0[index + 1] + (x * (@inbounds Saturate_soft_tanh_table_c1[index + 1] + (@inbounds Saturate_soft_tanh_table_c2[index + 1] * x))))
end

function Saturate_soft_process(x)
   return Saturate_soft_tanh_table(x)
end

function Saturate_soft_noteOn(note, velocity, channel)
end

function Saturate_soft_noteOff(note, channel)
end

function Saturate_soft_controlChange(control, value, channel)
end

function Saturate_soft_default()
end

function Svf_process(_ctx, x, cv, q, sel)
   q = (Float32(0.5) + q)
   if (Util_change(_ctx.inst_1b0a2, cv) || Util_change(_ctx.inst_2b0a2, q))
      begin
         _ctx.g = Svf_calc_g(cv)
         _ctx.r = (Float32(1.0) / (Float32(2.0) * (q + eps(Float32))))
         _ctx.inv_den = (Float32(1.0) / (Float32(1.0) + ((Float32(2.0) * (_ctx.r * _ctx.g)) + (_ctx.g * _ctx.g))))
      end
   end
   high = ((x + ((-(((Float32(2.0) * _ctx.r) + _ctx.g) * _ctx.z1)) + (-_ctx.z2))) * _ctx.inv_den)
   band = ((high * _ctx.g) + _ctx.z1)
   low = ((band * _ctx.g) + _ctx.z2)
   notch = (high + low)
   _ctx.z1 = (band + (high * _ctx.g))
   _ctx.z2 = (low + (band * _ctx.g))
   output = Float32(0.0)
   if (sel == Int32(0))
      output = low
   else
      if (sel == Int32(1))
         output = high
      else
         if (sel == Int32(2))
            output = band
         else
            output = notch
         end
      end
   end
   return Saturate_soft_process(output)
end

