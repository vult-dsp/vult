
# High-performance Vult Runtime for Julia with typed arrays

mutable struct Util_edge_type
       pre::Bool
end

# Default constructor for Util_edge_type
function Util_edge_type()
    return Util_edge_type(false)
end

mutable struct Util_change_type
       pre_x::Float32
end

# Default constructor for Util_change_type
function Util_change_type()
    return Util_change_type(Float32(0.0))
end

mutable struct Util_dcblock_type
       x1::Float32
       y1::Float32
end

# Default constructor for Util_dcblock_type
function Util_dcblock_type()
    return Util_dcblock_type(Float32(0.0), Float32(0.0))
end

mutable struct Util_smooth_type
       x::Float32
end

# Default constructor for Util_smooth_type
function Util_smooth_type()
    return Util_smooth_type(Float32(0.0))
end

mutable struct Util_average2_type
       x0::Float32
end

# Default constructor for Util_average2_type
function Util_average2_type()
    return Util_average2_type(Float32(0.0))
end

mutable struct Svf_process_type
       g::Float32
       inst_1b0a2::Util_change_type
       inst_2b0a2::Util_change_type
       inv_den::Float32
       r::Float32
       z1::Float32
       z2::Float32
end

# Default constructor for Svf_process_type
function Svf_process_type()
    return Svf_process_type(Float32(0.0), Util_change_type(), Util_change_type(), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0))
end

function Util_edge_type_alloc()
   _ctx = Util_edge_type()
   _ctx.pre = false
   return _ctx
end

function Util_change_type_alloc()
   _ctx = Util_change_type()
   _ctx.pre_x = Float32(0.0)
   return _ctx
end

function Util_dcblock_type_alloc()
   _ctx = Util_dcblock_type()
   _ctx.x1 = Float32(0.0)
   _ctx.y1 = Float32(0.0)
   return _ctx
end

function Util_smooth_type_alloc()
   _ctx = Util_smooth_type()
   _ctx.x = Float32(0.0)
   return _ctx
end

function Util_average2_type_alloc()
   _ctx = Util_average2_type()
   _ctx.x0 = Float32(0.0)
   return _ctx
end

function Util_cvToPitch(cv)
   return (Float32(24.0) + (Float32(120.0) * cv))
end

Svf_calc_g_c0 = nothing
Svf_calc_g_c1 = nothing
Svf_calc_g_c2 = nothing
function Svf_calc_g_raw_c0(index)
   return @inbounds Svf_calc_g_c0[index + 1]
end

function Svf_calc_g_raw_c1(index)
   return @inbounds Svf_calc_g_c1[index + 1]
end

function Svf_calc_g_raw_c2(index)
   return @inbounds Svf_calc_g_c2[index + 1]
end

function Svf_calc_g(cv)
   index = clamp(trunc(Int32, (cv * Float32(141.111111))), Int32(0), Int32(127))
   return (@inbounds Svf_calc_g_c0[index + 1] + (cv * (@inbounds Svf_calc_g_c1[index + 1] + (@inbounds Svf_calc_g_c2[index + 1] * cv))))
end

function Svf_default(_ctx)
   _ctx.g = Svf_calc_g(Float32(0.0))
   _ctx.r = Float32(1.0)
   _ctx.inv_den = (Float32(1.0) / (Float32(1.0) + (_ctx.g * _ctx.g)))
end

function Svf_process_type_alloc()
   _ctx = Svf_process_type()
   _ctx.g = Float32(0.0)
   _ctx.inst_1b0a2 = Util_change_type_alloc()
   _ctx.inst_2b0a2 = Util_change_type_alloc()
   _ctx.inv_den = Float32(0.0)
   _ctx.r = Float32(0.0)
   _ctx.z1 = Float32(0.0)
   _ctx.z2 = Float32(0.0)
   Svf_default(_ctx)
   return _ctx
end

function Svf_noteOn_type_alloc(_ctx)
   return Svf_process_type_alloc()
end

function Svf_noteOff_type_alloc(_ctx)
   return Svf_process_type_alloc()
end

function Svf_controlChange_type_alloc(_ctx)
   return Svf_process_type_alloc()
end

function Svf_default_type_alloc(_ctx)
   return Svf_process_type_alloc()
end

function Util_edge(_ctx, x)
   ret = (x && (_ctx.pre == false))
   _ctx.pre = x
   return ret
end

function Util_change(_ctx, x)
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v
end

function Util_map(x, x0, x1, y0, y1)
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))
end

function Util_dcblock(_ctx, x0)
   y0 = (x0 + ((-_ctx.x1) + (Float32(0.995) * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0
end

function Util_smooth(_ctx, input)
   _ctx.x = ((Float32(0.005) * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Util_average2(_ctx, x1)
   result = (Float32(0.5) * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result
end

function Util_cubic_clipper(x)
   if (x <= Float32(-0.666667))
      return Float32(-0.666667)
   else
      if (x >= Float32(0.666666))
         return Float32(0.666666)
      else
         return (x + (Float32(-0.333334) * (x * (x * x))))
      end
   end
end

