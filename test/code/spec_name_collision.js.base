};

this.Spec_name_collision_keep_Review_sig_a_b_c_b37a7a88 = function (v) {
   return v;
};

this.Spec_name_collision_test_distinct_specializations = function () {
   var _record_0 = { first: (11|0) };
   var ra = this.Spec_name_collision_keep_Review_sig_a_b_c(_record_0);
   var _record_1 = { second: (22|0) };
   var rb = this.Spec_name_collision_keep_Review_sig_a_b_c_b37a7a88(_record_1);
   if (((ra.first == (11|0)) && (rb.second == (22|0)))) {
      return (100|0);
   }
   return (-1|0);
};

this.Spec_name_collision_test_reversed_order = function () {
   var _record_0 = { second: (44|0) };
   var rb = this.Spec_name_collision_keep_Review_sig_a_b_c_b37a7a88(_record_0);
   var _record_1 = { first: (33|0) };
   var ra = this.Spec_name_collision_keep_Review_sig_a_b_c(_record_1);
   if (((ra.first == (33|0)) && (rb.second == (44|0)))) {
      return (200|0);
   }
   return (-2|0);
};

this.Spec_name_collision_main = function () {
   var t1 = this.Spec_name_collision_test_distinct_specializations();
   var t2 = this.Spec_name_collision_test_reversed_order();
   if (((t1 == (100|0)) && (t2 == (200|0)))) {
      return (1100|0);
   }
   return (t1 + t2);
};

