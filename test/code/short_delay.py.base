def Short_delay_soft(_ctx, x1):
   o = (0.25 * (x1 + (_ctx.x2 + (_ctx.x3 + _ctx.x4))))
   _t_temp_0 = x1
   _t_temp_1 = _ctx.x2
   _t_temp_2 = _ctx.x3
   _ctx.x2 = _t_temp_0
   _ctx.x3 = _t_temp_1
   _ctx.x4 = _t_temp_2
   return o


def Short_delay_do(_ctx, x, time_in, feedback_in):
   time = ((0.0) if (time_in) < (0.0) else ((1.0) if (time_in) > (1.0) else (time_in)))
   feedback = ((0.0) if (feedback_in) < (0.0) else ((1.0) if (feedback_in) > (1.0) else (feedback_in)))
   index_r = (22050.0 * time)
   index_i = int(math.floor(index_r))
   delta = ((-index_i) + _ctx.write_pos)
   read_pos = 0
   if (delta < 0):
      read_pos = (22050 + delta)
   else:
      read_pos = delta
   decimal = (index_r + (-float(index_i)))
   x1 = _ctx.buffer[read_pos]
   x2 = _ctx.buffer[((1 + read_pos) % 22050)]
   ret = (x1 + (decimal * (x2 + (-x1))))
   _ctx.write_pos = ((1 + _ctx.write_pos) % 22050)
   _ctx.buffer[_ctx.write_pos] = Saturate_process((x + (feedback * ret)))
   return ret


def Short_delay_process(_ctx, x, time, feedback):
   return Short_delay_do(_ctx.inst_2ba3b, x, Short_delay_soft(_ctx.inst_1593b, time), feedback)

