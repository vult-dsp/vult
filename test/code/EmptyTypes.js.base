
// Runtime functions (simple builtins like eps, pi, clip, real, int_, sin, cos, etc. are inlined)
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
this.EmptyTypes_foo_type_alloc = function () {
   var _ctx = {};
   _ctx.screen = {};
   _ctx.settings = {};
   return _ctx;
};

this.EmptyTypes_setSettings_type_alloc = function (_ctx) {
   return this.EmptyTypes_foo_type_alloc();
};

this.EmptyTypes_setScreen_type_alloc = function (_ctx) {
   return this.EmptyTypes_foo_type_alloc();
};

this.EmptyTypes_foo = function (_ctx) {
   this.setSomething(_ctx.settings);
   this.drawSomething(_ctx.screen);
};

this.EmptyTypes_setSettings = function (_ctx, s) {
   _ctx.settings = s;
};

this.EmptyTypes_setScreen = function (_ctx, s) {
   _ctx.settings = s;
};

