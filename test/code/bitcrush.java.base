private float Bitcrush_factor_raw_c0(int index) {
   return Bitcrush_factor_c[(index * 3)];
}

private float Bitcrush_factor_raw_c1(int index) {
   return Bitcrush_factor_c[((index * 3) + 1)];
}

private float Bitcrush_factor_raw_c2(int index) {
   return Bitcrush_factor_c[((index * 3) + 2)];
}

private float Bitcrush_factor(float cv) {
   float value = clip((cv * 128.0f), 0.0f, 128.0f);
   int cell = clip(float_to_int(value), 0, 127);
   float u = (value - (float)(cell));
   int index = (cell * 3);
   return (Bitcrush_factor_c[index] + (u * (Bitcrush_factor_c[(index + 1)] + (Bitcrush_factor_c[(index + 2)] * u))));
}

private float Bitcrush_process(float i, float cv) {
   float out = i;
   if ((cv == 0.0f)) {
      out = i;
   } else {
      {
         float b = Bitcrush_factor(cv);
         int x = (int)((b * i));
         out = ((float)(x) / b);
      }
   }
   return out;
}

