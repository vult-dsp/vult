private float Bitcrush_factor_raw_c0(int index) {
   return Bitcrush_factor_c0[index];
}

private float Bitcrush_factor_raw_c1(int index) {
   return Bitcrush_factor_c1[index];
}

private float Bitcrush_factor_raw_c2(int index) {
   return Bitcrush_factor_c2[index];
}

private float Bitcrush_factor(float cv) {
   int index = clip(float_to_int((cv * 128.0f)), 0, 127);
   return (Bitcrush_factor_c0[index] + (cv * (Bitcrush_factor_c1[index] + (Bitcrush_factor_c2[index] * cv))));
}

private float Bitcrush_process(float i, float cv) {
   float out = i;
   if ((cv == 0.0f)) {
      out = i;
   } else {
      {
         float b = Bitcrush_factor(cv);
         int x = (int)((b * i));
         out = ((float)(x) / b);
      }
   }
   return out;
}

