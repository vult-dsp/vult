class VultProcessor extends AudioWorkletProcessor {
   constructor() {
      super();
      this.vult = new (function() {
this.Sf_f_process = function (input) {
   return (input * input);
};

this.Sf_f_noteOn = function (note, velocity, channel) {
};

this.Sf_f_noteOff = function (note, channel) {
};

this.Sf_f_controlChange = function (control, value, channel) {
};

this.Sf_f_default = function () {
};


      this.context = {};
      this.Sf_f_default();
      })();
      this.port.onmessage = (e) => {
         if (e.data.type === 'noteOn') this.vult.Sf_f_noteOn(e.data.note, e.data.velocity, e.data.channel);
         if (e.data.type === 'noteOff') this.vult.Sf_f_noteOff(e.data.note, e.data.channel);
         if (e.data.type === 'controlChange') this.vult.Sf_f_controlChange(e.data.control, e.data.value, e.data.channel);
      };
   }
   process(inputs, outputs, parameters) {
      const input = inputs[0];
      const output = outputs[0];
      for (var i = 0; i < 128; i++) {
         output[0][i] = this.vult.Sf_f_process(input[0] ? input[0][i] : 0);
      }
      return true;
   }
}
registerProcessor('vult-processor', VultProcessor);