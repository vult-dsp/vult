
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.eps  = function()           { return 1e-18 };
this.pi   = function()           { return 3.1415926535897932384; }
this.clip = function(x,low,high) { return x<low?low:(x>high?high:x); };
this.not  = function(x)          { return x==0?1:0; };
this.real = function(x)          { return x; };
this.int_  = function(x)         { return x|0; };
this.sin  = function(x)          { return Math.sin(x); };
this.cos  = function(x)          { return Math.cos(x); };
this.abs  = function(x)          { return Math.abs(x); };
this.exp  = function(x)          { return Math.exp(x); };
this.floor = function(x)          { return Math.floor(x); };
this.tan  = function(x)          { return Math.tan(x); };
this.tanh = function(x)          { return Math.tanh(x); };
this.pow  = function(a,b)         { return Math.pow(a,b); };
this.sqrt = function(x)          { return x; };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
var Waves_sineTable1_chan_0 = {};
this.Waves_sineTable1_samples = function () {
   return (256|0);
};

this.Waves_sineTable1 = function (channel, index) {
   if ((channel == (0|0))) {
      return Waves_sineTable1_chan_0[(index % (256|0))];
   }
   return 0.0;
};

var Waves_sineTable2_c0 = {};
var Waves_sineTable2_c1 = {};
var Waves_sineTable2_c2 = {};
this.Waves_sineTable2_samples = function () {
   return (256|0);
};

this.Waves_sineTable2_raw_c0 = function (index) {
   return Waves_sineTable2_c0[index];
};

this.Waves_sineTable2_raw_c1 = function (index) {
   return Waves_sineTable2_c1[index];
};

this.Waves_sineTable2_raw_c2 = function (index) {
   return Waves_sineTable2_c2[index];
};

this.Waves_sineTable2 = function (position) {
   var index = this.clip(this.float_to_int((position * 255.0)), (0|0), (255|0));
   return (Waves_sineTable2_c0[index] + (position * (Waves_sineTable2_c1[index] + (Waves_sineTable2_c2[index] * position))));
};

this.Waves_test1 = function () {
   var n = this.Waves_sineTable1_samples();
   var i__1 = (0|0);
   while ((i__1 < n)) {
      {
         this.Waves_sineTable1((0|0), i__1);
         i__1 = ((1|0) + i__1);
      }
   }
};

this.Waves_test2 = function () {
   var result = this.Waves_sineTable2(0.5);
};

