import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

class Array_defined_type_dot:
    __slots__ = ['x', 'y']
    def __init__(self, x=0.0, y=0.0):
        self.x = x
        self.y = y

class Array_defined_type_foo_type:
    __slots__ = ['p1']
    def __init__(self, p1=[0.0] * 12):
        self.p1 = p1

class Array_defined_type_process_type:
    __slots__ = ['inst_1c76a']
    def __init__(self, inst_1c76a=Array_defined_type_foo_type()):
        self.inst_1c76a = inst_1c76a

def Array_defined_type_dot_alloc():
   _ctx = Array_defined_type_dot()
   _ctx.x = 0.0
   _ctx.y = 0.0
   return _ctx


def Array_defined_type_foo_type_alloc():
   i_0 = 0
   temp_1 = None
   _ctx = Array_defined_type_foo_type()
   while (i_0 < 12):
      temp_1[i_0] = Array_defined_type_dot_alloc()
      i_0 = (1 + i_0)

   _ctx.p1 = temp_1
   return _ctx


def Array_defined_type_process_type_alloc():
   _ctx = Array_defined_type_process_type()
   _ctx.inst_1c76a = Array_defined_type_foo_type_alloc()
   return _ctx


def Array_defined_type_noteOn_type_alloc(_ctx):
   return Array_defined_type_process_type_alloc()

def Array_defined_type_noteOff_type_alloc(_ctx):
   return Array_defined_type_process_type_alloc()

def Array_defined_type_controlChange_type_alloc(_ctx):
   return Array_defined_type_process_type_alloc()

def Array_defined_type_default_type_alloc(_ctx):
   return Array_defined_type_process_type_alloc()

def Array_defined_type_foo(_ctx):
   pass

def Array_defined_type_process(_ctx, input):
   _ = Array_defined_type_foo(_ctx.inst_1c76a)
   return input


def Array_defined_type_noteOn(_ctx, note, velocity, channel):
   pass

def Array_defined_type_noteOff(_ctx, note, channel):
   pass

def Array_defined_type_controlChange(_ctx, control, value, channel):
   pass

def Array_defined_type_default(_ctx):
   pass

