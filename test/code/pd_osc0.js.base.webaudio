
(function(audioContext) {
   var code = function () {
   this.Pd_osc0_process_type_alloc = function () {
   var _ctx = {};
   _ctx.phase = 0.0;
   return _ctx;
};

this.Pd_osc0_setFreq_type_alloc = function (_ctx) {
   return this.Pd_osc0_process_type_alloc();
};

this.Pd_osc0_process = function (_ctx) {
   _ctx.phase = ((440.0 / this.samplerate()) + _ctx.phase);
   if ((_ctx.phase > 1.0)) {
      _ctx.phase = (-1.0 + _ctx.phase);
   }
   return Math.sin((6.283185 * _ctx.phase));
};

this.Pd_osc0_setFreq = function (_ctx, freq) {
   _ctx.phase = _ctx.phase;
};


      this.context = this.Pd_osc0_process_type_alloc();
      };
   var processor = new code ();
   
   var node = audioContext.createScriptProcessor(0, 1, 1);
   node.inputs = 1;
   node.outputs = 1;
   node.onaudioprocess = function (e) {


   var in_0 = e.inputBuffer.getChannelData(0); 


   var out_0 = e.outputBuffer.getChannelData(0); 


   for (var n = 0; n < e.inputBuffer.length; n++) {
            var ret = processor.Pd_osc0_process(processor.context); 
out_0[n] = ret;  
   }
   }



   return node;
   })