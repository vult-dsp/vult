   index = ((0) if (float_to_int((cv * 32.0))) < (0) else ((31) if (float_to_int((cv * 32.0))) > (31) else (float_to_int((cv * 32.0)))))
   return (Util_cvTokHz_c0[index] + (cv * (Util_cvTokHz_c1[index] + (Util_cvTokHz_c2[index] * cv))))


def Phase_process(_ctx, cv, reset):
   if Util_change(_ctx.inst_1b08a, cv):
      _ctx.rate = Util_cvToRate_1024(cv)
   if Util_edge(_ctx.inst_2048a, (reset > 0.5)):
      _ctx.phase = 0.0
   else:
      _ctx.phase = (_ctx.phase + _ctx.rate)
   if (_ctx.phase > 1024.0):
      _ctx.phase = (-1024.0 + _ctx.phase)
   else:
      _ctx.phase = _ctx.phase
   return (0.000976 * _ctx.phase)


