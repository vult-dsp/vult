def Util_cvToperiod(cv):
   index = ((0) if (float_to_int((cv * 32.0))) < (0) else ((31) if (float_to_int((cv * 32.0))) > (31) else (float_to_int((cv * 32.0)))))
   return (Util_cvToperiod_c0[index] + (cv * (Util_cvToperiod_c1[index] + (Util_cvToperiod_c2[index] * cv))))


