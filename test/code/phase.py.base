def Util_cvToRate(cv):
   index = ((0) if (float_to_int((cv * 142.222222))) < (0) else ((127) if (float_to_int((cv * 142.222222))) > (127) else (float_to_int((cv * 142.222222)))))
   return (Util_cvToRate_c0[index] + (cv * (Util_cvToRate_c1[index] + (Util_cvToRate_c2[index] * cv))))


def Util_pitchToCv(pitch):
   return (-0.2 + (0.008333 * pitch))

