def Multi_return_foo(_ctx, x):
   if (x > 0):
      _ctx.Multi_return_foo_ret_0 = 0.0
      _ctx.Multi_return_foo_ret_1 = 0.0
      return None

   else:
      _ctx.Multi_return_foo_ret_0 = 1.0
      _ctx.Multi_return_foo_ret_1 = 1.0
      return None


def Multi_return_bar(_ctx):
   _ = Multi_return_foo(_ctx.inst_16585, 1)
   x = [_ctx.inst_16585.Multi_return_foo_ret_0, _ctx.inst_16585.Multi_return_foo_ret_1]
   _ctx.Multi_return_bar_ret_0 = x[0]
   _ctx.Multi_return_bar_ret_1 = x[1]
