    __slots__ = ['Multi_return_foo_ret_0', 'Multi_return_foo_ret_1']
    def __init__(self, Multi_return_foo_ret_0=0.0, Multi_return_foo_ret_1=0.0):
        self.Multi_return_foo_ret_0 = Multi_return_foo_ret_0
        self.Multi_return_foo_ret_1 = Multi_return_foo_ret_1

class Multi_return_bar_type:
