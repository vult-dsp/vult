
def Match_foo1(x):
   if (x == 0):
      return 0
   else:
      if (x == 1):
         return 1
      else:
         return 2

def Match_foo2(x, y):
   if ((x == 1) and (y == "e")):
      return (1 + x)
   else:
      if (x == 3):
         return 1
      else:
         return 2

def Match_foo3(x):
   if (x == 0):
      return 1
   else:
      if (x == 1):
         return 2
      else:
         return 0

