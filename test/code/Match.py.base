import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

def Match_foo1(x):
   if (x == 0):
      return 0
   else:
      if (x == 1):
         return 1
      else:
         return 2

def Match_foo2(x, y):
   if ((x == 1) and (y == "e")):
      return (1 + x)
   else:
      if (x == 3):
         return 1
      else:
         return 2

def Match_foo3(x):
   if (x == 0):
      return 1
   else:
      if (x == 1):
         return 2
      else:
         return 0

