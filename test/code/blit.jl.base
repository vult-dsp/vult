function Util_cvToPitch(cv)
   return (Float32(24.0) + (Float32(120.0) * cv))
end

Util_pitchToRate_1024_c = nothing
function Util_pitchToRate_1024_raw_c0(index)
   return @inbounds Util_pitchToRate_1024_c[(index * Int32(3)) + 1]
end

function Util_pitchToRate_1024_raw_c1(index)
   return @inbounds Util_pitchToRate_1024_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Util_pitchToRate_1024_raw_c2(index)
   return @inbounds Util_pitchToRate_1024_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Util_pitchToRate_1024(pitch)
   value = (clamp(pitch, Float32(0.0), Float32(127.0)) * Float32(0.251968))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_pitchToRate_1024_c[index + 1] + (u * (@inbounds Util_pitchToRate_1024_c[(index + Int32(1)) + 1] + (@inbounds Util_pitchToRate_1024_c[(index + Int32(2)) + 1] * u))))
end

Util_cvToRate_1024_c = nothing
function Util_cvToRate_1024_raw_c0(index)
   return @inbounds Util_cvToRate_1024_c[(index * Int32(3)) + 1]
end

function Util_cvToRate_1024_raw_c1(index)
   return @inbounds Util_cvToRate_1024_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Util_cvToRate_1024_raw_c2(index)
   return @inbounds Util_cvToRate_1024_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Util_cvToRate_1024(cv)
   value = (clamp(cv, Float32(0.0), Float32(0.9)) * Float32(35.555555))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_cvToRate_1024_c[index + 1] + (u * (@inbounds Util_cvToRate_1024_c[(index + Int32(1)) + 1] + (@inbounds Util_cvToRate_1024_c[(index + Int32(2)) + 1] * u))))
end

function Phase_default(_ctx)
   _ctx.rate = Util_cvToRate_1024(Float32(0.0))
end

function Phase_process_type_alloc()
   _ctx = Phase_process_type()
   _ctx.inst_1b08a = Util_change_type_alloc()
