function Util_cvToperiod(cv)
   value = (clamp(cv, Float32(0.0), Float32(1.0)) * Float32(32.0))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_cvToperiod_c[index + 1] + (u * (@inbounds Util_cvToperiod_c[(index + Int32(1)) + 1] + (@inbounds Util_cvToperiod_c[(index + Int32(2)) + 1] * u))))
end

function Blit_pulse_start(_ctx)
   _ctx.m = (Int32(1) + (trunc(Int32, Util_cvToperiod(Float32(0.0))) * 2))
   _ctx.scale = (Float32(1.0) + (Float32(2.0) * Util_cvToperiod(Float32(0.0))))
end

function Blit_pulse_train_type_alloc()
   _ctx = Blit_pulse_train_type()
   _ctx.inst_1b05e = Util_change_type_alloc()
   _ctx.m = Int32(0)
   _ctx.scale = Float32(0.0)
   Blit_pulse_start(_ctx)
   return _ctx
end

function Blit_pulse_start_type_alloc(_ctx)
   return Blit_pulse_train_type_alloc()
end

