function Util_edge(_ctx, x)
   ret = (x && (_ctx.pre == false))
   _ctx.pre = x
   return ret
end

function Util_change(_ctx, x)
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v
end

function Util_map(x, x0, x1, y0, y1)
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))
end

function Util_dcblock(_ctx, x0)
   y0 = (x0 + ((-_ctx.x1) + (Float32(0.995) * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0
end

function Util_smooth(_ctx, input)
   _ctx.x = ((Float32(0.005) * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Util_average2(_ctx, x1)
   result = (Float32(0.5) * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result
end

function Util_cubic_clipper(x)
   if (x <= Float32(-0.666667))
      return Float32(-0.666667)
   else
      if (x >= Float32(0.666666))
         return Float32(0.666666)
      else
         return (x + (Float32(-0.333334) * (x * (x * x))))
      end
   end
end

function Util_pitchToCv(pitch)
   return (Float32(-0.2) + (Float32(0.008333) * pitch))
end

Util_cvTokHz_c = nothing
function Util_cvTokHz_raw_c0(index)
   return @inbounds Util_cvTokHz_c[(index * Int32(3)) + 1]
end

function Util_cvTokHz_raw_c1(index)
   return @inbounds Util_cvTokHz_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Util_cvTokHz_raw_c2(index)
   return @inbounds Util_cvTokHz_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Util_cvTokHz(cv)
   value = (clamp(cv, Float32(0.0), Float32(1.0)) * Float32(32.0))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_cvTokHz_c[index + 1] + (u * (@inbounds Util_cvTokHz_c[(index + Int32(1)) + 1] + (@inbounds Util_cvTokHz_c[(index + Int32(2)) + 1] * u))))
end

function Phase_process(_ctx, cv, reset)
   if Util_change(_ctx.inst_1b08a, cv)
      _ctx.rate = Util_cvToRate_1024(cv)
   end
   if Util_edge(_ctx.inst_2048a, (reset > Float32(0.5)))
      _ctx.phase = Float32(0.0)
   else
      _ctx.phase = (_ctx.phase + _ctx.rate)
   end
   if (_ctx.phase > Float32(1024.0))
      _ctx.phase = (Float32(-1024.0) + _ctx.phase)
   else
      _ctx.phase = _ctx.phase
   end
   return (Float32(0.000976) * _ctx.phase)
end

function Phase_noteOn(_ctx, note, velocity, channel)
end

function Phase_noteOff(_ctx, note, channel)
end

function Phase_controlChange(_ctx, control, value, channel)
end

Tables_nsine_c = nothing
function Tables_nsine_raw_c0(index)
   return @inbounds Tables_nsine_c[(index * Int32(3)) + 1]
end

function Tables_nsine_raw_c1(index)
   return @inbounds Tables_nsine_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Tables_nsine_raw_c2(index)
   return @inbounds Tables_nsine_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Tables_nsine(x)
   value = (clamp(x, Float32(0.0), Float32(1.0)) * Float32(128.0))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(127))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Tables_nsine_c[index + 1] + (u * (@inbounds Tables_nsine_c[(index + Int32(1)) + 1] + (@inbounds Tables_nsine_c[(index + Int32(2)) + 1] * u))))
end

function Blit_pulse_train(_ctx, cv, phase)
   if Util_change(_ctx.inst_1b05e, cv)
      begin
         _ctx.m = (Int32(1) + (trunc(Int32, Util_cvToperiod(cv)) * 2))
         _ctx.scale = (Float32(2.0) * Util_cvToperiod(cv))
      end
   end
   pi_phase = (Float32(0.5) * phase)
   denominator = Tables_nsine(pi_phase)
   out = Float32(0.0)
   if (denominator <= eps(Float32))
      out = Float32(1.0)
   else
      begin
         m_phase = mod((pi_phase * Float32(_ctx.m)), Float32(1.0))
         numerator = Tables_nsine(m_phase)
         out = (numerator / (denominator * _ctx.scale))
      end
   end
   return out
end

function Blit_osc_blit(_ctx, cv, pw, wave)
   fixed_cv = Float32(0.0)
   if (wave < Float32(1.0))
      fixed_cv = cv
   else
      fixed_cv = (Float32(-0.1) + cv)
   end
   if Util_change(_ctx.inst_1b026, fixed_cv)
      _ctx.rate = Util_cvToRate(fixed_cv)
   end
   phase = Phase_process(_ctx.inst_28a26, fixed_cv, Float32(0.0))
   shift05 = (Float32(0.5) + (Float32(0.49) * pw))
   shift = (phase + shift05)
   if (shift > Float32(1.0))
      shift = (Float32(-1.0) + shift)
   end
   pulse1 = Blit_pulse_train(_ctx.inst_35e26, fixed_cv, phase)
   pulse2 = Blit_pulse_train(_ctx.inst_45e26, fixed_cv, shift)
   _ctx.state_pulse = (pulse1 + ((-pulse2) + (Float32(0.9995) * _ctx.state_pulse)))
   _ctx.state_saw = ((Float32(0.5) * ((pulse1 + (pulse2 + (Float32(-2.0) * _ctx.rate))) / shift05)) + (Float32(0.9995) * _ctx.state_saw))
   if (wave < Float32(1.0))
      _ctx.output = _ctx.state_pulse
   else
      _ctx.output = (Float32(2.0) * _ctx.state_saw)
   end
   _ctx.output = Util_dcblock(_ctx.inst_56426, _ctx.output)
   return _ctx.output
end

function Blit_process(_ctx, cv, pw, wave)
   return Blit_osc_blit(_ctx.inst_1268b, cv, pw, wave)
end

