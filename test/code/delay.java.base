private float Delay_smooth(Delay_smooth_type _ctx, float input) {
   _ctx.x = ((0.005f * (input + (-_ctx.x))) + _ctx.x);
   return _ctx.x;
}

private boolean Delay_change(Delay_change_type _ctx, float x) {
   boolean v = (_ctx.pre_x != x);
   _ctx.pre_x = x;
   return v;
}

private boolean Delay_edge(Delay_edge_type _ctx, boolean x) {
   boolean v = ((_ctx.pre_x != x) && (_ctx.pre_x == false));
   _ctx.pre_x = x;
   return v;
}

private boolean Delay_each(Delay_each_type _ctx, int n) {
   boolean ret = (_ctx.count == 0);
   _ctx.count = ((1 + _ctx.count) % n);
   return ret;
}

private float Delay_pitchToRate(float d) {
   return (0.000185f * exp((0.057762f * d)));
}

private float Delay_phasor(Delay_phasor_type _ctx, float pitch, boolean reset) {
   if (Delay_change(_ctx.inst_18071, pitch)) {
      _ctx.rate = Delay_pitchToRate(pitch);
   }
   if (reset) {
      _ctx.phase = 0.0f;
   } else {
      _ctx.phase = ((_ctx.phase + _ctx.rate) % 1.0f);
   }
   return _ctx.phase;
}

private float Delay_lfo(Delay_lfo_type _ctx, float f, boolean gate) {
   float rate = (0.000226f * f);
   if (Delay_edge(_ctx.inst_11461, gate)) {
      _ctx.phase = 0.0f;
   }
   _ctx.phase = (rate + _ctx.phase);
   if ((_ctx.phase > 1.0f)) {
      _ctx.phase = (-1.0f + _ctx.phase);
   }
   return (-0.5f + sin((6.283185f * _ctx.phase)));
}

private float Delay_phd_osc(Delay_phd_osc_type _ctx, float pitch, float detune) {
   float phase1 = Delay_phasor(_ctx.inst_171c4, pitch, false);
   float comp = (1.0f + (-phase1));
   boolean reset = (((-phase1) + _ctx.pre_phase1) > 0.5f);
   _ctx.pre_phase1 = phase1;
   float phase2 = Delay_phasor(_ctx.inst_371c4, (pitch + (32.0f * Delay_smooth(_ctx.inst_277c4, detune))), reset);
   float sine = sin((6.283185f * phase2));
   return (comp * sine);
}

private float Delay_delay(Delay_delay_type _ctx, float x, float time, float feedback) {
   time = clip(time, 0.0f, 1.0f);
   feedback = clip(feedback, 0.0f, 1.0f);
   float index_r = (30000.0f * time);
   int index_i = (int)(floor(index_r));
   int delta = ((-index_i) + _ctx.write_pos);
   int read_pos = 0;
   if ((delta < 0)) {
      read_pos = (30000 + delta);
   } else {
      read_pos = delta;
   }
   float decimal = (index_r + (-(float)(index_i)));
   float x1 = _ctx.buffer[read_pos];
   float x2 = _ctx.buffer[((1 + read_pos) % 30000)];
   float ret = (x1 + (decimal * (x2 + (-x1))));
   _ctx.write_pos = ((1 + _ctx.write_pos) % 30000);
   _ctx.buffer[_ctx.write_pos] = clip((x + (feedback * ret)), -1.0f, 1.0f);
   return ret;
}

private int Delay_mono_noteOn(Delay_mono_noteOn_type _ctx, int n) {
   if ((_ctx.count < 4)) {
      {
         _ctx.notes[_ctx.count] = n;
         _ctx.pre = n;
         if ((_ctx.count < 4)) {
            _ctx.count = (1 + _ctx.count);
         }
      }
   }
   return _ctx.pre;
}

private int Delay_mono_noteOff(Delay_mono_noteOn_type _ctx, int n) {
   boolean found = false;
   int i = 0;
   int pos = 0;
   if ((_ctx.count == 0)) {
      return _ctx.pre;
   }
   while (((i < 4) && (found == false))) {
      {
         if ((_ctx.notes[i] == n)) {
            {
               pos = i;
               found = true;
            }
         }
         i = (1 + i);
      }
   }
   if (found) {
      {
         int k = (1 + pos);
         while ((k < 4)) {
            {
               _ctx.notes[(-1 + k)] = _ctx.notes[k];
               k = (1 + k);
            }
         }
         if ((found && (_ctx.count > 0))) {
            {
               _ctx.count = (-1 + _ctx.count);
               _ctx.pre = _ctx.notes[(-1 + _ctx.count)];
            }
         }
      }
   }
   return _ctx.pre;
}

private boolean Delay_mono_isGateOn(Delay_mono_noteOn_type _ctx) {
   return (_ctx.count > 0);
}

private float Delay_process(Delay_process_type _ctx, float input) {
   boolean gate = Delay_mono_isGateOn(_ctx.notes);
   float lfo_val = (Delay_lfo(_ctx.inst_16101, _ctx.lfo_rate, gate) * _ctx.lfo_amt);
   float o1 = Delay_phd_osc(_ctx.inst_2c401, _ctx.pitch, (lfo_val + _ctx.detune));
   float amp = Delay_smooth(_ctx.inst_37701, (gate ? 1.0f : 0.0f));
   float osc_out = (amp * o1);
   float delay_out = Delay_delay(_ctx.inst_68e01, osc_out, Delay_smooth(_ctx.inst_47701, _ctx.time), Delay_smooth(_ctx.inst_57701, _ctx.feedback));
   return (0.5f * ((delay_out + osc_out) * _ctx.volume));
}

private void Delay_noteOn(Delay_process_type _ctx, int note, int velocity, int channel) {
   _ctx.pitch = (float)(Delay_mono_noteOn(_ctx.notes, note));
}

private void Delay_noteOff(Delay_process_type _ctx, int note, int channel) {
   _ctx.pitch = (float)(Delay_mono_noteOff(_ctx.notes, note));
}

private void Delay_controlChange(Delay_process_type _ctx, int control, float value, int channel) {
   if ((control == 30)) {
      _ctx.volume = (0.007874f * value);
   }
   if ((control == 31)) {
      _ctx.detune = (0.007874f * value);
   }
   if ((control == 32)) {
      _ctx.lfo_rate = (0.007874f * value);
   }
   if ((control == 33)) {
      _ctx.lfo_amt = (-1.0f + (0.015748f * value));
   }
   if ((control == 34)) {
      _ctx.time = (0.007874f * value);
   }
   if ((control == 35)) {
      _ctx.feedback = (0.007874f * value);
   }
}

private void Delay_default(Delay_process_type _ctx) {
   _ctx.volume = 1.0f;
   _ctx.pitch = 45.0f;
   _ctx.detune = 0.8f;
   _ctx.lfo_rate = 0.07f;
   _ctx.lfo_amt = -0.8f;
   _ctx.time = 0.5f;
   _ctx.feedback = 0.5f;
}


