function FixedAndFloat_take_fix_return_fixed(x)
   local value = (((x) > (1.0) and (1.0) or ((x) < (0.0) and (0.0) or (x))) * 33.0)
   local index = ((math.modf(value)) * 2)
   local decimal = (value - floor(value))
   return (FixedAndFloat_take_fix_return_fixed_c[(index) + 1] + (FixedAndFloat_take_fix_return_fixed_c[((index + 1)) + 1] * decimal))
end

