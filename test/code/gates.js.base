this.Gates_velToCV = function (vel) {
   return (0.007874 * this.real(vel));
};

this.Gates_gates_noteOn = function (_ctx, note, velocity) {
   if (((note >= (36|0)) && (note <= (43|0)))) {
      {
         var n = ((-36|0) + note);
         _ctx.vel[n] = velocity;
      }
   }
};

this.Gates_gates_noteOff = function (_ctx, note) {
