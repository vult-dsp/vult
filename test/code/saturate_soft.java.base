private float Saturate_soft_tanh_table(float x) {
   float value = ((clip(x, -24.0f, 24.0f) + 24.0f) * 5.020833f);
   int cell = clip(float_to_int(value), 0, 240);
   float u = (value - (float)(cell));
   int index = (cell * 3);
   return (Saturate_soft_tanh_table_c[index] + (u * (Saturate_soft_tanh_table_c[(index + 1)] + (Saturate_soft_tanh_table_c[(index + 2)] * u))));
}

