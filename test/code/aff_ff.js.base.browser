function vultProcess() {
this.Aff_ff_process_type_alloc = function () {
   var _ctx = {};
   _ctx.Aff_ff_process_ret_0 = 0.0;
   _ctx.Aff_ff_process_ret_1 = 0.0;
   _ctx.x = (0|0);
   return _ctx;
};

this.Aff_ff_noteOn_type_alloc = function (_ctx) {
   return this.Aff_ff_process_type_alloc();
};

this.Aff_ff_noteOff_type_alloc = function (_ctx) {
   return this.Aff_ff_process_type_alloc();
};

this.Aff_ff_controlChange_type_alloc = function (_ctx) {
   return this.Aff_ff_process_type_alloc();
};

this.Aff_ff_default_type_alloc = function (_ctx) {
   return this.Aff_ff_process_type_alloc();
};

this.Aff_ff_process = function (_ctx, a, b) {
   _ctx.x = ((1|0) + _ctx.x);
   _ctx.Aff_ff_process_ret_0 = (a + b);
   _ctx.Aff_ff_process_ret_1 = (a + (-b));
   return ;
};

this.Aff_ff_noteOn = function (_ctx, note, velocity, channel) {
};

this.Aff_ff_noteOff = function (_ctx, note, channel) {
};

this.Aff_ff_controlChange = function (_ctx, control, value, channel) {
};

this.Aff_ff_default = function (_ctx) {
};


   if(this.Aff_ff_process_type_alloc)  this.context =  this.Aff_ff_process_type_alloc(); else this.context = {};
   if(this.Aff_ff_default)      this.Aff_ff_default(this.context);
   this.liveNoteOn        = function(note,velocity,channel) { if(this.Aff_ff_noteOn)        this.Aff_ff_noteOn(this.context,note,velocity,channel); };
   this.liveNoteOff       = function(note,velocity,channel) { if(this.Aff_ff_noteOff)       this.Aff_ff_noteOff(this.context,note,velocity,channel); };
   this.liveControlChange = function(note,velocity,channel) { if(this.Aff_ff_controlChange) this.Aff_ff_controlChange(this.context,note,velocity,channel); };
   this.liveProcess       = function(input)         { if(this.Aff_ff_process)       return this.Aff_ff_process(this.context,input); else return 0; };
   this.liveDefault       = function() { if(this.Aff_ff_default)      return this.Aff_ff_default(this.context); };
   }