private float Saturate_tanh_table_raw_c0(int index) {
   return Saturate_tanh_table_c[(index * 3)];
}

private float Saturate_tanh_table_raw_c1(int index) {
   return Saturate_tanh_table_c[((index * 3) + 1)];
}

private float Saturate_tanh_table_raw_c2(int index) {
   return Saturate_tanh_table_c[((index * 3) + 2)];
}

private float Saturate_tanh_table(float x) {
   float value = clip(((x + 24.0f) * 5.020833f), 0.0f, 241.0f);
   int cell = clip(float_to_int(value), 0, 240);
   float u = (value - (float)(cell));
   int index = (cell * 3);
   return (Saturate_tanh_table_c[index] + (u * (Saturate_tanh_table_c[(index + 1)] + (Saturate_tanh_table_c[(index + 2)] * u))));
}

private float Saturate_process(float x) {
   return Saturate_tanh_table(x);
}

