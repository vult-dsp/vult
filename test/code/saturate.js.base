
// Runtime functions (simple builtins like eps, pi, clip, real, int_, sin, cos, etc. are inlined)
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
var Saturate_tanh_table_c = {};
this.Saturate_tanh_table_raw_c0 = function (index) {
   return Saturate_tanh_table_c[(index * (3|0))];
};

this.Saturate_tanh_table_raw_c1 = function (index) {
   return Saturate_tanh_table_c[((index * (3|0)) + (1|0))];
};

this.Saturate_tanh_table_raw_c2 = function (index) {
   return Saturate_tanh_table_c[((index * (3|0)) + (2|0))];
};

this.Saturate_tanh_table = function (x) {
   var value = ((((x + 24.0) * 5.020833)) < (0.0) ? (0.0) : ((((x + 24.0) * 5.020833)) > (241.0) ? (241.0) : (((x + 24.0) * 5.020833))));
   var cell = ((this.float_to_int(value)) < ((0|0)) ? ((0|0)) : ((this.float_to_int(value)) > ((240|0)) ? ((240|0)) : (this.float_to_int(value))));
   var u = (value - (cell));
   var index = (cell * (3|0));
   return (Saturate_tanh_table_c[index] + (u * (Saturate_tanh_table_c[(index + (1|0))] + (Saturate_tanh_table_c[(index + (2|0))] * u))));
};

this.Saturate_process = function (x) {
   return this.Saturate_tanh_table(x);
};

this.Saturate_noteOn = function (note, velocity, channel) {
};

this.Saturate_noteOff = function (note, channel) {
};

this.Saturate_controlChange = function (control, value, channel) {
};

this.Saturate_default = function () {
};

