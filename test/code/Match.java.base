
package vult.com.match;

import java.util.Arrays;
import java.util.Random;
import vult.com.external.*;

public class Match {

private int Match_foo1(int x) {
   if ((x == 0)) {
      return 0;
   } else {
      if ((x == 1)) {
         return 1;
      } else {
         return 2;
      }
   }
}

private int Match_foo2(int x, String y) {
   if (((x == 1) && (y == "e"))) {
      return (1 + x);
   } else {
      if ((x == 3)) {
         return 1;
      } else {
         return 2;
      }
   }
}

private int Match_foo3(int x) {
   if ((x == 0)) {
      return 1;
   } else {
      if ((x == 1)) {
         return 2;
      } else {
         return 0;
      }
   }
}


}
