
(function(audioContext) {
   var code = function () {
   this.Sff_ff_process_type_alloc = function () {
   var _ctx = {};
   _ctx.Sff_ff_process_ret_0 = 0.0;
   _ctx.Sff_ff_process_ret_1 = 0.0;
   return _ctx;
};

this.Sff_ff_process = function (_ctx, a, b) {
   _ctx.Sff_ff_process_ret_0 = (a + b);
   _ctx.Sff_ff_process_ret_1 = (a + (-b));
   return ;
};

this.Sff_ff_noteOn = function (_ctx, note, velocity, channel) {
};

this.Sff_ff_noteOff = function (_ctx, note, channel) {
};

this.Sff_ff_controlChange = function (_ctx, control, value, channel) {
};

this.Sff_ff_default = function (_ctx) {
};


      this.context = this.Sff_ff_process_type_alloc();
      };
   var processor = new code ();
   processor.Sff_ff_default(processor.context);
   var node = audioContext.createScriptProcessor(0, 2, 2);
   node.inputs = 2;
   node.outputs = 2;
   node.onaudioprocess = function (e) {


   var in_0 = e.inputBuffer.getChannelData(0); 
var in_1 = e.inputBuffer.getChannelData(1); 


   var out_0 = e.outputBuffer.getChannelData(0); 
var out_1 = e.outputBuffer.getChannelData(1); 


   for (var n = 0; n < e.inputBuffer.length; n++) {
            var ret = processor.Sff_ff_process(processor.context, in_0[n], in_1[n]); 
out_0[n] = Sff_ff_process_ret_0(processor.context); 
out_1[n] = Sff_ff_process_ret_1(processor.context);  
   }
   }


   node.noteOn = function(note, velocity, channel){
      if(velocity > 0) processor.Sff_ff_noteOn(processor.context,note,velocity,channel);
      else processor.Sff_ff_noteOff(processor.context,note,channel);
   }


   node.noteOff = function(note, channel) {
      processor.Sff_ff_noteOff(processor.context,note,channel);
   }


   node.controlChange = function(control, value, channel) {
      processor.Sff_ff_controlChange(processor.context,control,value,channel);
   }
   return node;
   })