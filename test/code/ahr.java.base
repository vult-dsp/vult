}

private float Util_cubic_clipper(float x) {
   if ((x <= -0.666667f)) {
      return -0.666667f;
   } else {
      if ((x >= 0.666666f)) {
         return 0.666666f;
      } else {
         return (x + (-0.333334f * (x * (x * x))));
      }
   }
}

