
# High-performance Vult Runtime for Julia with typed arrays

Tables_sineTable1_c = nothing
function Tables_sineTable1_raw_c0(index)
   return @inbounds Tables_sineTable1_c[(index * Int32(3)) + 1]
end

function Tables_sineTable1_raw_c1(index)
   return @inbounds Tables_sineTable1_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Tables_sineTable1_raw_c2(index)
   return @inbounds Tables_sineTable1_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Tables_sineTable1(x)
   value = (clamp(x, Float32(0.0), Float32(1.0)) * Float32(32.0))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Tables_sineTable1_c[index + 1] + (u * (@inbounds Tables_sineTable1_c[(index + Int32(1)) + 1] + (@inbounds Tables_sineTable1_c[(index + Int32(2)) + 1] * u))))
end

Tables_sineTable2_c = nothing
function Tables_sineTable2_raw_c0(index)
   return @inbounds Tables_sineTable2_c[(index * Int32(2)) + 1]
end

function Tables_sineTable2_raw_c1(index)
   return @inbounds Tables_sineTable2_c[((index * Int32(2)) + Int32(1)) + 1]
end

function Tables_sineTable2(x)
   value = (clamp(x, Float32(0.0), Float32(1.0)) * Float32(32.0))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(2))
   return (@inbounds Tables_sineTable2_c[index + 1] + (u * @inbounds Tables_sineTable2_c[(index + Int32(1)) + 1]))
end

Tables_sineTable3_c = nothing
function Tables_sineTable3_raw_c0(index)
   return @inbounds Tables_sineTable3_c[(index * Int32(2)) + 1]
end

function Tables_sineTable3_raw_c1(index)
   return @inbounds Tables_sineTable3_c[((index * Int32(2)) + Int32(1)) + 1]
end

function Tables_sineTable3(x)
   value = (clip(x, Float32(0.0), Float32(1.0)) * Float32(33.0))
   index = (trunc(Int32, value) * Int32(2))
   decimal = (value - floor(value))
   return (@inbounds Tables_sineTable3_c[index + 1] + (@inbounds Tables_sineTable3_c[(index + Int32(1)) + 1] * decimal))
end

Tables_power2_table = nothing
function Tables_power2(x)
   return @inbounds Tables_power2_table[(int_clip(x, Int32(-4), Int32(4)) + Int32(4)) + 1]
end

Tables_square_table = nothing
function Tables_square(x)
   return @inbounds Tables_square_table[(int_clip(x, Int32(-4), Int32(4)) + Int32(4)) + 1]
end

Tables_square16_table = nothing
function Tables_square16(x)
   return @inbounds Tables_square16_table[(int_clip(x, Int32(-4), Int32(4)) + Int32(4)) + 1]
end

