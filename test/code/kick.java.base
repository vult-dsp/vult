private float Util_pitchToRate_1024_raw_c0(int index) {
   return Util_pitchToRate_1024_c[(index * 3)];
}

private float Util_pitchToRate_1024_raw_c1(int index) {
   return Util_pitchToRate_1024_c[((index * 3) + 1)];
}

private float Util_pitchToRate_1024_raw_c2(int index) {
   return Util_pitchToRate_1024_c[((index * 3) + 2)];
