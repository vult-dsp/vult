private float Util_cvToRate_1024(float cv) {
   float value = clip((cv * 35.555555f), 0.0f, 32.0f);
   int cell = clip(float_to_int(value), 0, 31);
   float u = (value - (float)(cell));
   int index = (cell * 3);
   return (Util_cvToRate_1024_c[index] + (u * (Util_cvToRate_1024_c[(index + 1)] + (Util_cvToRate_1024_c[(index + 2)] * u))));
}

