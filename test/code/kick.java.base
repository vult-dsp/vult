private float Util_pitchToRate_1024(float pitch) {
   float value = clip((pitch * 0.251968f), 0.0f, 32.0f);
   int cell = clip(float_to_int(value), 0, 31);
   float u = (value - (float)(cell));
   int index = (cell * 3);
   return (Util_pitchToRate_1024_c[index] + (u * (Util_pitchToRate_1024_c[(index + 1)] + (Util_pitchToRate_1024_c[(index + 2)] * u))));
}

