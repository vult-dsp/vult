end

function Util_cvToRate_raw_c2(index)
   return @inbounds Util_cvToRate_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Util_cvToRate(cv)
   value = (clamp(cv, Float32(0.0), Float32(0.9)) * Float32(142.222222))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(127))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_cvToRate_c[index + 1] + (u * (@inbounds Util_cvToRate_c[(index + Int32(1)) + 1] + (@inbounds Util_cvToRate_c[(index + Int32(2)) + 1] * u))))
end

function Util_pitchToCv(pitch)
   return (Float32(-0.2) + (Float32(0.008333) * pitch))
end

