function Util_cvTokHz(cv)
   value = (clamp(cv, Float32(0.0), Float32(1.0)) * Float32(32.0))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_cvTokHz_c[index + 1] + (u * (@inbounds Util_cvTokHz_c[(index + Int32(1)) + 1] + (@inbounds Util_cvTokHz_c[(index + Int32(2)) + 1] * u))))
end

function Polycv_velToCV(vel)
   return (Float32(0.007874) * Float32(vel))
end

function Polycv_velToGate(vel)
   if (vel > Int32(0))
      return (Float32(0.007874) * Float32(vel))
   else
      return Float32(0.0)
   end
end

function Polycv_poly_noteOn(_ctx, note, velocity)
   i = Int32(0)
   found = false
   while ((i < Int32(4)) && (found == false))
      begin
         if (@inbounds _ctx.vel[i + 1] == Int32(0))
            begin
               @inbounds _ctx.notes[i + 1] = note
               @inbounds _ctx.vel[i + 1] = velocity
               found = true
            end
         end
         i = (Int32(1) + i)
      end
   end
end

function Polycv_poly_noteOff(_ctx, note)
   i = Int32(0)
   found = false
   while ((i < Int32(4)) && (found == false))
      begin
         if (@inbounds _ctx.notes[i + 1] == note)
            begin
               @inbounds _ctx.vel[i + 1] = Int32(0)
               found = true
            end
         end
         i = (Int32(1) + i)
      end
   end
end

function Polycv_polyState(_ctx)
   note1 = Util_pitchToCv(Float32(@inbounds _ctx.notes[1]))
   note2 = Util_pitchToCv(Float32(@inbounds _ctx.notes[2]))
   note3 = Util_pitchToCv(Float32(@inbounds _ctx.notes[3]))
   note4 = Util_pitchToCv(Float32(@inbounds _ctx.notes[4]))
   vel1 = Polycv_velToCV(@inbounds _ctx.vel[1])
   vel2 = Polycv_velToCV(@inbounds _ctx.vel[2])
   vel3 = Polycv_velToCV(@inbounds _ctx.vel[3])
   vel4 = Polycv_velToCV(@inbounds _ctx.vel[4])
   gate1 = Polycv_velToGate(@inbounds _ctx.vel[1])
   gate2 = Polycv_velToGate(@inbounds _ctx.vel[2])
   gate3 = Polycv_velToGate(@inbounds _ctx.vel[3])
   gate4 = Polycv_velToGate(@inbounds _ctx.vel[4])
   _ctx.Polycv_polyState_ret_0 = note1
   _ctx.Polycv_polyState_ret_1 = vel1
   _ctx.Polycv_polyState_ret_2 = gate1
   _ctx.Polycv_polyState_ret_3 = note2
   _ctx.Polycv_polyState_ret_4 = vel2
   _ctx.Polycv_polyState_ret_5 = gate2
   _ctx.Polycv_polyState_ret_6 = note3
   _ctx.Polycv_polyState_ret_7 = vel3
   _ctx.Polycv_polyState_ret_8 = gate3
   _ctx.Polycv_polyState_ret_9 = note4
   _ctx.Polycv_polyState_ret_10 = vel4
   _ctx.Polycv_polyState_ret_11 = gate4
   return 
end

function Polycv_process(_ctx, c)
   _ctx.channel_in = c
   Polycv_polyState(_ctx.poly)
   _call_temp_0 = _ctx.poly.Polycv_polyState_ret_0
   _call_temp_1 = _ctx.poly.Polycv_polyState_ret_1
   _call_temp_2 = _ctx.poly.Polycv_polyState_ret_2
   _call_temp_3 = _ctx.poly.Polycv_polyState_ret_3
   _call_temp_4 = _ctx.poly.Polycv_polyState_ret_4
   _call_temp_5 = _ctx.poly.Polycv_polyState_ret_5
   _call_temp_6 = _ctx.poly.Polycv_polyState_ret_6
   _call_temp_7 = _ctx.poly.Polycv_polyState_ret_7
   _call_temp_8 = _ctx.poly.Polycv_polyState_ret_8
   _call_temp_9 = _ctx.poly.Polycv_polyState_ret_9
   _call_temp_10 = _ctx.poly.Polycv_polyState_ret_10
   _call_temp_11 = _ctx.poly.Polycv_polyState_ret_11
   _ctx.Polycv_process_ret_0 = _call_temp_0
   _ctx.Polycv_process_ret_1 = _call_temp_1
   _ctx.Polycv_process_ret_2 = _call_temp_2
   _ctx.Polycv_process_ret_3 = _call_temp_3
   _ctx.Polycv_process_ret_4 = _call_temp_4
   _ctx.Polycv_process_ret_5 = _call_temp_5
   _ctx.Polycv_process_ret_6 = _call_temp_6
   _ctx.Polycv_process_ret_7 = _call_temp_7
   _ctx.Polycv_process_ret_8 = _call_temp_8
   _ctx.Polycv_process_ret_9 = _call_temp_9
   _ctx.Polycv_process_ret_10 = _call_temp_10
   _ctx.Polycv_process_ret_11 = _call_temp_11
   return 
end

function Polycv_noteOn(_ctx, note, velocity, channel)
   if (_ctx.channel_in == channel)
      if (velocity > Int32(0))
         Polycv_poly_noteOn(_ctx.poly, note, velocity)
      else
         Polycv_poly_noteOff(_ctx.poly, note)
      end
   end
end

function Polycv_noteOff(_ctx, note, channel)
   if (_ctx.channel_in == channel)
      Polycv_poly_noteOff(_ctx.poly, note)
   end
end

function Polycv_controlChange(_ctx, control, value, channel)
end

function Polycv_default(_ctx)
end

