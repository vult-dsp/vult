end

# Default constructor for Polycv_process_type
function Polycv_process_type()
    return Polycv_process_type(Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Int32(0), Polycv_poly_noteOn_type())
end

function Util_edge_type_alloc()
   _ctx = Util_edge_type()
   _ctx.pre = false
   return _ctx
end

function Util_change_type_alloc()
   _ctx = Util_change_type()
   _ctx.pre_x = Float32(0.0)
   return _ctx
end

function Util_dcblock_type_alloc()
   _ctx = Util_dcblock_type()
   _ctx.x1 = Float32(0.0)
   _ctx.y1 = Float32(0.0)
   return _ctx
end

function Util_smooth_type_alloc()
   _ctx = Util_smooth_type()
   _ctx.x = Float32(0.0)
   return _ctx
end

function Util_average2_type_alloc()
   _ctx = Util_average2_type()
   _ctx.x0 = Float32(0.0)
   return _ctx
end

function Polycv_poly_noteOn_type_alloc()
   _ctx = Polycv_poly_noteOn_type()
   _ctx.Polycv_polyState_ret_0 = Float32(0.0)
   _ctx.Polycv_polyState_ret_1 = Float32(0.0)
   _ctx.Polycv_polyState_ret_10 = Float32(0.0)
   _ctx.Polycv_polyState_ret_11 = Float32(0.0)
   _ctx.Polycv_polyState_ret_2 = Float32(0.0)
   _ctx.Polycv_polyState_ret_3 = Float32(0.0)
   _ctx.Polycv_polyState_ret_4 = Float32(0.0)
   _ctx.Polycv_polyState_ret_5 = Float32(0.0)
   _ctx.Polycv_polyState_ret_6 = Float32(0.0)
   _ctx.Polycv_polyState_ret_7 = Float32(0.0)
   _ctx.Polycv_polyState_ret_8 = Float32(0.0)
   _ctx.Polycv_polyState_ret_9 = Float32(0.0)
   i_0 = Int32(0)
   temp_1 = fill(Int32(0), Int32(4))
   while (i_0 < Int32(4))
      begin
         @inbounds temp_1[i_0 + 1] = Int32(0)
         i_0 = (Int32(1) + i_0)
      end
   end
   _ctx.notes = temp_1
   i_2 = Int32(0)
   temp_3 = fill(Int32(0), Int32(4))
   while (i_2 < Int32(4))
      begin
         @inbounds temp_3[i_2 + 1] = Int32(0)
         i_2 = (Int32(1) + i_2)
      end
   end
   _ctx.vel = temp_3
   return _ctx
end

function Polycv_poly_noteOff_type_alloc(_ctx)
   return Polycv_poly_noteOn_type_alloc()
end

function Polycv_polyState_type_alloc(_ctx)
   return Polycv_poly_noteOn_type_alloc()
end

function Polycv_process_type_alloc()
   _ctx = Polycv_process_type()
   _ctx.Polycv_process_ret_0 = Float32(0.0)
   _ctx.Polycv_process_ret_1 = Float32(0.0)
   _ctx.Polycv_process_ret_10 = Float32(0.0)
   _ctx.Polycv_process_ret_11 = Float32(0.0)
   _ctx.Polycv_process_ret_2 = Float32(0.0)
   _ctx.Polycv_process_ret_3 = Float32(0.0)
   _ctx.Polycv_process_ret_4 = Float32(0.0)
   _ctx.Polycv_process_ret_5 = Float32(0.0)
   _ctx.Polycv_process_ret_6 = Float32(0.0)
   _ctx.Polycv_process_ret_7 = Float32(0.0)
   _ctx.Polycv_process_ret_8 = Float32(0.0)
   _ctx.Polycv_process_ret_9 = Float32(0.0)
   _ctx.channel_in = Int32(0)
   _ctx.poly = Polycv_poly_noteOn_type_alloc()
   return _ctx
end

function Polycv_noteOn_type_alloc(_ctx)
   return Polycv_process_type_alloc()
end

function Polycv_noteOff_type_alloc(_ctx)
   return Polycv_process_type_alloc()
end

function Polycv_controlChange_type_alloc(_ctx)
   return Polycv_process_type_alloc()
end

function Polycv_default_type_alloc(_ctx)
   return Polycv_process_type_alloc()
end

function Util_edge(_ctx, x)
   ret = (x && (_ctx.pre == false))
   _ctx.pre = x
   return ret
end

function Util_change(_ctx, x)
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v
end

function Util_map(x, x0, x1, y0, y1)
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))
end

function Util_dcblock(_ctx, x0)
   y0 = (x0 + ((-_ctx.x1) + (Float32(0.995) * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0
end

function Util_smooth(_ctx, input)
   _ctx.x = ((Float32(0.005) * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Util_average2(_ctx, x1)
   result = (Float32(0.5) * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result
end

function Util_cubic_clipper(x)
   if (x <= Float32(-0.666667))
      return Float32(-0.666667)
   else
      if (x >= Float32(0.666666))
         return Float32(0.666666)
      else
         return (x + (Float32(-0.333334) * (x * (x * x))))
      end
   end
end

Util_pitchToRate_1024_c = nothing
function Util_pitchToRate_1024_raw_c0(index)
   return @inbounds Util_pitchToRate_1024_c[(index * Int32(3)) + 1]
end

function Util_pitchToRate_1024_raw_c1(index)
   return @inbounds Util_pitchToRate_1024_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Util_pitchToRate_1024_raw_c2(index)
   return @inbounds Util_pitchToRate_1024_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Util_pitchToRate_1024(pitch)
   value = (clamp(pitch, Float32(0.0), Float32(127.0)) * Float32(0.251968))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_pitchToRate_1024_c[index + 1] + (u * (@inbounds Util_pitchToRate_1024_c[(index + Int32(1)) + 1] + (@inbounds Util_pitchToRate_1024_c[(index + Int32(2)) + 1] * u))))
end

Util_pitchToRate_c = nothing
function Util_pitchToRate_raw_c0(index)
   return @inbounds Util_pitchToRate_c[(index * Int32(3)) + 1]
end

function Util_pitchToRate_raw_c1(index)
   return @inbounds Util_pitchToRate_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Util_pitchToRate_raw_c2(index)
   return @inbounds Util_pitchToRate_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Util_pitchToRate(pitch)
   value = (clamp(pitch, Float32(0.0), Float32(127.0)) * Float32(0.251968))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_pitchToRate_c[index + 1] + (u * (@inbounds Util_pitchToRate_c[(index + Int32(1)) + 1] + (@inbounds Util_pitchToRate_c[(index + Int32(2)) + 1] * u))))
end

function Util_cvToPitch(cv)
   return (Float32(24.0) + (Float32(120.0) * cv))
end

Util_cvToRate_1024_c = nothing
function Util_cvToRate_1024_raw_c0(index)
