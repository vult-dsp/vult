mutable struct Polycv_poly_noteOn_type
       Polycv_polyState_ret_0::Float32
       Polycv_polyState_ret_1::Float32
       Polycv_polyState_ret_10::Float32
       Polycv_polyState_ret_11::Float32
       Polycv_polyState_ret_2::Float32
       Polycv_polyState_ret_3::Float32
       Polycv_polyState_ret_4::Float32
       Polycv_polyState_ret_5::Float32
       Polycv_polyState_ret_6::Float32
       Polycv_polyState_ret_7::Float32
       Polycv_polyState_ret_8::Float32
       Polycv_polyState_ret_9::Float32
       notes::Vector{Int32}
       vel::Vector{Int32}
end

# Default constructor for Polycv_poly_noteOn_type
function Polycv_poly_noteOn_type()
    return Polycv_poly_noteOn_type(Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), Float32(0.0), fill(Int32(0), 4), fill(Int32(0), 4))
end

