
# High-performance Vult Runtime for Julia with typed arrays

mutable struct Util_edge_type
       pre::Bool
end

# Default constructor for Util_edge_type
function Util_edge_type()
    return Util_edge_type(false)
end

mutable struct Util_change_type
       pre_x::Float32
end

# Default constructor for Util_change_type
function Util_change_type()
    return Util_change_type(Float32(0.0))
end

mutable struct Util_dcblock_type
       x1::Float32
       y1::Float32
end

# Default constructor for Util_dcblock_type
function Util_dcblock_type()
    return Util_dcblock_type(Float32(0.0), Float32(0.0))
end

mutable struct Util_smooth_type
       x::Float32
end

# Default constructor for Util_smooth_type
function Util_smooth_type()
    return Util_smooth_type(Float32(0.0))
end

mutable struct Util_average2_type
       x0::Float32
end

# Default constructor for Util_average2_type
function Util_average2_type()
    return Util_average2_type(Float32(0.0))
end

mutable struct Ad_do_type
       inst_10452::Util_edge_type
       out::Float32
       rate::Float32
       scale::Float32
       state::Int32
       target::Float32
end

# Default constructor for Ad_do_type
function Ad_do_type()
    return Ad_do_type(Util_edge_type(), Float32(0.0), Float32(0.0), Float32(0.0), Int32(0), Float32(0.0))
end

mutable struct Ad_process_type
       inst_15232::Ad_do_type
       knob1::Float32
       knob2::Float32
end

# Default constructor for Ad_process_type
function Ad_process_type()
    return Ad_process_type(Ad_do_type(), Float32(0.0), Float32(0.0))
end

function Util_edge_type_alloc()
   _ctx = Util_edge_type()
   _ctx.pre = false
   return _ctx
end

function Util_change_type_alloc()
   _ctx = Util_change_type()
   _ctx.pre_x = Float32(0.0)
   return _ctx
end

function Util_dcblock_type_alloc()
   _ctx = Util_dcblock_type()
   _ctx.x1 = Float32(0.0)
   _ctx.y1 = Float32(0.0)
   return _ctx
end

function Util_smooth_type_alloc()
   _ctx = Util_smooth_type()
   _ctx.x = Float32(0.0)
   return _ctx
end

function Util_average2_type_alloc()
   _ctx = Util_average2_type()
   _ctx.x0 = Float32(0.0)
   return _ctx
end

function Ad_do_type_alloc()
   _ctx = Ad_do_type()
   _ctx.inst_10452 = Util_edge_type_alloc()
   _ctx.out = Float32(0.0)
   _ctx.rate = Float32(0.0)
   _ctx.scale = Float32(0.0)
   _ctx.state = Int32(0)
   _ctx.target = Float32(0.0)
   return _ctx
end

function Ad_process_type_alloc()
   _ctx = Ad_process_type()
   _ctx.inst_15232 = Ad_do_type_alloc()
   _ctx.knob1 = Float32(0.0)
   _ctx.knob2 = Float32(0.0)
   return _ctx
end

function Ad_noteOn_type_alloc(_ctx)
   return Ad_process_type_alloc()
end

function Ad_noteOff_type_alloc(_ctx)
   return Ad_process_type_alloc()
end

function Ad_controlChange_type_alloc(_ctx)
   return Ad_process_type_alloc()
end

function Ad_default_type_alloc(_ctx)
   return Ad_process_type_alloc()
end

function Util_edge(_ctx, x)
   ret = (x && (_ctx.pre == false))
   _ctx.pre = x
   return ret
end

function Util_change(_ctx, x)
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v
end

function Util_map(x, x0, x1, y0, y1)
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))
end

function Util_dcblock(_ctx, x0)
   y0 = (x0 + ((-_ctx.x1) + (Float32(0.995) * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0
end

function Util_smooth(_ctx, input)
   _ctx.x = ((Float32(0.005) * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Util_average2(_ctx, x1)
   result = (Float32(0.5) * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result
end

function Util_cubic_clipper(x)
   if (x <= Float32(-0.666667))
      return Float32(-0.666667)
   else
      if (x >= Float32(0.666666))
         return Float32(0.666666)
      else
         return (x + (Float32(-0.333334) * (x * (x * x))))
      end
   end
end

Util_pitchToRate_1024_c = nothing
function Util_pitchToRate_1024_raw_c0(index)
   return @inbounds Util_pitchToRate_1024_c[(index * Int32(3)) + 1]
end

function Util_pitchToRate_1024_raw_c1(index)
   return @inbounds Util_pitchToRate_1024_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Util_pitchToRate_1024_raw_c2(index)
   return @inbounds Util_pitchToRate_1024_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Util_pitchToRate_1024(pitch)
   value = (clamp(pitch, Float32(0.0), Float32(127.0)) * Float32(0.251968))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_pitchToRate_1024_c[index + 1] + (u * (@inbounds Util_pitchToRate_1024_c[(index + Int32(1)) + 1] + (@inbounds Util_pitchToRate_1024_c[(index + Int32(2)) + 1] * u))))
end

