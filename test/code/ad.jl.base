end

function Util_pitchToRate(pitch)
   value = (clamp(pitch, Float32(0.0), Float32(127.0)) * Float32(0.251968))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_pitchToRate_c[index + 1] + (u * (@inbounds Util_pitchToRate_c[(index + Int32(1)) + 1] + (@inbounds Util_pitchToRate_c[(index + Int32(2)) + 1] * u))))
end

function Util_cvToPitch(cv)
   return (Float32(24.0) + (Float32(120.0) * cv))
end

