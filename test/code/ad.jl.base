   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_cvTokHz_c[index + 1] + (u * (@inbounds Util_cvTokHz_c[(index + Int32(1)) + 1] + (@inbounds Util_cvTokHz_c[(index + Int32(2)) + 1] * u))))
end

function Ad_do(_ctx, gate, a, d)
   a_rate = (Float32(1.0) / (Float32(0.01) + (Float32(100.0) * a)))
   d_rate = (Float32(1.0) / (Float32(0.01) + (Float32(100.0) * d)))
   bgate = (gate > Float32(0.0))
   _ctx.out = ((Float32(0.004) * (((-_ctx.out) + _ctx.target) * _ctx.rate)) + _ctx.out)
   if (_ctx.state == Int32(0))
      begin
         if Util_edge(_ctx.inst_10452, bgate)
            begin
               _ctx.state = Int32(1)
               _ctx.scale = (Float32(0.2) * gate)
            end
         end
         _ctx.rate = d_rate
         _ctx.target = Float32(0.0)
      end
   end
   if (_ctx.state == Int32(1))
      begin
         if ((bgate == false) || (_ctx.out > Float32(1024.0)))
            _ctx.state = Int32(0)
         end
         _ctx.rate = a_rate
         _ctx.target = Float32(1228.8)
      end
   end
   return (clamp((Float32(0.000976) * _ctx.out), Float32(0.0), Float32(1.0)) * _ctx.scale)
end

function Ad_process(_ctx, gate)
   return Ad_do(_ctx.inst_15232, gate, _ctx.knob1, _ctx.knob2)
end

function Ad_noteOn(_ctx, note, velocity, channel)
end

function Ad_noteOff(_ctx, note, channel)
end

function Ad_controlChange(_ctx, control, value, channel)
   if (control == Int32(1))
      _ctx.knob1 = (Float32(0.007874) * Float32(value))
   end
   if (control == Int32(2))
      _ctx.knob2 = (Float32(0.007874) * Float32(value))
   end
end

function Ad_default(_ctx)
   _ctx.knob1 = Float32(0.0)
   _ctx.knob2 = Float32(0.5)
end

