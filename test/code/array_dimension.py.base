import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

def Array_dimension_total(data):
   acc = 0.0
   i__1 = 0
   while (i__1 < size(data)):
      acc = (acc + data[i__1])
      i__1 = (1 + i__1)

   return acc


def Array_dimension_sum(data1, data2):
   acc = 0.0
   i__1 = 0
   while (i__1 < size(data1)):
      acc = (acc + (data1[i__1] + data2[i__1]))
      i__1 = (1 + i__1)

   return acc


def Array_dimension_main():
   x = [1.0, 2.0]
   y = [1.0, 2.0, 3.0]
   z = (Array_dimension_total(x) + Array_dimension_total(y))
   k = Array_dimension_sum(x, y)


