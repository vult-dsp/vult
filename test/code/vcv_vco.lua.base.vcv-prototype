

-- Math functions
local sin = math.sin


-- VCV Prototype functions
local global_block = {}

function stringAppend(s1, s2)
   return s1 .. s2
end

function string(n)
   return tostring(n)
end

function getKnob(i)
   if i > 6 or i < 1 then
      return 0.0
   else
      return global_block.knobs[i]
   end
end

function getSwitch(i)
   if i > 6 or i < 1 then
      return false
   else
      return global_block.switches[i]
   end
end

function setLight(i, r, g, b)
   if not(i > 6 or i < 1) then
      global_block.lights[i][1] = r
      global_block.lights[i][2] = g
      global_block.lights[i][3] = b
   end
end

function setSwitchLight(i, r, g, b)
   if not(i > 6 or i < 1) then
      global_block.switchLights[i][1] = r
      global_block.switchLights[i][2] = g
      global_block.switchLights[i][3] = b
   end
end

function samplerate()
   return global_block.sampleRate
end

function sampletime()
   return global_block.sampleTime
end

config.frameDivider = 1
config.bufferSize = 32
function Vcv_vco_process_type_alloc()
   local _ctx = {};
   _ctx.phase = 0.0
   return _ctx
end

function Vcv_vco_update_type_alloc(_ctx)
   return Vcv_vco_process_type_alloc()
end

function Vcv_vco_process(_ctx, input_cv)
   local knob_cv = (-0.5 + getKnob(1))
   local freq = (440.0 * (input_cv + knob_cv))
   local delta = (freq * sampletime())
   _ctx.phase = (delta + _ctx.phase)
   if (_ctx.phase > 1.0) then
      _ctx.phase = (-1.0 + _ctx.phase)
   end
   return sin((6.283185 * _ctx.phase))
end

function Vcv_vco_update(_ctx)
end


function display(s)
   print(s)
end

local processor = Vcv_vco_process_type_alloc()


function process(block)
   global_block = block
   Vcv_vco_update(processor)
   for i=1,block.bufferSize do
      local input_cv = block.inputs[1][i] / 10.0
      block.outputs[1][i] = 10.0 * Vcv_vco_process(processor, input_cv)
   end
end
