   _ctx.m = (Int32(1) + (trunc(Int32, Util_cvToperiod(Float32(0.0))) * 2))
   _ctx.scale = (Float32(1.0) + (Float32(2.0) * Util_cvToperiod(Float32(0.0))))
end

