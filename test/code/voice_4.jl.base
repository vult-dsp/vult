function Voice_4_process(_ctx, cv, vel, gate)
   lfo = Lfo_process(_ctx.inst_1d695, _ctx.lfo_rate, _ctx.lfo_shape, (gate * _ctx.lfo_reset))
   mod_pw = (lfo * _ctx.lfo_pw)
   mod_cv = (lfo * _ctx.lfo_cv)
   mod_flt = (lfo * _ctx.lfo_flt)
   o1 = Blit_process(_ctx.inst_28b95, (Float32(0.0001) + (cv + mod_cv)), (mod_pw + _ctx.pw1), Float32(0.0))
   o2 = Blit_process(_ctx.inst_38b95, (Float32(0.0002) + (cv + mod_cv)), (mod_pw + _ctx.pw2), Float32(1.0))
   o3 = Blit_process(_ctx.inst_48b95, (cv + (mod_cv + _ctx.pw3)), (mod_pw + _ctx.pw1), Float32(0.0))
   sub = Saturate_process(((Float32(2.0) + (Float32(5.0) * _ctx.pw4)) * Tricore_process(_ctx.inst_53c95, (cv + mod_cv), Float32(0.0), Float32(1.0))))
   o = ((o1 * _ctx.level1) + ((o2 * _ctx.level2) + ((o3 * _ctx.level3) + (sub * _ctx.level4))))
   f = Svf_process(_ctx.inst_6a295, o, (mod_flt + _ctx.flt_cut), _ctx.flt_res, _ctx.flt_shape)
   env = Adsr_do(_ctx.inst_7a095, gate, _ctx.attack, _ctx.decay, _ctx.sustain, _ctx.release)
   return (env * f)
end

