function Adsr_do(_ctx, gate, a, d, s, r)
   a_rate = (Float32(1.0) / (Float32(0.01) + (Float32(100.0) * a)))
   d_rate = (Float32(1.0) / (Float32(0.01) + (Float32(100.0) * d)))
   r_rate = (Float32(1.0) / (Float32(0.01) + (Float32(100.0) * r)))
   _ctx.out = ((Float32(0.004) * (((-_ctx.out) + _ctx.target) * _ctx.rate)) + _ctx.out)
   bgate = (gate > Float32(0.0))
   if (_ctx.state == Int32(0))
      begin
         if Util_edge(_ctx.inst_104a0, bgate)
            begin
               _ctx.state = Int32(1)
               _ctx.scale = (Float32(0.2) * gate)
            end
         end
         _ctx.rate = r_rate
         _ctx.target = Float32(0.0)
      end
   end
   if (_ctx.state == Int32(1))
      begin
         if (bgate == false)
            _ctx.state = Int32(0)
         end
         if (_ctx.out > Float32(1024.0))
            _ctx.state = Int32(2)
         end
         _ctx.rate = a_rate
         _ctx.target = Float32(1228.8)
      end
   end
   if (_ctx.state == Int32(2))
      begin
         if (bgate == false)
            _ctx.state = Int32(0)
         end
         _ctx.rate = d_rate
         _ctx.target = (Float32(1024.0) * s)
      end
   end
   return (Util_smooth(_ctx.inst_295a0, _ctx.scale) * clamp((Float32(0.000976) * _ctx.out), Float32(0.0), Float32(1.0)))
end

