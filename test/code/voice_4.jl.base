   if (control == Int32(46))
      _ctx.flt_shape = div((value * 4), Int32(127))
   end
   if (control == Int32(47))
      _ctx.attack = (Float32(0.007874) * Float32(value))
   end
   if (control == Int32(48))
      _ctx.decay = (Float32(0.007874) * Float32(value))
