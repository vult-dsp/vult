function Blit_pulse_train(_ctx, cv, phase)
   if Util_change(_ctx.inst_1b05e, cv)
      begin
         _ctx.m = (Int32(1) + (trunc(Int32, Util_cvToperiod(cv)) * 2))
         _ctx.scale = (Float32(2.0) * Util_cvToperiod(cv))
      end
   end
   pi_phase = (Float32(0.5) * phase)
   denominator = Tables_nsine(pi_phase)
   out = Float32(0.0)
   if (denominator <= eps(Float32))
      out = Float32(1.0)
   else
      begin
         m_phase = mod((pi_phase * Float32(_ctx.m)), Float32(1.0))
         numerator = Tables_nsine(m_phase)
         out = (numerator / (denominator * _ctx.scale))
      end
   end
   return out
end

function Blit_osc_blit(_ctx, cv, pw, wave)
   fixed_cv = Float32(0.0)
   if (wave < Float32(1.0))
      fixed_cv = cv
   else
      fixed_cv = (Float32(-0.1) + cv)
   end
   if Util_change(_ctx.inst_1b026, fixed_cv)
      _ctx.rate = Util_cvToRate(fixed_cv)
   end
   phase = Phase_process(_ctx.inst_28a26, fixed_cv, Float32(0.0))
   shift05 = (Float32(0.5) + (Float32(0.49) * pw))
   shift = (phase + shift05)
   if (shift > Float32(1.0))
      shift = (Float32(-1.0) + shift)
   end
   pulse1 = Blit_pulse_train(_ctx.inst_35e26, fixed_cv, phase)
   pulse2 = Blit_pulse_train(_ctx.inst_45e26, fixed_cv, shift)
   _ctx.state_pulse = (pulse1 + ((-pulse2) + (Float32(0.9995) * _ctx.state_pulse)))
   _ctx.state_saw = ((Float32(0.5) * ((pulse1 + (pulse2 + (Float32(-2.0) * _ctx.rate))) / shift05)) + (Float32(0.9995) * _ctx.state_saw))
   if (wave < Float32(1.0))
      _ctx.output = _ctx.state_pulse
   else
      _ctx.output = (Float32(2.0) * _ctx.state_saw)
   end
   _ctx.output = Util_dcblock(_ctx.inst_56426, _ctx.output)
   return _ctx.output
end

