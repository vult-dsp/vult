function Svf_calc_g(cv)
   value = (clamp(cv, Float32(0.0), Float32(0.9)) * Float32(142.222222))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(127))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Svf_calc_g_c[index + 1] + (u * (@inbounds Svf_calc_g_c[(index + Int32(1)) + 1] + (@inbounds Svf_calc_g_c[(index + Int32(2)) + 1] * u))))
end

function Svf_default(_ctx)
   _ctx.g = Svf_calc_g(Float32(0.0))
   _ctx.r = Float32(1.0)
   _ctx.inv_den = (Float32(1.0) / (Float32(1.0) + (_ctx.g * _ctx.g)))
end

