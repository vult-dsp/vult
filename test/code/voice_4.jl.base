function Lfo_soft(_ctx, x1)
   o = (Float32(0.25) * (x1 + (_ctx.x2 + (_ctx.x3 + _ctx.x4))))
   _t_temp_0 = x1
   _t_temp_1 = _ctx.x2
   _t_temp_2 = _ctx.x3
   _ctx.x2 = _t_temp_0
   _ctx.x3 = _t_temp_1
   _ctx.x4 = _t_temp_2
   return o
end

function Lfo_process(_ctx, cv, shape, reset)
   if Util_change(_ctx.inst_1b0d6, cv)
      _ctx.rate = Util_cvToRate((Float32(-0.3) + cv))
   end
   _ctx.phase = (_ctx.phase + _ctx.rate)
   if (_ctx.phase > Float32(2.0))
      _ctx.phase = (Float32(-2.0) + _ctx.phase)
   else
      _ctx.phase = _ctx.phase
   end
   breset = (reset > Float32(0.0))
   if Util_edge(_ctx.inst_204d6, breset)
      _ctx.phase = Float32(0.0)
   end
   tmp = (Float32(-1.0) + _ctx.phase)
   o = Float32(0.0)
   if (shape < Float32(1.0))
      o = tmp
   else
      if (shape < Float32(2.0))
         o = (Float32(-1.0) + (Float32(2.0) * abs(tmp)))
      else
         if (tmp > Float32(0.0))
            o = Float32(1.0)
         else
            o = Float32(0.0)
         end
      end
   end
   return Lfo_soft(_ctx.inst_337d6, o)
end

