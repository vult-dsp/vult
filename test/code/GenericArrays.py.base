import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

def GenericArrays_sum(data):
   total = 0.0
   i__1 = 0
   while (i__1 < size(data)):
      total = (total + data[i__1])
      i__1 = (1 + i__1)

   return total


def GenericArrays_test1():
   data1 = [1.0, 2.0, 3.0]
   data2 = [1.0, 2.0, 3.0, 4.0]
   result1 = GenericArrays_sum(data1)
   result2 = GenericArrays_sum(data2)


