Ladder_tune_c0 = nothing
Ladder_tune_c1 = nothing
Ladder_tune_c2 = nothing
function Ladder_tune_raw_c0(index)
   return @inbounds Ladder_tune_c0[index + 1]
end

function Ladder_tune_raw_c1(index)
   return @inbounds Ladder_tune_c1[index + 1]
end

function Ladder_tune_raw_c2(index)
   return @inbounds Ladder_tune_c2[index + 1]
end

function Ladder_tune(cut)
   index = clamp(trunc(Int32, (cut * Float32(128.0))), Int32(0), Int32(127))
   return (@inbounds Ladder_tune_c0[index + 1] + (cut * (@inbounds Ladder_tune_c1[index + 1] + (@inbounds Ladder_tune_c2[index + 1] * cut))))
end

function Ladder_heun(_ctx, input, fh, res)
   wt0 = Util_cubic_clipper((input + (Float32(-4.0) * (res * _ctx.p3))))
   wt1 = Util_cubic_clipper(_ctx.p0)
   dpt0 = (fh * (wt0 + (-wt1)))
   wt3 = Util_cubic_clipper(_ctx.p1)
   dpt1 = (fh * (wt1 + (-wt3)))
   wt5 = Util_cubic_clipper(_ctx.p2)
   dpt2 = (fh * (wt3 + (-wt5)))
   wt7 = Util_cubic_clipper(_ctx.p3)
   dpt3 = (fh * (wt5 + (-wt7)))
   pt0 = (dpt0 + _ctx.p0)
   pt1 = (dpt1 + _ctx.p1)
   pt2 = (dpt2 + _ctx.p2)
   pt3 = (dpt3 + _ctx.p3)
   w0 = Util_cubic_clipper((input + (Float32(-4.0) * (pt3 * res))))
   w1 = Util_cubic_clipper(pt0)
   dp0 = (fh * (w0 + (-w1)))
   w3 = Util_cubic_clipper(pt1)
   dp1 = (fh * (w1 + (-w3)))
   w5 = Util_cubic_clipper(pt2)
   dp2 = (fh * (w3 + (-w5)))
   w7 = Util_cubic_clipper(pt3)
   dp3 = (fh * (w5 + (-w7)))
   _ctx.p0 = ((Float32(0.5) * (dp0 + dpt0)) + _ctx.p0)
   _ctx.p1 = ((Float32(0.5) * (dp1 + dpt1)) + _ctx.p1)
   _ctx.p2 = ((Float32(0.5) * (dp2 + dpt2)) + _ctx.p2)
   _ctx.p3 = ((Float32(0.5) * (dp3 + dpt3)) + _ctx.p3)
   return _ctx.p3
end

function Ladder_euler(_ctx, input, fh, res)
   w0 = Util_cubic_clipper((input + (Float32(-4.0) * (res * _ctx.p3))))
   w1 = Util_cubic_clipper(_ctx.p0)
   dpt0 = (fh * (w0 + (-w1)))
   w3 = Util_cubic_clipper(_ctx.p1)
   dpt1 = (fh * (w1 + (-w3)))
   w5 = Util_cubic_clipper(_ctx.p2)
   dpt2 = (fh * (w3 + (-w5)))
   w7 = Util_cubic_clipper(_ctx.p3)
   dpt3 = (fh * (w5 + (-w7)))
   _ctx.p0 = (dpt0 + _ctx.p0)
   _ctx.p1 = (dpt1 + _ctx.p1)
   _ctx.p2 = (dpt2 + _ctx.p2)
   _ctx.p3 = (dpt3 + _ctx.p3)
   return _ctx.p3
end

function Ladder_process_euler(_ctx, input, cut, res)
   if Util_change(_ctx.inst_1b099, cut)
      _ctx.fh = Ladder_tune(cut)
   end
   Ladder_euler(_ctx.e, input, _ctx.fh, res)
   Ladder_euler(_ctx.e, input, _ctx.fh, res)
   Ladder_euler(_ctx.e, input, _ctx.fh, res)
   out = Ladder_euler(_ctx.e, input, _ctx.fh, res)
   return out
end

function Ladder_process_heun(_ctx, input, cut, res)
   if Util_change(_ctx.inst_1b0a0, cut)
      _ctx.fh = Ladder_tune(cut)
   end
   Ladder_heun(_ctx.h, input, _ctx.fh, res)
   Ladder_heun(_ctx.h, input, _ctx.fh, res)
   Ladder_heun(_ctx.h, input, _ctx.fh, res)
   out = Ladder_heun(_ctx.h, input, _ctx.fh, res)
   return out
end

function Ladder_process(_ctx, input, cut, res)
   return Ladder_process_heun(_ctx.inst_1a0c3, input, cut, res)
end

