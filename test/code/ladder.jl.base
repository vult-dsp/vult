end

function Util_pitchToRate(pitch)
   index = clamp(trunc(Int32, (pitch * Float32(0.251968))), Int32(0), Int32(31))
   return (@inbounds Util_pitchToRate_c0[index + 1] + (pitch * (@inbounds Util_pitchToRate_c1[index + 1] + (@inbounds Util_pitchToRate_c2[index + 1] * pitch))))
end

function Util_cvToPitch(cv)
   return (Float32(24.0) + (Float32(120.0) * cv))
end

