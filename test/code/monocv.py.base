def Monocv_mono_noteOn(_ctx, n):
   if (_ctx.count < 4):
      _ctx.notes[_ctx.count] = n
      _ctx.pre = n
      if (_ctx.count < 4):
         _ctx.count = (1 + _ctx.count)

   return _ctx.pre


def Monocv_mono_noteOff(_ctx, n):
   found = False
   i = 0
   pos = 0
   if (_ctx.count == 0):
      return _ctx.pre
   while ((i < 4) and (found == False)):
      if (_ctx.notes[i] == n):
         pos = i
         found = True

      i = (1 + i)

   if found:
      k = (1 + pos)
      while (k < 4):
         _ctx.notes[(-1 + k)] = _ctx.notes[k]
         k = (1 + k)

      if (found and (_ctx.count > 0)):
         _ctx.count = (-1 + _ctx.count)
         _ctx.pre = _ctx.notes[(-1 + _ctx.count)]


   return _ctx.pre


def Monocv_mono_isGateOn(_ctx):
   return (_ctx.count > 0)

def Monocv_process(_ctx, c):
   _ctx.channel_in = c
   if Monocv_mono_isGateOn(_ctx.notes):
      _ctx.gate = _ctx.vel
   else:
      _ctx.gate = 0.0
   note = float(_ctx.active_note)
   if Util_change(_ctx.inst_1b0d6, note):
      _ctx.cv = Util_pitchToCv(note)
   _ctx.Monocv_process_ret_0 = _ctx.cv
   _ctx.Monocv_process_ret_1 = _ctx.vel
   _ctx.Monocv_process_ret_2 = _ctx.gate
   return None


def Monocv_noteOn(_ctx, note, velocity, channel):
   if (_ctx.channel_in == channel):
      if (velocity > 0):
         _ctx.active_note = Monocv_mono_noteOn(_ctx.notes, note)
         _ctx.vel = (0.007874 * float(velocity))

      else:
         _ctx.active_note = Monocv_mono_noteOff(_ctx.notes, note)

def Monocv_noteOff(_ctx, note, channel):
   if (_ctx.channel_in == channel):
      _ctx.active_note = Monocv_mono_noteOff(_ctx.notes, note)

def Monocv_controlChange(_ctx, control, value, channel):
   pass

def Monocv_default(_ctx):
   pass

