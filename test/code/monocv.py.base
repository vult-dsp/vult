import math
import random as random_module

def eps():
    return 1e-18

def pi():
    return 3.1415926535897932384

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def clip(x, low, high):
    return low if x < low else (high if x > high else x)

def not_(x):
    return 0 if x != 0 else 1

def real(x):
    return float(x)

def int_(x):
    return int(x)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

def Util_edge_type_alloc():
   _ctx = {}
   _ctx["pre"] = False
   return _ctx


def Util_change_type_alloc():
   _ctx = {}
   _ctx["pre_x"] = 0.0
   return _ctx


def Util_dcblock_type_alloc():
   _ctx = {}
   _ctx["x1"] = 0.0
   _ctx["y1"] = 0.0
   return _ctx


def Util_smooth_type_alloc():
   _ctx = {}
   _ctx["x"] = 0.0
   return _ctx


def Util_average2_type_alloc():
   _ctx = {}
   _ctx["x0"] = 0.0
   return _ctx


def Monocv_mono_noteOn_type_alloc():
   _ctx = {}
   _ctx["count"] = 0
   i_0 = 0
   temp = initializeArray(0, 4)
   while (i_0 < 4):
      temp[i_0] = 0
      i_0 = (1 + i_0)

   _ctx["notes"] = temp
   _ctx["pre"] = 0
   return _ctx


def Monocv_mono_noteOff_type_alloc(_ctx):
   return Monocv_mono_noteOn_type_alloc()

def Monocv_mono_isGateOn_type_alloc(_ctx):
   return Monocv_mono_noteOn_type_alloc()

def Monocv_process_type_alloc():
   _ctx = {}
   _ctx["Monocv_process_ret_0"] = 0.0
   _ctx["Monocv_process_ret_1"] = 0.0
   _ctx["Monocv_process_ret_2"] = 0.0
   _ctx["active_note"] = 0
   _ctx["channel_in"] = 0
   _ctx["cv"] = 0.0
   _ctx["gate"] = 0.0
   _ctx["inst_1b0d6"] = Util_change_type_alloc()
   _ctx["notes"] = Monocv_mono_noteOn_type_alloc()
   _ctx["vel"] = 0.0
   return _ctx


def Monocv_noteOn_type_alloc(_ctx):
   return Monocv_process_type_alloc()

def Monocv_noteOff_type_alloc(_ctx):
   return Monocv_process_type_alloc()

def Monocv_controlChange_type_alloc(_ctx):
   return Monocv_process_type_alloc()

def Monocv_default_type_alloc(_ctx):
   return Monocv_process_type_alloc()

def Util_edge(_ctx, x):
   ret = (x and (_ctx["pre"] == False))
   _ctx["pre"] = x
   return ret


def Util_change(_ctx, x):
   v = (_ctx["pre_x"] != x)
   _ctx["pre_x"] = x
   return v


def Util_map(x, x0, x1, y0, y1):
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))

def Util_dcblock(_ctx, x0):
   y0 = (x0 + ((-_ctx["x1"]) + (0.995 * _ctx["y1"])))
   _ctx["x1"] = x0
   _ctx["y1"] = y0
   return y0


def Util_smooth(_ctx, input):
   _ctx["x"] = ((0.005 * (input + (-_ctx["x"]))) + _ctx["x"])
   return _ctx["x"]


def Util_average2(_ctx, x1):
   result = (0.5 * (x1 + _ctx["x0"]))
   _ctx["x0"] = x1
   return result


def Util_cubic_clipper(x):
   if (x <= -0.666667):
      return -0.666667
   else:
      if (x >= 0.666666):
         return 0.666666
      else:
         return (x + (-0.333334 * (x * (x * x))))

Util_pitchToRate_1024_c0 = {}
Util_pitchToRate_1024_c1 = {}
Util_pitchToRate_1024_c2 = {}
def Util_pitchToRate_1024_raw_c0(index):
   return Util_pitchToRate_1024_c0[index]

def Util_pitchToRate_1024_raw_c1(index):
   return Util_pitchToRate_1024_c1[index]

def Util_pitchToRate_1024_raw_c2(index):
   return Util_pitchToRate_1024_c2[index]

def Util_pitchToRate_1024(pitch):
   index = clip(float_to_int((pitch * 0.244094)), 0, 31)
   return (Util_pitchToRate_1024_c0[index] + (pitch * (Util_pitchToRate_1024_c1[index] + (Util_pitchToRate_1024_c2[index] * pitch))))


Util_pitchToRate_c0 = {}
Util_pitchToRate_c1 = {}
Util_pitchToRate_c2 = {}
def Util_pitchToRate_raw_c0(index):
   return Util_pitchToRate_c0[index]

def Util_pitchToRate_raw_c1(index):
   return Util_pitchToRate_c1[index]

def Util_pitchToRate_raw_c2(index):
   return Util_pitchToRate_c2[index]

def Util_pitchToRate(pitch):
   index = clip(float_to_int((pitch * 0.244094)), 0, 31)
   return (Util_pitchToRate_c0[index] + (pitch * (Util_pitchToRate_c1[index] + (Util_pitchToRate_c2[index] * pitch))))


def Util_cvToPitch(cv):
   return (24.0 + (120.0 * cv))

