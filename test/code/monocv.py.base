import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

class Util_edge_type:
    __slots__ = ['pre']
    def __init__(self, pre=False):
        self.pre = pre

class Util_change_type:
    __slots__ = ['pre_x']
    def __init__(self, pre_x=0.0):
        self.pre_x = pre_x

class Util_dcblock_type:
    __slots__ = ['x1', 'y1']
    def __init__(self, x1=0.0, y1=0.0):
        self.x1 = x1
        self.y1 = y1

class Util_smooth_type:
    __slots__ = ['x']
    def __init__(self, x=0.0):
        self.x = x

class Util_average2_type:
    __slots__ = ['x0']
    def __init__(self, x0=0.0):
        self.x0 = x0

class Monocv_mono_noteOn_type:
    __slots__ = ['count', 'notes', 'pre']
    def __init__(self, count=0, notes=[0.0] * 4, pre=0):
        self.count = count
        self.notes = notes
        self.pre = pre

class Monocv_process_type:
    __slots__ = ['Monocv_process_ret_0', 'Monocv_process_ret_1', 'Monocv_process_ret_2', 'active_note', 'channel_in', 'cv', 'gate', 'inst_1b0d6', 'notes', 'vel']
    def __init__(self, Monocv_process_ret_0=0.0, Monocv_process_ret_1=0.0, Monocv_process_ret_2=0.0, active_note=0, channel_in=0, cv=0.0, gate=0.0, inst_1b0d6=Util_change_type(), notes=Monocv_mono_noteOn_type(), vel=0.0):
        self.Monocv_process_ret_0 = Monocv_process_ret_0
        self.Monocv_process_ret_1 = Monocv_process_ret_1
        self.Monocv_process_ret_2 = Monocv_process_ret_2
        self.active_note = active_note
        self.channel_in = channel_in
        self.cv = cv
        self.gate = gate
        self.inst_1b0d6 = inst_1b0d6
        self.notes = notes
        self.vel = vel

