def Util_cvToRate_1024(cv):
   index = ((0) if (float_to_int((cv * 34.444444))) < (0) else ((31) if (float_to_int((cv * 34.444444))) > (31) else (float_to_int((cv * 34.444444)))))
   return (Util_cvToRate_1024_c0[index] + (cv * (Util_cvToRate_1024_c1[index] + (Util_cvToRate_1024_c2[index] * cv))))


