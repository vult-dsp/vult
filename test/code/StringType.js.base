this.StringType_test1 = function () {
   var str1 = "first";
   var str2 = "second";
   var str3 = ((str1 + ", ") + str2);
   return str3;
};

this.StringType_test2 = function () {
   var str1 = this.string((1|0));
   var str2 = this.string(1.0);
   var str3 = this.string(1.0);
   var str4 = this.string(true);
   return (((str1 + str2) + str3) + str4);
};

this.StringType_test3 = function (a, b) {
   return (a + b);
};

