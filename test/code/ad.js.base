this.Ad_do = function (_ctx, gate, a, d) {
   var a_rate = (1.0 / (0.01 + (100.0 * a)));
   var d_rate = (1.0 / (0.01 + (100.0 * d)));
   var bgate = (gate > 0.0);
   _ctx.out = ((0.004 * (((-_ctx.out) + _ctx.target) * _ctx.rate)) + _ctx.out);
   if ((_ctx.state == (0|0))) {
      {
         if (this.Util_edge(_ctx.inst_10452, bgate)) {
            {
               _ctx.state = (1|0);
               _ctx.scale = (0.2 * gate);
            }
         }
         _ctx.rate = d_rate;
         _ctx.target = 0.0;
      }
   }
   if ((_ctx.state == (1|0))) {
      {
         if (((bgate == false) || (_ctx.out > 1024.0))) {
            _ctx.state = (0|0);
         }
         _ctx.rate = a_rate;
         _ctx.target = 1228.8;
      }
   }
   return (this.clip((0.000976 * _ctx.out), 0.0, 1.0) * _ctx.scale);
};

this.Ad_process = function (_ctx, gate) {
   return this.Ad_do(_ctx.inst_15232, gate, _ctx.knob1, _ctx.knob2);
};

this.Ad_noteOn = function (_ctx, note, velocity, channel) {
};

this.Ad_noteOff = function (_ctx, note, channel) {
};

this.Ad_controlChange = function (_ctx, control, value, channel) {
   if ((control == (1|0))) {
      _ctx.knob1 = (0.007874 * this.real(value));
   }
   if ((control == (2|0))) {
      _ctx.knob2 = (0.007874 * this.real(value));
   }
};

this.Ad_default = function (_ctx) {
   _ctx.knob1 = 0.0;
   _ctx.knob2 = 0.5;
};

