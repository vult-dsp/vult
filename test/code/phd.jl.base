function Util_cvToperiod(cv)
   value = (clamp(cv, Float32(0.0), Float32(1.0)) * Float32(32.0))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_cvToperiod_c[index + 1] + (u * (@inbounds Util_cvToperiod_c[(index + Int32(1)) + 1] + (@inbounds Util_cvToperiod_c[(index + Int32(2)) + 1] * u))))
