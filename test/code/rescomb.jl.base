
# High-performance Vult Runtime for Julia with typed arrays

mutable struct Util_edge_type
       pre::Bool
end

# Default constructor for Util_edge_type
function Util_edge_type()
    return Util_edge_type(false)
end

mutable struct Util_change_type
       pre_x::Float32
end

# Default constructor for Util_change_type
function Util_change_type()
    return Util_change_type(Float32(0.0))
end

mutable struct Util_dcblock_type
       x1::Float32
       y1::Float32
end

# Default constructor for Util_dcblock_type
function Util_dcblock_type()
    return Util_dcblock_type(Float32(0.0), Float32(0.0))
end

mutable struct Util_smooth_type
       x::Float32
end

# Default constructor for Util_smooth_type
function Util_smooth_type()
    return Util_smooth_type(Float32(0.0))
end

mutable struct Util_average2_type
       x0::Float32
end

# Default constructor for Util_average2_type
function Util_average2_type()
    return Util_average2_type(Float32(0.0))
end

mutable struct Rescomb_delay_type
       buffer::Vector{Float32}
       write_pos::Int32
end

# Default constructor for Rescomb_delay_type
function Rescomb_delay_type()
    return Rescomb_delay_type(fill(Float32(0.0), 675), Int32(0))
end

mutable struct Rescomb_do_type
       inst_1b000::Util_change_type
       inst_26400::Util_dcblock_type
       inst_3a900::Rescomb_delay_type
       output::Float32
       stone::Float32
end

# Default constructor for Rescomb_do_type
function Rescomb_do_type()
    return Rescomb_do_type(Util_change_type(), Util_dcblock_type(), Rescomb_delay_type(), Float32(0.0), Float32(0.0))
end

mutable struct Rescomb_process_type
       inst_100b6::Rescomb_do_type
end

# Default constructor for Rescomb_process_type
function Rescomb_process_type()
    return Rescomb_process_type(Rescomb_do_type())
end

function Util_edge_type_alloc()
   _ctx = Util_edge_type()
   _ctx.pre = false
   return _ctx
end

function Util_change_type_alloc()
   _ctx = Util_change_type()
   _ctx.pre_x = Float32(0.0)
   return _ctx
end

function Util_dcblock_type_alloc()
   _ctx = Util_dcblock_type()
   _ctx.x1 = Float32(0.0)
   _ctx.y1 = Float32(0.0)
   return _ctx
end

function Util_smooth_type_alloc()
   _ctx = Util_smooth_type()
   _ctx.x = Float32(0.0)
   return _ctx
end

function Util_average2_type_alloc()
   _ctx = Util_average2_type()
   _ctx.x0 = Float32(0.0)
   return _ctx
end

function Rescomb_delay_type_alloc()
   i_0 = Int32(0)
   temp = fill(Float32(0.0), Int32(675))
   _ctx = Rescomb_delay_type()
   while (i_0 < Int32(675))
      begin
         @inbounds temp[i_0 + 1] = Float32(0.0)
         i_0 = (Int32(1) + i_0)
      end
   end
   _ctx.buffer = temp
   _ctx.write_pos = Int32(0)
   return _ctx
end

function Rescomb_do_type_alloc()
   _ctx = Rescomb_do_type()
   _ctx.inst_1b000 = Util_change_type_alloc()
   _ctx.inst_26400 = Util_dcblock_type_alloc()
   _ctx.inst_3a900 = Rescomb_delay_type_alloc()
   _ctx.output = Float32(0.0)
   _ctx.stone = Float32(0.0)
   return _ctx
end

function Rescomb_process_type_alloc()
   _ctx = Rescomb_process_type()
   _ctx.inst_100b6 = Rescomb_do_type_alloc()
   return _ctx
end

function Rescomb_noteOn_type_alloc(_ctx)
   return Rescomb_process_type_alloc()
end

function Rescomb_noteOff_type_alloc(_ctx)
   return Rescomb_process_type_alloc()
end

function Rescomb_controlChange_type_alloc(_ctx)
   return Rescomb_process_type_alloc()
end

function Rescomb_default_type_alloc(_ctx)
   return Rescomb_process_type_alloc()
end

Saturate_soft_tanh_table_c0 = nothing
Saturate_soft_tanh_table_c1 = nothing
Saturate_soft_tanh_table_c2 = nothing
function Saturate_soft_tanh_table_raw_c0(index)
   return @inbounds Saturate_soft_tanh_table_c0[index + 1]
end

function Saturate_soft_tanh_table_raw_c1(index)
   return @inbounds Saturate_soft_tanh_table_c1[index + 1]
end

function Saturate_soft_tanh_table_raw_c2(index)
   return @inbounds Saturate_soft_tanh_table_c2[index + 1]
end

function Saturate_soft_tanh_table(x)
   index = clamp(trunc(Int32, ((x + Float32(24.0)) * Float32(5.0))), Int32(0), Int32(240))
   return (@inbounds Saturate_soft_tanh_table_c0[index + 1] + (x * (@inbounds Saturate_soft_tanh_table_c1[index + 1] + (@inbounds Saturate_soft_tanh_table_c2[index + 1] * x))))
end

function Saturate_soft_process(x)
   return Saturate_soft_tanh_table(x)
end

function Saturate_soft_noteOn(note, velocity, channel)
end

function Saturate_soft_noteOff(note, channel)
end

function Saturate_soft_controlChange(control, value, channel)
end

function Saturate_soft_default()
end

function Util_edge(_ctx, x)
   ret = (x && (_ctx.pre == false))
   _ctx.pre = x
   return ret
end

function Util_change(_ctx, x)
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v
end

function Util_map(x, x0, x1, y0, y1)
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))
end

function Util_dcblock(_ctx, x0)
   y0 = (x0 + ((-_ctx.x1) + (Float32(0.995) * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0
end

function Util_smooth(_ctx, input)
   _ctx.x = ((Float32(0.005) * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Util_average2(_ctx, x1)
   result = (Float32(0.5) * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result
end

function Util_cubic_clipper(x)
   if (x <= Float32(-0.666667))
      return Float32(-0.666667)
   else
      if (x >= Float32(0.666666))
         return Float32(0.666666)
      else
         return (x + (Float32(-0.333334) * (x * (x * x))))
      end
   end
end

