end

function Util_cvToperiod_raw_c2(index)
   return @inbounds Util_cvToperiod_c2[index + 1]
end

function Util_cvToperiod(cv)
   index = clamp(trunc(Int32, (cv * Float32(31.0))), Int32(0), Int32(31))
   return (@inbounds Util_cvToperiod_c0[index + 1] + (cv * (@inbounds Util_cvToperiod_c1[index + 1] + (@inbounds Util_cvToperiod_c2[index + 1] * cv))))
end

Util_cvTokHz_c0 = nothing
Util_cvTokHz_c1 = nothing
Util_cvTokHz_c2 = nothing
function Util_cvTokHz_raw_c0(index)
   return @inbounds Util_cvTokHz_c0[index + 1]
