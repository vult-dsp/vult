function Util_cvTokHz(cv)
   index = clamp(trunc(Int32, (cv * Float32(31.0))), Int32(0), Int32(31))
   return (@inbounds Util_cvTokHz_c0[index + 1] + (cv * (@inbounds Util_cvTokHz_c1[index + 1] + (@inbounds Util_cvTokHz_c2[index + 1] * cv))))
end

function Rescomb_delay(_ctx, x, cv)
   _ctx.write_pos = ((Int32(1) + _ctx.write_pos) % Int32(675))
   @inbounds _ctx.buffer[_ctx.write_pos + 1] = x
   r_size = Float32(675.0)
   r_index = mod(((-Util_cvToperiod(cv)) + Float32(_ctx.write_pos)), r_size)
   if (r_index < Float32(0.0))
      r_index = (r_index + r_size)
   end
   t1 = (trunc(Int32, floor(r_index)) % Int32(675))
   t2 = ((Int32(1) + t1) % Int32(675))
   decimal = (r_index + (-Float32(t1)))
   x1 = @inbounds _ctx.buffer[t1 + 1]
   x2 = @inbounds _ctx.buffer[t2 + 1]
   ret = (x1 + (decimal * (x2 + (-x1))))
   return ret
end

Rescomb_toneCurve_c0 = nothing
Rescomb_toneCurve_c1 = nothing
Rescomb_toneCurve_c2 = nothing
function Rescomb_toneCurve_raw_c0(index)
   return @inbounds Rescomb_toneCurve_c0[index + 1]
end

function Rescomb_toneCurve_raw_c1(index)
   return @inbounds Rescomb_toneCurve_c1[index + 1]
end

function Rescomb_toneCurve_raw_c2(index)
   return @inbounds Rescomb_toneCurve_c2[index + 1]
end

function Rescomb_toneCurve(tone)
   index = clamp(trunc(Int32, ((tone + Float32(1.2)) * Float32(26.25))), Int32(0), Int32(63))
   return (@inbounds Rescomb_toneCurve_c0[index + 1] + (tone * (@inbounds Rescomb_toneCurve_c1[index + 1] + (@inbounds Rescomb_toneCurve_c2[index + 1] * tone))))
end

function Rescomb_do(_ctx, in, cv, tone, res)
   if Util_change(_ctx.inst_1b000, tone)
      _ctx.stone = Rescomb_toneCurve(tone)
   end
   feedback = Util_dcblock(_ctx.inst_26400, (res * _ctx.output))
   saturated_input = Saturate_soft_process((feedback + in))
   _ctx.output = (in + (Rescomb_delay(_ctx.inst_3a900, saturated_input, cv) * _ctx.stone))
   return Saturate_soft_process(_ctx.output)
end

function Rescomb_process(_ctx, in, cv, tone, res)
   return Rescomb_do(_ctx.inst_100b6, in, cv, tone, res)
end

