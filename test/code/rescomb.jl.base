Util_cvToperiod_c0 = nothing
Util_cvToperiod_c1 = nothing
Util_cvToperiod_c2 = nothing
function Util_cvToperiod_raw_c0(index)
   return @inbounds Util_cvToperiod_c0[index + 1]
end

function Util_cvToperiod_raw_c1(index)
