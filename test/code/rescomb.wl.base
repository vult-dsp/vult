   Return[(Util`cvTokHz`c0[[index + 1]] + (cv * (Util`cvTokHz`c1[[index + 1]] + (Util`cvTokHz`c2[[index + 1]] * cv))))];
]

Rescomb`delay[`ctx_, x_, cv_] := Module[{ ret, x2, x1, decimal, t2, t1, r`index, r`size }, 
   setValue[`ctx,"write_pos",Mod[(1 + getValue[`ctx, "write_pos"]), 675]];
   getValue[`ctx, "buffer"][[getValue[`ctx, "write_pos"] + 1]] = x;
   r`size = 675.;
   r`index = (((-Util`cvToperiod[cv]) + N[getValue[`ctx, "write_pos"]]) % r`size);
   If[(r`index < 0.), 
      r`index = (r`index + r`size);];
   t1 = Mod[Floor[Floor[r`index]], 675];
   t2 = Mod[(1 + t1), 675];
   decimal = (r`index + (-N[t1]));
   x1 = getValue[`ctx, "buffer"][[t1 + 1]];
   x2 = getValue[`ctx, "buffer"][[t2 + 1]];
   ret = (x1 + (decimal * (x2 + (-x1))));
   Return[ret];
]

Rescomb`toneCurve`c0 = {};
Rescomb`toneCurve`c1 = {};
Rescomb`toneCurve`c2 = {};
Rescomb`toneCurve`raw`c0[index_] := 
   Return[Rescomb`toneCurve`c0[[index + 1]]];


Rescomb`toneCurve`raw`c1[index_] := 
   Return[Rescomb`toneCurve`c1[[index + 1]]];


Rescomb`toneCurve`raw`c2[index_] := 
   Return[Rescomb`toneCurve`c2[[index + 1]]];


Rescomb`toneCurve[tone_] := Module[{ index }, 
   index = Clip[Floor[((tone - -1.2) * 26.25)], {0, 63}];
   Return[(Rescomb`toneCurve`c0[[index + 1]] + (tone * (Rescomb`toneCurve`c1[[index + 1]] + (Rescomb`toneCurve`c2[[index + 1]] * tone))))];
]

Rescomb`do[`ctx_, in_, cv_, tone_, res_] := Module[{ saturated`input, feedback }, 
   If[Util`change[getValue[`ctx, "inst_1b000"], tone], 
      setValue[`ctx,"stone",Rescomb`toneCurve[tone]];];
   feedback = Util`dcblock[getValue[`ctx, "inst_26400"], (res * getValue[`ctx, "output"])];
   saturated`input = Saturate`soft`process[(feedback + in)];
   setValue[`ctx,"output",(in + (Rescomb`delay[getValue[`ctx, "inst_3a900"], saturated`input, cv] * getValue[`ctx, "stone"]))];
   Return[Saturate`soft`process[getValue[`ctx, "output"]]];
]

Rescomb`process[`ctx_, in_, cv_, tone_, res_] := 
   Return[Rescomb`do[getValue[`ctx, "inst_100b6"], in, cv, tone, res]];


