
IntegerDivision[a_, b_] := Floor[a / b];
newEmptyObject[] := CreateDataStructure["HashTable"];
setValue[var_, key_, value_] := var["Insert", key -> value];
getValue[var_, key_] := var["Lookup", key];
newObject[elems_] := Module[{t = newEmptyObject[]}, Map[t["Insert", #] &, elems]; t];
initializeArray[v_, n_] := Table[v, n];
eps[] := $MinMachineNumber
Util`edge`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"pre",False];
   Return[`ctx];
]

Util`change`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"pre_x",0.];
   Return[`ctx];
]

Util`dcblock`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x1",0.];
   setValue[`ctx,"y1",0.];
   Return[`ctx];
]

Util`smooth`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x",0.];
   Return[`ctx];
]

Util`average2`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x0",0.];
   Return[`ctx];
]

Rescomb`delay`type`alloc[] := Module[{ `ctx, temp, in`n0 }, 
   in`n0 = 0;
   temp = initializeArray[0., 675];
   `ctx = newEmptyObject[];
   While[(in`n0 < 675), 
      Module[{  }, 
         temp[[in`n0 + 1]] = 0.;
         in`n0 = (1 + in`n0);
      ];];
   setValue[`ctx,"buffer",temp];
   setValue[`ctx,"write_pos",0];
   Return[`ctx];
]

Rescomb`do`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"inst_1b000",Util`change`type`alloc[]];
   setValue[`ctx,"inst_26400",Util`dcblock`type`alloc[]];
   setValue[`ctx,"inst_3a900",Rescomb`delay`type`alloc[]];
   setValue[`ctx,"output",0.];
   setValue[`ctx,"stone",0.];
   Return[`ctx];
]

Rescomb`process`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"inst_100b6",Rescomb`do`type`alloc[]];
   Return[`ctx];
]

Rescomb`noteOn`type`alloc[`ctx_] := 
   Return[Rescomb`process`type`alloc[]];


Rescomb`noteOff`type`alloc[`ctx_] := 
   Return[Rescomb`process`type`alloc[]];


Rescomb`controlChange`type`alloc[`ctx_] := 
   Return[Rescomb`process`type`alloc[]];


Rescomb`default`type`alloc[`ctx_] := 
   Return[Rescomb`process`type`alloc[]];


Saturate`soft`tanh`table`c0 = {};
Saturate`soft`tanh`table`c1 = {};
Saturate`soft`tanh`table`c2 = {};
Saturate`soft`tanh`table`raw`c0[index_] := 
   Return[Saturate`soft`tanh`table`c0[[index + 1]]];


Saturate`soft`tanh`table`raw`c1[index_] := 
   Return[Saturate`soft`tanh`table`c1[[index + 1]]];


Saturate`soft`tanh`table`raw`c2[index_] := 
   Return[Saturate`soft`tanh`table`c2[[index + 1]]];


Saturate`soft`tanh`table[x_] := Module[{ index }, 
   index = Clip[Floor[((x - -24.) * 5.)], {0, 240}];
   Return[(Saturate`soft`tanh`table`c0[[index + 1]] + (x * (Saturate`soft`tanh`table`c1[[index + 1]] + (Saturate`soft`tanh`table`c2[[index + 1]] * x))))];
]

Saturate`soft`process[x_] := 
   Return[Saturate`soft`tanh`table[x]];


Saturate`soft`noteOn[note_, velocity_, channel_] := Null

Saturate`soft`noteOff[note_, channel_] := Null

Saturate`soft`controlChange[control_, value_, channel_] := Null

Saturate`soft`default[] := Null

Util`edge[`ctx_, x_] := Module[{ ret }, 
   ret = (x && (getValue[`ctx, "pre"] == False));
   setValue[`ctx,"pre",x];
   Return[ret];
]

Util`change[`ctx_, x_] := Module[{ v }, 
   v = (getValue[`ctx, "pre_x"] != x);
   setValue[`ctx,"pre_x",x];
   Return[v];
]

Util`map[x_, x0_, x1_, y0_, y1_] := 
   Return[(y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))];


Util`dcblock[`ctx_, x0_] := Module[{ y0 }, 
   y0 = (x0 + ((-getValue[`ctx, "x1"]) + (0.995 * getValue[`ctx, "y1"])));
   setValue[`ctx,"x1",x0];
   setValue[`ctx,"y1",y0];
   Return[y0];
]

Util`smooth[`ctx_, input_] := Module[{  }, 
   setValue[`ctx,"x",((0.005 * (input + (-getValue[`ctx, "x"]))) + getValue[`ctx, "x"])];
   Return[getValue[`ctx, "x"]];
]

Util`average2[`ctx_, x1_] := Module[{ result }, 
   result = (0.5 * (x1 + getValue[`ctx, "x0"]));
   setValue[`ctx,"x0",x1];
   Return[result];
]

Util`cubic`clipper[x_] := 
   If[(x <= -0.666667), 
      Return[-0.666667];, 
      If[(x >= 0.666666), 
         Return[0.666666];, 
         Return[(x + (-0.333334 * (x * (x * x))))];];];


