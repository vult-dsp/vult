function Swept_process(_ctx, gate, start, end_, rate)
   a_rate = (Float32(1.0) / (Float32(0.01) + (Float32(100.0) * rate)))
   bgate = (gate > Float32(0.5))
   _ctx.out = ((Float32(0.004) * (rate * ((-_ctx.out) + (Float32(1024.0) * end_)))) + _ctx.out)
   if Util_edge(_ctx.inst_10402, bgate)
      _ctx.out = (Float32(1024.0) * start)
   end
   return (Float32(0.000976) * _ctx.out)
end

