function Ahr_controlChange(_ctx, control, value, channel)
   if (control == Int32(1))
      _ctx.knob1 = (Float32(0.007874) * Float32(value))
   end
   if (control == Int32(2))
      _ctx.knob2 = (Float32(0.007874) * Float32(value))
   end
   if (control == Int32(3))
      _ctx.knob3 = (Float32(0.007874) * Float32(value))
   end
end

function Ahr_default(_ctx)
   _ctx.knob1 = Float32(0.0)
   _ctx.knob2 = Float32(0.5)
   _ctx.knob3 = Float32(0.5)
end

function Kick_do(_ctx, gate, odecay, pitch, swept, noise)
   Ahr_do(_ctx.inst_1d863, gate, Float32(0.005), (Float32(0.1) + odecay), (Float32(0.01) + odecay))
   osc_env = _ctx.inst_1d863.Ahr_do_ret_0
   env_reset = _ctx.inst_1d863.Ahr_do_ret_1
   cv = Swept_process(_ctx.inst_20263, (Float32(1.0) + (-env_reset)), (pitch + (Float32(0.4) * swept)), pitch, Float32(0.1))
   osc = Tricore_process(_ctx.inst_33c63, cv, Float32(0.0), env_reset)
   osc_sat = Saturate_process((Float32(1.5) * osc))
   Ahr_do(_ctx.inst_4d863, gate, Float32(0.001), Float32(0.01), (Float32(0.001) + (Float32(0.01) * noise)))
   noise_env = _ctx.inst_4d863.Ahr_do_ret_0
   noise_osc = (Float32(0.333333) * (noise * Noise_process(_ctx.inst_53d63, Float32(1.0))))
   return ((noise_env * noise_osc) + (osc_env * osc_sat))
end

function Kick_process(_ctx, gate)
   return Kick_do(_ctx.inst_16352, gate, _ctx.odecay, _ctx.pitch, _ctx.swept, _ctx.noise)
end

function Kick_noteOn(_ctx, note, velocity, channel)
end

function Kick_noteOff(_ctx, note, channel)
end

function Kick_controlChange(_ctx, control, value, channel)
   if (control == Int32(30))
      _ctx.odecay = (Float32(0.007874) * Float32(value))
   end
   if (control == Int32(31))
      _ctx.pitch = Util_map(Float32(value), Float32(0.0), Float32(127.0), Float32(0.0), Float32(0.1))
   end
   if (control == Int32(32))
      _ctx.swept = (Float32(0.007874) * Float32(value))
   end
   if (control == Int32(33))
      _ctx.noise = (Float32(0.007874) * Float32(value))
   end
end

function Kick_default(_ctx)
end

