function Ahr_do(_ctx, gate, a, h, r)
   release = Int32(0)
   attack = Int32(1)
   hold = Int32(2)
   reset = Int32(3)
   bgate = (gate > Float32(0.0))
   if Util_edge(_ctx.inst_104d8, bgate)
      _ctx.state = reset
   end
   resetting = Float32(0.0)
   if (_ctx.state == reset)
      resetting = Float32(1.0)
   else
      resetting = Float32(0.0)
   end
   if Util_edge(_ctx.inst_204d8, (_ctx.out > Float32(1024.0)))
      begin
         _ctx.hold_phase = Float32(0.0)
         _ctx.state = hold
      end
   end
   if ((_ctx.out < Float32(10.0)) && (_ctx.state == reset))
      _ctx.state = attack
   end
   if ((_ctx.hold_phase > Float32(100.0)) && (_ctx.state == hold))
      _ctx.state = release
   end
   if (_ctx.state == reset)
      begin
         _ctx.rate = Float32(0.990099)
         _ctx.target = Float32(0.0)
      end
   end
   if (_ctx.state == attack)
      begin
         _ctx.rate = (Float32(1.0) / (Float32(0.01) + (Float32(100.0) * a)))
         _ctx.target = Float32(1228.8)
      end
   end
   if (_ctx.state == hold)
      begin
         hrate = (Float32(1.0) / (Float32(0.01) + (Float32(100.0) * h)))
         _ctx.hold_phase = (hrate + _ctx.hold_phase)
      end
   end
   if (_ctx.state == release)
      begin
         _ctx.rate = (Float32(1.0) / (Float32(0.01) + (Float32(100.0) * r)))
         _ctx.target = Float32(0.0)
      end
   end
   _ctx.out = ((Float32(0.005) * (((-_ctx.out) + _ctx.target) * _ctx.rate)) + _ctx.out)
   _ctx.Ahr_do_ret_0 = clamp((Float32(0.000976) * _ctx.out), Float32(0.0), Float32(1.0))
   _ctx.Ahr_do_ret_1 = resetting
   return 
end

function Ahr_process(_ctx, gate)
   Ahr_do(_ctx.inst_1d84b, gate, _ctx.knob1, _ctx.knob2, _ctx.knob3)
   _call_temp_0 = _ctx.inst_1d84b.Ahr_do_ret_0
   _call_temp_1 = _ctx.inst_1d84b.Ahr_do_ret_1
   _ctx.Ahr_process_ret_0 = _call_temp_0
   _ctx.Ahr_process_ret_1 = _call_temp_1
   return 
end

