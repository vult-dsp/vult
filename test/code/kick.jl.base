function Noise_pinker(_ctx, x)
   b0 = Float32(0.027712)
   b1 = Float32(0.027712)
   a1 = Float32(-0.944575)
   w0 = (x + (-(a1 * _ctx.w1)))
   y0 = ((b0 * w0) + (b1 * _ctx.w1))
   _ctx.w1 = w0
   return y0
end

function Noise_process(_ctx, color)
   _ctx.x1 = ((Int32(7919) + (Int32(17389) * _ctx.x1)) % Int32(32768))
   y1 = (Float32(3e-05) * Float32(_ctx.x1))
   _ctx.x2 = ((Int32(12553) + (Int32(27449) * _ctx.x2)) % Int32(32768))
   y2 = (Float32(3e-05) * Float32(_ctx.x2))
   out = Float32(0.0)
   if (color > Float32(0.5))
      out = Noise_pinker(_ctx.inst_16d3d, (y1 + (-y2)))
   else
      out = (y1 + (-y2))
   end
   return (Float32(2.0) * out)
end

