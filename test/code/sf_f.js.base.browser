function vultProcess() {
this.Sf_f_process = function (input) {
   return (input * input);
};

this.Sf_f_noteOn = function (note, velocity, channel) {
};

this.Sf_f_noteOff = function (note, channel) {
};

this.Sf_f_controlChange = function (control, value, channel) {
};

this.Sf_f_default = function () {
};


   this.context = {};
   if(this.Sf_f_default)      this.Sf_f_default();
   this.liveNoteOn        = function(note,velocity,channel) { if(this.Sf_f_noteOn)        this.Sf_f_noteOn(this.context,note,velocity,channel); };
   this.liveNoteOff       = function(note,velocity,channel) { if(this.Sf_f_noteOff)       this.Sf_f_noteOff(this.context,note,velocity,channel); };
   this.liveControlChange = function(note,velocity,channel) { if(this.Sf_f_controlChange) this.Sf_f_controlChange(this.context,note,velocity,channel); };
   this.liveProcess       = function(input)         { if(this.Sf_f_process)       return this.Sf_f_process(this.context,input); else return 0; };
   this.liveDefault       = function() { if(this.Sf_f_default)      return this.Sf_f_default(this.context); };
   }