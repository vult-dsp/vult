

-- Math functions
local floor = math.floor

-- Core runtime functions
local function clipValue(x, low, high) if x > high then return high elseif x < low then return low else return x end end

function Util_edge_type_alloc()
   local _ctx = {};
   _ctx.pre = false
   return _ctx
end

function Util_change_type_alloc()
   local _ctx = {};
   _ctx.pre_x = 0.0
   return _ctx
end

function Util_dcblock_type_alloc()
   local _ctx = {};
   _ctx.x1 = 0.0
   _ctx.y1 = 0.0
   return _ctx
end

function Util_smooth_type_alloc()
   local _ctx = {};
   _ctx.x = 0.0
   return _ctx
end

function Util_average2_type_alloc()
   local _ctx = {};
   _ctx.x0 = 0.0
   return _ctx
end

function Util_cvToPitch(cv)
   return (24.0 + (120.0 * cv))
end

Util_pitchToRate_1024_c = {};
function Util_pitchToRate_1024_raw_c0(index)
   return Util_pitchToRate_1024_c[((index * 3)) + 1]
end

function Util_pitchToRate_1024_raw_c1(index)
   return Util_pitchToRate_1024_c[(((index * 3) + 1)) + 1]
end

function Util_pitchToRate_1024_raw_c2(index)
   return Util_pitchToRate_1024_c[(((index * 3) + 2)) + 1]
end

function Util_pitchToRate_1024(pitch)
   local value = (((pitch) > (127.0) and (127.0) or ((pitch) < (0.0) and (0.0) or (pitch))) * 0.251968)
   local cell = clipValue(floor(value), 0, 31)
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_pitchToRate_1024_c[(index) + 1] + (u * (Util_pitchToRate_1024_c[((index + 1)) + 1] + (Util_pitchToRate_1024_c[((index + 2)) + 1] * u))))
end

Util_cvToRate_1024_c = {};
function Util_cvToRate_1024_raw_c0(index)
   return Util_cvToRate_1024_c[((index * 3)) + 1]
end

function Util_cvToRate_1024_raw_c1(index)
   return Util_cvToRate_1024_c[(((index * 3) + 1)) + 1]
end

function Util_cvToRate_1024_raw_c2(index)
   return Util_cvToRate_1024_c[(((index * 3) + 2)) + 1]
end

function Util_cvToRate_1024(cv)
   local value = (((cv) > (0.9) and (0.9) or ((cv) < (0.0) and (0.0) or (cv))) * 35.555555)
   local cell = clipValue(floor(value), 0, 31)
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_cvToRate_1024_c[(index) + 1] + (u * (Util_cvToRate_1024_c[((index + 1)) + 1] + (Util_cvToRate_1024_c[((index + 2)) + 1] * u))))
end

function Phase_default(_ctx)
   _ctx.rate = Util_cvToRate_1024(0.0)
end

function Phase_process_type_alloc()
   local _ctx = {};
   _ctx.inst_1b08a = Util_change_type_alloc()
   _ctx.inst_2048a = Util_edge_type_alloc()
   _ctx.phase = 0.0
   _ctx.rate = 0.0
   Phase_default(_ctx)
   return _ctx
end

function Phase_noteOn_type_alloc(_ctx)
   return Phase_process_type_alloc()
end

function Phase_noteOff_type_alloc(_ctx)
   return Phase_process_type_alloc()
end

function Phase_controlChange_type_alloc(_ctx)
   return Phase_process_type_alloc()
end

function Phase_default_type_alloc(_ctx)
   return Phase_process_type_alloc()
end

function Phd_process_type_alloc()
   local _ctx = {};
   _ctx.inst_18aec = Phase_process_type_alloc()
   _ctx.inst_295ec = Util_smooth_type_alloc()
   _ctx.inst_38aec = Phase_process_type_alloc()
   _ctx.pre_phase1 = 0.0
   return _ctx
end

function Phd_noteOn_type_alloc(_ctx)
   return Phd_process_type_alloc()
end

function Phd_noteOff_type_alloc(_ctx)
   return Phd_process_type_alloc()
end

function Phd_controlChange_type_alloc(_ctx)
   return Phd_process_type_alloc()
end

function Phd_default_type_alloc(_ctx)
   return Phd_process_type_alloc()
end

function Util_edge(_ctx, x)
   local ret = (x and (_ctx.pre == false))
   _ctx.pre = x
   return ret
end

function Util_change(_ctx, x)
   local v = (_ctx.pre_x ~= x)
   _ctx.pre_x = x
   return v
end

function Util_map(x, x0, x1, y0, y1)
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))
end

function Util_dcblock(_ctx, x0)
   local y0 = (x0 + ((-_ctx.x1) + (0.995 * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0
end

function Util_smooth(_ctx, input)
   _ctx.x = ((0.005 * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Util_average2(_ctx, x1)
   local result = (0.5 * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result
end

function Util_cubic_clipper(x)
   if (x <= -0.666667) then
      return -0.666667
   else
      if (x >= 0.666666) then
         return 0.666666
      else
         return (x + (-0.333334 * (x * (x * x))))
      end
   end
end

