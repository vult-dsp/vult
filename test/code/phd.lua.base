end

function Phase_controlChange(_ctx, control, value, channel)
end

Tables_nsine_c = {};
function Tables_nsine_raw_c0(index)
   return Tables_nsine_c[((index * 3)) + 1]
end

function Tables_nsine_raw_c1(index)
   return Tables_nsine_c[(((index * 3) + 1)) + 1]
end

function Tables_nsine_raw_c2(index)
   return Tables_nsine_c[(((index * 3) + 2)) + 1]
end

function Tables_nsine(x)
   local value = (((x) > (1.0) and (1.0) or ((x) < (0.0) and (0.0) or (x))) * 128.0)
   local cell = clipValue(floor(value), 0, 127)
   local u = (value - (cell))
   local index = (cell * 3)
   return (Tables_nsine_c[(index) + 1] + (u * (Tables_nsine_c[((index + 1)) + 1] + (Tables_nsine_c[((index + 2)) + 1] * u))))
end

function Phd_process(_ctx, cv, detune)
   local phase1 = Phase_process(_ctx.inst_18aec, cv, 0.0)
   local comp = (1.0 + (-phase1))
   local reset = ((-phase1) + _ctx.pre_phase1)
   _ctx.pre_phase1 = phase1
   local phase2 = Phase_process(_ctx.inst_38aec, (cv + Util_smooth(_ctx.inst_295ec, (0.5 * detune))), reset)
   local sine = Tables_nsine(phase2)
   return (comp * sine)
end

function Phd_noteOn(_ctx, note, velocity, channel)
end

function Phd_noteOff(_ctx, note, channel)
end

function Phd_controlChange(_ctx, control, value, channel)
end

function Phd_default(_ctx)
end

