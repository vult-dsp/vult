   var index = ((this.fix_to_int((x * 32.0))) < ((0|0)) ? ((0|0)) : ((this.fix_to_int((x * 32.0))) > ((31|0)) ? ((31|0)) : (this.fix_to_int((x * 32.0)))));
   return (FixedAndFloat_take_fix_return_real_c0[index] + (this.fix_to_float(x) * (FixedAndFloat_take_fix_return_real_c1[index] + (FixedAndFloat_take_fix_return_real_c2[index] * this.fix_to_float(x)))));
};

