this.FixedAndFloat_take_fix_return_fixed = function (x) {
   var value = (((x) < (0.0) ? (0.0) : ((x) > (1.0) ? (1.0) : (x))) * 33.0);
   var index = ((value)|0);
   var decimal = (value - Math.floor(value));
   return (FixedAndFloat_take_fix_return_fixed_c0[index] + (FixedAndFloat_take_fix_return_fixed_c1[index] * decimal));
};

var FixedAndFloat_take_fix_return_real_c0 = {};
