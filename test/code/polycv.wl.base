Polycv`velToCV[vel_] := 
   Return[(0.007874 * N[vel])];


Polycv`velToGate[vel_] := 
   If[(vel > 0), 
      Return[(0.007874 * N[vel])];, 
      Return[0.];];


Polycv`poly`noteOn[`ctx_, note_, velocity_] := Module[{ found, i }, 
   i = 0;
   found = False;
   While[((i < 4) && (found == False)), 
      Module[{  }, 
         If[(getValue[`ctx, "vel"][[i + 1]] == 0), 
            Module[{  }, 
               getValue[`ctx, "notes"][[i + 1]] = note;
               getValue[`ctx, "vel"][[i + 1]] = velocity;
               found = True;
            ];];
         i = (1 + i);
      ];];
]

Polycv`poly`noteOff[`ctx_, note_] := Module[{ found, i }, 
   i = 0;
   found = False;
   While[((i < 4) && (found == False)), 
      Module[{  }, 
         If[(getValue[`ctx, "notes"][[i + 1]] == note), 
            Module[{  }, 
               getValue[`ctx, "vel"][[i + 1]] = 0;
               found = True;
            ];];
         i = (1 + i);
      ];];
]

Polycv`polyState[`ctx_] := Module[{ gate4, gate3, gate2, gate1, vel4, vel3, vel2, vel1, note4, note3, note2, note1 }, 
   note1 = Util`pitchToCv[N[getValue[`ctx, "notes"][[1]]]];
   note2 = Util`pitchToCv[N[getValue[`ctx, "notes"][[2]]]];
   note3 = Util`pitchToCv[N[getValue[`ctx, "notes"][[3]]]];
   note4 = Util`pitchToCv[N[getValue[`ctx, "notes"][[4]]]];
   vel1 = Polycv`velToCV[getValue[`ctx, "vel"][[1]]];
   vel2 = Polycv`velToCV[getValue[`ctx, "vel"][[2]]];
   vel3 = Polycv`velToCV[getValue[`ctx, "vel"][[3]]];
   vel4 = Polycv`velToCV[getValue[`ctx, "vel"][[4]]];
   gate1 = Polycv`velToGate[getValue[`ctx, "vel"][[1]]];
   gate2 = Polycv`velToGate[getValue[`ctx, "vel"][[2]]];
   gate3 = Polycv`velToGate[getValue[`ctx, "vel"][[3]]];
   gate4 = Polycv`velToGate[getValue[`ctx, "vel"][[4]]];
   setValue[`ctx,"Polycv_polyState_ret_0",note1];
   setValue[`ctx,"Polycv_polyState_ret_1",vel1];
   setValue[`ctx,"Polycv_polyState_ret_2",gate1];
   setValue[`ctx,"Polycv_polyState_ret_3",note2];
   setValue[`ctx,"Polycv_polyState_ret_4",vel2];
   setValue[`ctx,"Polycv_polyState_ret_5",gate2];
   setValue[`ctx,"Polycv_polyState_ret_6",note3];
   setValue[`ctx,"Polycv_polyState_ret_7",vel3];
   setValue[`ctx,"Polycv_polyState_ret_8",gate3];
   setValue[`ctx,"Polycv_polyState_ret_9",note4];
   setValue[`ctx,"Polycv_polyState_ret_10",vel4];
   setValue[`ctx,"Polycv_polyState_ret_11",gate4];
   Return[];
]

Polycv`process[`ctx_, c_] := Module[{ `call`tempn`n11, `call`tempn`n10, `call`tempn`n9, `call`tempn`n8, `call`tempn`n7, `call`tempn`n6, `call`tempn`n5, `call`tempn`n4, `call`tempn`n3, `call`tempn`n2, `call`tempn`n1, `call`tempn`n0 }, 
   setValue[`ctx,"channel_in",c];
   Polycv`polyState[getValue[`ctx, "poly"]];
   `call`tempn`n0 = getValue[getValue[`ctx, "poly"], "Polycv_polyState_ret_0"];
   `call`tempn`n1 = getValue[getValue[`ctx, "poly"], "Polycv_polyState_ret_1"];
   `call`tempn`n2 = getValue[getValue[`ctx, "poly"], "Polycv_polyState_ret_2"];
   `call`tempn`n3 = getValue[getValue[`ctx, "poly"], "Polycv_polyState_ret_3"];
   `call`tempn`n4 = getValue[getValue[`ctx, "poly"], "Polycv_polyState_ret_4"];
   `call`tempn`n5 = getValue[getValue[`ctx, "poly"], "Polycv_polyState_ret_5"];
   `call`tempn`n6 = getValue[getValue[`ctx, "poly"], "Polycv_polyState_ret_6"];
   `call`tempn`n7 = getValue[getValue[`ctx, "poly"], "Polycv_polyState_ret_7"];
   `call`tempn`n8 = getValue[getValue[`ctx, "poly"], "Polycv_polyState_ret_8"];
   `call`tempn`n9 = getValue[getValue[`ctx, "poly"], "Polycv_polyState_ret_9"];
   `call`tempn`n10 = getValue[getValue[`ctx, "poly"], "Polycv_polyState_ret_10"];
   `call`tempn`n11 = getValue[getValue[`ctx, "poly"], "Polycv_polyState_ret_11"];
   setValue[`ctx,"Polycv_process_ret_0",`call`tempn`n0];
   setValue[`ctx,"Polycv_process_ret_1",`call`tempn`n1];
   setValue[`ctx,"Polycv_process_ret_2",`call`tempn`n2];
   setValue[`ctx,"Polycv_process_ret_3",`call`tempn`n3];
   setValue[`ctx,"Polycv_process_ret_4",`call`tempn`n4];
   setValue[`ctx,"Polycv_process_ret_5",`call`tempn`n5];
   setValue[`ctx,"Polycv_process_ret_6",`call`tempn`n6];
   setValue[`ctx,"Polycv_process_ret_7",`call`tempn`n7];
   setValue[`ctx,"Polycv_process_ret_8",`call`tempn`n8];
   setValue[`ctx,"Polycv_process_ret_9",`call`tempn`n9];
   setValue[`ctx,"Polycv_process_ret_10",`call`tempn`n10];
   setValue[`ctx,"Polycv_process_ret_11",`call`tempn`n11];
   Return[];
]

Polycv`noteOn[`ctx_, note_, velocity_, channel_] := 
   If[(getValue[`ctx, "channel_in"] == channel), 
      If[(velocity > 0), 
         Polycv`poly`noteOn[getValue[`ctx, "poly"], note, velocity];, 
         Polycv`poly`noteOff[getValue[`ctx, "poly"], note];];];


Polycv`noteOff[`ctx_, note_, channel_] := 
   If[(getValue[`ctx, "channel_in"] == channel), 
      Polycv`poly`noteOff[getValue[`ctx, "poly"], note];];


Polycv`controlChange[`ctx_, control_, value_, channel_] := Null

Polycv`default[`ctx_] := Null

