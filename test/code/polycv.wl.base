   Return[`ctx];
]

Polycv`poly`noteOn`type`alloc[] := Module[{ temp, in`n1, temp, in`n0, `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"Polycv_polyState_ret_0",0.];
   setValue[`ctx,"Polycv_polyState_ret_1",0.];
   setValue[`ctx,"Polycv_polyState_ret_10",0.];
   setValue[`ctx,"Polycv_polyState_ret_11",0.];
   setValue[`ctx,"Polycv_polyState_ret_2",0.];
   setValue[`ctx,"Polycv_polyState_ret_3",0.];
   setValue[`ctx,"Polycv_polyState_ret_4",0.];
   setValue[`ctx,"Polycv_polyState_ret_5",0.];
   setValue[`ctx,"Polycv_polyState_ret_6",0.];
   setValue[`ctx,"Polycv_polyState_ret_7",0.];
   setValue[`ctx,"Polycv_polyState_ret_8",0.];
   setValue[`ctx,"Polycv_polyState_ret_9",0.];
   in`n0 = 0;
   temp = initializeArray[0, 4];
   While[(in`n0 < 4), 
      Module[{  }, 
         temp[[in`n0 + 1]] = 0;
         in`n0 = (1 + in`n0);
      ];];
   setValue[`ctx,"notes",temp];
   in`n1 = 0;
   temp = initializeArray[0, 4];
   While[(in`n1 < 4), 
      Module[{  }, 
         temp[[in`n1 + 1]] = 0;
         in`n1 = (1 + in`n1);
      ];];
   setValue[`ctx,"vel",temp];
   Return[`ctx];
]

