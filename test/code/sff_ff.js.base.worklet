class VultProcessor extends AudioWorkletProcessor {
   constructor() {
      super();
      this.vult = new (function() {

// Runtime functions (simple builtins like eps, pi, clip, real, int_, sin, cos, etc. are inlined)
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
this.Sff_ff_process_type_alloc = function () {
   var _ctx = {};
   _ctx.Sff_ff_process_ret_0 = 0.0;
   _ctx.Sff_ff_process_ret_1 = 0.0;
   return _ctx;
};

this.Sff_ff_process = function (_ctx, a, b) {
   _ctx.Sff_ff_process_ret_0 = (a + b);
   _ctx.Sff_ff_process_ret_1 = (a + (-b));
   return ;
};

this.Sff_ff_noteOn = function (_ctx, note, velocity, channel) {
};

this.Sff_ff_noteOff = function (_ctx, note, channel) {
};

this.Sff_ff_controlChange = function (_ctx, control, value, channel) {
};

this.Sff_ff_default = function (_ctx) {
};


      this.context = this.Sff_ff_process_type_alloc();
      this.Sff_ff_default(this.context);
      })();
      this.port.onmessage = (e) => {
         if (e.data.type === 'noteOn') this.vult.Sff_ff_noteOn(this.vult.context, e.data.note, e.data.velocity, e.data.channel);
         if (e.data.type === 'noteOff') this.vult.Sff_ff_noteOff(this.vult.context, e.data.note, e.data.channel);
         if (e.data.type === 'controlChange') this.vult.Sff_ff_controlChange(this.vult.context, e.data.control, e.data.value, e.data.channel);
      };
   }
   process(inputs, outputs, parameters) {
      const input = inputs[0];
      const output = outputs[0];
      for (var i = 0; i < 128; i++) {
         this.vult.Sff_ff_process(this.vult.context, input[0] ? input[0][i] : 0, input[1] ? input[1][i] : 0);
         output[0][i] = this.vult.Sff_ff_process_ret_0(this.vult.context);
output[1][i] = this.vult.Sff_ff_process_ret_1(this.vult.context);
      }
      return true;
   }
}
registerProcessor('vult-processor', VultProcessor);