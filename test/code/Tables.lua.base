

-- Math functions
local floor = math.floor

Tables_sineTable1_c = {};
function Tables_sineTable1_raw_c0(index)
   return Tables_sineTable1_c[((index * 3)) + 1]
end

function Tables_sineTable1_raw_c1(index)
   return Tables_sineTable1_c[(((index * 3) + 1)) + 1]
end

function Tables_sineTable1_raw_c2(index)
   return Tables_sineTable1_c[(((index * 3) + 2)) + 1]
end

function Tables_sineTable1(x)
   local value = (((x) > (1.0) and (1.0) or ((x) < (0.0) and (0.0) or (x))) * 32.0)
   local cell = ((math.floor(value)) > (31) and (31) or ((math.floor(value)) < (0) and (0) or (math.floor(value))))
   local u = (value - (cell))
   local index = (cell * 3)
   return (Tables_sineTable1_c[(index) + 1] + (u * (Tables_sineTable1_c[((index + 1)) + 1] + (Tables_sineTable1_c[((index + 2)) + 1] * u))))
end

Tables_sineTable2_c = {};
function Tables_sineTable2_raw_c0(index)
   return Tables_sineTable2_c[((index * 2)) + 1]
end

function Tables_sineTable2_raw_c1(index)
   return Tables_sineTable2_c[(((index * 2) + 1)) + 1]
end

function Tables_sineTable2(x)
   local value = (((x) > (1.0) and (1.0) or ((x) < (0.0) and (0.0) or (x))) * 32.0)
   local cell = ((math.floor(value)) > (31) and (31) or ((math.floor(value)) < (0) and (0) or (math.floor(value))))
   local u = (value - (cell))
   local index = (cell * 2)
   return (Tables_sineTable2_c[(index) + 1] + (u * Tables_sineTable2_c[((index + 1)) + 1]))
end

Tables_sineTable3_c = {};
function Tables_sineTable3_raw_c0(index)
   return Tables_sineTable3_c[((index * 2)) + 1]
end

function Tables_sineTable3_raw_c1(index)
   return Tables_sineTable3_c[(((index * 2) + 1)) + 1]
end

function Tables_sineTable3(x)
   local value = (((x) > (1.0) and (1.0) or ((x) < (0.0) and (0.0) or (x))) * 33.0)
   local index = ((math.modf(value)) * 2)
   local decimal = (value - floor(value))
   return (Tables_sineTable3_c[(index) + 1] + (Tables_sineTable3_c[((index + 1)) + 1] * decimal))
end

Tables_power2_table = {};
function Tables_power2(x)
   return Tables_power2_table[((int_clip(x, -4, 4) + 4)) + 1]
end

Tables_square_table = {};
function Tables_square(x)
   return Tables_square_table[((int_clip(x, -4, 4) + 4)) + 1]
end

Tables_square16_table = {};
function Tables_square16(x)
   return Tables_square16_table[((int_clip(x, -4, 4) + 4)) + 1]
end

