
-- LuaJIT detection
local isLuaJIT = type(jit) == "table" and jit.version


-- Numeric arrays use FFI storage under LuaJIT, tables everywhere else.
local initializeArray
if isLuaJIT then
    local ffi = require("ffi")
    function initializeArray(v, n)
        if type(v) == "number" then
            -- One-based, so element zero is unused. This is cdata, not a
            -- table: indexing works, '#' and pairs() do not.
            local a = ffi.new("double[?]", n + 1)
            for i = 1, n do a[i] = v end
            return a
        else
            local a = {}
            for i = 1, n do a[i] = v end
            return a
        end
    end
else
    function initializeArray(v, n)
        local a = {}
        for i = 1, n do a[i] = v end
        return a
    end
end


-- Math functions
local floor = math.floor
local modf = math.modf

-- Core runtime functions
local function clipValue(x, low, high) if x > high then return high elseif x < low then return low else return x end end

function Short_delay_soft_type_alloc()
   local _ctx = {};
   _ctx.x2 = 0.0
   _ctx.x3 = 0.0
   _ctx.x4 = 0.0
   return _ctx
end

function Short_delay_do_type_alloc()
   local i_0 = 0
   local temp_1 = initializeArray(0.0, 22050)
   local _ctx = {};
   while (i_0 < 22050) do
      do
         temp_1[i_0 + 1] = 0.0
         i_0 = (1 + i_0)
      end
   end
   _ctx.buffer = temp_1
   _ctx.write_pos = 0
   return _ctx
end

function Short_delay_process_type_alloc()
   local _ctx = {};
   _ctx.inst_1593b = Short_delay_soft_type_alloc()
   _ctx.inst_2ba3b = Short_delay_do_type_alloc()
   return _ctx
end

function Short_delay_noteOn_type_alloc(_ctx)
   return Short_delay_process_type_alloc()
end

function Short_delay_noteOff_type_alloc(_ctx)
   return Short_delay_process_type_alloc()
end

function Short_delay_controlChange_type_alloc(_ctx)
   return Short_delay_process_type_alloc()
end

function Short_delay_default_type_alloc(_ctx)
   return Short_delay_process_type_alloc()
end

Saturate_tanh_table_c = {};
function Saturate_tanh_table_raw_c0(index)
   return Saturate_tanh_table_c[((index * 3)) + 1]
end

function Saturate_tanh_table_raw_c1(index)
   return Saturate_tanh_table_c[(((index * 3) + 1)) + 1]
end

function Saturate_tanh_table_raw_c2(index)
   return Saturate_tanh_table_c[(((index * 3) + 2)) + 1]
end

function Saturate_tanh_table(x)
   local value = ((((x) > (24.0) and (24.0) or ((x) < (-24.0) and (-24.0) or (x))) + 24.0) * 5.020833)
   local cell = clipValue(floor(value), 0, 240)
   local u = (value - (cell))
   local index = (cell * 3)
   return (Saturate_tanh_table_c[(index) + 1] + (u * (Saturate_tanh_table_c[((index + 1)) + 1] + (Saturate_tanh_table_c[((index + 2)) + 1] * u))))
end

function Saturate_process(x)
   return Saturate_tanh_table(x)
end

function Saturate_noteOn(note, velocity, channel)
end

function Saturate_noteOff(note, channel)
end

function Saturate_controlChange(control, value, channel)
end

function Saturate_default()
end

function Short_delay_soft(_ctx, x1)
   local o = (0.25 * (x1 + (_ctx.x2 + (_ctx.x3 + _ctx.x4))))
   _ctx.x4 = _ctx.x3
   _ctx.x3 = _ctx.x2
   _ctx.x2 = x1
   return o
end

function Short_delay_do(_ctx, x, time_in, feedback_in)
   local time = ((time_in) > (1.0) and (1.0) or ((time_in) < (0.0) and (0.0) or (time_in)))
   local feedback = ((feedback_in) > (1.0) and (1.0) or ((feedback_in) < (0.0) and (0.0) or (feedback_in)))
   local index_r = (22050.0 * time)
   local index_i = (modf(index_r))
   local delta = ((-index_i) + _ctx.write_pos)
   local read_pos = 0
   if (delta < 0) then
      read_pos = (22050 + delta)
   else
      read_pos = delta
   end
   local decimal = (index_r + (-(index_i)))
   local x1 = _ctx.buffer[(read_pos) + 1]
   local _wrap_temp_0 = (1 + read_pos)
   local x2 = 0.0
   if (_wrap_temp_0 >= 22050) then
      if (_wrap_temp_0 == 22050) then
         _wrap_temp_0 = 0
      else
         _wrap_temp_0 = (_wrap_temp_0 % 22050)
      end
   else
      if (_wrap_temp_0 <= -22050) then
         _wrap_temp_0 = (_wrap_temp_0 % 22050)
      end
   end
   x2 = _ctx.buffer[(_wrap_temp_0) + 1]
   local ret = (x1 + (decimal * (x2 + (-x1))))
   _ctx.write_pos = (1 + _ctx.write_pos)
   if (_ctx.write_pos >= 22050) then
      if (_ctx.write_pos == 22050) then
         _ctx.write_pos = 0
      else
         _ctx.write_pos = (_ctx.write_pos % 22050)
      end
   else
      if (_ctx.write_pos <= -22050) then
         _ctx.write_pos = (_ctx.write_pos % 22050)
      end
   end
   _ctx.buffer[_ctx.write_pos + 1] = Saturate_process((x + (feedback * ret)))
   return ret
end

function Short_delay_process(_ctx, x, time, feedback)
   return Short_delay_do(_ctx.inst_2ba3b, x, Short_delay_soft(_ctx.inst_1593b, time), feedback)
end

function Short_delay_noteOn(_ctx, note, velocity, channel)
end

function Short_delay_noteOff(_ctx, note, channel)
end

function Short_delay_controlChange(_ctx, control, value, channel)
end

function Short_delay_default(_ctx)
end

