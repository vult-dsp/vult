class VultProcessor extends AudioWorkletProcessor {
   constructor() {
      super();
      this.vult = new (function() {

// Runtime functions (simple builtins like eps, pi, clip, real, int_, sin, cos, etc. are inlined)
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
this.Sff_f_process = function (a, b) {
   return (a * b);
};

this.Sff_f_noteOn = function (note, velocity, channel) {
};

this.Sff_f_noteOff = function (note, channel) {
};

this.Sff_f_controlChange = function (control, value, channel) {
};

this.Sff_f_default = function () {
};


      this.context = {};
      this.Sff_f_default();
      })();
      this.port.onmessage = (e) => {
         if (e.data.type === 'noteOn') this.vult.Sff_f_noteOn(e.data.note, e.data.velocity, e.data.channel);
         if (e.data.type === 'noteOff') this.vult.Sff_f_noteOff(e.data.note, e.data.channel);
         if (e.data.type === 'controlChange') this.vult.Sff_f_controlChange(e.data.control, e.data.value, e.data.channel);
      };
   }
   process(inputs, outputs, parameters) {
      const input = inputs[0];
      const output = outputs[0];
      for (var i = 0; i < 128; i++) {
         output[0][i] = this.vult.Sff_f_process(input[0] ? input[0][i] : 0, input[1] ? input[1][i] : 0);
      }
      return true;
   }
}
registerProcessor('vult-processor', VultProcessor);