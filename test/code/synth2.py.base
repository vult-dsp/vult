def Synth2_minFixed():
   return 1.5e-05

def Synth2_change(_ctx, x):
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v


def Synth2_bchange(_ctx, x):
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v


def Synth2_edge(_ctx, x):
   v = ((_ctx.pre_x != x) and (_ctx.pre_x == True))
   _ctx.pre_x = x
   return v


def Synth2_each(_ctx, n):
   ret = (_ctx.count == 0)
   _ctx.count = ((1 + _ctx.count) % n)
   return ret


def Synth2_near_zero(x):
   return (abs(x) < 0.02)

def Synth2_dcblock(_ctx, x0):
   y0 = (x0 + ((-_ctx.x1) + (0.995 * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0


def Synth2_smooth(_ctx, input):
   _ctx.x = ((0.005 * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x


def Synth2_lpfilter(_ctx, x):
   ret = (0.5 * (x + _ctx.pre_x))
   _ctx.pre_x = x
   return ret


def Synth2_pitchToRate(d):
   return (0.000185 * math.exp((0.057762 * d)))

def Synth2_pulse_train(m, phase):
   pi_phase = (3.141592 * phase)
   denominator1 = math.sin(pi_phase)
   tmp1 = 0.0
   if Synth2_near_zero(denominator1):
      tmp1 = 1.0
   else:
      tmp1 = math.sin((m * pi_phase))
      tmp1 = (tmp1 / (denominator1 * m))

   return tmp1


def Synth2_osc(_ctx, pitch, pw, wave):
   fixed_pitch = 0.0
   if (wave < 0.666666):
      fixed_pitch = pitch
   else:
      fixed_pitch = (12.0 + pitch)
   if Synth2_change(_ctx.inst_177e5, fixed_pitch):
      _ctx.rate = Synth2_pitchToRate(fixed_pitch)
      p = (1.0 / _ctx.rate)
      maxHarmonics = math.floor((0.5 * p))
      _ctx.m = (1.0 + (2.0 * maxHarmonics))

   shift05 = (0.5 + (0.49 * pw))
   shift = (shift05 + _ctx.phase)
   if (shift > 1.0):
      shift = (-1.0 + shift)
   tmp1 = Synth2_pulse_train(_ctx.m, _ctx.phase)
   tmp2 = Synth2_pulse_train(_ctx.m, shift)
   _ctx.phase = (_ctx.phase + _ctx.rate)
   if (_ctx.phase > 1.0):
      _ctx.phase = (-1.0 + _ctx.phase)
   _ctx.state_pulse = ((-1.0) if ((tmp1 + ((-tmp2) + (0.9995 * _ctx.state_pulse)))) < (-1.0) else ((1.0) if ((tmp1 + ((-tmp2) + (0.9995 * _ctx.state_pulse)))) > (1.0) else ((tmp1 + ((-tmp2) + (0.9995 * _ctx.state_pulse))))))
   _ctx.state_saw = ((-1.0) if (((0.5 * ((tmp1 + (tmp2 + (-2.0 * _ctx.rate))) / shift05)) + (0.9995 * _ctx.state_saw))) < (-1.0) else ((1.0) if (((0.5 * ((tmp1 + (tmp2 + (-2.0 * _ctx.rate))) / shift05)) + (0.9995 * _ctx.state_saw))) > (1.0) else (((0.5 * ((tmp1 + (tmp2 + (-2.0 * _ctx.rate))) / shift05)) + (0.9995 * _ctx.state_saw)))))
   _ctx.state_triang = ((-1.0) if (((0.9995 * _ctx.state_triang) + (2.0 * (_ctx.state_pulse * _ctx.rate)))) < (-1.0) else ((1.0) if (((0.9995 * _ctx.state_triang) + (2.0 * (_ctx.state_pulse * _ctx.rate)))) > (1.0) else (((0.9995 * _ctx.state_triang) + (2.0 * (_ctx.state_pulse * _ctx.rate))))))
   if (wave < 0.333333):
      _ctx.output = _ctx.state_pulse
   else:
      if (wave < 0.666666):
         _ctx.output = (2.0 * _ctx.state_saw)
      else:
         _ctx.output = (2.0 * ((1.0 + pw) * _ctx.state_triang))
   _ctx.output = Synth2_dcblock(_ctx.inst_24fe5, _ctx.output)
   return ((-1.0) if ((0.25 * _ctx.output)) < (-1.0) else ((1.0) if ((0.25 * _ctx.output)) > (1.0) else ((0.25 * _ctx.output))))


def Synth2_svf_step(_ctx, input, g, q, sel):
   low = ((g * _ctx.dband) + _ctx.dlow)
   high = (input + ((-low) + (-(q * _ctx.dband))))
   band = ((g * high) + _ctx.dband)
   notch = (high + low)
   _ctx.dband = ((-1.0) if (band) < (-1.0) else ((1.0) if (band) > (1.0) else (band)))
   _ctx.dlow = ((-1.0) if (low) < (-1.0) else ((1.0) if (low) > (1.0) else (low)))
   output = 0.0
   if (sel == 0):
      output = low
   else:
      if (sel == 1):
         output = high
      else:
         if (sel == 2):
            output = band
         else:
            output = notch
   return output


def Synth2_svf(_ctx, input, fc, q, sel):
   fc = ((0.0) if (fc) < (0.0) else ((1.0) if (fc) > (1.0) else (fc)))
   q = ((0.0) if (q) < (0.0) else ((1.0) if (q) > (1.0) else (q)))
   fix_q = (2.0 + (2.0 * (-q)))
   if Synth2_change(_ctx.inst_177a7, fc):
      _ctx.g = (0.5 * fc)
   x1 = Synth2_svf_step(_ctx.step, input, _ctx.g, fix_q, sel)
   x2 = Synth2_svf_step(_ctx.step, input, _ctx.g, fix_q, sel)
   return (0.5 * (x1 + x2))


def Synth2_lfo(_ctx, f, gate):
   _cse_temp_0 = Synth2_minFixed()
   rate = (_cse_temp_0 + (100.0 * (_cse_temp_0 * f)))
   if Synth2_edge(_ctx.inst_1445f, gate):
      _ctx.phase = 0.0
   if Synth2_each(_ctx.inst_2cb5f, 4):
      _ctx.phase = (rate + _ctx.phase)
   if (_ctx.phase > 1.0):
      _ctx.phase = (-1.0 + _ctx.phase)
   return (0.5 + math.sin((6.283185 * _ctx.phase)))


def Synth2_mono_noteOn(_ctx, n):
   if (_ctx.count < 4):
      _ctx.notes[_ctx.count] = n
      _ctx.pre = n
      if (_ctx.count < 4):
         _ctx.count = (1 + _ctx.count)

   return _ctx.pre


def Synth2_mono_noteOff(_ctx, n):
   found = False
   i = 0
   pos = 0
   if (_ctx.count == 0):
      return _ctx.pre
   while ((i < 4) and (found == False)):
      if (_ctx.notes[i] == n):
         pos = i
         found = True

      i = (1 + i)

   if found:
      k = (1 + pos)
      while (k < 4):
         _ctx.notes[(-1 + k)] = _ctx.notes[k]
         k = (1 + k)

      if (found and (_ctx.count > 0)):
         _ctx.count = (-1 + _ctx.count)
         _ctx.pre = _ctx.notes[(-1 + _ctx.count)]


   return _ctx.pre


def Synth2_mono_isGateOn(_ctx):
   return (_ctx.count > 0)

def Synth2_process(_ctx, i):
   gate = Synth2_mono_isGateOn(_ctx.monoin)
   lfo1 = (Synth2_lfo(_ctx.inst_15fb7, _ctx.lfo_rate, gate) * _ctx.lfo_amt)
   o1 = Synth2_osc(_ctx.inst_2e5b7, _ctx.pitch, (lfo1 + _ctx.pw), _ctx.wave)
   amp_env = Synth2_smooth(_ctx.inst_3dfb7, (1.0 if gate else 0.0))
   output = (amp_env * Synth2_svf(_ctx.inst_4a7b7, o1, _ctx.cut, _ctx.res, 0))
   return (output * _ctx.volume)


def Synth2_noteOn(_ctx, note, velocity, channel):
   _ctx.pitch = float(Synth2_mono_noteOn(_ctx.monoin, note))

def Synth2_noteOff(_ctx, note, channel):
   _ctx.pitch = float(Synth2_mono_noteOff(_ctx.monoin, note))

def Synth2_controlChange(_ctx, control, value, channel):
   value_0_1 = (0.007874 * float(value))
   value_m1_1 = (-1.0 + (2.0 * value_0_1))
   if (control == 30):
      _ctx.volume = value_0_1
   if (control == 31):
      _ctx.wave = value_0_1
   if (control == 32):
      _ctx.pw = value_0_1
   if (control == 33):
      _ctx.lfo_rate = value_0_1
   if (control == 34):
      _ctx.lfo_amt = value_m1_1
   if (control == 35):
      _ctx.cut = value_0_1
   if (control == 36):
      _ctx.res = value_0_1


