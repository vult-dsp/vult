class Synth2_process_type:
    __slots__ = ['amp_s', 'cut', 'inst_15fb7', 'inst_2e5b7', 'inst_3dfb7', 'inst_4a7b7', 'lfo_amt', 'lfo_rate', 'monoin', 'pitch', 'pw', 'res', 'volume', 'wave']
    def __init__(self, amp_s=0.0, cut=0.0, inst_15fb7=Synth2_lfo_type(), inst_2e5b7=Synth2_osc_type(), inst_3dfb7=Synth2_smooth_type(), inst_4a7b7=Synth2_svf_type(), lfo_amt=0.0, lfo_rate=0.0, monoin=Synth2_mono_noteOn_type(), pitch=0.0, pw=0.0, res=0.0, volume=0.0, wave=0.0):
        self.amp_s = amp_s
        self.cut = cut
        self.inst_15fb7 = inst_15fb7
