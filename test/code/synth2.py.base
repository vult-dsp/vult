   _ctx = {}
   _ctx["x1"] = 0.0
   _ctx["y1"] = 0.0
   return _ctx


def Synth2_smooth_type_alloc():
   _ctx = {}
   _ctx["x"] = 0.0
   return _ctx


def Synth2_lpfilter_type_alloc():
   _ctx = {}
   _ctx["pre_x"] = 0.0
   return _ctx


def Synth2_osc_type_alloc():
   _ctx = {}
   _ctx["inst_177e5"] = Synth2_change_type_alloc()
   _ctx["inst_24fe5"] = Synth2_dcblock_type_alloc()
   _ctx["m"] = 0.0
   _ctx["output"] = 0.0
   _ctx["phase"] = 0.0
   _ctx["rate"] = 0.0
   _ctx["state_pulse"] = 0.0
   _ctx["state_saw"] = 0.0
