import math

# Runtime functions

def initializeArray(v, size):
    return [v for _ in range(size)]

class Synth2_change_type:
    __slots__ = ['pre_x']
    def __init__(self, pre_x=0.0):
        self.pre_x = pre_x

class Synth2_bchange_type:
    __slots__ = ['pre_x']
