def Synth2_mono_noteOn_type_alloc():
   _ctx = Synth2_mono_noteOn_type()
   _ctx.count = 0
   i_0 = 0
   temp_1 = initializeArray(0, 4)
   while (i_0 < 4):
      temp_1[i_0] = 0
      i_0 = (1 + i_0)

   _ctx.notes = temp_1
   _ctx.pre = 0
   return _ctx


