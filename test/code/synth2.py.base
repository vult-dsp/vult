class Synth2_osc_type:
    __slots__ = ['inst_177e5', 'inst_24fe5', 'm', 'output', 'phase', 'rate', 'state_pulse', 'state_saw', 'state_triang']
    def __init__(self, inst_177e5=Synth2_change_type(), inst_24fe5=Synth2_dcblock_type(), m=0.0, output=0.0, phase=0.0, rate=0.0, state_pulse=0.0, state_saw=0.0, state_triang=0.0):
        self.inst_177e5 = inst_177e5
        self.inst_24fe5 = inst_24fe5
        self.m = m
        self.output = output
        self.phase = phase
        self.rate = rate
        self.state_pulse = state_pulse
