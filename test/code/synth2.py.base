import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

def Synth2_change_type_alloc():
   _ctx = {}
   _ctx["pre_x"] = 0.0
   return _ctx


def Synth2_bchange_type_alloc():
   _ctx = {}
   _ctx["pre_x"] = False
   return _ctx


def Synth2_edge_type_alloc():
   _ctx = {}
   _ctx["pre_x"] = False
   return _ctx


def Synth2_each_type_alloc():
   _ctx = {}
   _ctx["count"] = 0
   return _ctx


