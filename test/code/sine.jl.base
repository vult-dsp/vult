end

function Phase_process(_ctx, cv, reset)
   if Util_change(_ctx.inst_1b08a, cv)
      _ctx.rate = Util_cvToRate_1024(cv)
   end
   if Util_edge(_ctx.inst_2048a, (reset > Float32(0.5)))
      _ctx.phase = Float32(0.0)
   else
      _ctx.phase = (_ctx.phase + _ctx.rate)
   end
   if (_ctx.phase > Float32(1024.0))
      _ctx.phase = (Float32(-1024.0) + _ctx.phase)
   else
      _ctx.phase = _ctx.phase
   end
   return (Float32(0.000976) * _ctx.phase)
end

function Phase_noteOn(_ctx, note, velocity, channel)
end

function Phase_noteOff(_ctx, note, channel)
end

function Phase_controlChange(_ctx, control, value, channel)
end

Tables_nsine_c0 = nothing
Tables_nsine_c1 = nothing
Tables_nsine_c2 = nothing
function Tables_nsine_raw_c0(index)
   return @inbounds Tables_nsine_c0[index + 1]
end

function Tables_nsine_raw_c1(index)
   return @inbounds Tables_nsine_c1[index + 1]
end

function Tables_nsine_raw_c2(index)
   return @inbounds Tables_nsine_c2[index + 1]
end

function Tables_nsine(x)
   index = clamp(trunc(Int32, (x * Float32(127.0))), Int32(0), Int32(127))
   return (@inbounds Tables_nsine_c0[index + 1] + (x * (@inbounds Tables_nsine_c1[index + 1] + (@inbounds Tables_nsine_c2[index + 1] * x))))
end

function Sine_process(_ctx, cv, reset)
   if Util_edge(_ctx.inst_104ba, (reset > Float32(0.5)))
      _ctx.trig = true
   end
   phase = Phase_process(_ctx.p, cv, Float32(0.0))
   if ((phase < eps(Float32)) && _ctx.trig)
      begin
         _ctx.trig = false
         Phase_process(_ctx.p, cv, Float32(0.0))
      end
   end
   return Tables_nsine(phase)
end

function Sine_noteOn(_ctx, note, velocity, channel)
end

function Sine_noteOff(_ctx, note, channel)
end

function Sine_controlChange(_ctx, control, value, channel)
end

function Sine_default(_ctx)
end

