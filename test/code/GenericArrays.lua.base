

function GenericArrays_sum(data)
   local total = 0.0
   local i__1 = 0
   while (i__1 < size(data)) do
      do
         total = (total + data[(i__1) + 1])
         i__1 = (1 + i__1)
      end
   end
   return total
end

function GenericArrays_test1()
   local data1 = {1.0, 2.0, 3.0}
   local data2 = {1.0, 2.0, 3.0, 4.0}
   GenericArrays_sum(data1)
   GenericArrays_sum(data2)
end

