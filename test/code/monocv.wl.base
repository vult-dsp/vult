Util`cvTokHz`raw`c1[index_] := 
   Return[Util`cvTokHz`c1[[index + 1]]];


Util`cvTokHz`raw`c2[index_] := 
   Return[Util`cvTokHz`c2[[index + 1]]];


Util`cvTokHz[cv_] := Module[{ index }, 
   index = Clip[Floor[(cv * 31.)], {0, 31}];
   Return[(Util`cvTokHz`c0[[index + 1]] + (cv * (Util`cvTokHz`c1[[index + 1]] + (Util`cvTokHz`c2[[index + 1]] * cv))))];
]

Monocv`mono`noteOn[`ctx_, n_] := Module[{  }, 
   If[(getValue[`ctx, "count"] < 4), 
      Module[{  }, 
         getValue[`ctx, "notes"][[getValue[`ctx, "count"] + 1]] = n;
         setValue[`ctx,"pre",n];
         If[(getValue[`ctx, "count"] < 4), 
            setValue[`ctx,"count",(1 + getValue[`ctx, "count"])];];
      ];];
   Return[getValue[`ctx, "pre"]];
]

Monocv`mono`noteOff[`ctx_, n_] := Module[{ pos, i, found }, 
   found = False;
   i = 0;
   pos = 0;
   If[(getValue[`ctx, "count"] == 0), 
      Return[getValue[`ctx, "pre"]];];
   While[((i < 4) && (found == False)), 
      Module[{  }, 
         If[(getValue[`ctx, "notes"][[i + 1]] == n), 
            Module[{  }, 
               pos = i;
               found = True;
            ];];
         i = (1 + i);
      ];];
   If[found, 
      Module[{ k }, 
         k = (1 + pos);
         While[(k < 4), 
            Module[{  }, 
               getValue[`ctx, "notes"][[(-1 + k) + 1]] = getValue[`ctx, "notes"][[k + 1]];
               k = (1 + k);
            ];];
         If[(found && (getValue[`ctx, "count"] > 0)), 
            Module[{  }, 
               setValue[`ctx,"count",(-1 + getValue[`ctx, "count"])];
               setValue[`ctx,"pre",getValue[`ctx, "notes"][[(-1 + getValue[`ctx, "count"]) + 1]]];
            ];];
      ];];
   Return[getValue[`ctx, "pre"]];
]

Monocv`mono`isGateOn[`ctx_] := 
   Return[(getValue[`ctx, "count"] > 0)];


Monocv`process[`ctx_, c_] := Module[{ note }, 
   setValue[`ctx,"channel_in",c];
   If[Monocv`mono`isGateOn[getValue[`ctx, "notes"]], 
      setValue[`ctx,"gate",getValue[`ctx, "vel"]];, 
      setValue[`ctx,"gate",0.];];
   note = N[getValue[`ctx, "active_note"]];
   If[Util`change[getValue[`ctx, "inst_1b0d6"], note], 
      setValue[`ctx,"cv",Util`pitchToCv[note]];];
   setValue[`ctx,"Monocv_process_ret_0",getValue[`ctx, "cv"]];
   setValue[`ctx,"Monocv_process_ret_1",getValue[`ctx, "vel"]];
   setValue[`ctx,"Monocv_process_ret_2",getValue[`ctx, "gate"]];
   Return[];
]

Monocv`noteOn[`ctx_, note_, velocity_, channel_] := 
   If[(getValue[`ctx, "channel_in"] == channel), 
      If[(velocity > 0), 
         Module[{  }, 
            setValue[`ctx,"active_note",Monocv`mono`noteOn[getValue[`ctx, "notes"], note]];
            setValue[`ctx,"vel",(0.007874 * N[velocity])];
         ];, 
         setValue[`ctx,"active_note",Monocv`mono`noteOff[getValue[`ctx, "notes"], note]];];];


Monocv`noteOff[`ctx_, note_, channel_] := 
   If[(getValue[`ctx, "channel_in"] == channel), 
      setValue[`ctx,"active_note",Monocv`mono`noteOff[getValue[`ctx, "notes"], note]];];


Monocv`controlChange[`ctx_, control_, value_, channel_] := Null

Monocv`default[`ctx_] := Null

