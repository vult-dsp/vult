
IntegerDivision[a_, b_] := Floor[a / b];
newEmptyObject[] := CreateDataStructure["HashTable"];
setValue[var_, key_, value_] := var["Insert", key -> value];
getValue[var_, key_] := var["Lookup", key];
newObject[elems_] := Module[{t = newEmptyObject[]}, Map[t["Insert", #] &, elems]; t];
initializeArray[v_, n_] := Table[v, n];
eps[] := $MinMachineNumber
Util`edge`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"pre",False];
   Return[`ctx];
]

Util`change`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"pre_x",0.];
   Return[`ctx];
]

Util`dcblock`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x1",0.];
   setValue[`ctx,"y1",0.];
   Return[`ctx];
]

Util`smooth`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x",0.];
   Return[`ctx];
]

Util`average2`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x0",0.];
   Return[`ctx];
]

Monocv`mono`noteOn`type`alloc[] := Module[{ temp, in`n0, `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"count",0];
   in`n0 = 0;
   temp = initializeArray[0, 4];
   While[(in`n0 < 4), 
      Module[{  }, 
         temp[[in`n0 + 1]] = 0;
         in`n0 = (1 + in`n0);
      ];];
   setValue[`ctx,"notes",temp];
   setValue[`ctx,"pre",0];
   Return[`ctx];
]

Monocv`mono`noteOff`type`alloc[`ctx_] := 
   Return[Monocv`mono`noteOn`type`alloc[]];


Monocv`mono`isGateOn`type`alloc[`ctx_] := 
   Return[Monocv`mono`noteOn`type`alloc[]];


Monocv`process`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"Monocv_process_ret_0",0.];
   setValue[`ctx,"Monocv_process_ret_1",0.];
   setValue[`ctx,"Monocv_process_ret_2",0.];
   setValue[`ctx,"active_note",0];
   setValue[`ctx,"channel_in",0];
   setValue[`ctx,"cv",0.];
   setValue[`ctx,"gate",0.];
   setValue[`ctx,"inst_1b0d6",Util`change`type`alloc[]];
   setValue[`ctx,"notes",Monocv`mono`noteOn`type`alloc[]];
   setValue[`ctx,"vel",0.];
   Return[`ctx];
]

Monocv`noteOn`type`alloc[`ctx_] := 
   Return[Monocv`process`type`alloc[]];


Monocv`noteOff`type`alloc[`ctx_] := 
   Return[Monocv`process`type`alloc[]];


Monocv`controlChange`type`alloc[`ctx_] := 
   Return[Monocv`process`type`alloc[]];


Monocv`default`type`alloc[`ctx_] := 
   Return[Monocv`process`type`alloc[]];


Util`edge[`ctx_, x_] := Module[{ ret }, 
   ret = (x && (getValue[`ctx, "pre"] == False));
   setValue[`ctx,"pre",x];
   Return[ret];
]

Util`change[`ctx_, x_] := Module[{ v }, 
   v = (getValue[`ctx, "pre_x"] != x);
   setValue[`ctx,"pre_x",x];
   Return[v];
]

Util`map[x_, x0_, x1_, y0_, y1_] := 
   Return[(y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))];


Util`dcblock[`ctx_, x0_] := Module[{ y0 }, 
   y0 = (x0 + ((-getValue[`ctx, "x1"]) + (0.995 * getValue[`ctx, "y1"])));
   setValue[`ctx,"x1",x0];
   setValue[`ctx,"y1",y0];
   Return[y0];
]

Util`smooth[`ctx_, input_] := Module[{  }, 
   setValue[`ctx,"x",((0.005 * (input + (-getValue[`ctx, "x"]))) + getValue[`ctx, "x"])];
   Return[getValue[`ctx, "x"]];
]

Util`average2[`ctx_, x1_] := Module[{ result }, 
   result = (0.5 * (x1 + getValue[`ctx, "x0"]));
   setValue[`ctx,"x0",x1];
   Return[result];
]

Util`cubic`clipper[x_] := 
   If[(x <= -0.666667), 
      Return[-0.666667];, 
      If[(x >= 0.666666), 
         Return[0.666666];, 
         Return[(x + (-0.333334 * (x * (x * x))))];];];


Util`pitchToRaten`n1024`c0 = {};
Util`pitchToRaten`n1024`c1 = {};
Util`pitchToRaten`n1024`c2 = {};
Util`pitchToRaten`n1024`raw`c0[index_] := 
   Return[Util`pitchToRaten`n1024`c0[[index + 1]]];


Util`pitchToRaten`n1024`raw`c1[index_] := 
   Return[Util`pitchToRaten`n1024`c1[[index + 1]]];


Util`pitchToRaten`n1024`raw`c2[index_] := 
   Return[Util`pitchToRaten`n1024`c2[[index + 1]]];


Util`pitchToRaten`n1024[pitch_] := Module[{ index }, 
   index = Clip[Floor[(pitch * 0.244094)], {0, 31}];
   Return[(Util`pitchToRaten`n1024`c0[[index + 1]] + (pitch * (Util`pitchToRaten`n1024`c1[[index + 1]] + (Util`pitchToRaten`n1024`c2[[index + 1]] * pitch))))];
]

Util`pitchToRate`c0 = {};
Util`pitchToRate`c1 = {};
Util`pitchToRate`c2 = {};
Util`pitchToRate`raw`c0[index_] := 
   Return[Util`pitchToRate`c0[[index + 1]]];


Util`pitchToRate`raw`c1[index_] := 
   Return[Util`pitchToRate`c1[[index + 1]]];


Util`pitchToRate`raw`c2[index_] := 
   Return[Util`pitchToRate`c2[[index + 1]]];


Util`pitchToRate[pitch_] := Module[{ index }, 
   index = Clip[Floor[(pitch * 0.244094)], {0, 31}];
   Return[(Util`pitchToRate`c0[[index + 1]] + (pitch * (Util`pitchToRate`c1[[index + 1]] + (Util`pitchToRate`c2[[index + 1]] * pitch))))];
]

Util`cvToPitch[cv_] := 
   Return[(24. + (120. * cv))];


Util`cvToRaten`n1024`c0 = {};
Util`cvToRaten`n1024`c1 = {};
Util`cvToRaten`n1024`c2 = {};
Util`cvToRaten`n1024`raw`c0[index_] := 
   Return[Util`cvToRaten`n1024`c0[[index + 1]]];


Util`cvToRaten`n1024`raw`c1[index_] := 
   Return[Util`cvToRaten`n1024`c1[[index + 1]]];


Util`cvToRaten`n1024`raw`c2[index_] := 
   Return[Util`cvToRaten`n1024`c2[[index + 1]]];


Util`cvToRaten`n1024[cv_] := Module[{ index }, 
   index = Clip[Floor[(cv * 34.444444)], {0, 31}];
   Return[(Util`cvToRaten`n1024`c0[[index + 1]] + (cv * (Util`cvToRaten`n1024`c1[[index + 1]] + (Util`cvToRaten`n1024`c2[[index + 1]] * cv))))];
]

Util`cvToRate`c0 = {};
Util`cvToRate`c1 = {};
Util`cvToRate`c2 = {};
Util`cvToRate`raw`c0[index_] := 
   Return[Util`cvToRate`c0[[index + 1]]];


Util`cvToRate`raw`c1[index_] := 
   Return[Util`cvToRate`c1[[index + 1]]];


Util`cvToRate`raw`c2[index_] := 
   Return[Util`cvToRate`c2[[index + 1]]];


Util`cvToRate[cv_] := Module[{ index }, 
   index = Clip[Floor[(cv * 141.111111)], {0, 127}];
   Return[(Util`cvToRate`c0[[index + 1]] + (cv * (Util`cvToRate`c1[[index + 1]] + (Util`cvToRate`c2[[index + 1]] * cv))))];
]

Util`pitchToCv[pitch_] := 
   Return[(-0.2 + (0.008333 * pitch))];


Util`cvToperiod`c0 = {};
Util`cvToperiod`c1 = {};
Util`cvToperiod`c2 = {};
Util`cvToperiod`raw`c0[index_] := 
   Return[Util`cvToperiod`c0[[index + 1]]];


Util`cvToperiod`raw`c1[index_] := 
   Return[Util`cvToperiod`c1[[index + 1]]];


Util`cvToperiod`raw`c2[index_] := 
   Return[Util`cvToperiod`c2[[index + 1]]];


Util`cvToperiod[cv_] := Module[{ index }, 
   index = Clip[Floor[(cv * 31.)], {0, 31}];
   Return[(Util`cvToperiod`c0[[index + 1]] + (cv * (Util`cvToperiod`c1[[index + 1]] + (Util`cvToperiod`c2[[index + 1]] * cv))))];
]

Util`cvTokHz`c0 = {};
Util`cvTokHz`c1 = {};
Util`cvTokHz`c2 = {};
