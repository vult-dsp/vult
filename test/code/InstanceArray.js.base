
// Runtime functions (simple builtins like eps, pi, clip, real, int_, sin, cos, etc. are inlined)
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
this.InstanceArray_counter_type_alloc = function () {
   var _ctx = {};
   _ctx.total = 0.0;
   return _ctx;
};

this.InstanceArray_test1_type_alloc = function () {
   var i_0 = (0|0);
   var temp;
   var _ctx = {};
   while ((i_0 < (4|0))) {
      {
         temp[i_0] = this.InstanceArray_counter_type_alloc();
         i_0 = ((1|0) + i_0);
      }
   }
   _ctx.instances = temp;
   return _ctx;
};

this.InstanceArray_test2_type_alloc = function () {
   var _ctx = {};
   _ctx.case1 = this.InstanceArray_counter_type_alloc();
   _ctx.case2 = this.InstanceArray_counter_type_alloc();
   return _ctx;
};

this.InstanceArray_counter = function (_ctx) {
   _ctx.total = (1.0 + _ctx.total);
   return _ctx.total;
};

this.InstanceArray_test1 = function (_ctx) {
   var sum = 0.0;
   var i__1 = (0|0);
   while ((i__1 < (4|0))) {
      {
         sum = (sum + this.InstanceArray_counter(_ctx.instances[i__1]));
         i__1 = ((1|0) + i__1);
      }
   }
   return sum;
};

this.InstanceArray_test2 = function (_ctx) {
   this.InstanceArray_counter(_ctx.case1);
   this.InstanceArray_counter(_ctx.case2);
};

