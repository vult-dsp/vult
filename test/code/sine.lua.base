function Tables_nsine_raw_c2(index)
   return Tables_nsine_c[(((index * 3) + 2)) + 1]
end

function Tables_nsine(x)
   local value = (((x * 128.0)) > (128.0) and (128.0) or (((x * 128.0)) < (0.0) and (0.0) or ((x * 128.0))))
   local cell = ((math.floor(value)) > (127) and (127) or ((math.floor(value)) < (0) and (0) or (math.floor(value))))
   local u = (value - (cell))
   local index = (cell * 3)
   return (Tables_nsine_c[(index) + 1] + (u * (Tables_nsine_c[((index + 1)) + 1] + (Tables_nsine_c[((index + 2)) + 1] * u))))
end

function Sine_process(_ctx, cv, reset)
   if Util_edge(_ctx.inst_104ba, (reset > 0.5)) then
      _ctx.trig = true
   end
   local phase = Phase_process(_ctx.p, cv, 0.0)
   if ((phase < 1e-18) and _ctx.trig) then
      do
         _ctx.trig = false
         Phase_process(_ctx.p, cv, 0.0)
      end
   end
   return Tables_nsine(phase)
end

