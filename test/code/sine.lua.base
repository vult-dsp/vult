function Phase_process(_ctx, cv, reset)
   if Util_change(_ctx.inst_1b08a, cv) then
      _ctx.rate = Util_cvToRate_1024(cv)
   end
   if Util_edge(_ctx.inst_2048a, (reset > 0.5)) then
      _ctx.phase = 0.0
   else
      _ctx.phase = (_ctx.phase + _ctx.rate)
   end
   if (_ctx.phase > 1024.0) then
      _ctx.phase = (-1024.0 + _ctx.phase)
   else
      _ctx.phase = _ctx.phase
   end
   return (0.000976 * _ctx.phase)
end

function Phase_noteOn(_ctx, note, velocity, channel)
end

function Phase_noteOff(_ctx, note, channel)
end

function Phase_controlChange(_ctx, control, value, channel)
end

Tables_nsine_c0 = {};
Tables_nsine_c1 = {};
Tables_nsine_c2 = {};
function Tables_nsine_raw_c0(index)
   return Tables_nsine_c0[index + 1]
end

function Tables_nsine_raw_c1(index)
   return Tables_nsine_c1[index + 1]
end

function Tables_nsine_raw_c2(index)
   return Tables_nsine_c2[index + 1]
end

function Tables_nsine(x)
   local index = clip(math.floor((x * 127.0)), 0, 127)
   return (Tables_nsine_c0[index + 1] + (x * (Tables_nsine_c1[index + 1] + (Tables_nsine_c2[index + 1] * x))))
end

function Sine_process(_ctx, cv, reset)
   if Util_edge(_ctx.inst_104ba, (reset > 0.5)) then
      _ctx.trig = true
   end
   local phase = Phase_process(_ctx.p, cv, 0.0)
   if ((phase < eps()) and _ctx.trig) then
      do
         _ctx.trig = false
         Phase_process(_ctx.p, cv, 0.0)
      end
   end
   return Tables_nsine(phase)
end

function Sine_noteOn(_ctx, note, velocity, channel)
end

function Sine_noteOff(_ctx, note, channel)
end

function Sine_controlChange(_ctx, control, value, channel)
end

function Sine_default(_ctx)
end

