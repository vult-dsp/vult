function Util_cvToRate_1024(cv)
   local value = (((cv * 35.555555)) > (32.0) and (32.0) or (((cv * 35.555555)) < (0.0) and (0.0) or ((cv * 35.555555))))
   local cell = ((math.floor(value)) > (31) and (31) or ((math.floor(value)) < (0) and (0) or (math.floor(value))))
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_cvToRate_1024_c[(index) + 1] + (u * (Util_cvToRate_1024_c[((index + 1)) + 1] + (Util_cvToRate_1024_c[((index + 2)) + 1] * u))))
end

function Phase_default(_ctx)
   _ctx.rate = Util_cvToRate_1024(0.0)
end

function Phase_process_type_alloc()
   local _ctx = {};
   _ctx.inst_1b08a = Util_change_type_alloc()
   _ctx.inst_2048a = Util_edge_type_alloc()
   _ctx.phase = 0.0
   _ctx.rate = 0.0
   Phase_default(_ctx)
   return _ctx
end

function Phase_noteOn_type_alloc(_ctx)
   return Phase_process_type_alloc()
end

function Phase_noteOff_type_alloc(_ctx)
   return Phase_process_type_alloc()
end

