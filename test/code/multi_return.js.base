
// Runtime functions (simple builtins like eps, pi, clip, real, int_, sin, cos, etc. are inlined)
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
this.Multi_return_foo_type_alloc = function () {
   var _ctx = {};
   _ctx.Multi_return_foo_ret_0 = 0.0;
   _ctx.Multi_return_foo_ret_1 = 0.0;
   return _ctx;
};

this.Multi_return_bar_type_alloc = function () {
   var _ctx = {};
   _ctx.Multi_return_bar_ret_0 = 0.0;
   _ctx.Multi_return_bar_ret_1 = 0.0;
   _ctx.inst_16585 = this.Multi_return_foo_type_alloc();
   return _ctx;
};

this.Multi_return_foo = function (_ctx, x) {
   if ((x > (0|0))) {
      {
         _ctx.Multi_return_foo_ret_0 = 0.0;
         _ctx.Multi_return_foo_ret_1 = 0.0;
         return ;
      }
   } else {
      {
         _ctx.Multi_return_foo_ret_0 = 1.0;
         _ctx.Multi_return_foo_ret_1 = 1.0;
         return ;
      }
   }
};

this.Multi_return_bar = function (_ctx) {
   this.Multi_return_foo(_ctx.inst_16585, (1|0));
   var x = [ _ctx.inst_16585.Multi_return_foo_ret_0, _ctx.inst_16585.Multi_return_foo_ret_1 ];
   _ctx.Multi_return_bar_ret_0 = x[0];
   _ctx.Multi_return_bar_ret_1 = x[1];
   return ;
};

