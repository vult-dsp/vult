
// Runtime functions (simple builtins like eps, pi, clip, real, int_, sin, cos, etc. are inlined)
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
var Bitcrush_factor_c0 = {};
var Bitcrush_factor_c1 = {};
var Bitcrush_factor_c2 = {};
this.Bitcrush_factor_raw_c0 = function (index) {
   return Bitcrush_factor_c0[index];
};

this.Bitcrush_factor_raw_c1 = function (index) {
   return Bitcrush_factor_c1[index];
};

this.Bitcrush_factor_raw_c2 = function (index) {
   return Bitcrush_factor_c2[index];
};

this.Bitcrush_factor = function (cv) {
   var index = ((this.float_to_int((cv * 127.0))) < ((0|0)) ? ((0|0)) : ((this.float_to_int((cv * 127.0))) > ((127|0)) ? ((127|0)) : (this.float_to_int((cv * 127.0)))));
   return (Bitcrush_factor_c0[index] + (cv * (Bitcrush_factor_c1[index] + (Bitcrush_factor_c2[index] * cv))));
};

this.Bitcrush_process = function (i, cv) {
   var out = i;
   if ((cv == 0.0)) {
      out = i;
   } else {
      {
         var b = this.Bitcrush_factor(cv);
         var x = (((b * i))|0);
         out = ((x) / b);
      }
   }
   return out;
};

this.Bitcrush_noteOn = function (note, velocity, channel) {
};

this.Bitcrush_noteOff = function (note, channel) {
};

this.Bitcrush_controlChange = function (control, value, channel) {
};

this.Bitcrush_default = function () {
};

