
# High-performance Vult Runtime for Julia with typed arrays

mutable struct Record_literals_point
       x::Float32
       y::Float32
end

# Default constructor for Record_literals_point
function Record_literals_point()
    return Record_literals_point(Float32(0.0), Float32(0.0))
end

mutable struct Record_literals_ipoint
       x::Int32
       y::Int32
end

# Default constructor for Record_literals_ipoint
function Record_literals_ipoint()
    return Record_literals_ipoint(Int32(0), Int32(0))
end

mutable struct Record_literals_point3
       x::Float32
       y::Float32
       z::Float32
end

# Default constructor for Record_literals_point3
function Record_literals_point3()
    return Record_literals_point3(Float32(0.0), Float32(0.0), Float32(0.0))
end

mutable struct Record_literals_pair
       first::Record_literals_point
       second::Record_literals_point
end

# Default constructor for Record_literals_pair
function Record_literals_pair()
    return Record_literals_pair(Record_literals_point(), Record_literals_point())
end

function Record_literals_point_alloc()
   _ctx = Record_literals_point()
   _ctx.x = Float32(0.0)
   _ctx.y = Float32(0.0)
   return _ctx
end

function Record_literals_ipoint_alloc()
   _ctx = Record_literals_ipoint()
   _ctx.x = Int32(0)
   _ctx.y = Int32(0)
   return _ctx
end

function Record_literals_point3_alloc()
   _ctx = Record_literals_point3()
   _ctx.x = Float32(0.0)
   _ctx.y = Float32(0.0)
   _ctx.z = Float32(0.0)
   return _ctx
end

function Record_literals_pair_alloc()
   _ctx = Record_literals_pair()
   _ctx.first = Record_literals_point_alloc()
   _ctx.second = Record_literals_point_alloc()
   return _ctx
end

function Record_literals_norm(p)
   return ((p.x * p.x) + (p.y * p.y))
end

function Record_literals_make(a, b)
   _record_0 = (; x = a, y = b )
   return _record_0
end

function Record_literals_main()
   a = (; x = Float32(1.0), y = Float32(2.0) )
   b = (; x = Int32(3), y = Int32(4) )
   c = (; x = Float32(1.0), y = Float32(2.0), z = Float32(3.0) )
   d = (; first = (; x = Float32(5.0), y = Float32(0.0) ), second = a )
   e = Record_literals_make(Int32(10), Int32(20))
   total = (Record_literals_norm(a) + (c.z + (d.first.x + d.second.y)))
   return ((Int32(1000) * trunc(Int32, total)) + (b.x + (b.y + (e.x + e.y))))
end

