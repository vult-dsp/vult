function Synth2_default(_ctx)
   _ctx.volume = Float32(1.0)
   _ctx.pw = Float32(0.0)
   _ctx.pitch = Float32(42.0)
   _ctx.cut = Float32(1.0)
   _ctx.res = Float32(0.0)
   _ctx.amp_s = Float32(1.0)
   _ctx.lfo_amt = Float32(0.5)
   _ctx.lfo_rate = Float32(0.0)
end

