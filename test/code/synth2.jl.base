   _ctx.inst_4a7b7 = Synth2_svf_type_alloc()
   _ctx.lfo_amt = Float32(0.0)
   _ctx.lfo_rate = Float32(0.0)
   _ctx.monoin = Synth2_mono_noteOn_type_alloc()
   _ctx.pitch = Float32(0.0)
   _ctx.pw = Float32(0.0)
   _ctx.res = Float32(0.0)
   _ctx.volume = Float32(0.0)
   _ctx.wave = Float32(0.0)
   Synth2_default(_ctx)
   return _ctx
end

