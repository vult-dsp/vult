function Synth2_minFixed()
   return Float32(1.5e-05)
end

function Synth2_change(_ctx, x)
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v
end

function Synth2_bchange(_ctx, x)
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v
end

function Synth2_edge(_ctx, x)
   v = ((_ctx.pre_x != x) && (_ctx.pre_x == true))
   _ctx.pre_x = x
   return v
end

function Synth2_each(_ctx, n)
   ret = (_ctx.count == Int32(0))
   _ctx.count = ((Int32(1) + _ctx.count) % n)
   return ret
end

function Synth2_near_zero(x)
   return (abs(x) < Float32(0.02))
end

function Synth2_dcblock(_ctx, x0)
   y0 = (x0 + ((-_ctx.x1) + (Float32(0.995) * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0
end

function Synth2_smooth(_ctx, input)
   _ctx.x = ((Float32(0.005) * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Synth2_lpfilter(_ctx, x)
   ret = (Float32(0.5) * (x + _ctx.pre_x))
   _ctx.pre_x = x
   return ret
end

function Synth2_pitchToRate(d)
   return (Float32(0.000185) * exp((Float32(0.057762) * d)))
end

function Synth2_pulse_train(m, phase)
   pi_phase = (Float32(3.141592) * phase)
   denominator1 = sin(pi_phase)
   tmp1 = Float32(0.0)
   if Synth2_near_zero(denominator1)
      tmp1 = Float32(1.0)
   else
      begin
         tmp1 = sin((m * pi_phase))
         tmp1 = (tmp1 / (denominator1 * m))
      end
   end
   return tmp1
end

function Synth2_osc(_ctx, pitch, pw, wave)
   fixed_pitch = Float32(0.0)
   if (wave < Float32(0.666666))
      fixed_pitch = pitch
   else
      fixed_pitch = (Float32(12.0) + pitch)
   end
   if Synth2_change(_ctx.inst_177e5, fixed_pitch)
      begin
         _ctx.rate = Synth2_pitchToRate(fixed_pitch)
         p = (Float32(1.0) / _ctx.rate)
         maxHarmonics = floor((Float32(0.5) * p))
         _ctx.m = (Float32(1.0) + (Float32(2.0) * maxHarmonics))
      end
   end
   shift05 = (Float32(0.5) + (Float32(0.49) * pw))
   shift = (shift05 + _ctx.phase)
   if (shift > Float32(1.0))
      shift = (Float32(-1.0) + shift)
   end
   tmp1 = Synth2_pulse_train(_ctx.m, _ctx.phase)
   tmp2 = Synth2_pulse_train(_ctx.m, shift)
   _ctx.phase = (_ctx.phase + _ctx.rate)
   if (_ctx.phase > Float32(1.0))
      _ctx.phase = (Float32(-1.0) + _ctx.phase)
   end
   _ctx.state_pulse = clamp((tmp1 + ((-tmp2) + (Float32(0.9995) * _ctx.state_pulse))), Float32(-1.0), Float32(1.0))
   _ctx.state_saw = clamp(((Float32(0.5) * ((tmp1 + (tmp2 + (Float32(-2.0) * _ctx.rate))) / shift05)) + (Float32(0.9995) * _ctx.state_saw)), Float32(-1.0), Float32(1.0))
   _ctx.state_triang = clamp(((Float32(0.9995) * _ctx.state_triang) + (Float32(2.0) * (_ctx.state_pulse * _ctx.rate))), Float32(-1.0), Float32(1.0))
   if (wave < Float32(0.333333))
      _ctx.output = _ctx.state_pulse
   else
      if (wave < Float32(0.666666))
         _ctx.output = (Float32(2.0) * _ctx.state_saw)
      else
         _ctx.output = (Float32(2.0) * ((Float32(1.0) + pw) * _ctx.state_triang))
      end
   end
   _ctx.output = Synth2_dcblock(_ctx.inst_24fe5, _ctx.output)
   return clamp((Float32(0.25) * _ctx.output), Float32(-1.0), Float32(1.0))
end

function Synth2_svf_step(_ctx, input, g, q, sel)
   low = ((g * _ctx.dband) + _ctx.dlow)
   high = (input + ((-low) + (-(q * _ctx.dband))))
   band = ((g * high) + _ctx.dband)
   notch = (high + low)
   _ctx.dband = clamp(band, Float32(-1.0), Float32(1.0))
   _ctx.dlow = clamp(low, Float32(-1.0), Float32(1.0))
   output = Float32(0.0)
   if (sel == Int32(0))
      output = low
   else
      if (sel == Int32(1))
         output = high
      else
         if (sel == Int32(2))
            output = band
         else
            output = notch
         end
      end
   end
   return output
end

function Synth2_svf(_ctx, input, fc, q, sel)
   fc = clamp(fc, Float32(0.0), Float32(1.0))
   q = clamp(q, Float32(0.0), Float32(1.0))
   fix_q = (Float32(2.0) + (Float32(2.0) * (-q)))
   if Synth2_change(_ctx.inst_177a7, fc)
      _ctx.g = (Float32(0.5) * fc)
   end
   x1 = Synth2_svf_step(_ctx.step, input, _ctx.g, fix_q, sel)
   x2 = Synth2_svf_step(_ctx.step, input, _ctx.g, fix_q, sel)
   return (Float32(0.5) * (x1 + x2))
end

function Synth2_lfo(_ctx, f, gate)
   rate = ((Float32(100.0) * (f * Synth2_minFixed())) + Synth2_minFixed())
   if Synth2_edge(_ctx.inst_1445f, gate)
      _ctx.phase = Float32(0.0)
   end
   if Synth2_each(_ctx.inst_2cb5f, Int32(4))
      _ctx.phase = (rate + _ctx.phase)
   end
   if (_ctx.phase > Float32(1.0))
      _ctx.phase = (Float32(-1.0) + _ctx.phase)
   end
   return (Float32(0.5) + sin((Float32(6.283185) * _ctx.phase)))
end

function Synth2_mono_noteOn(_ctx, n)
   if (_ctx.count < Int32(4))
      begin
         @inbounds _ctx.notes[_ctx.count + 1] = n
         _ctx.pre = n
         if (_ctx.count < Int32(4))
            _ctx.count = (Int32(1) + _ctx.count)
         end
      end
   end
   return _ctx.pre
end

function Synth2_mono_noteOff(_ctx, n)
   found = false
   i = Int32(0)
   pos = Int32(0)
   if (_ctx.count == Int32(0))
      return _ctx.pre
   end
   while ((i < Int32(4)) && (found == false))
      begin
         if (@inbounds _ctx.notes[i + 1] == n)
            begin
               pos = i
               found = true
            end
         end
         i = (Int32(1) + i)
      end
   end
   if found
      begin
         k = (Int32(1) + pos)
         while (k < Int32(4))
            begin
               @inbounds _ctx.notes[(Int32(-1) + k) + 1] = @inbounds _ctx.notes[k + 1]
               k = (Int32(1) + k)
            end
         end
         if (found && (_ctx.count > Int32(0)))
            begin
               _ctx.count = (Int32(-1) + _ctx.count)
               _ctx.pre = @inbounds _ctx.notes[(Int32(-1) + _ctx.count) + 1]
            end
         end
      end
   end
   return _ctx.pre
end

function Synth2_mono_isGateOn(_ctx)
   return (_ctx.count > Int32(0))
end

function Synth2_process(_ctx, i)
   gate = Synth2_mono_isGateOn(_ctx.monoin)
   lfo1 = (Synth2_lfo(_ctx.inst_15fb7, _ctx.lfo_rate, gate) * _ctx.lfo_amt)
   o1 = Synth2_osc(_ctx.inst_2e5b7, _ctx.pitch, (lfo1 + _ctx.pw), _ctx.wave)
   amp_env = Synth2_smooth(_ctx.inst_3dfb7, (gate ? Float32(1.0) : Float32(0.0)))
   output = (amp_env * Synth2_svf(_ctx.inst_4a7b7, o1, _ctx.cut, _ctx.res, Int32(0)))
   return (output * _ctx.volume)
end

function Synth2_noteOn(_ctx, note, velocity, channel)
   _ctx.pitch = Float32(Synth2_mono_noteOn(_ctx.monoin, note))
end

function Synth2_noteOff(_ctx, note, channel)
   _ctx.pitch = Float32(Synth2_mono_noteOff(_ctx.monoin, note))
end

function Synth2_controlChange(_ctx, control, value, channel)
   value_0_1 = (Float32(0.007874) * Float32(value))
   value_m1_1 = (Float32(-1.0) + (Float32(2.0) * value_0_1))
   if (control == Int32(30))
      _ctx.volume = value_0_1
   end
   if (control == Int32(31))
      _ctx.wave = value_0_1
   end
   if (control == Int32(32))
      _ctx.pw = value_0_1
   end
   if (control == Int32(33))
      _ctx.lfo_rate = value_0_1
   end
   if (control == Int32(34))
      _ctx.lfo_amt = value_m1_1
   end
   if (control == Int32(35))
      _ctx.cut = value_0_1
   end
   if (control == Int32(36))
      _ctx.res = value_0_1
   end
end

