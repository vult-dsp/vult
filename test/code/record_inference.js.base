this.Record_inference_point_alloc = function () {
   var _ctx = {};
   _ctx.x = 0.0;
   _ctx.y = 0.0;
   return _ctx;
};

this.Record_inference_point3_alloc = function () {
   var _ctx = {};
   _ctx.x = 0.0;
   _ctx.y = 0.0;
   _ctx.z = 0.0;
   return _ctx;
};

this.Record_inference_counter_alloc = function () {
   var _ctx = {};
   _ctx.count = (0|0);
   _ctx.step = (0|0);
   return _ctx;
};

this.Record_inference_icounter_alloc = function () {
   var _ctx = {};
   _ctx.count = (0|0);
   return _ctx;
};

this.Record_inference_rcounter_alloc = function () {
   var _ctx = {};
   _ctx.count = 0.0;
   return _ctx;
};

this.Record_inference_length3 = function (p) {
   return (p.x + (p.y + p.z));
};

this.Record_inference_sum2 = function (p) {
   return (p.x + p.y);
};

this.Record_inference_half = function (c) {
   return (0.5 * c.count);
};

this.Record_inference_advance = function (c) {
   c.count = (c.count + c.step);
   return c.count;
};

this.Record_inference_first = function (p) {
   var q = p;
   return q.x;
};

this.Record_inference_main = function () {
   var a = { x: 1.0, y: 2.0, z: 3.0 };
   var b = { x: 10.0, y: 20.0 };
   var c = { count: 9.0 };
   var d = { count: (1|0), step: (4|0) };
   var total = (this.Record_inference_first(b) + (this.Record_inference_half(c) + (this.Record_inference_length3(a) + this.Record_inference_sum2(b))));
   var advanced = this.Record_inference_advance(d);
   return (advanced + ((100|0) * ((total)|0)));
};

