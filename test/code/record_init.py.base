import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

class Record_init_point:
    __slots__ = ['x', 'y']
    def __init__(self, x=0.0, y=0.0):
        self.x = x
        self.y = y

def Record_init_point_alloc():
   _ctx = Record_init_point()
   _ctx.x = 0.0
   _ctx.y = 0.0
   return _ctx


def Record_init_foo():
   _record_0 = Record_init_point(x=0.0, y=0.0)
   p1 = _record_0.x


