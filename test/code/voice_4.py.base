def Blit_pulse_train(_ctx, cv, phase):
   if Util_change(_ctx["inst_1b05e"], cv):
      _ctx["m"] = (1 + (int(Util_cvToperiod(cv)) << 1))
      _ctx["scale"] = (2.0 * Util_cvToperiod(cv))

   pi_phase = (0.5 * phase)
   denominator = Tables_nsine(pi_phase)
   out = 0.0
   if (denominator <= eps()):
      out = 1.0
   else:
      m_phase = ((pi_phase * real(_ctx["m"])) % 1.0)
      numerator = Tables_nsine(m_phase)
      out = (numerator / (denominator * _ctx["scale"]))

   return out


def Blit_osc_blit(_ctx, cv, pw, wave):
   fixed_cv = 0.0
   if (wave < 1.0):
      fixed_cv = cv
   else:
