def Adsr_do(_ctx, gate, a, d, s, r):
   a_rate = (1.0 / (0.01 + (100.0 * a)))
   d_rate = (1.0 / (0.01 + (100.0 * d)))
   r_rate = (1.0 / (0.01 + (100.0 * r)))
   _ctx["out"] = ((0.004 * (((-_ctx["out"]) + _ctx["target"]) * _ctx["rate"])) + _ctx["out"])
   bgate = (gate > 0.0)
   if (_ctx["state"] == 0):
      if Util_edge(_ctx["inst_104a0"], bgate):
         _ctx["state"] = 1
         _ctx["scale"] = (0.2 * gate)

      _ctx["rate"] = r_rate
      _ctx["target"] = 0.0

   if (_ctx["state"] == 1):
      if (bgate == False):
         _ctx["state"] = 0
      if (_ctx["out"] > 1024.0):
         _ctx["state"] = 2
      _ctx["rate"] = a_rate
      _ctx["target"] = 1228.8

   if (_ctx["state"] == 2):
      if (bgate == False):
         _ctx["state"] = 0
      _ctx["rate"] = d_rate
      _ctx["target"] = (1024.0 * s)

   return (Util_smooth(_ctx["inst_295a0"], _ctx["scale"]) * clip((0.000976 * _ctx["out"]), 0.0, 1.0))


