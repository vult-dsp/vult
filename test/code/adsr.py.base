def Adsr_do(_ctx, gate, a, d, s, r):
   a_rate = (1.0 / (0.01 + (100.0 * a)))
   d_rate = (1.0 / (0.01 + (100.0 * d)))
   r_rate = (1.0 / (0.01 + (100.0 * r)))
   _ctx.out = ((0.004 * (((-_ctx.out) + _ctx.target) * _ctx.rate)) + _ctx.out)
   bgate = (gate > 0.0)
   if (_ctx.state == 0):
      if Util_edge(_ctx.inst_104a0, bgate):
         _ctx.state = 1
         _ctx.scale = (0.2 * gate)

      _ctx.rate = r_rate
      _ctx.target = 0.0

   if (_ctx.state == 1):
      if (bgate == False):
         _ctx.state = 0
      if (_ctx.out > 1024.0):
         _ctx.state = 2
      _ctx.rate = a_rate
      _ctx.target = 1228.8

   if (_ctx.state == 2):
      if (bgate == False):
         _ctx.state = 0
      _ctx.rate = d_rate
      _ctx.target = (1024.0 * s)

   return (Util_smooth(_ctx.inst_295a0, _ctx.scale) * ((0.0) if ((0.000976 * _ctx.out)) < (0.0) else ((1.0) if ((0.000976 * _ctx.out)) > (1.0) else ((0.000976 * _ctx.out)))))


def Adsr_process(_ctx, gate):
   return Adsr_do(_ctx.inst_1a025, gate, _ctx.knob1, _ctx.knob2, _ctx.knob3, _ctx.knob4)

def Adsr_noteOn(_ctx, note, velocity, channel):
   pass

def Adsr_noteOff(_ctx, note, channel):
   pass

def Adsr_controlChange(_ctx, control, value, channel):
   if (control == 1):
      _ctx.knob1 = (0.007874 * float(value))
   if (control == 2):
      _ctx.knob2 = (0.007874 * float(value))
   if (control == 3):
      _ctx.knob3 = (0.007874 * float(value))
   if (control == 4):
      _ctx.knob4 = (0.007874 * float(value))


def Adsr_default(_ctx):
   _ctx.knob1 = 0.0
   _ctx.knob2 = 0.5
   _ctx.knob3 = 1.0
   _ctx.knob4 = 0.5


