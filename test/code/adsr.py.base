import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

class Util_edge_type:
    __slots__ = ['pre']
    def __init__(self, pre=False):
        self.pre = pre

class Util_change_type:
    __slots__ = ['pre_x']
    def __init__(self, pre_x=0.0):
        self.pre_x = pre_x

class Util_dcblock_type:
    __slots__ = ['x1', 'y1']
    def __init__(self, x1=0.0, y1=0.0):
        self.x1 = x1
        self.y1 = y1

class Util_smooth_type:
    __slots__ = ['x']
    def __init__(self, x=0.0):
        self.x = x

class Util_average2_type:
    __slots__ = ['x0']
    def __init__(self, x0=0.0):
        self.x0 = x0

class Adsr_do_type:
    __slots__ = ['inst_104a0', 'inst_295a0', 'out', 'rate', 'scale', 'state', 'target']
    def __init__(self, inst_104a0=Util_edge_type(), inst_295a0=Util_smooth_type(), out=0.0, rate=0.0, scale=0.0, state=0, target=0.0):
        self.inst_104a0 = inst_104a0
        self.inst_295a0 = inst_295a0
        self.out = out
        self.rate = rate
        self.scale = scale
        self.state = state
        self.target = target

class Adsr_process_type:
    __slots__ = ['inst_1a025', 'knob1', 'knob2', 'knob3', 'knob4']
    def __init__(self, inst_1a025=Adsr_do_type(), knob1=0.0, knob2=0.0, knob3=0.0, knob4=0.0):
        self.inst_1a025 = inst_1a025
        self.knob1 = knob1
        self.knob2 = knob2
        self.knob3 = knob3
        self.knob4 = knob4

