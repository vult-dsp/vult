def Adsr_do_type_alloc():
   _ctx = Adsr_do_type()
   _ctx.inst_104a0 = Util_edge_type_alloc()
   _ctx.inst_295a0 = Util_smooth_type_alloc()
   _ctx.out = 0.0
   _ctx.rate = 0.0
   _ctx.scale = 0.0
   _ctx.state = 0
   _ctx.target = 0.0
   return _ctx


