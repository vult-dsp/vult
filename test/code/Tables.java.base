   return Tables_sineTable2_c[(index * 2)];
}

private float Tables_sineTable2_raw_c1(int index) {
   return Tables_sineTable2_c[((index * 2) + 1)];
}

private float Tables_sineTable2(float x) {
   int cell = clip(float_to_int((x * 32.0f)), 0, 31);
   int index = (cell * 2);
   return (Tables_sineTable2_c[index] + ((x - 0.5f) * Tables_sineTable2_c[(index + 1)]));
}

