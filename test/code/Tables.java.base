}

private float Tables_sineTable3(float x) {
   int cell = clip(float_to_int((x * 32.0f)), 0, 31);
   int index = (cell * 2);
   return (Tables_sineTable3_c[index] + ((x - 0.5f) * Tables_sineTable3_c[(index + 1)]));
}

public static final float[] Tables_power2_table = new float[]{0.0625f, 0.125f, 0.25f, 0.5f, 1.0f, 2.0f, 4.0f, 8.0f, 16.0f};
private float Tables_power2(int x) {
   return Tables_power2_table[(int_clip(x, -4, 4) + 4)];
}

public static final int[] Tables_square_table = new int[]{16, 9, 4, 1, 0, 1, 4, 9, 16};
private int Tables_square(int x) {
   return Tables_square_table[(int_clip(x, -4, 4) + 4)];
}

public static final short[] Tables_square16_table = new short[]{16, 9, 4, 1, 0, 1, 4, 9, 16};
private short Tables_square16(short x) {
