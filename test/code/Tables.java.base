private int Tables_sineTable3(int x) {
   int value = clip((x * 0x200000 /* 32.000000 */), 0x0 /* 0.000000 */, 0x200000 /* 32.000000 */);
   int index = (int)(value);
   int decimal = (value - floor(value));
   return (Tables_sineTable3_c0[index] + (Tables_sineTable3_c1[index] * decimal));
