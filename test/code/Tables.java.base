private float Tables_sineTable1(float x) {
   float value = clip((x * 32.0f), 0.0f, 32.0f);
   int cell = clip(float_to_int(value), 0, 31);
   float u = (value - (float)(cell));
   int index = (cell * 3);
   return (Tables_sineTable1_c[index] + (u * (Tables_sineTable1_c[(index + 1)] + (Tables_sineTable1_c[(index + 2)] * u))));
}

