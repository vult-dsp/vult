def Rescomb_delay_type_alloc():
   i_0 = 0
   temp_1 = initializeArray(0.0, 675)
   _ctx = Rescomb_delay_type()
   while (i_0 < 675):
      temp_1[i_0] = 0.0
      i_0 = (1 + i_0)

   _ctx.buffer = temp_1
   _ctx.write_pos = 0
   return _ctx


def Rescomb_do_type_alloc():
   _ctx = Rescomb_do_type()
   _ctx.inst_1b000 = Util_change_type_alloc()
   _ctx.inst_26400 = Util_dcblock_type_alloc()
   _ctx.inst_3a900 = Rescomb_delay_type_alloc()
   _ctx.output = 0.0
   _ctx.stone = 0.0
   return _ctx


def Rescomb_process_type_alloc():
   _ctx = Rescomb_process_type()
   _ctx.inst_100b6 = Rescomb_do_type_alloc()
   return _ctx


def Rescomb_noteOn_type_alloc(_ctx):
   return Rescomb_process_type_alloc()

def Rescomb_noteOff_type_alloc(_ctx):
