def Rescomb_toneCurve(tone):
   value = ((0.0) if (((tone + 1.2) * 26.666666)) < (0.0) else ((64.0) if (((tone + 1.2) * 26.666666)) > (64.0) else (((tone + 1.2) * 26.666666))))
   cell = ((0) if (float_to_int(value)) < (0) else ((63) if (float_to_int(value)) > (63) else (float_to_int(value))))
   u = (value - float(cell))
   index = (cell * 3)
   return (Rescomb_toneCurve_c[index] + (u * (Rescomb_toneCurve_c[(index + 1)] + (Rescomb_toneCurve_c[(index + 2)] * u))))


def Rescomb_do(_ctx, in_, cv, tone, res):
   if Util_change(_ctx.inst_1b000, tone):
      _ctx.stone = Rescomb_toneCurve(tone)
   feedback = Util_dcblock(_ctx.inst_26400, (res * _ctx.output))
   saturated_input = Saturate_soft_process((feedback + in_))
   _ctx.output = (in_ + (Rescomb_delay(_ctx.inst_3a900, saturated_input, cv) * _ctx.stone))
   return Saturate_soft_process(_ctx.output)


def Rescomb_process(_ctx, in_, cv, tone, res):
   return Rescomb_do(_ctx.inst_100b6, in_, cv, tone, res)

