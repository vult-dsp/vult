def Rescomb_delay(_ctx, x, cv):
   _ctx["write_pos"] = ((1 + _ctx["write_pos"]) % 675)
   _ctx["buffer"][_ctx["write_pos"]] = x
   r_size = 675.0
   r_index = (((-Util_cvToperiod(cv)) + real(_ctx["write_pos"])) % r_size)
   if (r_index < 0.0):
      r_index = (r_index + r_size)
   t1 = (int(math.floor(r_index)) % 675)
   t2 = ((1 + t1) % 675)
   decimal = (r_index + (-real(t1)))
   x1 = _ctx["buffer"][t1]
   x2 = _ctx["buffer"][t2]
   ret = (x1 + (decimal * (x2 + (-x1))))
   return ret


Rescomb_toneCurve_c0 = {}
Rescomb_toneCurve_c1 = {}
