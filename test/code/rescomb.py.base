import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

class Util_edge_type:
    __slots__ = ['pre']
    def __init__(self, pre=False):
        self.pre = pre

class Util_change_type:
    __slots__ = ['pre_x']
    def __init__(self, pre_x=0.0):
        self.pre_x = pre_x

class Util_dcblock_type:
    __slots__ = ['x1', 'y1']
    def __init__(self, x1=0.0, y1=0.0):
        self.x1 = x1
        self.y1 = y1

class Util_smooth_type:
    __slots__ = ['x']
    def __init__(self, x=0.0):
        self.x = x

class Util_average2_type:
    __slots__ = ['x0']
    def __init__(self, x0=0.0):
        self.x0 = x0

class Rescomb_delay_type:
    __slots__ = ['buffer', 'write_pos']
    def __init__(self, buffer=[0.0] * 675, write_pos=0):
        self.buffer = buffer
        self.write_pos = write_pos

class Rescomb_do_type:
    __slots__ = ['inst_1b000', 'inst_26400', 'inst_3a900', 'output', 'stone']
    def __init__(self, inst_1b000=Util_change_type(), inst_26400=Util_dcblock_type(), inst_3a900=Rescomb_delay_type(), output=0.0, stone=0.0):
        self.inst_1b000 = inst_1b000
        self.inst_26400 = inst_26400
        self.inst_3a900 = inst_3a900
        self.output = output
        self.stone = stone

class Rescomb_process_type:
    __slots__ = ['inst_100b6']
    def __init__(self, inst_100b6=Rescomb_do_type()):
        self.inst_100b6 = inst_100b6

def Util_edge_type_alloc():
   _ctx = Util_edge_type()
   _ctx.pre = False
   return _ctx


def Util_change_type_alloc():
   _ctx = Util_change_type()
   _ctx.pre_x = 0.0
