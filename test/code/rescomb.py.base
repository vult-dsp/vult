import math
import random as random_module

def eps():
    return 1e-18

def pi():
    return 3.1415926535897932384

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def clip(x, low, high):
    return low if x < low else (high if x > high else x)

def not_(x):
    return 0 if x != 0 else 1

def real(x):
    return float(x)

def int_(x):
    return int(x)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

def Util_edge_type_alloc():
   _ctx = {}
   _ctx["pre"] = False
   return _ctx


def Util_change_type_alloc():
   _ctx = {}
   _ctx["pre_x"] = 0.0
   return _ctx


def Util_dcblock_type_alloc():
   _ctx = {}
   _ctx["x1"] = 0.0
   _ctx["y1"] = 0.0
   return _ctx


def Util_smooth_type_alloc():
   _ctx = {}
   _ctx["x"] = 0.0
   return _ctx


def Util_average2_type_alloc():
   _ctx = {}
   _ctx["x0"] = 0.0
   return _ctx


def Rescomb_delay_type_alloc():
   i_0 = 0
   temp = initializeArray(0.0, 675)
   _ctx = {}
   while (i_0 < 675):
      temp[i_0] = 0.0
      i_0 = (1 + i_0)

   _ctx["buffer"] = temp
   _ctx["write_pos"] = 0
   return _ctx


def Rescomb_do_type_alloc():
   _ctx = {}
   _ctx["inst_1b000"] = Util_change_type_alloc()
   _ctx["inst_26400"] = Util_dcblock_type_alloc()
   _ctx["inst_3a900"] = Rescomb_delay_type_alloc()
   _ctx["output"] = 0.0
   _ctx["stone"] = 0.0
   return _ctx


def Rescomb_process_type_alloc():
   _ctx = {}
   _ctx["inst_100b6"] = Rescomb_do_type_alloc()
   return _ctx


