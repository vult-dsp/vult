def Util_cvToRate(cv):
   index = ((0) if (float_to_int((cv * 141.111111))) < (0) else ((127) if (float_to_int((cv * 141.111111))) > (127) else (float_to_int((cv * 141.111111)))))
   return (Util_cvToRate_c0[index] + (cv * (Util_cvToRate_c1[index] + (Util_cvToRate_c2[index] * cv))))


