def Polycv_velToCV(vel):
   return (0.007874 * float(vel))

def Polycv_velToGate(vel):
   if (vel > 0):
      return (0.007874 * float(vel))
   else:
      return 0.0

def Polycv_poly_noteOn(_ctx, note, velocity):
   i = 0
   found = False
   while ((i < 4) and (found == False)):
      if (_ctx["vel"][i] == 0):
         _ctx["notes"][i] = note
         _ctx["vel"][i] = velocity
         found = True

      i = (1 + i)



def Polycv_poly_noteOff(_ctx, note):
   i = 0
   found = False
   while ((i < 4) and (found == False)):
      if (_ctx["notes"][i] == note):
         _ctx["vel"][i] = 0
         found = True

      i = (1 + i)



def Polycv_polyState(_ctx):
   note1 = Util_pitchToCv(float(_ctx["notes"][0]))
   note2 = Util_pitchToCv(float(_ctx["notes"][1]))
   note3 = Util_pitchToCv(float(_ctx["notes"][2]))
   note4 = Util_pitchToCv(float(_ctx["notes"][3]))
   vel1 = Polycv_velToCV(_ctx["vel"][0])
   vel2 = Polycv_velToCV(_ctx["vel"][1])
   vel3 = Polycv_velToCV(_ctx["vel"][2])
   vel4 = Polycv_velToCV(_ctx["vel"][3])
   gate1 = Polycv_velToGate(_ctx["vel"][0])
   gate2 = Polycv_velToGate(_ctx["vel"][1])
   gate3 = Polycv_velToGate(_ctx["vel"][2])
   gate4 = Polycv_velToGate(_ctx["vel"][3])
   _ctx["Polycv_polyState_ret_0"] = note1
   _ctx["Polycv_polyState_ret_1"] = vel1
   _ctx["Polycv_polyState_ret_2"] = gate1
   _ctx["Polycv_polyState_ret_3"] = note2
   _ctx["Polycv_polyState_ret_4"] = vel2
   _ctx["Polycv_polyState_ret_5"] = gate2
   _ctx["Polycv_polyState_ret_6"] = note3
   _ctx["Polycv_polyState_ret_7"] = vel3
   _ctx["Polycv_polyState_ret_8"] = gate3
   _ctx["Polycv_polyState_ret_9"] = note4
   _ctx["Polycv_polyState_ret_10"] = vel4
   _ctx["Polycv_polyState_ret_11"] = gate4
   return None


def Polycv_process(_ctx, c):
   _ctx["channel_in"] = c
   _ = Polycv_polyState(_ctx["poly"])
   _call_temp_0 = _ctx["poly"]["Polycv_polyState_ret_0"]
   _call_temp_1 = _ctx["poly"]["Polycv_polyState_ret_1"]
   _call_temp_2 = _ctx["poly"]["Polycv_polyState_ret_2"]
   _call_temp_3 = _ctx["poly"]["Polycv_polyState_ret_3"]
   _call_temp_4 = _ctx["poly"]["Polycv_polyState_ret_4"]
   _call_temp_5 = _ctx["poly"]["Polycv_polyState_ret_5"]
   _call_temp_6 = _ctx["poly"]["Polycv_polyState_ret_6"]
   _call_temp_7 = _ctx["poly"]["Polycv_polyState_ret_7"]
   _call_temp_8 = _ctx["poly"]["Polycv_polyState_ret_8"]
   _call_temp_9 = _ctx["poly"]["Polycv_polyState_ret_9"]
   _call_temp_10 = _ctx["poly"]["Polycv_polyState_ret_10"]
   _call_temp_11 = _ctx["poly"]["Polycv_polyState_ret_11"]
   _ctx["Polycv_process_ret_0"] = _call_temp_0
   _ctx["Polycv_process_ret_1"] = _call_temp_1
   _ctx["Polycv_process_ret_2"] = _call_temp_2
   _ctx["Polycv_process_ret_3"] = _call_temp_3
   _ctx["Polycv_process_ret_4"] = _call_temp_4
   _ctx["Polycv_process_ret_5"] = _call_temp_5
   _ctx["Polycv_process_ret_6"] = _call_temp_6
   _ctx["Polycv_process_ret_7"] = _call_temp_7
   _ctx["Polycv_process_ret_8"] = _call_temp_8
   _ctx["Polycv_process_ret_9"] = _call_temp_9
   _ctx["Polycv_process_ret_10"] = _call_temp_10
   _ctx["Polycv_process_ret_11"] = _call_temp_11
   return None


def Polycv_noteOn(_ctx, note, velocity, channel):
   if (_ctx["channel_in"] == channel):
      if (velocity > 0):
         _ = Polycv_poly_noteOn(_ctx["poly"], note, velocity)
      else:
         _ = Polycv_poly_noteOff(_ctx["poly"], note)

def Polycv_noteOff(_ctx, note, channel):
   if (_ctx["channel_in"] == channel):
      _ = Polycv_poly_noteOff(_ctx["poly"], note)

def Polycv_controlChange(_ctx, control, value, channel):
   pass

def Polycv_default(_ctx):
   pass

