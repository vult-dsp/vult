def Util_pitchToRate(pitch):
   index = ((0) if (float_to_int((pitch * 0.244094))) < (0) else ((31) if (float_to_int((pitch * 0.244094))) > (31) else (float_to_int((pitch * 0.244094)))))
   return (Util_pitchToRate_c0[index] + (pitch * (Util_pitchToRate_c1[index] + (Util_pitchToRate_c2[index] * pitch))))


def Util_cvToPitch(cv):
   return (24.0 + (120.0 * cv))

