   _ctx = {}
   _ctx["x"] = 0.0
   return _ctx


def Util_average2_type_alloc():
   _ctx = {}
   _ctx["x0"] = 0.0
   return _ctx


def Polycv_poly_noteOn_type_alloc():
   _ctx = {}
   _ctx["Polycv_polyState_ret_0"] = 0.0
   _ctx["Polycv_polyState_ret_1"] = 0.0
   _ctx["Polycv_polyState_ret_10"] = 0.0
   _ctx["Polycv_polyState_ret_11"] = 0.0
   _ctx["Polycv_polyState_ret_2"] = 0.0
   _ctx["Polycv_polyState_ret_3"] = 0.0
   _ctx["Polycv_polyState_ret_4"] = 0.0
   _ctx["Polycv_polyState_ret_5"] = 0.0
   _ctx["Polycv_polyState_ret_6"] = 0.0
   _ctx["Polycv_polyState_ret_7"] = 0.0
   _ctx["Polycv_polyState_ret_8"] = 0.0
   _ctx["Polycv_polyState_ret_9"] = 0.0
   i_0 = 0
   temp = initializeArray(0, 4)
   while (i_0 < 4):
      temp[i_0] = 0
      i_0 = (1 + i_0)

   _ctx["notes"] = temp
   i_1 = 0
   temp = initializeArray(0, 4)
   while (i_1 < 4):
      temp[i_1] = 0
      i_1 = (1 + i_1)

   _ctx["vel"] = temp
   return _ctx


