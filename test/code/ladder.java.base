private boolean Util_edge(Util_edge_type _ctx, boolean x) {
   boolean ret = (x && (_ctx.pre == false));
   _ctx.pre = x;
   return ret;
}

private boolean Util_change(Util_change_type _ctx, float x) {
   boolean v = (_ctx.pre_x != x);
   _ctx.pre_x = x;
   return v;
}

private float Util_map(float x, float x0, float x1, float y0, float y1) {
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))));
}

private float Util_dcblock(Util_dcblock_type _ctx, float x0) {
   float y0 = (x0 + ((-_ctx.x1) + (0.995f * _ctx.y1)));
   _ctx.x1 = x0;
   _ctx.y1 = y0;
   return y0;
}

private float Util_smooth(Util_smooth_type _ctx, float input) {
   _ctx.x = ((0.005f * (input + (-_ctx.x))) + _ctx.x);
   return _ctx.x;
}

private float Util_average2(Util_average2_type _ctx, float x1) {
   float result = (0.5f * (x1 + _ctx.x0));
   _ctx.x0 = x1;
   return result;
}

private float Util_cubic_clipper(float x) {
   if ((x <= -0.666667f)) {
      return -0.666667f;
   } else {
      if ((x >= 0.666666f)) {
         return 0.666666f;
      } else {
         return (x + (-0.333334f * (x * (x * x))));
      }
   }
}

