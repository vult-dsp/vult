
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.eps  = function()           { return 1e-18 };
this.pi   = function()           { return 3.1415926535897932384; }
this.clip = function(x,low,high) { return x<low?low:(x>high?high:x); };
this.not  = function(x)          { return x==0?1:0; };
this.real = function(x)          { return x; };
this.int_  = function(x)         { return x|0; };
this.sin  = function(x)          { return Math.sin(x); };
this.cos  = function(x)          { return Math.cos(x); };
this.abs  = function(x)          { return Math.abs(x); };
this.exp  = function(x)          { return Math.exp(x); };
this.floor = function(x)          { return Math.floor(x); };
this.tan  = function(x)          { return Math.tan(x); };
this.tanh = function(x)          { return Math.tanh(x); };
this.pow  = function(a,b)         { return Math.pow(a,b); };
this.sqrt = function(x)          { return x; };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
this.Defined_types_dot_alloc = function () {
   var _ctx = {};
   _ctx.x = 0.0;
   _ctx.y = 0.0;
   return _ctx;
};

this.Defined_types_foo_type_alloc = function () {
   var _ctx = {};
   _ctx.p1 = this.Defined_types_dot_alloc();
   return _ctx;
};

this.Defined_types_process_type_alloc = function () {
   var _ctx = {};
   _ctx.inst_1a5d1 = this.Defined_types_foo_type_alloc();
   return _ctx;
};

this.Defined_types_noteOn_type_alloc = function (_ctx) {
   return this.Defined_types_process_type_alloc();
};

this.Defined_types_noteOff_type_alloc = function (_ctx) {
   return this.Defined_types_process_type_alloc();
};

this.Defined_types_controlChange_type_alloc = function (_ctx) {
   return this.Defined_types_process_type_alloc();
};

this.Defined_types_default_type_alloc = function (_ctx) {
   return this.Defined_types_process_type_alloc();
};

this.Defined_types_micro_alloc = function () {
   var _ctx = {};
   _ctx.dot_0 = this.Defined_types_dot_alloc();
   _ctx.dot_1 = this.Defined_types_dot_alloc();
   return _ctx;
};

this.Defined_types_foo = function (_ctx) {
};

this.Defined_types_process = function (_ctx, input) {
   this.Defined_types_foo(_ctx.inst_1a5d1);
   return input;
};

this.Defined_types_noteOn = function (_ctx, note, velocity, channel) {
};

this.Defined_types_noteOff = function (_ctx, note, channel) {
};

this.Defined_types_controlChange = function (_ctx, control, value, channel) {
};

this.Defined_types_default = function (_ctx) {
};

