function ConstSpecialization_accumulate_real_real_2(_ctx, x)
   _ctx.sum = ((Float32(2.0) * x) + _ctx.sum)
   return _ctx.sum
end

function ConstSpecialization_accumulate_real_dyn_real(_ctx, scale, x)
   _ctx.sum = ((scale * x) + _ctx.sum)
   return _ctx.sum
end

