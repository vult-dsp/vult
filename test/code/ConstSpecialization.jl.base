function ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_0(m, value)
   @inbounds m[1] = value
end

function ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_1(m, value)
   @inbounds m[2] = value
end

function ConstSpecialization_test_array_mutation(m, x)
   ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_0(m, @inbounds x[1])
   ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_1(m, @inbounds x[2])
end

function ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_0(m, value)
   @inbounds m[1] = value
end

function ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_1(m, value)
   @inbounds m[3] = value
end

function ConstSpecialization_setMatrix2_array_of_real_size_4_real_dyn_int_int(m, row, col, value)
   @inbounds m[(row + (col * 2)) + 1] = value
end

function ConstSpecialization_getMatrix2_array_of_real_size_4_dyn_int_int(m, row, col)
   return @inbounds m[(row + (col * 2)) + 1]
end

function ConstSpecialization_test_matrix_mutation(m, x)
   ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_0(m, @inbounds x[1])
   ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_1(m, @inbounds x[2])
end

function ConstSpecialization_eliminate_row(m, row, col)
   k = ConstSpecialization_getMatrix2_array_of_real_size_4_dyn_int_int(m, row, col)
   ConstSpecialization_setMatrix2_array_of_real_size_4_real_dyn_int_int(m, row, col, (Float32(1.0) + k))
end

function ConstSpecialization_process_matrix(m)
   row = Int32(0)
   while (row < Int32(2))
      begin
         ConstSpecialization_eliminate_row(m, row, Int32(0))
         row = (Int32(1) + row)
      end
   end
end

function ConstSpecialization_main(_ctx)
   ConstSpecialization_test_accumulate_spec(_ctx.inst_13dfa)
   ConstSpecialization_test_accumulate_nonspec(_ctx.inst_201fa, Float32(3.0), Float32(4.0))
   ConstSpecialization_test_typed_int(_ctx.inst_3e2fa)
   ConstSpecialization_test_typed_real(_ctx.inst_477fa)
   inputs = fill(Float32(0.0), Int32(2))
   @inbounds inputs[1] = Float32(1.0)
   @inbounds inputs[2] = Float32(2.0)
   arr = fill(Float32(0.0), Int32(4))
   ConstSpecialization_test_array_mutation(arr, inputs)
   ConstSpecialization_test_matrix_mutation(arr, inputs)
   ConstSpecialization_process_matrix(arr)
end

