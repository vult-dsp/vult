

function Volume_smooth_type_alloc()
   local _ctx = {};
   _ctx.x = 0.0
   return _ctx
end

function Volume_process_type_alloc()
   local _ctx = {};
   _ctx.inst_1d7d3 = Volume_smooth_type_alloc()
   _ctx.volume = 0.0
   return _ctx
end

function Volume_noteOn_type_alloc(_ctx)
   return Volume_process_type_alloc()
end

function Volume_noteOff_type_alloc(_ctx)
   return Volume_process_type_alloc()
end

function Volume_controlChange_type_alloc(_ctx)
   return Volume_process_type_alloc()
end

function Volume_default_type_alloc(_ctx)
   return Volume_process_type_alloc()
end

function Volume_smooth(_ctx, input)
   _ctx.x = ((0.005 * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Volume_process(_ctx, input)
   return (input * Volume_smooth(_ctx.inst_1d7d3, _ctx.volume))
end

function Volume_noteOn(_ctx, note, velocity, channel)
end

function Volume_noteOff(_ctx, note, channel)
end

function Volume_controlChange(_ctx, control, value, channel)
   if (control == 30) then
      _ctx.volume = (0.007874 * (value))
   end
end

function Volume_default(_ctx)
   _ctx.volume = 0.0
end

