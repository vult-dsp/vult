]

Ladder`tune`c0 = {};
Ladder`tune`c1 = {};
Ladder`tune`c2 = {};
Ladder`tune`raw`c0[index_] := 
   Return[Ladder`tune`c0[[index + 1]]];


Ladder`tune`raw`c1[index_] := 
   Return[Ladder`tune`c1[[index + 1]]];


Ladder`tune`raw`c2[index_] := 
   Return[Ladder`tune`c2[[index + 1]]];


Ladder`tune[cut_] := Module[{ index }, 
   index = Clip[Floor[(cut * 127.)], {0, 127}];
   Return[(Ladder`tune`c0[[index + 1]] + (cut * (Ladder`tune`c1[[index + 1]] + (Ladder`tune`c2[[index + 1]] * cut))))];
]

Ladder`heun[`ctx_, input_, fh_, res_] := Module[{ dp3, w7, dp2, w5, dp1, w3, dp0, w1, w0, pt3, pt2, pt1, pt0, dpt3, wt7, dpt2, wt5, dpt1, wt3, dpt0, wt1, wt0 }, 
   wt0 = Util`cubic`clipper[(input + (-4. * (res * getValue[`ctx, "p3"])))];
   wt1 = Util`cubic`clipper[getValue[`ctx, "p0"]];
   dpt0 = (fh * (wt0 + (-wt1)));
   wt3 = Util`cubic`clipper[getValue[`ctx, "p1"]];
   dpt1 = (fh * (wt1 + (-wt3)));
   wt5 = Util`cubic`clipper[getValue[`ctx, "p2"]];
   dpt2 = (fh * (wt3 + (-wt5)));
   wt7 = Util`cubic`clipper[getValue[`ctx, "p3"]];
   dpt3 = (fh * (wt5 + (-wt7)));
   pt0 = (dpt0 + getValue[`ctx, "p0"]);
   pt1 = (dpt1 + getValue[`ctx, "p1"]);
   pt2 = (dpt2 + getValue[`ctx, "p2"]);
   pt3 = (dpt3 + getValue[`ctx, "p3"]);
   w0 = Util`cubic`clipper[(input + (-4. * (pt3 * res)))];
   w1 = Util`cubic`clipper[pt0];
   dp0 = (fh * (w0 + (-w1)));
   w3 = Util`cubic`clipper[pt1];
   dp1 = (fh * (w1 + (-w3)));
   w5 = Util`cubic`clipper[pt2];
   dp2 = (fh * (w3 + (-w5)));
   w7 = Util`cubic`clipper[pt3];
   dp3 = (fh * (w5 + (-w7)));
   setValue[`ctx,"p0",((0.5 * (dp0 + dpt0)) + getValue[`ctx, "p0"])];
   setValue[`ctx,"p1",((0.5 * (dp1 + dpt1)) + getValue[`ctx, "p1"])];
   setValue[`ctx,"p2",((0.5 * (dp2 + dpt2)) + getValue[`ctx, "p2"])];
   setValue[`ctx,"p3",((0.5 * (dp3 + dpt3)) + getValue[`ctx, "p3"])];
   Return[getValue[`ctx, "p3"]];
]

Ladder`euler[`ctx_, input_, fh_, res_] := Module[{ dpt3, w7, dpt2, w5, dpt1, w3, dpt0, w1, w0 }, 
   w0 = Util`cubic`clipper[(input + (-4. * (res * getValue[`ctx, "p3"])))];
   w1 = Util`cubic`clipper[getValue[`ctx, "p0"]];
   dpt0 = (fh * (w0 + (-w1)));
   w3 = Util`cubic`clipper[getValue[`ctx, "p1"]];
   dpt1 = (fh * (w1 + (-w3)));
   w5 = Util`cubic`clipper[getValue[`ctx, "p2"]];
   dpt2 = (fh * (w3 + (-w5)));
   w7 = Util`cubic`clipper[getValue[`ctx, "p3"]];
   dpt3 = (fh * (w5 + (-w7)));
   setValue[`ctx,"p0",(dpt0 + getValue[`ctx, "p0"])];
   setValue[`ctx,"p1",(dpt1 + getValue[`ctx, "p1"])];
   setValue[`ctx,"p2",(dpt2 + getValue[`ctx, "p2"])];
   setValue[`ctx,"p3",(dpt3 + getValue[`ctx, "p3"])];
   Return[getValue[`ctx, "p3"]];
]

Ladder`process`euler[`ctx_, input_, cut_, res_] := Module[{ out }, 
   If[Util`change[getValue[`ctx, "inst_1b099"], cut], 
      setValue[`ctx,"fh",Ladder`tune[cut]];];
   Ladder`euler[getValue[`ctx, "e"], input, getValue[`ctx, "fh"], res];
   Ladder`euler[getValue[`ctx, "e"], input, getValue[`ctx, "fh"], res];
   Ladder`euler[getValue[`ctx, "e"], input, getValue[`ctx, "fh"], res];
   out = Ladder`euler[getValue[`ctx, "e"], input, getValue[`ctx, "fh"], res];
   Return[out];
]

Ladder`process`heun[`ctx_, input_, cut_, res_] := Module[{ out }, 
   If[Util`change[getValue[`ctx, "inst_1b0a0"], cut], 
      setValue[`ctx,"fh",Ladder`tune[cut]];];
   Ladder`heun[getValue[`ctx, "h"], input, getValue[`ctx, "fh"], res];
   Ladder`heun[getValue[`ctx, "h"], input, getValue[`ctx, "fh"], res];
   Ladder`heun[getValue[`ctx, "h"], input, getValue[`ctx, "fh"], res];
   out = Ladder`heun[getValue[`ctx, "h"], input, getValue[`ctx, "fh"], res];
   Return[out];
]

Ladder`process[`ctx_, input_, cut_, res_] := 
   Return[Ladder`process`heun[getValue[`ctx, "inst_1a0c3"], input, cut, res]];


