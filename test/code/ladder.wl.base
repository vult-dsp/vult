   Return[`ctx];
]

Ladder`process`euler`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"e",Ladder`euler`type`alloc[]];
   setValue[`ctx,"fh",0.];
   setValue[`ctx,"inst_1b099",Util`change`type`alloc[]];
   Return[`ctx];
]

Ladder`process`heun`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"fh",0.];
   setValue[`ctx,"h",Ladder`heun`type`alloc[]];
   setValue[`ctx,"inst_1b0a0",Util`change`type`alloc[]];
   Return[`ctx];
]

Ladder`process`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"inst_1a0c3",Ladder`process`heun`type`alloc[]];
   Return[`ctx];
]

Ladder`noteOn`type`alloc[`ctx_] := 
   Return[Ladder`process`type`alloc[]];


Ladder`noteOff`type`alloc[`ctx_] := 
