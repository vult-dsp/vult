   `ctx = newEmptyObject[];
   setValue[`ctx,"p0",0.];
   setValue[`ctx,"p1",0.];
   setValue[`ctx,"p2",0.];
   setValue[`ctx,"p3",0.];
   Return[`ctx];
]

