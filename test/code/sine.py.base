import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

class Util_edge_type:
    __slots__ = ['pre']
    def __init__(self, pre=False):
        self.pre = pre

class Util_change_type:
    __slots__ = ['pre_x']
    def __init__(self, pre_x=0.0):
        self.pre_x = pre_x

class Util_dcblock_type:
    __slots__ = ['x1', 'y1']
    def __init__(self, x1=0.0, y1=0.0):
        self.x1 = x1
        self.y1 = y1

class Util_smooth_type:
    __slots__ = ['x']
    def __init__(self, x=0.0):
        self.x = x

class Util_average2_type:
    __slots__ = ['x0']
    def __init__(self, x0=0.0):
        self.x0 = x0

class Phase_process_type:
    __slots__ = ['inst_1b08a', 'inst_2048a', 'phase', 'rate']
    def __init__(self, inst_1b08a=Util_change_type(), inst_2048a=Util_edge_type(), phase=0.0, rate=0.0):
        self.inst_1b08a = inst_1b08a
        self.inst_2048a = inst_2048a
        self.phase = phase
        self.rate = rate

class Sine_process_type:
    __slots__ = ['inst_104ba', 'p', 'trig']
    def __init__(self, inst_104ba=Util_edge_type(), p=Phase_process_type(), trig=False):
        self.inst_104ba = inst_104ba
        self.p = p
        self.trig = trig

def Util_edge_type_alloc():
   _ctx = Util_edge_type()
   _ctx.pre = False
   return _ctx


def Util_change_type_alloc():
   _ctx = Util_change_type()
   _ctx.pre_x = 0.0
   return _ctx


def Util_dcblock_type_alloc():
   _ctx = Util_dcblock_type()
   _ctx.x1 = 0.0
   _ctx.y1 = 0.0
   return _ctx


def Util_smooth_type_alloc():
   _ctx = Util_smooth_type()
   _ctx.x = 0.0
   return _ctx


def Util_average2_type_alloc():
   _ctx = Util_average2_type()
   _ctx.x0 = 0.0
   return _ctx


def Util_cvToPitch(cv):
   return (24.0 + (120.0 * cv))

Util_pitchToRate_1024_c = {}
def Util_pitchToRate_1024_raw_c0(index):
   return Util_pitchToRate_1024_c[(index * 3)]

def Util_pitchToRate_1024_raw_c1(index):
   return Util_pitchToRate_1024_c[((index * 3) + 1)]

def Util_pitchToRate_1024_raw_c2(index):
   return Util_pitchToRate_1024_c[((index * 3) + 2)]

def Util_pitchToRate_1024(pitch):
   value = (((0.0) if (pitch) < (0.0) else ((127.0) if (pitch) > (127.0) else (pitch))) * 0.251968)
   cell = ((0) if (float_to_int(value)) < (0) else ((31) if (float_to_int(value)) > (31) else (float_to_int(value))))
   u = (value - float(cell))
   index = (cell * 3)
   return (Util_pitchToRate_1024_c[index] + (u * (Util_pitchToRate_1024_c[(index + 1)] + (Util_pitchToRate_1024_c[(index + 2)] * u))))


