def Tables_nsine(x):
   value = (((0.0) if (x) < (0.0) else ((1.0) if (x) > (1.0) else (x))) * 128.0)
   cell = ((0) if (float_to_int(value)) < (0) else ((127) if (float_to_int(value)) > (127) else (float_to_int(value))))
   u = (value - float(cell))
   index = (cell * 3)
   return (Tables_nsine_c[index] + (u * (Tables_nsine_c[(index + 1)] + (Tables_nsine_c[(index + 2)] * u))))


def Sine_process(_ctx, cv, reset):
   if Util_edge(_ctx.inst_104ba, (reset > 0.5)):
      _ctx.trig = True
   phase = Phase_process(_ctx.p, cv, 0.0)
   if ((phase < 1e-18) and _ctx.trig):
      _ctx.trig = False
      _ = Phase_process(_ctx.p, cv, 0.0)

   return Tables_nsine(phase)


