def Util_cvToRate_1024_raw_c2(index):
   return Util_cvToRate_1024_c[((index * 3) + 2)]

def Util_cvToRate_1024(cv):
   value = (((0.0) if (cv) < (0.0) else ((0.9) if (cv) > (0.9) else (cv))) * 35.555555)
   cell = ((0) if (float_to_int(value)) < (0) else ((31) if (float_to_int(value)) > (31) else (float_to_int(value))))
   u = (value - float(cell))
   index = (cell * 3)
   return (Util_cvToRate_1024_c[index] + (u * (Util_cvToRate_1024_c[(index + 1)] + (Util_cvToRate_1024_c[(index + 2)] * u))))


def Phase_default(_ctx):
   _ctx.rate = Util_cvToRate_1024(0.0)

def Phase_process_type_alloc():
   _ctx = Phase_process_type()
   _ctx.inst_1b08a = Util_change_type_alloc()
   _ctx.inst_2048a = Util_edge_type_alloc()
   _ctx.phase = 0.0
   _ctx.rate = 0.0
   _ = Phase_default(_ctx)
   return _ctx


def Phase_noteOn_type_alloc(_ctx):
   return Phase_process_type_alloc()

def Phase_noteOff_type_alloc(_ctx):
   return Phase_process_type_alloc()

def Phase_controlChange_type_alloc(_ctx):
   return Phase_process_type_alloc()

def Phase_default_type_alloc(_ctx):
   return Phase_process_type_alloc()

def Sine_process_type_alloc():
   _ctx = Sine_process_type()
   _ctx.inst_104ba = Util_edge_type_alloc()
   _ctx.p = Phase_process_type_alloc()
   _ctx.trig = False
   return _ctx


def Sine_noteOn_type_alloc(_ctx):
   return Sine_process_type_alloc()

def Sine_noteOff_type_alloc(_ctx):
   return Sine_process_type_alloc()

def Sine_controlChange_type_alloc(_ctx):
   return Sine_process_type_alloc()

def Sine_default_type_alloc(_ctx):
   return Sine_process_type_alloc()

def Util_edge(_ctx, x):
   ret = (x and (_ctx.pre == False))
   _ctx.pre = x
   return ret


def Util_change(_ctx, x):
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v


def Util_map(x, x0, x1, y0, y1):
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))

def Util_dcblock(_ctx, x0):
   y0 = (x0 + ((-_ctx.x1) + (0.995 * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0


def Util_smooth(_ctx, input):
   _ctx.x = ((0.005 * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x


def Util_average2(_ctx, x1):
   result = (0.5 * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result


def Util_cubic_clipper(x):
   if (x <= -0.666667):
      return -0.666667
   else:
      if (x >= 0.666666):
         return 0.666666
      else:
         return (x + (-0.333334 * (x * (x * x))))

