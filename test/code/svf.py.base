def Svf_process(_ctx, x, cv, q, sel):
   q = (0.5 + q)
   if (Util_change(_ctx.inst_1b0a2, cv) or Util_change(_ctx.inst_2b0a2, q)):
      _ctx.g = Svf_calc_g(cv)
      _ctx.r = (1.0 / (2.0 * (q + 1e-18)))
      _ctx.inv_den = (1.0 / (1.0 + ((2.0 * (_ctx.r * _ctx.g)) + (_ctx.g * _ctx.g))))

   high = ((x + ((-(((2.0 * _ctx.r) + _ctx.g) * _ctx.z1)) + (-_ctx.z2))) * _ctx.inv_den)
   band = ((high * _ctx.g) + _ctx.z1)
   low = ((band * _ctx.g) + _ctx.z2)
   notch = (high + low)
   _ctx.z1 = (band + (high * _ctx.g))
   _ctx.z2 = (low + (band * _ctx.g))
   output = 0.0
   if (sel == 0):
      output = low
   else:
      if (sel == 1):
         output = high
      else:
         if (sel == 2):
            output = band
         else:
            output = notch
   return Saturate_soft_process(output)


