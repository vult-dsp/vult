def Svf_calc_g(cv):
   value = (((0.0) if (cv) < (0.0) else ((0.9) if (cv) > (0.9) else (cv))) * 142.222222)
   cell = ((0) if (float_to_int(value)) < (0) else ((127) if (float_to_int(value)) > (127) else (float_to_int(value))))
   u = (value - float(cell))
   index = (cell * 3)
   return (Svf_calc_g_c[index] + (u * (Svf_calc_g_c[(index + 1)] + (Svf_calc_g_c[(index + 2)] * u))))


def Svf_default(_ctx):
   _ctx.g = Svf_calc_g(0.0)
   _ctx.r = 1.0
   _ctx.inv_den = (1.0 / (1.0 + (_ctx.g * _ctx.g)))


def Svf_process_type_alloc():
   _ctx = Svf_process_type()
   _ctx.g = 0.0
   _ctx.inst_1b0a2 = Util_change_type_alloc()
   _ctx.inst_2b0a2 = Util_change_type_alloc()
   _ctx.inv_den = 0.0
   _ctx.r = 0.0
   _ctx.z1 = 0.0
   _ctx.z2 = 0.0
   _ = Svf_default(_ctx)
   return _ctx


