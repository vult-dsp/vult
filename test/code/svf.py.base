def Util_edge(_ctx, x):
   ret = (x and (_ctx.pre == False))
   _ctx.pre = x
   return ret


def Util_change(_ctx, x):
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v


def Util_map(x, x0, x1, y0, y1):
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))

def Util_dcblock(_ctx, x0):
   y0 = (x0 + ((-_ctx.x1) + (0.995 * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0


def Util_smooth(_ctx, input):
   _ctx.x = ((0.005 * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x


def Util_average2(_ctx, x1):
   result = (0.5 * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result


def Util_cubic_clipper(x):
   if (x <= -0.666667):
      return -0.666667
   else:
      if (x >= 0.666666):
         return 0.666666
      else:
         return (x + (-0.333334 * (x * (x * x))))

