def Svf_calc_g(cv):
   index = ((0) if (float_to_int((cv * 141.111111))) < (0) else ((127) if (float_to_int((cv * 141.111111))) > (127) else (float_to_int((cv * 141.111111)))))
   return (Svf_calc_g_c0[index] + (cv * (Svf_calc_g_c1[index] + (Svf_calc_g_c2[index] * cv))))


def Svf_default(_ctx):
   _ctx.g = Svf_calc_g(0.0)
   _ctx.r = 1.0
   _ctx.inv_den = (1.0 / (1.0 + (_ctx.g * _ctx.g)))


def Svf_process_type_alloc():
   _ctx = Svf_process_type()
   _ctx.g = 0.0
   _ctx.inst_1b0a2 = Util_change_type_alloc()
   _ctx.inst_2b0a2 = Util_change_type_alloc()
   _ctx.inv_den = 0.0
   _ctx.r = 0.0
   _ctx.z1 = 0.0
   _ctx.z2 = 0.0
   _ = Svf_default(_ctx)
   return _ctx


