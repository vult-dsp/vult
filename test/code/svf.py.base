import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

class Util_edge_type:
    __slots__ = ['pre']
    def __init__(self, pre=False):
        self.pre = pre

class Util_change_type:
    __slots__ = ['pre_x']
    def __init__(self, pre_x=0.0):
        self.pre_x = pre_x

class Util_dcblock_type:
    __slots__ = ['x1', 'y1']
    def __init__(self, x1=0.0, y1=0.0):
        self.x1 = x1
        self.y1 = y1

class Util_smooth_type:
    __slots__ = ['x']
    def __init__(self, x=0.0):
        self.x = x

class Util_average2_type:
    __slots__ = ['x0']
    def __init__(self, x0=0.0):
        self.x0 = x0

class Svf_process_type:
    __slots__ = ['g', 'inst_1b0a2', 'inst_2b0a2', 'inv_den', 'r', 'z1', 'z2']
    def __init__(self, g=0.0, inst_1b0a2=Util_change_type(), inst_2b0a2=Util_change_type(), inv_den=0.0, r=0.0, z1=0.0, z2=0.0):
        self.g = g
        self.inst_1b0a2 = inst_1b0a2
        self.inst_2b0a2 = inst_2b0a2
        self.inv_den = inv_den
        self.r = r
        self.z1 = z1
        self.z2 = z2

