   return ConstSpecialization_accumulate_real_2(_ctx["inst_10ec4"], 5.0)

def ConstSpecialization_test_accumulate_nonspec(_ctx, s, x):
   return ConstSpecialization_accumulate_nonspec_real(_ctx["inst_1383f"], s, x)

