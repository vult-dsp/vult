def ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_1(m, value):
   m[1] = value

def ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_0(m, value):
   m[0] = value

def ConstSpecialization_test_array_mutation(m, x):
   _ = ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_0(m, x[0])
   _ = ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_1(m, x[1])


def ConstSpecialization_setMatrix2_array_of_real_size_4_real_dyn_int_int(m, row, col, value):
   m[(row + (col << 1))] = value

def ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_1(m, value):
   m[2] = value

def ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_0(m, value):
   m[0] = value

def ConstSpecialization_getMatrix2_array_of_real_size_4_dyn_int_int(m, row, col):
   return m[(row + (col << 1))]

def ConstSpecialization_test_matrix_mutation(m, x):
   _ = ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_0(m, x[0])
   _ = ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_1(m, x[1])


def ConstSpecialization_eliminate_row(m, row, col):
   k = ConstSpecialization_getMatrix2_array_of_real_size_4_dyn_int_int(m, row, col)
   _ = ConstSpecialization_setMatrix2_array_of_real_size_4_real_dyn_int_int(m, row, col, (1.0 + k))


def ConstSpecialization_process_matrix(m):
   row = 0
   while (row < 2):
      _ = ConstSpecialization_eliminate_row(m, row, 0)
      row = (1 + row)



def ConstSpecialization_main(_ctx):
   r1 = ConstSpecialization_test_specialized_5()
   r2 = ConstSpecialization_test_specialized_100()
   r3 = ConstSpecialization_test_nonspec(50)
   r4 = ConstSpecialization_test_weighted_spec()
   r5 = ConstSpecialization_test_weighted_nonspec(0.5)
   r6 = ConstSpecialization_test_interleaved_spec()
   r7 = ConstSpecialization_test_interleaved_nonspec(1.5)
   r8 = ConstSpecialization_test_accumulate_spec(_ctx.inst_13dfa)
   r9 = ConstSpecialization_test_accumulate_nonspec(_ctx.inst_201fa, 3.0, 4.0)
   r10 = ConstSpecialization_test_typed_int(_ctx.inst_3e2fa)
   r11 = ConstSpecialization_test_typed_real(_ctx.inst_477fa)
   inputs = initializeArray(0.0, 2)
   inputs[0] = 1.0
   inputs[1] = 2.0
   arr = initializeArray(0.0, 4)
   _ = ConstSpecialization_test_array_mutation(arr, inputs)
   _ = ConstSpecialization_test_matrix_mutation(arr, inputs)
   _ = ConstSpecialization_process_matrix(arr)


