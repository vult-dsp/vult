def ConstSpecialization_add_n_int_5(x):
   return (5 + x)

def ConstSpecialization_add_n_int_100(x):
   return (100 + x)

def ConstSpecialization_add_n_nonspec_int(n, x):
   return (n + x)

def ConstSpecialization_test_specialized_5():
   return ConstSpecialization_add_n_int_5(10)

def ConstSpecialization_test_specialized_100():
   return ConstSpecialization_add_n_int_100(10)

def ConstSpecialization_test_nonspec(n):
   return ConstSpecialization_add_n_nonspec_int(n, 10)

def ConstSpecialization_weighted_real_real_0_3_0_7(x, y):
   return ((0.3 * x) + (0.7 * y))

def ConstSpecialization_weighted_nonspec_real_real(w1, w2, x, y):
   return ((w1 * x) + (w2 * y))

def ConstSpecialization_test_weighted_spec():
   return ConstSpecialization_weighted_real_real_0_3_0_7(10.0, 20.0)

def ConstSpecialization_test_weighted_nonspec(w):
   return ConstSpecialization_weighted_nonspec_real_real(w, 0.7, 10.0, 20.0)

def ConstSpecialization_interleaved_real_real_2_3(x, y):
   return ((2.0 * x) + (3.0 * y))

def ConstSpecialization_interleaved_nonspec_real_real(x, a, y, b):
   return ((a * x) + (b * y))

def ConstSpecialization_test_interleaved_spec():
   return ConstSpecialization_interleaved_real_real_2_3(5.0, 4.0)

def ConstSpecialization_test_interleaved_nonspec(a):
   return ConstSpecialization_interleaved_nonspec_real_real(5.0, a, 4.0, 3.0)

def ConstSpecialization_accumulate_real_2(_ctx, x):
   _ctx["sum"] = ((2.0 * x) + _ctx["sum"])
   return _ctx["sum"]


def ConstSpecialization_accumulate_nonspec_real(_ctx, scale, x):
   _ctx["sum"] = ((scale * x) + _ctx["sum"])
   return _ctx["sum"]


