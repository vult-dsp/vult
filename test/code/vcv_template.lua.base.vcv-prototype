


-- VCV Prototype functions
local global_block = {}

function stringAppend(s1, s2)
   return s1 .. s2
end

function string(n)
   return tostring(n)
end

function getKnob(i)
   if i > 6 or i < 1 then
      return 0.0
   else
      return global_block.knobs[i]
   end
end

function getSwitch(i)
   if i > 6 or i < 1 then
      return false
   else
      return global_block.switches[i]
   end
end

function setLight(i, r, g, b)
   if not(i > 6 or i < 1) then
      global_block.lights[i][1] = r
      global_block.lights[i][2] = g
      global_block.lights[i][3] = b
   end
end

function setSwitchLight(i, r, g, b)
   if not(i > 6 or i < 1) then
      global_block.switchLights[i][1] = r
      global_block.switchLights[i][2] = g
      global_block.switchLights[i][3] = b
   end
end

function samplerate()
   return global_block.sampleRate
end

function sampletime()
   return global_block.sampleTime
end

config.frameDivider = 1
config.bufferSize = 32
function Vcv_template_process_type_alloc()
   local _ctx = {};
   _ctx.Vcv_template_process_ret_0 = 0.0
   _ctx.Vcv_template_process_ret_1 = 0.0
   _ctx.Vcv_template_process_ret_2 = 0.0
   _ctx.sub = 0.0
   _ctx.sum = 0.0
   return _ctx
end

function Vcv_template_update_type_alloc(_ctx)
   return Vcv_template_process_type_alloc()
end

function Vcv_template_process(_ctx, in1, in2)
   _ctx.sum = (((in1 + in2)) > (1.0) and (1.0) or (((in1 + in2)) < (-1.0) and (-1.0) or ((in1 + in2))))
   _ctx.sub = (((in1 + (-in2))) > (1.0) and (1.0) or (((in1 + (-in2))) < (-1.0) and (-1.0) or ((in1 + (-in2)))))
   _ctx.Vcv_template_process_ret_0 = _ctx.sum
   _ctx.Vcv_template_process_ret_1 = _ctx.sub
   _ctx.Vcv_template_process_ret_2 = (_ctx.sum * _ctx.sub)
   return 
end

function Vcv_template_update(_ctx)
   display("test")
   setLight(1, 1.0, 0.0, 0.0)
   setSwitchLight(1, 0.0, 1.0, 0.0)
end


function display(s)
   print(s)
end

local processor = Vcv_template_process_type_alloc()


function process(block)
   global_block = block
   Vcv_template_update(processor)
   for i=1,block.bufferSize do
      local in1 = block.inputs[1][i] / 10.0
      local in2 = block.inputs[2][i] / 10.0
      Vcv_template_process(processor, in1, in2)
      block.outputs[1][i] = 10.0 * processor.Vcv_template_process_ret_0
      block.outputs[2][i] = 10.0 * processor.Vcv_template_process_ret_1
      block.outputs[3][i] = 10.0 * processor.Vcv_template_process_ret_2
   end
end
