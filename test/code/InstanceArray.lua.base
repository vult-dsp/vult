

function InstanceArray_counter_type_alloc()
   local _ctx = {};
   _ctx.total = 0.0
   return _ctx
end

function InstanceArray_test1_type_alloc()
   local i_0 = 0
   local temp_1
   local _ctx = {};
   while (i_0 < 4) do
      do
         temp_1[i_0 + 1] = InstanceArray_counter_type_alloc()
         i_0 = (1 + i_0)
      end
   end
   _ctx.instances = temp_1
   return _ctx
end

function InstanceArray_test2_type_alloc()
   local _ctx = {};
   _ctx.case1 = InstanceArray_counter_type_alloc()
   _ctx.case2 = InstanceArray_counter_type_alloc()
   return _ctx
end

function InstanceArray_counter(_ctx)
   _ctx.total = (1.0 + _ctx.total)
   return _ctx.total
end

function InstanceArray_test1(_ctx)
   local sum = 0.0
   local i__1 = 0
   while (i__1 < 4) do
      do
         sum = (sum + InstanceArray_counter(_ctx.instances[(i__1) + 1]))
         i__1 = (1 + i__1)
      end
   end
   return sum
end

function InstanceArray_test2(_ctx)
   InstanceArray_counter(_ctx.case1)
   InstanceArray_counter(_ctx.case2)
end

