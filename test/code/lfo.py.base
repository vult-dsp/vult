import math

# Runtime functions

def float_to_int(i):
    return int(math.floor(i))

class Util_edge_type:
    __slots__ = ['pre']
    def __init__(self, pre=False):
        self.pre = pre

class Util_change_type:
    __slots__ = ['pre_x']
    def __init__(self, pre_x=0.0):
        self.pre_x = pre_x

class Util_dcblock_type:
    __slots__ = ['x1', 'y1']
    def __init__(self, x1=0.0, y1=0.0):
        self.x1 = x1
        self.y1 = y1

class Util_smooth_type:
    __slots__ = ['x']
    def __init__(self, x=0.0):
        self.x = x

class Util_average2_type:
    __slots__ = ['x0']
    def __init__(self, x0=0.0):
        self.x0 = x0

class Lfo_soft_type:
    __slots__ = ['x2', 'x3', 'x4']
    def __init__(self, x2=0.0, x3=0.0, x4=0.0):
        self.x2 = x2
        self.x3 = x3
        self.x4 = x4

class Lfo_process_type:
    __slots__ = ['inst_1b0d6', 'inst_204d6', 'inst_337d6', 'phase', 'rate']
    def __init__(self, inst_1b0d6=Util_change_type(), inst_204d6=Util_edge_type(), inst_337d6=Lfo_soft_type(), phase=0.0, rate=0.0):
        self.inst_1b0d6 = inst_1b0d6
        self.inst_204d6 = inst_204d6
        self.inst_337d6 = inst_337d6
        self.phase = phase
        self.rate = rate

def Util_edge_type_alloc():
   _ctx = Util_edge_type()
   _ctx.pre = False
   return _ctx


def Util_change_type_alloc():
   _ctx = Util_change_type()
   _ctx.pre_x = 0.0
   return _ctx


