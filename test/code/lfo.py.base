def Lfo_soft(_ctx, x1):
   o = (0.25 * (x1 + (_ctx.x2 + (_ctx.x3 + _ctx.x4))))
   _ctx.x4 = _ctx.x3
   _ctx.x3 = _ctx.x2
   _ctx.x2 = x1
   return o


def Lfo_process(_ctx, cv, shape, reset):
   if Util_change(_ctx.inst_1b0d6, cv):
      _ctx.rate = Util_cvToRate((-0.3 + cv))
   _ctx.phase = (_ctx.phase + _ctx.rate)
   if (_ctx.phase > 2.0):
      _ctx.phase = (-2.0 + _ctx.phase)
   breset = (reset > 0.0)
   if Util_edge(_ctx.inst_204d6, breset):
      _ctx.phase = 0.0
   tmp = (-1.0 + _ctx.phase)
   o = 0.0
   if (shape < 1.0):
      o = tmp
   else:
      if (shape < 2.0):
         o = (-1.0 + (2.0 * abs(tmp)))
      else:
         if (tmp > 0.0):
            o = 1.0
         else:
            o = 0.0
   return Lfo_soft(_ctx.inst_337d6, o)


