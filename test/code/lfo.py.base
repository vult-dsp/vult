   _ctx.x3 = 0.0
   _ctx.x4 = 0.0
   return _ctx


def Lfo_process_type_alloc():
   _ctx = Lfo_process_type()
   _ctx.inst_1b0d6 = Util_change_type_alloc()
   _ctx.inst_204d6 = Util_edge_type_alloc()
   _ctx.inst_337d6 = Lfo_soft_type_alloc()
   _ctx.phase = 0.0
   _ctx.rate = 0.0
   return _ctx


def Lfo_noteOn_type_alloc(_ctx):
   return Lfo_process_type_alloc()

def Lfo_noteOff_type_alloc(_ctx):
   return Lfo_process_type_alloc()

def Lfo_controlChange_type_alloc(_ctx):
   return Lfo_process_type_alloc()

def Lfo_default_type_alloc(_ctx):
   return Lfo_process_type_alloc()

def Util_edge(_ctx, x):
   ret = (x and (_ctx.pre == False))
   _ctx.pre = x
   return ret


def Util_change(_ctx, x):
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v


def Util_map(x, x0, x1, y0, y1):
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))

def Util_dcblock(_ctx, x0):
   y0 = (x0 + ((-_ctx.x1) + (0.995 * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0


def Util_smooth(_ctx, input):
   _ctx.x = ((0.005 * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x


def Util_average2(_ctx, x1):
   result = (0.5 * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result


def Util_cubic_clipper(x):
   if (x <= -0.666667):
      return -0.666667
   else:
      if (x >= 0.666666):
         return 0.666666
      else:
         return (x + (-0.333334 * (x * (x * x))))

Util_pitchToRate_1024_c = {}
def Util_pitchToRate_1024_raw_c0(index):
   return Util_pitchToRate_1024_c[(index * 3)]

def Util_pitchToRate_1024_raw_c1(index):
   return Util_pitchToRate_1024_c[((index * 3) + 1)]

def Util_pitchToRate_1024_raw_c2(index):
   return Util_pitchToRate_1024_c[((index * 3) + 2)]

def Util_pitchToRate_1024(pitch):
   value = (((0.0) if (pitch) < (0.0) else ((127.0) if (pitch) > (127.0) else (pitch))) * 0.251968)
   cell = ((0) if (float_to_int(value)) < (0) else ((31) if (float_to_int(value)) > (31) else (float_to_int(value))))
   u = (value - float(cell))
   index = (cell * 3)
   return (Util_pitchToRate_1024_c[index] + (u * (Util_pitchToRate_1024_c[(index + 1)] + (Util_pitchToRate_1024_c[(index + 2)] * u))))


