
// Runtime functions (simple builtins like eps, pi, clip, real, int_, sin, cos, etc. are inlined)
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
this.Array_instance_counter_type_alloc = function () {
   var _ctx = {};
   _ctx.x = (0|0);
   return _ctx;
};

this.Array_instance_foo_type_alloc = function () {
   var i_0 = (0|0);
   var temp;
   var _ctx = {};
   while ((i_0 < (2|0))) {
      {
         temp[i_0] = this.Array_instance_counter_type_alloc();
         i_0 = ((1|0) + i_0);
      }
   }
   _ctx.x = temp;
   return _ctx;
};

this.Array_instance_counter = function (_ctx) {
   _ctx.x = ((1|0) + _ctx.x);
   return _ctx.x;
};

this.Array_instance_incr = function (ctx) {
   ctx.x = ((1|0) + ctx.x);
   return ctx.x;
};

this.Array_instance_foo = function (_ctx) {
   var i__1 = (0|0);
   while ((i__1 < (2|0))) {
      {
         this.Array_instance_counter(_ctx.x[i__1]);
         i__1 = ((1|0) + i__1);
      }
   }
   return _ctx.x[1].x;
};

