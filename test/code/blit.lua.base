function Util_cvToperiod(cv)
   local value = (((cv) > (1.0) and (1.0) or ((cv) < (0.0) and (0.0) or (cv))) * 32.0)
   local cell = ((math.floor(value)) > (31) and (31) or ((math.floor(value)) < (0) and (0) or (math.floor(value))))
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_cvToperiod_c[(index) + 1] + (u * (Util_cvToperiod_c[((index + 1)) + 1] + (Util_cvToperiod_c[((index + 2)) + 1] * u))))
end

function Blit_pulse_start(_ctx)
   _ctx.m = (1 + lshift((math.modf(Util_cvToperiod(0.0))), 1))
   _ctx.scale = (1.0 + (2.0 * Util_cvToperiod(0.0)))
end

function Blit_pulse_train_type_alloc()
   local _ctx = {};
   _ctx.inst_1b05e = Util_change_type_alloc()
   _ctx.m = 0
   _ctx.scale = 0.0
   Blit_pulse_start(_ctx)
   return _ctx
end

function Blit_pulse_start_type_alloc(_ctx)
