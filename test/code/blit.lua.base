end

Util_pitchToRate_1024_c = {};
function Util_pitchToRate_1024_raw_c0(index)
   return Util_pitchToRate_1024_c[((index * 3)) + 1]
end

function Util_pitchToRate_1024_raw_c1(index)
   return Util_pitchToRate_1024_c[(((index * 3) + 1)) + 1]
end

function Util_pitchToRate_1024_raw_c2(index)
   return Util_pitchToRate_1024_c[(((index * 3) + 2)) + 1]
end

function Util_pitchToRate_1024(pitch)
   local value = (((pitch) > (127.0) and (127.0) or ((pitch) < (0.0) and (0.0) or (pitch))) * 0.251968)
   local cell = ((math.floor(value)) > (31) and (31) or ((math.floor(value)) < (0) and (0) or (math.floor(value))))
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_pitchToRate_1024_c[(index) + 1] + (u * (Util_pitchToRate_1024_c[((index + 1)) + 1] + (Util_pitchToRate_1024_c[((index + 2)) + 1] * u))))
end

Util_cvToRate_1024_c = {};
function Util_cvToRate_1024_raw_c0(index)
   return Util_cvToRate_1024_c[((index * 3)) + 1]
end

function Util_cvToRate_1024_raw_c1(index)
   return Util_cvToRate_1024_c[(((index * 3) + 1)) + 1]
