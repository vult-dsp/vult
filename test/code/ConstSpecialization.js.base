this.ConstSpecialization_accumulate_real_real_2 = function (_ctx, x) {
   _ctx.sum = ((2.0 * x) + _ctx.sum);
   return _ctx.sum;
};

this.ConstSpecialization_accumulate_real_dyn_real = function (_ctx, scale, x) {
   _ctx.sum = ((scale * x) + _ctx.sum);
   return _ctx.sum;
};

