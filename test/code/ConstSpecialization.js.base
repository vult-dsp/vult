   inputs[0] = 1.0;
   inputs[1] = 2.0;
   var arr = this.initializeArray(0.0, (4|0));
   this.ConstSpecialization_test_array_mutation(arr, inputs);
   this.ConstSpecialization_test_matrix_mutation(arr, inputs);
   this.ConstSpecialization_process_matrix(arr);
};

