};

this.ConstSpecialization_setMatrix2_array_of_real_size_4_real_dyn_int_int = function (m, row, col, value) {
   m[(row + (col << (1|0)))] = value;
};

this.ConstSpecialization_getMatrix2_array_of_real_size_4_dyn_int_int = function (m, row, col) {
   return m[(row + (col << (1|0)))];
};

this.ConstSpecialization_test_matrix_mutation = function (m, x) {
   this.ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_0(m, x[0]);
   this.ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_1(m, x[1]);
};

this.ConstSpecialization_eliminate_row = function (m, row, col) {
   var k = this.ConstSpecialization_getMatrix2_array_of_real_size_4_dyn_int_int(m, row, col);
   this.ConstSpecialization_setMatrix2_array_of_real_size_4_real_dyn_int_int(m, row, col, (1.0 + k));
};

this.ConstSpecialization_process_matrix = function (m) {
   var row = (0|0);
   while ((row < (2|0))) {
      {
         this.ConstSpecialization_eliminate_row(m, row, (0|0));
         row = ((1|0) + row);
      }
   }
};

this.ConstSpecialization_main = function (_ctx) {
   this.ConstSpecialization_test_accumulate_spec(_ctx.inst_13dfa);
   this.ConstSpecialization_test_accumulate_nonspec(_ctx.inst_201fa, 3.0, 4.0);
   this.ConstSpecialization_test_typed_int(_ctx.inst_3e2fa);
   this.ConstSpecialization_test_typed_real(_ctx.inst_477fa);
