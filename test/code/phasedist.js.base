
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.eps  = function()           { return 1e-18 };
this.pi   = function()           { return 3.1415926535897932384; }
this.clip = function(x,low,high) { return x<low?low:(x>high?high:x); };
this.not  = function(x)          { return x==0?1:0; };
this.real = function(x)          { return x; };
this.int_  = function(x)         { return x|0; };
this.sin  = function(x)          { return Math.sin(x); };
this.cos  = function(x)          { return Math.cos(x); };
this.abs  = function(x)          { return Math.abs(x); };
this.exp  = function(x)          { return Math.exp(x); };
this.floor = function(x)          { return Math.floor(x); };
this.tan  = function(x)          { return Math.tan(x); };
this.tanh = function(x)          { return Math.tanh(x); };
this.pow  = function(a,b)         { return Math.pow(a,b); };
this.sqrt = function(x)          { return x; };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
this.Phasedist_smooth_type_alloc = function () {
   var _ctx = {};
   _ctx.x = 0.0;
   return _ctx;
};

this.Phasedist_change_type_alloc = function () {
   var _ctx = {};
   _ctx.pre_x = 0.0;
   return _ctx;
};

this.Phasedist_phasor_type_alloc = function () {
   var _ctx = {};
   _ctx.inst_1e817 = this.Phasedist_change_type_alloc();
   _ctx.phase = 0.0;
   _ctx.rate = 0.0;
   return _ctx;
};

this.Phasedist_process_type_alloc = function () {
   var _ctx = {};
   _ctx.detune = 0.0;
   _ctx.inst_117e9 = this.Phasedist_phasor_type_alloc();
   _ctx.inst_275e9 = this.Phasedist_smooth_type_alloc();
   _ctx.inst_317e9 = this.Phasedist_phasor_type_alloc();
   _ctx.inst_475e9 = this.Phasedist_smooth_type_alloc();
   _ctx.pitch = 0.0;
   _ctx.pre_phase1 = 0.0;
   _ctx.volume = 0.0;
   return _ctx;
};

this.Phasedist_noteOn_type_alloc = function (_ctx) {
   return this.Phasedist_process_type_alloc();
};

this.Phasedist_noteOff_type_alloc = function (_ctx) {
   return this.Phasedist_process_type_alloc();
};

this.Phasedist_controlChange_type_alloc = function (_ctx) {
   return this.Phasedist_process_type_alloc();
};

this.Phasedist_default_type_alloc = function (_ctx) {
   return this.Phasedist_process_type_alloc();
};

this.Phasedist_smooth = function (_ctx, input) {
   _ctx.x = ((0.005 * (input + (-_ctx.x))) + _ctx.x);
   return _ctx.x;
};

this.Phasedist_change = function (_ctx, x) {
   var v = (_ctx.pre_x != x);
   _ctx.pre_x = x;
   return v;
};

this.Phasedist_pitchToRate = function (d) {
   return (0.000185 * this.exp((0.057762 * d)));
};

this.Phasedist_phasor = function (_ctx, pitch, reset) {
   if (this.Phasedist_change(_ctx.inst_1e817, pitch)) {
      _ctx.rate = this.Phasedist_pitchToRate(pitch);
   }
   if (reset) {
      _ctx.phase = 0.0;
   } else {
      _ctx.phase = (_ctx.phase + _ctx.rate);
   }
   if ((_ctx.phase > 1.0)) {
      _ctx.phase = (-1.0 + _ctx.phase);
   } else {
      _ctx.phase = _ctx.phase;
   }
   return _ctx.phase;
};

this.Phasedist_process = function (_ctx, input) {
   var phase1 = this.Phasedist_phasor(_ctx.inst_117e9, _ctx.pitch, false);
   var comp = (1.0 + (-phase1));
   var reset = (((-phase1) + _ctx.pre_phase1) > 0.5);
   _ctx.pre_phase1 = phase1;
   var phase2 = this.Phasedist_phasor(_ctx.inst_317e9, ((32.0 * this.Phasedist_smooth(_ctx.inst_275e9, _ctx.detune)) + _ctx.pitch), reset);
   var sine = this.sin((6.283185 * phase2));
   return (comp * (sine * this.Phasedist_smooth(_ctx.inst_475e9, _ctx.volume)));
};

this.Phasedist_noteOn = function (_ctx, note, velocity, channel) {
   _ctx.pitch = this.real(note);
};

this.Phasedist_noteOff = function (_ctx, note, channel) {
};

this.Phasedist_controlChange = function (_ctx, control, value, channel) {
   if ((control == (30|0))) {
      _ctx.volume = (0.007874 * this.real(value));
   }
   if ((control == (31|0))) {
      _ctx.detune = (0.007874 * this.real(value));
   }
};

this.Phasedist_default = function (_ctx) {
   _ctx.volume = 1.0;
   _ctx.pitch = 45.0;
   _ctx.detune = 0.0;
};

