this.Util_edge = function (_ctx, x) {
   var ret = (x && (_ctx.pre == false));
   _ctx.pre = x;
   return ret;
};

this.Util_change = function (_ctx, x) {
   var v = (_ctx.pre_x != x);
   _ctx.pre_x = x;
   return v;
};

this.Util_map = function (x, x0, x1, y0, y1) {
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))));
};

this.Util_dcblock = function (_ctx, x0) {
   var y0 = (x0 + ((-_ctx.x1) + (0.995 * _ctx.y1)));
   _ctx.x1 = x0;
   _ctx.y1 = y0;
   return y0;
};

this.Util_smooth = function (_ctx, input) {
   _ctx.x = ((0.005 * (input + (-_ctx.x))) + _ctx.x);
   return _ctx.x;
};

this.Util_average2 = function (_ctx, x1) {
   var result = (0.5 * (x1 + _ctx.x0));
   _ctx.x0 = x1;
   return result;
};

this.Util_cubic_clipper = function (x) {
   if ((x <= -0.666667)) {
      return -0.666667;
   } else {
      if ((x >= 0.666666)) {
         return 0.666666;
      } else {
         return (x + (-0.333334 * (x * (x * x))));
      }
   }
};

