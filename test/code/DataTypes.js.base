this.DataTypes_point_alloc = function () {
   var _ctx = {};
   _ctx.x = 0.0;
   _ctx.y = 0.0;
   return _ctx;
};

this.DataTypes_test2_type_alloc = function () {
   var _ctx = {};
   _ctx.p2 = this.DataTypes_point_alloc();
   _ctx.result = this.DataTypes_point_alloc();
   return _ctx;
};

this.DataTypes_addPoint1 = function (p1, p2) {
   var p3 = DataTypes_point_alloc();
   p3.x = (p1.x + p2.x);
   p3.y = (p1.y + p2.y);
   return p3;
};

this.DataTypes_addPoint2 = function (p1, p2, result) {
   result.x = (p1.x + p2.x);
   result.y = (p1.y + p2.y);
};

this.DataTypes_test1 = function () {
   var p1 = DataTypes_point_alloc();
   var p2 = DataTypes_point_alloc();
   var result = this.DataTypes_addPoint1(p1, p2);
   this.DataTypes_addPoint2(p1, p2, result);
};

this.DataTypes_test2 = function (_ctx) {
   var p1 = DataTypes_point_alloc();
   _ctx.result = this.DataTypes_addPoint1(p1, _ctx.p2);
};

