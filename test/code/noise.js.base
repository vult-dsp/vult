this.Noise_pinker = function (_ctx, x) {
   var b0 = 0.027712;
   var b1 = 0.027712;
   var a1 = -0.944575;
   var w0 = (x + (-(a1 * _ctx.w1)));
   var y0 = ((b0 * w0) + (b1 * _ctx.w1));
   _ctx.w1 = w0;
   return y0;
};

this.Noise_process = function (_ctx, color) {
   _ctx.x1 = (((7919|0) + ((17389|0) * _ctx.x1)) % (32768|0));
   var y1 = (3e-05 * this.real(_ctx.x1));
   _ctx.x2 = (((12553|0) + ((27449|0) * _ctx.x2)) % (32768|0));
   var y2 = (3e-05 * this.real(_ctx.x2));
   var out = 0.0;
   if ((color > 0.5)) {
      out = this.Noise_pinker(_ctx.inst_16d3d, (y1 + (-y2)));
   } else {
      out = (y1 + (-y2));
   }
   return (2.0 * out);
};

