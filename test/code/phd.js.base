this.Phase_process = function (_ctx, cv, reset) {
   if (this.Util_change(_ctx.inst_1b08a, cv)) {
      _ctx.rate = this.Util_cvToRate_1024(cv);
   }
   if (this.Util_edge(_ctx.inst_2048a, (reset > 0.5))) {
      _ctx.phase = 0.0;
   } else {
      _ctx.phase = (_ctx.phase + _ctx.rate);
   }
   if ((_ctx.phase > 1024.0)) {
      _ctx.phase = (-1024.0 + _ctx.phase);
   } else {
      _ctx.phase = _ctx.phase;
   }
   return (0.000976 * _ctx.phase);
};

