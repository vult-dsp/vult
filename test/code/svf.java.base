private float Svf_calc_g(float cv) {
   float value = (clip(cv, 0.0f, 0.9f) * 142.222222f);
   int cell = clip(float_to_int(value), 0, 127);
   float u = (value - (float)(cell));
   int index = (cell * 3);
   return (Svf_calc_g_c[index] + (u * (Svf_calc_g_c[(index + 1)] + (Svf_calc_g_c[(index + 2)] * u))));
}

