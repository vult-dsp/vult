Ladder_tune_c = {};
function Ladder_tune_raw_c0(index)
   return Ladder_tune_c[((index * 3)) + 1]
end

function Ladder_tune_raw_c1(index)
   return Ladder_tune_c[(((index * 3) + 1)) + 1]
end

function Ladder_tune_raw_c2(index)
   return Ladder_tune_c[(((index * 3) + 2)) + 1]
end

function Ladder_tune(cut)
   local value = (((cut) > (1.0) and (1.0) or ((cut) < (0.0) and (0.0) or (cut))) * 128.0)
   local cell = clipValue(floor(value), 0, 127)
   local u = (value - (cell))
   local index = (cell * 3)
   return (Ladder_tune_c[(index) + 1] + (u * (Ladder_tune_c[((index + 1)) + 1] + (Ladder_tune_c[((index + 2)) + 1] * u))))
end

function Ladder_heun(_ctx, input, fh, res)
   local wt0 = Util_cubic_clipper((input + (-4.0 * (res * _ctx.p3))))
   local wt1 = Util_cubic_clipper(_ctx.p0)
   local dpt0 = (fh * (wt0 + (-wt1)))
   local wt3 = Util_cubic_clipper(_ctx.p1)
   local dpt1 = (fh * (wt1 + (-wt3)))
   local wt5 = Util_cubic_clipper(_ctx.p2)
   local dpt2 = (fh * (wt3 + (-wt5)))
   local wt7 = Util_cubic_clipper(_ctx.p3)
   local dpt3 = (fh * (wt5 + (-wt7)))
   local pt0 = (dpt0 + _ctx.p0)
   local pt1 = (dpt1 + _ctx.p1)
   local pt2 = (dpt2 + _ctx.p2)
   local pt3 = (dpt3 + _ctx.p3)
   local w0 = Util_cubic_clipper((input + (-4.0 * (pt3 * res))))
   local w1 = Util_cubic_clipper(pt0)
   local dp0 = (fh * (w0 + (-w1)))
   local w3 = Util_cubic_clipper(pt1)
   local dp1 = (fh * (w1 + (-w3)))
   local w5 = Util_cubic_clipper(pt2)
   local dp2 = (fh * (w3 + (-w5)))
   local w7 = Util_cubic_clipper(pt3)
   local dp3 = (fh * (w5 + (-w7)))
   _ctx.p0 = ((0.5 * (dp0 + dpt0)) + _ctx.p0)
   _ctx.p1 = ((0.5 * (dp1 + dpt1)) + _ctx.p1)
   _ctx.p2 = ((0.5 * (dp2 + dpt2)) + _ctx.p2)
   _ctx.p3 = ((0.5 * (dp3 + dpt3)) + _ctx.p3)
   return _ctx.p3
end

function Ladder_euler(_ctx, input, fh, res)
   local w0 = Util_cubic_clipper((input + (-4.0 * (res * _ctx.p3))))
   local w1 = Util_cubic_clipper(_ctx.p0)
   local dpt0 = (fh * (w0 + (-w1)))
   local w3 = Util_cubic_clipper(_ctx.p1)
   local dpt1 = (fh * (w1 + (-w3)))
   local w5 = Util_cubic_clipper(_ctx.p2)
   local dpt2 = (fh * (w3 + (-w5)))
   local w7 = Util_cubic_clipper(_ctx.p3)
   local dpt3 = (fh * (w5 + (-w7)))
   _ctx.p0 = (dpt0 + _ctx.p0)
   _ctx.p1 = (dpt1 + _ctx.p1)
   _ctx.p2 = (dpt2 + _ctx.p2)
   _ctx.p3 = (dpt3 + _ctx.p3)
   return _ctx.p3
end

function Ladder_process_euler(_ctx, input, cut, res)
   if Util_change(_ctx.inst_1b099, cut) then
      _ctx.fh = Ladder_tune(cut)
   end
   Ladder_euler(_ctx.e, input, _ctx.fh, res)
   Ladder_euler(_ctx.e, input, _ctx.fh, res)
   Ladder_euler(_ctx.e, input, _ctx.fh, res)
   local out = Ladder_euler(_ctx.e, input, _ctx.fh, res)
   return out
end

function Ladder_process_heun(_ctx, input, cut, res)
   if Util_change(_ctx.inst_1b0a0, cut) then
      _ctx.fh = Ladder_tune(cut)
   end
   Ladder_heun(_ctx.h, input, _ctx.fh, res)
   Ladder_heun(_ctx.h, input, _ctx.fh, res)
   Ladder_heun(_ctx.h, input, _ctx.fh, res)
   local out = Ladder_heun(_ctx.h, input, _ctx.fh, res)
   return out
end

function Ladder_process(_ctx, input, cut, res)
   return Ladder_process_heun(_ctx.inst_1a0c3, input, cut, res)
end

function Ladder_noteOn(_ctx, note, velocity, channel)
end

function Ladder_noteOff(_ctx, note, channel)
end

function Ladder_controlChange(_ctx, control, value, channel)
end

function Ladder_default(_ctx)
end

