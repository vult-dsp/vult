   return (Util_pitchToRate_c0[index + 1] + (pitch * (Util_pitchToRate_c1[index + 1] + (Util_pitchToRate_c2[index + 1] * pitch))))
end

function Util_cvToPitch(cv)
   return (24.0 + (120.0 * cv))
end

