   local cell = clipValue(floor(value), 0, 31)
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_pitchToRate_c[(index) + 1] + (u * (Util_pitchToRate_c[((index + 1)) + 1] + (Util_pitchToRate_c[((index + 2)) + 1] * u))))
end

