function Ahr_do(_ctx, gate, a, h, r)
   local release = 0
   local attack = 1
   local hold = 2
   local reset = 3
   local bgate = (gate > 0.0)
   if Util_edge(_ctx.inst_104d8, bgate) then
      _ctx.state = reset
   end
   local resetting = 0.0
   if (_ctx.state == reset) then
      resetting = 1.0
   else
      resetting = 0.0
   end
   if Util_edge(_ctx.inst_204d8, (_ctx.out > 1024.0)) then
      do
         _ctx.hold_phase = 0.0
         _ctx.state = hold
      end
   end
   if ((_ctx.out < 10.0) and (_ctx.state == reset)) then
      _ctx.state = attack
   end
   if ((_ctx.hold_phase > 100.0) and (_ctx.state == hold)) then
      _ctx.state = release
   end
   if (_ctx.state == reset) then
      do
         _ctx.rate = 0.990099
         _ctx.target = 0.0
      end
   end
   if (_ctx.state == attack) then
      do
         _ctx.rate = (1.0 / (0.01 + (100.0 * a)))
         _ctx.target = 1228.8
      end
   end
   if (_ctx.state == hold) then
      do
         local hrate = (1.0 / (0.01 + (100.0 * h)))
         _ctx.hold_phase = (hrate + _ctx.hold_phase)
      end
   end
   if (_ctx.state == release) then
      do
         _ctx.rate = (1.0 / (0.01 + (100.0 * r)))
         _ctx.target = 0.0
      end
   end
   _ctx.out = ((0.005 * (((-_ctx.out) + _ctx.target) * _ctx.rate)) + _ctx.out)
   _ctx.Ahr_do_ret_0 = (((0.000976 * _ctx.out)) > (1.0) and (1.0) or (((0.000976 * _ctx.out)) < (0.0) and (0.0) or ((0.000976 * _ctx.out))))
   _ctx.Ahr_do_ret_1 = resetting
   return 
end

function Ahr_process(_ctx, gate)
   Ahr_do(_ctx.inst_1d84b, gate, _ctx.knob1, _ctx.knob2, _ctx.knob3)
   local _call_temp_0 = _ctx.inst_1d84b.Ahr_do_ret_0
   local _call_temp_1 = _ctx.inst_1d84b.Ahr_do_ret_1
   _ctx.Ahr_process_ret_0 = _call_temp_0
   _ctx.Ahr_process_ret_1 = _call_temp_1
   return 
end

function Ahr_noteOn(_ctx, note, velocity, channel)
end

function Ahr_noteOff(_ctx, note, channel)
end

function Ahr_controlChange(_ctx, control, value, channel)
   if (control == 1) then
      _ctx.knob1 = (0.007874 * (value))
   end
   if (control == 2) then
      _ctx.knob2 = (0.007874 * (value))
   end
   if (control == 3) then
      _ctx.knob3 = (0.007874 * (value))
   end
end

function Ahr_default(_ctx)
   _ctx.knob1 = 0.0
   _ctx.knob2 = 0.5
   _ctx.knob3 = 0.5
end

