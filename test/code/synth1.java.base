   }
   if ((_ctx.count <= 4)) {
      _ctx.count = (1 + _ctx.count);
   }
   if ((_ctx.count > 0)) {
      _ctx.gate = 1;
   } else {
      _ctx.gate = 0;
   }
}

private void Synth1_noteOff(Synth1_process_type _ctx, int note, int channel) {
   boolean found = false;
   if ((note == _ctx.n1)) {
