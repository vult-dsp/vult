private int ConstSpecialization_add_n_int_int_5(int x) {
   return (5 + x);
}

private int ConstSpecialization_add_n_int_int_100(int x) {
   return (100 + x);
}

private int ConstSpecialization_add_n_int_dyn_int(int n, int x) {
   return (n + x);
}

