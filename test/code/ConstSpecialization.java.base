private void ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_0(float[] m, float value) {
   m[0] = value;
}

private void ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_1(float[] m, float value) {
   m[1] = value;
}

private void ConstSpecialization_test_array_mutation(float[] m, float[] x) {
   ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_0(m, x[0]);
   ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_1(m, x[1]);
}

private void ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_0(float[] m, float value) {
   m[0] = value;
}

private void ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_1(float[] m, float value) {
   m[2] = value;
}

private void ConstSpecialization_setMatrix2_array_of_real_size_4_real_dyn_int_int(float[] m, int row, int col, float value) {
   m[(row + (col << 1))] = value;
}

private float ConstSpecialization_getMatrix2_array_of_real_size_4_dyn_int_int(float[] m, int row, int col) {
   return m[(row + (col << 1))];
}

private void ConstSpecialization_test_matrix_mutation(float[] m, float[] x) {
   ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_0(m, x[0]);
   ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_1(m, x[1]);
}

private void ConstSpecialization_eliminate_row(float[] m, int row, int col) {
   float k = ConstSpecialization_getMatrix2_array_of_real_size_4_dyn_int_int(m, row, col);
   ConstSpecialization_setMatrix2_array_of_real_size_4_real_dyn_int_int(m, row, col, (1.0f + k));
}

private void ConstSpecialization_process_matrix(float[] m) {
   int row = 0;
   while ((row < 2)) {
      {
         ConstSpecialization_eliminate_row(m, row, 0);
         row = (1 + row);
      }
   }
}

private void ConstSpecialization_main(ConstSpecialization_main_type _ctx) {
   int r1 = ConstSpecialization_test_specialized_5();
   int r2 = ConstSpecialization_test_specialized_100();
   int r3 = ConstSpecialization_test_nonspec(50);
   float r4 = ConstSpecialization_test_weighted_spec();
   float r5 = ConstSpecialization_test_weighted_nonspec(0.5f);
   float r6 = ConstSpecialization_test_interleaved_spec();
   float r7 = ConstSpecialization_test_interleaved_nonspec(1.5f);
   float r8 = ConstSpecialization_test_accumulate_spec(_ctx.inst_13dfa);
   float r9 = ConstSpecialization_test_accumulate_nonspec(_ctx.inst_201fa, 3.0f, 4.0f);
   int r10 = ConstSpecialization_test_typed_int(_ctx.inst_3e2fa);
   float r11 = ConstSpecialization_test_typed_real(_ctx.inst_477fa);
   float[] inputs = initializeArray(0.0f, 2);
   inputs[0] = 1.0f;
   inputs[1] = 2.0f;
   float[] arr = initializeArray(0.0f, 4);
   ConstSpecialization_test_array_mutation(arr, inputs);
   ConstSpecialization_test_matrix_mutation(arr, inputs);
   ConstSpecialization_process_matrix(arr);
}


