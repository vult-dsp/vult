function Polycv_velToCV(vel)
   return (0.007874 * real(vel))
end

function Polycv_velToGate(vel)
   if (vel > 0) then
      return (0.007874 * real(vel))
   else
      return 0.
   end
end

function Polycv_poly_noteOn(_ctx, note, velocity)
   local i = 0
   local found = false
   while ((i < 4) and (found == false)) do
      do
         if (_ctx.vel[i + 1] == 0) then
            do
               _ctx.notes[i + 1] = note
               _ctx.vel[i + 1] = velocity
               found = true
            end
         end
         i = (1 + i)
      end
   end
end

function Polycv_poly_noteOff(_ctx, note)
   local i = 0
   local found = false
   while ((i < 4) and (found == false)) do
      do
         if (_ctx.notes[i + 1] == note) then
            do
               _ctx.vel[i + 1] = 0
               found = true
            end
         end
         i = (1 + i)
      end
   end
end

function Polycv_polyState(_ctx)
   local note1 = Util_pitchToCv(real(_ctx.notes[1]))
   local note2 = Util_pitchToCv(real(_ctx.notes[2]))
   local note3 = Util_pitchToCv(real(_ctx.notes[3]))
   local note4 = Util_pitchToCv(real(_ctx.notes[4]))
   local vel1 = Polycv_velToCV(_ctx.vel[1])
   local vel2 = Polycv_velToCV(_ctx.vel[2])
   local vel3 = Polycv_velToCV(_ctx.vel[3])
   local vel4 = Polycv_velToCV(_ctx.vel[4])
   local gate1 = Polycv_velToGate(_ctx.vel[1])
   local gate2 = Polycv_velToGate(_ctx.vel[2])
   local gate3 = Polycv_velToGate(_ctx.vel[3])
   local gate4 = Polycv_velToGate(_ctx.vel[4])
   _ctx.Polycv_polyState_ret_0 = note1
   _ctx.Polycv_polyState_ret_1 = vel1
   _ctx.Polycv_polyState_ret_2 = gate1
   _ctx.Polycv_polyState_ret_3 = note2
   _ctx.Polycv_polyState_ret_4 = vel2
   _ctx.Polycv_polyState_ret_5 = gate2
   _ctx.Polycv_polyState_ret_6 = note3
   _ctx.Polycv_polyState_ret_7 = vel3
   _ctx.Polycv_polyState_ret_8 = gate3
   _ctx.Polycv_polyState_ret_9 = note4
   _ctx.Polycv_polyState_ret_10 = vel4
   _ctx.Polycv_polyState_ret_11 = gate4
   return 
end

function Polycv_process(_ctx, c)
   _ctx.channel_in = c
   Polycv_polyState(_ctx.poly)
   local _call_temp_0 = _ctx.poly.Polycv_polyState_ret_0
   local _call_temp_1 = _ctx.poly.Polycv_polyState_ret_1
   local _call_temp_2 = _ctx.poly.Polycv_polyState_ret_2
   local _call_temp_3 = _ctx.poly.Polycv_polyState_ret_3
   local _call_temp_4 = _ctx.poly.Polycv_polyState_ret_4
   local _call_temp_5 = _ctx.poly.Polycv_polyState_ret_5
   local _call_temp_6 = _ctx.poly.Polycv_polyState_ret_6
   local _call_temp_7 = _ctx.poly.Polycv_polyState_ret_7
   local _call_temp_8 = _ctx.poly.Polycv_polyState_ret_8
   local _call_temp_9 = _ctx.poly.Polycv_polyState_ret_9
   local _call_temp_10 = _ctx.poly.Polycv_polyState_ret_10
   local _call_temp_11 = _ctx.poly.Polycv_polyState_ret_11
   _ctx.Polycv_process_ret_0 = _call_temp_0
   _ctx.Polycv_process_ret_1 = _call_temp_1
   _ctx.Polycv_process_ret_2 = _call_temp_2
   _ctx.Polycv_process_ret_3 = _call_temp_3
   _ctx.Polycv_process_ret_4 = _call_temp_4
   _ctx.Polycv_process_ret_5 = _call_temp_5
   _ctx.Polycv_process_ret_6 = _call_temp_6
   _ctx.Polycv_process_ret_7 = _call_temp_7
   _ctx.Polycv_process_ret_8 = _call_temp_8
   _ctx.Polycv_process_ret_9 = _call_temp_9
   _ctx.Polycv_process_ret_10 = _call_temp_10
   _ctx.Polycv_process_ret_11 = _call_temp_11
   return 
end

function Polycv_noteOn(_ctx, note, velocity, channel)
   if (_ctx.channel_in == channel) then
      if (velocity > 0) then
         Polycv_poly_noteOn(_ctx.poly, note, velocity)
      else
         Polycv_poly_noteOff(_ctx.poly, note)
      end
   end
end

function Polycv_noteOff(_ctx, note, channel)
   if (_ctx.channel_in == channel) then
      Polycv_poly_noteOff(_ctx.poly, note)
   end
end

function Polycv_controlChange(_ctx, control, value, channel)
end

function Polycv_default(_ctx)
end

