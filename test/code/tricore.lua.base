function Util_cvTokHz(cv)
   local value = (((cv) > (1.0) and (1.0) or ((cv) < (0.0) and (0.0) or (cv))) * 32.0)
   local cell = clipValue(floor(value), 0, 31)
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_cvTokHz_c[(index) + 1] + (u * (Util_cvTokHz_c[((index + 1)) + 1] + (Util_cvTokHz_c[((index + 2)) + 1] * u))))
end

function Tricore_process(_ctx, cv, reset, disable)
   local out = 0.0
   if Util_change(_ctx.inst_1b03c, cv) then
      _ctx.rate = (4.0 * Util_cvToRate_1024(cv))
   end
   local new_phase = (ifExpressionValue(_ctx.direction, _ctx.rate, (-_ctx.rate)) + _ctx.phase)
   local bdisable = (disable > 0.5)
   if (Util_edge(_ctx.inst_2043c, (reset > 0.0)) or Util_edge(_ctx.inst_3043c, bdisable)) then
      do
         _ctx.reset_phase = _ctx.phase
         _ctx.reset_state = true
         new_phase = 0.0
      end
   end
   if (new_phase > 1024.0) then
      do
         new_phase = (2048.0 + (-new_phase))
         _ctx.direction = false
      end
   else
      if (new_phase < -1024.0) then
         _ctx.direction = true
      end
   end
   if bdisable then
      _ctx.phase = 0.0
   else
      _ctx.phase = new_phase
   end
   if _ctx.reset_state then
      do
         if ((abs(_ctx.reset_phase) > 10.0) or bdisable) then
            do
               local reset_speed = 0.0
               if bdisable then
                  reset_speed = 0.01
               else
                  reset_speed = 0.5
               end
               _ctx.reset_phase = ((-(reset_speed * _ctx.reset_phase)) + _ctx.reset_phase)
            end
         else
            do
               if (not(_ctx.reset_phase > 10.0)) then
                  _ctx.reset_phase = 0.0
               end
               _ctx.reset_state = false
               _ctx.direction = true
            end
         end
         out = _ctx.reset_phase
      end
   end
   out = (out + _ctx.phase)
   return (0.000976 * out)
end

function Tricore_noteOn(_ctx, note, velocity, channel)
end

function Tricore_noteOff(_ctx, note, channel)
end

function Tricore_controlChange(_ctx, control, value, channel)
end

