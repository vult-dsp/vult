function Sawcore_ptr_w2(_ctx, phase, rate)
   s1 = rate
   s2 = (rate + s1)
   out2 = Float32(0.0)
   out1 = false
   if (phase < s1)
      begin
         d = (phase / rate)
         t2 = (Float32(0.000976) * s2)
         out1 = false
         out2 = (Float32(1.0) + (d * (t2 + (-d))))
      end
   else
      if (phase < s2)
         begin
            d = (phase / rate)
            t2 = (Float32(0.000976) * s2)
            out1 = false
            out2 = (Float32(3.0) + (d * (Float32(-4.0) + (d + t2))))
         end
      else
         begin
            out1 = true
            out2 = Float32(0.0)
         end
      end
   end
   _ctx.Sawcore_ptr_w2_ret_0 = out1
   _ctx.Sawcore_ptr_w2_ret_1 = out2
   return 
end

function Sawcore_process(_ctx, cv, reset)
   transition = Float32(0.0)
   out = Float32(0.0)
   if Util_change(_ctx.inst_1b0dd, cv)
      _ctx.rate = Util_cvToRate_1024(cv)
   end
   new_phase = (_ctx.phase + _ctx.rate)
   do_reset = Util_edge(_ctx.inst_204dd, (reset > Float32(0.0)))
   do_wrap = (new_phase > Float32(1024.0))
   if (do_reset || do_wrap)
      begin
         _ctx.reset_phase = _ctx.phase
         if do_wrap
            new_phase = (Float32(-1024.0) + new_phase)
         else
            new_phase = Float32(0.0)
         end
         _ctx.reset_state = true
      end
   end
   _ctx.phase = new_phase
   out = _ctx.phase
   if _ctx.reset_state
      begin
         Sawcore_ptr_w2(_ctx.inst_324dd, _ctx.phase, _ctx.rate)
         done = _ctx.inst_324dd.Sawcore_ptr_w2_ret_0
         ptr = _ctx.inst_324dd.Sawcore_ptr_w2_ret_1
         transition = (Float32(0.5) * ((Float32(1.0) + ptr) * _ctx.reset_phase))
         if done
            _ctx.reset_state = false
         else
            out = transition
         end
      end
   end
   return (Float32(-1.0) + (Float32(0.001953) * out))
end

function Sawcore_noteOn(_ctx, note, velocity, channel)
end

