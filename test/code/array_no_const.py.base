
# Runtime functions

def initializeArray(v, size):
    return [v for _ in range(size)]

class Array_no_const_main_type:
    __slots__ = ['x']
    def __init__(self, x=[0.0] * 3):
        self.x = x

def Array_no_const_main_type_alloc():
   i_0 = 0
   temp_1 = initializeArray(0.0, 3)
   _ctx = Array_no_const_main_type()
   while (i_0 < 3):
      temp_1[i_0] = 0.0
      i_0 = (1 + i_0)

   _ctx.x = temp_1
   return _ctx


def Array_no_const_bar1_array_of_real_size_3(a):
   a[0] = 1.0

def Array_no_const_bob1(a):
   _ = Array_no_const_bar1_array_of_real_size_3(a)

def Array_no_const_bar2(a):
   _ = foo(a)

def Array_no_const_bob2(a):
   _ = Array_no_const_bar2(a)

def Array_no_const_bar3_array_of_real_size_3(a):
   pass

def Array_no_const_bob3(a):
   _ = Array_no_const_bar3_array_of_real_size_3(a)

def Array_no_const_main(_ctx):
   _ = Array_no_const_bob1(_ctx.x)
   _ = Array_no_const_bob2(_ctx.x)
   _ = Array_no_const_bob3(_ctx.x)


