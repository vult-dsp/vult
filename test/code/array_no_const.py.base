import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

def Array_no_const_bar1(a):
   a[0] = 1.0

def Array_no_const_bob1(a):
   _ = Array_no_const_bar1(a)

def Array_no_const_bar2(a):
   _ = foo(a)

def Array_no_const_bob2(a):
   _ = Array_no_const_bar2(a)

def Array_no_const_bar3(a):
   pass

def Array_no_const_bob3(a):
   _ = Array_no_const_bar3(a)

