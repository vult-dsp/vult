function Ad_do(_ctx, gate, a, d)
   local a_rate = (1.0 / (0.01 + (100.0 * a)))
   local d_rate = (1.0 / (0.01 + (100.0 * d)))
   local bgate = (gate > 0.0)
   _ctx.out = ((0.004 * (((-_ctx.out) + _ctx.target) * _ctx.rate)) + _ctx.out)
   if (_ctx.state == 0) then
      do
         if Util_edge(_ctx.inst_10452, bgate) then
            do
               _ctx.state = 1
               _ctx.scale = (0.2 * gate)
            end
         end
         _ctx.rate = d_rate
         _ctx.target = 0.0
      end
   end
   if (_ctx.state == 1) then
      do
         if ((bgate == false) or (_ctx.out > 1024.0)) then
            _ctx.state = 0
         end
         _ctx.rate = a_rate
         _ctx.target = 1228.8
      end
   end
   return ((((0.000976 * _ctx.out)) > (1.0) and (1.0) or (((0.000976 * _ctx.out)) < (0.0) and (0.0) or ((0.000976 * _ctx.out)))) * _ctx.scale)
end

function Ad_process(_ctx, gate)
   return Ad_do(_ctx.inst_15232, gate, _ctx.knob1, _ctx.knob2)
end

function Ad_noteOn(_ctx, note, velocity, channel)
end

function Ad_noteOff(_ctx, note, channel)
end

function Ad_controlChange(_ctx, control, value, channel)
   if (control == 1) then
      _ctx.knob1 = (0.007874 * (value))
   end
   if (control == 2) then
      _ctx.knob2 = (0.007874 * (value))
   end
end

function Ad_default(_ctx)
   _ctx.knob1 = 0.0
   _ctx.knob2 = 0.5
end

