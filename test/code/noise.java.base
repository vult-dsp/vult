public class Noise {


static int clip(int x, int minv, int maxv) {
    if(x > maxv)
        return maxv;
    else if(x < minv)
        return minv;
    else return x;
}

static float clip(float x, float minv, float maxv) {
    if(x > maxv)
        return maxv;
    else if(x < minv)
        return minv;
    else return x;
}

static int[] makeArray(int size, int init) {
    int a[] = new int[size];
    Arrays.fill(a, init);
    return a;
}

static float[] makeArray(int size, float init) {
    float a[] = new float[size];
    Arrays.fill(a, init);
    return a;
}

static boolean[] makeArray(int size, boolean init) {
    boolean a[] = new boolean[size];
    Arrays.fill(a, init);
    return a;
}

static boolean not(boolean x) {
    return !x;
}

static float int_to_float(int x) {
    return (float)x;
}

static float bool_to_float(boolean x) {
    return x ? 1.0f : 0.0f;
}

static int float_to_int(float x) {
    return (int)x;
}

static short int16(int x) {
    return (short)Math.max(-32768, Math.min(32767, x));
}

static short int16(float x) {
    return (short)Math.max(-32768, Math.min(32767, (int)x));
}

static float floor(float x) {
    return (float)Math.floor(x);
}

static float ceil(float x) {
    return (float)Math.ceil(x);
}

static float asin(float x) {
    return (float)Math.asin(x);
}

static float acos(float x) {
    return (float)Math.acos(x);
}

static float atan(float x) {
    return (float)Math.atan(x);
}

static float atan2(float y, float x) {
    return (float)Math.atan2(y, x);
}

static float min(float a, float b) {
    return Math.min(a, b);
}

static float max(float a, float b) {
    return Math.max(a, b);
}

static int min(int a, int b) {
    return Math.min(a, b);
}

static int max(int a, int b) {
    return Math.max(a, b);
}

Random rand = new Random();

float random() {
    return rand.nextFloat();
}

int irandom() {
    return rand.nextInt();
}

static float get(float[] a, int i) {
    return a[i];
}

static void set(float[] a, int i, float val) {
    a[i] = val;
}

static int get(int[] a, int i) {
    return a[i];
}

static void set(int[] a, int i, int val) {
    a[i] = val;
}

static float[] wrap_array(float x[]) {
    return x;
}

static int[] wrap_array(int x[]) {
    return x;
}

static float cosh(float x) {
    return (float)Math.cosh(x);
}

static float cos(float x) {
    return (float)Math.cos(x);
}

static float sin(float x) {
    return (float)Math.sin(x);
}

static float sinh(float x) {
    return (float)Math.sinh(x);
}

static float tan(float x) {
    return (float)Math.tan(x);
}

static float tanh(float x) {
    return (float)Math.tanh(x);
}

static float sqrt(float x) {
    return (float)Math.sqrt(x);
}

static float pow(float x, float y) {
    return (float)Math.pow(x, y);
}

static float exp(float x) {
    return (float)Math.exp(x);
}

static float log(float x) {
    return (float)Math.log(x);
}

static float log10(float x) {
    return (float)Math.log10(x);
}

static float abs(float x) {
    return Math.abs(x);
}

static int abs(int x) {
    return Math.abs(x);
}

static float[] initializeArray(float v, int size) {
    float[] a = new float[size];
    Arrays.fill(a, v);
    return a;
}

static int[] initializeArray(int v, int size) {
    int[] a = new int[size];
    Arrays.fill(a, v);
    return a;
}

static boolean[] initializeArray(boolean v, int size) {
    boolean[] a = new boolean[size];
    Arrays.fill(a, v);
    return a;
}

static float eps() {
    return 1e-18f;
}

static float pi() {
    return 3.1415926535897932384f;
}

static int float_to_fix(float x) {
    return (int)(x * 65536.0f);
}

static int fix_to_int(int x) {
    return x >> 16;
}

static float fix_to_float(int x) {
    return ((float)x) / 65536.0f;
}


public static class Noise_pinker_type {
   public float w1;

   public Noise_pinker_type() {
      this.w1 = 0.0f;
   }
   public Noise_pinker_type(float w1) {
      this.w1 = w1;
   }}public static class Noise_process_type {
   public Noise_pinker_type inst_16d3d;
   public int x1;
   public int x2;

   public Noise_process_type() {
      this.inst_16d3d = new Noise_pinker_type();
      this.x1 = 0;
      this.x2 = 0;
   }
   public Noise_process_type(Noise_pinker_type inst_16d3d, int x1, int x2) {
      this.inst_16d3d = inst_16d3d;
      this.x1 = x1;
      this.x2 = x2;
   }}private Noise_pinker_type Noise_pinker_type_alloc() {
   Noise_pinker_type _ctx = new Noise_pinker_type();
   _ctx.w1 = 0.0f;
   return _ctx;
}

private Noise_process_type Noise_process_type_alloc() {
   Noise_process_type _ctx = new Noise_process_type();
   _ctx.inst_16d3d = Noise_pinker_type_alloc();
   _ctx.x1 = 0;
   _ctx.x2 = 0;
   return _ctx;
}

private Noise_noteOn_type Noise_noteOn_type_alloc(Noise_noteOn_type _ctx) {
   return new Noise_noteOn_type();
}

private Noise_noteOff_type Noise_noteOff_type_alloc(Noise_noteOff_type _ctx) {
   return new Noise_noteOff_type();
}

private Noise_controlChange_type Noise_controlChange_type_alloc(Noise_controlChange_type _ctx) {
   return new Noise_controlChange_type();
}

private Noise_default_type Noise_default_type_alloc(Noise_default_type _ctx) {
   return new Noise_default_type();
}

private float Noise_pinker(Noise_pinker_type _ctx, float x) {
   float b0 = 0.027712f;
   float b1 = 0.027712f;
   float a1 = -0.944575f;
   float w0 = (x + (-(a1 * _ctx.w1)));
   float y0 = ((b0 * w0) + (b1 * _ctx.w1));
   _ctx.w1 = w0;
   return y0;
}

private float Noise_process(Noise_process_type _ctx, float color) {
   _ctx.x1 = ((7919 + (17389 * _ctx.x1)) % 32768);
   float y1 = (3e-05f * (float)(_ctx.x1));
   _ctx.x2 = ((12553 + (27449 * _ctx.x2)) % 32768);
   float y2 = (3e-05f * (float)(_ctx.x2));
   float out = 0.0f;
   if ((color > 0.5f)) {
      out = Noise_pinker(_ctx.inst_16d3d, (y1 + (-y2)));
   } else {
      out = (y1 + (-y2));
   }
   return (2.0f * out);
}

private void Noise_noteOn(Noise_process_type _ctx, int note, int velocity, int channel) {
}

private void Noise_noteOff(Noise_process_type _ctx, int note, int channel) {
}

private void Noise_controlChange(Noise_process_type _ctx, int control, int value, int channel) {
}

private void Noise_default(Noise_process_type _ctx) {
}


   public static class Noise_default_type extends Noise_process_type {
       public Noise_default_type() { super(); }
   }
   public static class Noise_controlChange_type extends Noise_process_type {
       public Noise_controlChange_type() { super(); }
   }
   public static class Noise_noteOff_type extends Noise_process_type {
