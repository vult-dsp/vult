   _ctx.w1 = 0.0f;
   return _ctx;
}

private Noise_process_type Noise_process_type_alloc() {
   Noise_process_type _ctx = new Noise_process_type();
   _ctx.inst_16d3d = Noise_pinker_type_alloc();
   _ctx.x1 = 0;
   _ctx.x2 = 0;
