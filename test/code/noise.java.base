   public Noise_pinker_type(float w1) {
      this.w1 = w1;
   }}public static class Noise_process_type {
   public Noise_pinker_type inst_16d3d;
   public int x1;
   public int x2;

   public Noise_process_type() {
      this.inst_16d3d = new Noise_pinker_type();
