
# High-performance Vult Runtime for Julia with typed arrays

mutable struct Synth1_smooth_type
       x::Float32
end

# Default constructor for Synth1_smooth_type
function Synth1_smooth_type()
    return Synth1_smooth_type(Float32(0.0))
end

