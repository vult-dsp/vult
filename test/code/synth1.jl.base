mutable struct Synth1_process_type
       count::Int32
       detune::Float32
       gate::Int32
       inst_17d3d::Synth1_lfo_type
       inst_2863d::Synth1_phasor_type
       inst_3dc3d::Synth1_smooth_type
       inst_4863d::Synth1_phasor_type
       inst_5dc3d::Synth1_smooth_type
       inst_6dc3d::Synth1_smooth_type
       lfo_amt::Float32
       lfo_rate::Float32
       n1::Int32
       n2::Int32
       n3::Int32
       n4::Int32
       pitch::Float32
       pre_phase1::Float32
       volume::Float32
end

# Default constructor for Synth1_process_type
function Synth1_process_type()
    return Synth1_process_type(Int32(0), Float32(0.0), Int32(0), Synth1_lfo_type(), Synth1_phasor_type(), Synth1_smooth_type(), Synth1_phasor_type(), Synth1_smooth_type(), Synth1_smooth_type(), Float32(0.0), Float32(0.0), Int32(0), Int32(0), Int32(0), Int32(0), Float32(0.0), Float32(0.0), Float32(0.0))
end

function Synth1_smooth_type_alloc()
   _ctx = Synth1_smooth_type()
   _ctx.x = Float32(0.0)
   return _ctx
end

function Synth1_change_type_alloc()
   _ctx = Synth1_change_type()
   _ctx.pre_x = Float32(0.0)
   return _ctx
end

function Synth1_edge_type_alloc()
   _ctx = Synth1_edge_type()
   _ctx.pre_x = Int32(0)
   return _ctx
end

function Synth1_each_type_alloc()
   _ctx = Synth1_each_type()
   _ctx.count = Int32(0)
   return _ctx
end

function Synth1_phasor_type_alloc()
   _ctx = Synth1_phasor_type()
   _ctx.inst_1be86 = Synth1_change_type_alloc()
   _ctx.phase = Float32(0.0)
   _ctx.rate = Float32(0.0)
   return _ctx
end

function Synth1_lfo_type_alloc()
   _ctx = Synth1_lfo_type()
   _ctx.inst_11e7d = Synth1_edge_type_alloc()
   _ctx.phase = Float32(0.0)
   return _ctx
end

function Synth1_process_type_alloc()
   _ctx = Synth1_process_type()
   _ctx.count = Int32(0)
   _ctx.detune = Float32(0.0)
   _ctx.gate = Int32(0)
   _ctx.inst_17d3d = Synth1_lfo_type_alloc()
   _ctx.inst_2863d = Synth1_phasor_type_alloc()
   _ctx.inst_3dc3d = Synth1_smooth_type_alloc()
   _ctx.inst_4863d = Synth1_phasor_type_alloc()
   _ctx.inst_5dc3d = Synth1_smooth_type_alloc()
   _ctx.inst_6dc3d = Synth1_smooth_type_alloc()
   _ctx.lfo_amt = Float32(0.0)
   _ctx.lfo_rate = Float32(0.0)
   _ctx.n1 = Int32(0)
   _ctx.n2 = Int32(0)
   _ctx.n3 = Int32(0)
   _ctx.n4 = Int32(0)
   _ctx.pitch = Float32(0.0)
   _ctx.pre_phase1 = Float32(0.0)
   _ctx.volume = Float32(0.0)
   return _ctx
end

function Synth1_noteOn_type_alloc(_ctx)
   return Synth1_process_type_alloc()
end

function Synth1_noteOff_type_alloc(_ctx)
   return Synth1_process_type_alloc()
end

function Synth1_controlChange_type_alloc(_ctx)
   return Synth1_process_type_alloc()
end

function Synth1_default_type_alloc(_ctx)
   return Synth1_process_type_alloc()
end

function Synth1_smooth(_ctx, input)
   _ctx.x = ((Float32(0.005) * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Synth1_change(_ctx, x)
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v
end

function Synth1_edge(_ctx, x)
   v = ((_ctx.pre_x != x) && (_ctx.pre_x == Int32(0)))
   _ctx.pre_x = x
   return v
end

function Synth1_each(_ctx, n)
   ret = (_ctx.count == Int32(0))
   _ctx.count = ((Int32(1) + _ctx.count) % n)
   return ret
end

function Synth1_pitchToRate(d)
   return (Float32(0.000185) * exp((Float32(0.057762) * d)))
end

function Synth1_phasor(_ctx, pitch, reset)
   if Synth1_change(_ctx.inst_1be86, pitch)
      _ctx.rate = Synth1_pitchToRate(pitch)
   end
   if reset
      _ctx.phase = Float32(0.0)
   else
      _ctx.phase = mod((_ctx.phase + _ctx.rate), Float32(1.0))
   end
   return _ctx.phase
end

function Synth1_lfo(_ctx, f, gate)
   rate = (Float32(0.000226) * f)
   if Synth1_edge(_ctx.inst_11e7d, gate)
      _ctx.phase = Float32(0.0)
   end
   _ctx.phase = (rate + _ctx.phase)
   if (_ctx.phase > Float32(1.0))
      _ctx.phase = (Float32(-1.0) + _ctx.phase)
   end
   return (Float32(-0.5) + sin((Float32(6.283185) * _ctx.phase)))
end

function Synth1_process(_ctx, input)
   lfo_val = (Synth1_lfo(_ctx.inst_17d3d, _ctx.lfo_rate, _ctx.gate) * _ctx.lfo_amt)
   phase1 = Synth1_phasor(_ctx.inst_2863d, _ctx.pitch, false)
   comp = (Float32(1.0) + (-phase1))
   reset = (((-phase1) + _ctx.pre_phase1) > Float32(0.5))
   _ctx.pre_phase1 = phase1
   phase2 = Synth1_phasor(_ctx.inst_4863d, ((Float32(32.0) * Synth1_smooth(_ctx.inst_3dc3d, (lfo_val + _ctx.detune))) + _ctx.pitch), reset)
   sine = sin((Float32(6.283185) * phase2))
   gate_value = Float32(0.0)
   if (_ctx.gate > Int32(0))
      gate_value = Float32(1.0)
   else
      gate_value = Float32(0.0)
   end
   return (comp * (sine * (Synth1_smooth(_ctx.inst_5dc3d, _ctx.volume) * Synth1_smooth(_ctx.inst_6dc3d, gate_value))))
end

function Synth1_noteOn(_ctx, note, velocity, channel)
   if (_ctx.count == Int32(0))
      begin
         _ctx.n1 = note
         _ctx.pitch = Float32(note)
      end
   else
      if (_ctx.count == Int32(1))
         begin
            _ctx.n2 = note
            _ctx.pitch = Float32(note)
         end
      else
         if (_ctx.count == Int32(2))
            begin
               _ctx.n3 = note
               _ctx.pitch = Float32(note)
            end
         else
            if (_ctx.count == Int32(3))
               begin
                  _ctx.n4 = note
                  _ctx.pitch = Float32(note)
               end
            end
         end
      end
   end
   if (_ctx.count <= Int32(4))
      _ctx.count = (Int32(1) + _ctx.count)
   end
   if (_ctx.count > Int32(0))
      _ctx.gate = Int32(1)
   else
      _ctx.gate = Int32(0)
   end
end

function Synth1_noteOff(_ctx, note, channel)
   found = false
   if (note == _ctx.n1)
      begin
         _t_temp_0 = _ctx.n2
         _t_temp_1 = _ctx.n3
         _t_temp_2 = _ctx.n4
         _ctx.n1 = _t_temp_0
         _ctx.n2 = _t_temp_1
         _ctx.n3 = _t_temp_2
         found = true
      end
   else
      if (note == _ctx.n2)
         begin
            _t_temp_3 = _ctx.n3
            _t_temp_4 = _ctx.n4
            _ctx.n2 = _t_temp_3
            _ctx.n3 = _t_temp_4
            found = true
         end
      else
         if (note == _ctx.n3)
            begin
               _ctx.n3 = _ctx.n4
               found = true
            end
         else
            if (note == _ctx.n4)
               found = true
            end
         end
      end
   end
   if (found && (_ctx.count > Int32(0)))
      _ctx.count = (Int32(-1) + _ctx.count)
   end
   if (_ctx.count > Int32(0))
      _ctx.gate = Int32(1)
   else
      _ctx.gate = Int32(0)
   end
   if (_ctx.count == Int32(1))
      _ctx.pitch = Float32(_ctx.n1)
   end
   if (_ctx.count == Int32(2))
      _ctx.pitch = Float32(_ctx.n2)
   end
   if (_ctx.count == Int32(3))
      _ctx.pitch = Float32(_ctx.n3)
   end
   if (_ctx.count == Int32(4))
      _ctx.pitch = Float32(_ctx.n4)
   end
end

function Synth1_controlChange(_ctx, control, value, channel)
   if (control == Int32(30))
      _ctx.volume = (Float32(0.007874) * value)
   end
   if (control == Int32(31))
      _ctx.detune = (Float32(0.007874) * value)
   end
   if (control == Int32(32))
      _ctx.lfo_rate = (Float32(0.007874) * value)
   end
   if (control == Int32(33))
      _ctx.lfo_amt = (Float32(-1.0) + (Float32(0.015748) * value))
   end
end

function Synth1_default(_ctx)
   _ctx.volume = Float32(1.0)
   _ctx.pitch = Float32(45.0)
   _ctx.detune = Float32(0.8)
   _ctx.lfo_rate = Float32(0.07)
   _ctx.lfo_amt = Float32(-0.8)
end

