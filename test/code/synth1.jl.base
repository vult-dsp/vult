mutable struct Synth1_phasor_type
       inst_1be86::Synth1_change_type
       phase::Float32
       rate::Float32
end

# Default constructor for Synth1_phasor_type
function Synth1_phasor_type()
    return Synth1_phasor_type(Synth1_change_type(), Float32(0.0), Float32(0.0))
end

mutable struct Synth1_lfo_type
       inst_11e7d::Synth1_edge_type
       phase::Float32
end

# Default constructor for Synth1_lfo_type
function Synth1_lfo_type()
    return Synth1_lfo_type(Synth1_edge_type(), Float32(0.0))
