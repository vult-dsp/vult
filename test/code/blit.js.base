         _ctx.scale = (2.0 * this.Util_cvToperiod(cv));
      }
   }
   var pi_phase = (0.5 * phase);
   var denominator = this.Tables_nsine(pi_phase);
   var out = 0.0;
   if ((denominator <= this.eps())) {
      out = 1.0;
   } else {
      {
         var m_phase = ((pi_phase * this.real(_ctx.m)) % 1.0);
         var numerator = this.Tables_nsine(m_phase);
         out = (numerator / (denominator * _ctx.scale));
      }
   }
   return out;
};

this.Blit_osc_blit = function (_ctx, cv, pw, wave) {
   var fixed_cv = 0.0;
   if ((wave < 1.0)) {
      fixed_cv = cv;
   } else {
