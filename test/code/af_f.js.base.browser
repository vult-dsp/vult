function vultProcess() {
this.Af_f_process_type_alloc = function () {
   var _ctx = {};
   _ctx.x = (0|0);
   return _ctx;
};

this.Af_f_noteOn_type_alloc = function (_ctx) {
   return this.Af_f_process_type_alloc();
};

this.Af_f_noteOff_type_alloc = function (_ctx) {
   return this.Af_f_process_type_alloc();
};

this.Af_f_controlChange_type_alloc = function (_ctx) {
   return this.Af_f_process_type_alloc();
};

this.Af_f_default_type_alloc = function (_ctx) {
   return this.Af_f_process_type_alloc();
};

this.Af_f_process = function (_ctx, input) {
   _ctx.x = ((1|0) + _ctx.x);
   return (input * input);
};

this.Af_f_noteOn = function (_ctx, note, velocity, channel) {
};

this.Af_f_noteOff = function (_ctx, note, channel) {
};

this.Af_f_controlChange = function (_ctx, control, value, channel) {
};

this.Af_f_default = function (_ctx) {
};


   if(this.Af_f_process_type_alloc)  this.context =  this.Af_f_process_type_alloc(); else this.context = {};
   if(this.Af_f_default)      this.Af_f_default(this.context);
   this.liveNoteOn        = function(note,velocity,channel) { if(this.Af_f_noteOn)        this.Af_f_noteOn(this.context,note,velocity,channel); };
   this.liveNoteOff       = function(note,velocity,channel) { if(this.Af_f_noteOff)       this.Af_f_noteOff(this.context,note,velocity,channel); };
   this.liveControlChange = function(note,velocity,channel) { if(this.Af_f_controlChange) this.Af_f_controlChange(this.context,note,velocity,channel); };
   this.liveProcess       = function(input)         { if(this.Af_f_process)       return this.Af_f_process(this.context,input); else return 0; };
   this.liveDefault       = function() { if(this.Af_f_default)      return this.Af_f_default(this.context); };
   }