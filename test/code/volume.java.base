
package vult.com.volume;

import java.util.Arrays;
import java.util.Random;
import vult.com.external.*;

public class Volume {

public static class Volume_smooth_type {
   public float x;

   public Volume_smooth_type() {
      this.x = 0.0f;
   }
   public Volume_smooth_type(float x) {
      this.x = x;
   }}public static class Volume_process_type {
   public Volume_smooth_type inst_1d7d3;
   public float volume;

   public Volume_process_type() {
      this.inst_1d7d3 = new Volume_smooth_type();
      this.volume = 0.0f;
   }
   public Volume_process_type(Volume_smooth_type inst_1d7d3, float volume) {
      this.inst_1d7d3 = inst_1d7d3;
      this.volume = volume;
   }}private Volume_smooth_type Volume_smooth_type_alloc() {
   Volume_smooth_type _ctx = new Volume_smooth_type();
   _ctx.x = 0.0f;
   return _ctx;
}

private Volume_process_type Volume_process_type_alloc() {
   Volume_process_type _ctx = new Volume_process_type();
   _ctx.inst_1d7d3 = Volume_smooth_type_alloc();
   _ctx.volume = 0.0f;
   return _ctx;
}

private Volume_noteOn_type Volume_noteOn_type_alloc(Volume_noteOn_type _ctx) {
   return new Volume_noteOn_type();
}

private Volume_noteOff_type Volume_noteOff_type_alloc(Volume_noteOff_type _ctx) {
   return new Volume_noteOff_type();
}

private Volume_controlChange_type Volume_controlChange_type_alloc(Volume_controlChange_type _ctx) {
   return new Volume_controlChange_type();
}

private Volume_default_type Volume_default_type_alloc(Volume_default_type _ctx) {
   return new Volume_default_type();
}

private float Volume_smooth(Volume_smooth_type _ctx, float input) {
   _ctx.x = ((0.005f * (input + (-_ctx.x))) + _ctx.x);
   return _ctx.x;
}

private float Volume_process(Volume_process_type _ctx, float input) {
   return (input * Volume_smooth(_ctx.inst_1d7d3, _ctx.volume));
}

private void Volume_noteOn(Volume_process_type _ctx, int note, int velocity, int channel) {
}

private void Volume_noteOff(Volume_process_type _ctx, int note, int channel) {
}

private void Volume_controlChange(Volume_process_type _ctx, int control, int value, int channel) {
   if ((control == 30)) {
      _ctx.volume = (0.007874f * (float)(value));
   }
}

private void Volume_default(Volume_process_type _ctx) {
   _ctx.volume = 0.0f;
}


   public static class Volume_default_type extends Volume_process_type {
       public Volume_default_type() { super(); }
   }
   public static class Volume_controlChange_type extends Volume_process_type {
       public Volume_controlChange_type() { super(); }
   }
   public static class Volume_noteOff_type extends Volume_process_type {
       public Volume_noteOff_type() { super(); }
   }
   public static class Volume_noteOn_type extends Volume_process_type {
       public Volume_noteOn_type() { super(); }
   }

}
