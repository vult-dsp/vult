def Util_cvTokHz(cv):
   value = (((0.0) if (cv) < (0.0) else ((1.0) if (cv) > (1.0) else (cv))) * 32.0)
   cell = ((0) if (float_to_int(value)) < (0) else ((31) if (float_to_int(value)) > (31) else (float_to_int(value))))
   u = (value - float(cell))
   index = (cell * 3)
   return (Util_cvTokHz_c[index] + (u * (Util_cvTokHz_c[(index + 1)] + (Util_cvTokHz_c[(index + 2)] * u))))


def Phase_process(_ctx, cv, reset):
   if Util_change(_ctx.inst_1b08a, cv):
      _ctx.rate = Util_cvToRate_1024(cv)
   if Util_edge(_ctx.inst_2048a, (reset > 0.5)):
      _ctx.phase = 0.0
   else:
      _ctx.phase = (_ctx.phase + _ctx.rate)
   if (_ctx.phase > 1024.0):
      _ctx.phase = (-1024.0 + _ctx.phase)
   else:
      _ctx.phase = _ctx.phase
   return (0.000976 * _ctx.phase)


