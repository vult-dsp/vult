Tables_nsine_c = {}
def Tables_nsine_raw_c0(index):
   return Tables_nsine_c[(index * 3)]

def Tables_nsine_raw_c1(index):
   return Tables_nsine_c[((index * 3) + 1)]

def Tables_nsine_raw_c2(index):
   return Tables_nsine_c[((index * 3) + 2)]

def Tables_nsine(x):
   value = (((0.0) if (x) < (0.0) else ((1.0) if (x) > (1.0) else (x))) * 128.0)
   cell = ((0) if (float_to_int(value)) < (0) else ((127) if (float_to_int(value)) > (127) else (float_to_int(value))))
   u = (value - float(cell))
   index = (cell * 3)
   return (Tables_nsine_c[index] + (u * (Tables_nsine_c[(index + 1)] + (Tables_nsine_c[(index + 2)] * u))))


def Blit_pulse_train(_ctx, cv, phase):
   if Util_change(_ctx.inst_1b05e, cv):
      _ctx.m = (1 + (int(Util_cvToperiod(cv)) << 1))
      _ctx.scale = (2.0 * Util_cvToperiod(cv))

   pi_phase = (0.5 * phase)
   denominator = Tables_nsine(pi_phase)
   out = 0.0
   if (denominator <= 1e-18):
      out = 1.0
   else:
      m_phase = ((pi_phase * float(_ctx.m)) % 1.0)
      numerator = Tables_nsine(m_phase)
      out = (numerator / (denominator * _ctx.scale))

   return out


def Blit_osc_blit(_ctx, cv, pw, wave):
   fixed_cv = 0.0
   if (wave < 1.0):
      fixed_cv = cv
   else:
      fixed_cv = (-0.1 + cv)
   if Util_change(_ctx.inst_1b026, fixed_cv):
      _ctx.rate = Util_cvToRate(fixed_cv)
   phase = Phase_process(_ctx.inst_28a26, fixed_cv, 0.0)
   shift05 = (0.5 + (0.49 * pw))
   shift = (phase + shift05)
   if (shift > 1.0):
      shift = (-1.0 + shift)
   pulse1 = Blit_pulse_train(_ctx.inst_35e26, fixed_cv, phase)
   pulse2 = Blit_pulse_train(_ctx.inst_45e26, fixed_cv, shift)
   _ctx.state_pulse = (pulse1 + ((-pulse2) + (0.9995 * _ctx.state_pulse)))
   _ctx.state_saw = ((0.5 * ((pulse1 + (pulse2 + (-2.0 * _ctx.rate))) / shift05)) + (0.9995 * _ctx.state_saw))
   if (wave < 1.0):
      _ctx.output = _ctx.state_pulse
   else:
      _ctx.output = (2.0 * _ctx.state_saw)
   _ctx.output = Util_dcblock(_ctx.inst_56426, _ctx.output)
   return _ctx.output


def Blit_process(_ctx, cv, pw, wave):
   return Blit_osc_blit(_ctx.inst_1268b, cv, pw, wave)

