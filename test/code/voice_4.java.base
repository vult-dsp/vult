static int clip(int x, int minv, int maxv) {
    if(x > maxv)
        return maxv;
    else if(x < minv)
        return minv;
    else return x;
}

static float clip(float x, float minv, float maxv) {
    if(x > maxv)
        return maxv;
    else if(x < minv)
        return minv;
    else return x;
}

static int[] makeArray(int size, int init) {
