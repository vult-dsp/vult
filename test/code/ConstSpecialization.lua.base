
-- LuaJIT detection
local isLuaJIT = type(jit) == "table" and jit.version


-- Numeric arrays use FFI storage under LuaJIT, tables everywhere else.
local initializeArray
if isLuaJIT then
    local ffi = require("ffi")
    function initializeArray(v, n)
        if type(v) == "number" then
            -- One-based, so element zero is unused. This is cdata, not a
            -- table: indexing works, '#' and pairs() do not.
            local a = ffi.new("double[?]", n + 1)
            for i = 1, n do a[i] = v end
            return a
        else
            local a = {}
            for i = 1, n do a[i] = v end
            return a
        end
    end
else
    function initializeArray(v, n)
        local a = {}
        for i = 1, n do a[i] = v end
        return a
    end
end


-- Bit operations, using the LuaJIT bit library when available
local lshift, rshift
if isLuaJIT then
    local bit = require("bit")
    lshift = bit.lshift
    rshift = bit.rshift
else
    -- Arithmetic fallback for standard Lua
    function lshift(a, b) return a * (2 ^ b) end
    function rshift(a, b) return math.floor(a / (2 ^ b)) end
end


function ConstSpecialization_accumulate_real_real_2_type_alloc()
   local _ctx = {};
   _ctx.sum = 0.0
   return _ctx
end

function ConstSpecialization_accumulate_real_dyn_real_type_alloc()
   local _ctx = {};
   _ctx.sum = 0.0
   return _ctx
end

function ConstSpecialization_test_accumulate_spec_type_alloc()
   local _ctx = {};
   _ctx.inst_124c4 = ConstSpecialization_accumulate_real_real_2_type_alloc()
   return _ctx
end

function ConstSpecialization_test_accumulate_nonspec_type_alloc()
   local _ctx = {};
   _ctx.inst_1053f = ConstSpecialization_accumulate_real_dyn_real_type_alloc()
   return _ctx
end

function ConstSpecialization_scale_typed_real_int_2_type_alloc()
   local _ctx = {};
   _ctx.last = 0.0
   return _ctx
end

function ConstSpecialization_scale_typed_int_int_2_type_alloc()
   local _ctx = {};
   _ctx.last = 0
   return _ctx
end

function ConstSpecialization_test_typed_int_type_alloc()
   local _ctx = {};
   _ctx.inst_1e935 = ConstSpecialization_scale_typed_int_int_2_type_alloc()
   return _ctx
end

function ConstSpecialization_test_typed_real_type_alloc()
   local _ctx = {};
   _ctx.inst_1537d = ConstSpecialization_scale_typed_real_int_2_type_alloc()
   return _ctx
end

function ConstSpecialization_main_type_alloc()
   local _ctx = {};
   _ctx.inst_13dfa = ConstSpecialization_test_accumulate_spec_type_alloc()
   _ctx.inst_201fa = ConstSpecialization_test_accumulate_nonspec_type_alloc()
   _ctx.inst_3e2fa = ConstSpecialization_test_typed_int_type_alloc()
   _ctx.inst_477fa = ConstSpecialization_test_typed_real_type_alloc()
   return _ctx
end

function ConstSpecialization_add_n_int_int_5(x)
   return (5 + x)
end

function ConstSpecialization_add_n_int_int_100(x)
   return (100 + x)
end

function ConstSpecialization_add_n_int_dyn_int(n, x)
   return (n + x)
end

function ConstSpecialization_test_specialized_5()
   return ConstSpecialization_add_n_int_int_5(10)
end

function ConstSpecialization_test_specialized_100()
   return ConstSpecialization_add_n_int_int_100(10)
end

function ConstSpecialization_test_nonspec(n)
   return ConstSpecialization_add_n_int_dyn_int(n, 10)
end

function ConstSpecialization_weighted_real_real_real_0_3_real_0_7(x, y)
   return ((0.3 * x) + (0.7 * y))
end

function ConstSpecialization_weighted_real_real_dyn_real_real(w1, w2, x, y)
   return ((w1 * x) + (w2 * y))
end

function ConstSpecialization_test_weighted_spec()
   return ConstSpecialization_weighted_real_real_real_0_3_real_0_7(10.0, 20.0)
end

function ConstSpecialization_test_weighted_nonspec(w)
   return ConstSpecialization_weighted_real_real_dyn_real_real(w, 0.7, 10.0, 20.0)
end

function ConstSpecialization_interleaved_real_real_real_2_real_3(x, y)
   return ((2.0 * x) + (3.0 * y))
end

function ConstSpecialization_interleaved_real_real_dyn_real_real(x, a, y, b)
   return ((a * x) + (b * y))
end

function ConstSpecialization_test_interleaved_spec()
   return ConstSpecialization_interleaved_real_real_real_2_real_3(5.0, 4.0)
end

function ConstSpecialization_test_interleaved_nonspec(a)
   return ConstSpecialization_interleaved_real_real_dyn_real_real(5.0, a, 4.0, 3.0)
end

function ConstSpecialization_accumulate_real_real_2(_ctx, x)
   _ctx.sum = ((2.0 * x) + _ctx.sum)
   return _ctx.sum
end

function ConstSpecialization_accumulate_real_dyn_real(_ctx, scale, x)
   _ctx.sum = ((scale * x) + _ctx.sum)
   return _ctx.sum
end

function ConstSpecialization_test_accumulate_spec(_ctx)
   return ConstSpecialization_accumulate_real_real_2(_ctx.inst_124c4, 5.0)
end

function ConstSpecialization_test_accumulate_nonspec(_ctx, s, x)
   return ConstSpecialization_accumulate_real_dyn_real(_ctx.inst_1053f, s, x)
end

function ConstSpecialization_scale_typed_int_int_2(_ctx, x)
   _ctx.last = x
   return x
end

function ConstSpecialization_scale_typed_real_int_2(_ctx, x)
   _ctx.last = x
   return x
end

function ConstSpecialization_test_typed_int(_ctx)
   return ConstSpecialization_scale_typed_int_int_2(_ctx.inst_1e935, 42)
end

function ConstSpecialization_test_typed_real(_ctx)
   return ConstSpecialization_scale_typed_real_int_2(_ctx.inst_1537d, 3.14)
end

function ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_0(m, value)
   m[1] = value
end

function ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_1(m, value)
   m[2] = value
end

function ConstSpecialization_test_array_mutation(m, x)
   ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_0(m, x[1])
   ConstSpecialization_setArrayElement_array_of_real_size_4_real_int_1(m, x[2])
end

function ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_0(m, value)
   m[1] = value
end

function ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_1(m, value)
   m[3] = value
end

function ConstSpecialization_setMatrix2_array_of_real_size_4_real_dyn_int_int(m, row, col, value)
   m[(row + lshift(col, 1)) + 1] = value
end

function ConstSpecialization_getMatrix2_array_of_real_size_4_dyn_int_int(m, row, col)
   return m[((row + lshift(col, 1))) + 1]
end

function ConstSpecialization_test_matrix_mutation(m, x)
   ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_0(m, x[1])
   ConstSpecialization_setMatrix2_array_of_real_size_4_real_int_0_int_1(m, x[2])
end

function ConstSpecialization_eliminate_row(m, row, col)
   local k = ConstSpecialization_getMatrix2_array_of_real_size_4_dyn_int_int(m, row, col)
   ConstSpecialization_setMatrix2_array_of_real_size_4_real_dyn_int_int(m, row, col, (1.0 + k))
end

function ConstSpecialization_process_matrix(m)
   local row = 0
   while (row < 2) do
      do
         ConstSpecialization_eliminate_row(m, row, 0)
         row = (1 + row)
      end
   end
end

function ConstSpecialization_main(_ctx)
   ConstSpecialization_test_accumulate_spec(_ctx.inst_13dfa)
   ConstSpecialization_test_accumulate_nonspec(_ctx.inst_201fa, 3.0, 4.0)
   ConstSpecialization_test_typed_int(_ctx.inst_3e2fa)
   ConstSpecialization_test_typed_real(_ctx.inst_477fa)
   local inputs = initializeArray(0.0, 2)
   inputs[1] = 1.0
   inputs[2] = 2.0
   local arr = initializeArray(0.0, 4)
   ConstSpecialization_test_array_mutation(arr, inputs)
   ConstSpecialization_test_matrix_mutation(arr, inputs)
   ConstSpecialization_process_matrix(arr)
end

