
IntegerDivision[a_, b_] := Floor[a / b];
newEmptyObject[] := CreateDataStructure["HashTable"];
setValue[var_, key_, value_] := var["Insert", key -> value];
getValue[var_, key_] := var["Lookup", key];
newObject[elems_] := Module[{t = newEmptyObject[]}, Map[t["Insert", #] &, elems]; t];
newArray[v_, n_] := Table[v, n];

Util`edge`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"pre",False];
   Return[`ctx];
]

Util`change`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"pre_x",0.];
   Return[`ctx];
]

Util`dcblock`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x1",0.];
   setValue[`ctx,"y1",0.];
   Return[`ctx];
]

Util`smooth`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x",0.];
   Return[`ctx];
]

Util`average2`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x0",0.];
   Return[`ctx];
]

Util`cvToPitch[cv_] := 
   Return[(24. + (120. * cv))];


Svf`calc`g`c0 = {};
Svf`calc`g`c1 = {};
Svf`calc`g`c2 = {};
Svf`calc`g`raw`c0[index_] := 
   Return[Svf`calc`g`c0[[index + 1]]];


Svf`calc`g`raw`c1[index_] := 
   Return[Svf`calc`g`c1[[index + 1]]];


Svf`calc`g`raw`c2[index_] := 
   Return[Svf`calc`g`c2[[index + 1]]];


Svf`calc`g[cv_] := Module[{ index }, 
   index = Clip[Floor[(cv * 141.111111)], {0, 127}];
   Return[(Svf`calc`g`c0[[index + 1]] + (cv * (Svf`calc`g`c1[[index + 1]] + (Svf`calc`g`c2[[index + 1]] * cv))))];
]

Svf`default[`ctx_] := Module[{  }, 
   setValue[`ctx,"g",Svf`calc`g[0.]];
   setValue[`ctx,"r",1.];
   setValue[`ctx,"inv_den",(1. / (1. + (getValue[`ctx, "g"] * getValue[`ctx, "g"])))];
]

Svf`process`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"g",0.];
   setValue[`ctx,"inst_1b0a2",Util`change`type`alloc[]];
   setValue[`ctx,"inst_2b0a2",Util`change`type`alloc[]];
   setValue[`ctx,"inv_den",0.];
   setValue[`ctx,"r",0.];
   setValue[`ctx,"z1",0.];
   setValue[`ctx,"z2",0.];
   Svf`default[`ctx];
   Return[`ctx];
]

Svf`noteOn`type`alloc[`ctx_] := 
   Return[Svf`process`type`alloc[]];


Svf`noteOff`type`alloc[`ctx_] := 
   Return[Svf`process`type`alloc[]];


Svf`controlChange`type`alloc[`ctx_] := 
   Return[Svf`process`type`alloc[]];


Svf`default`type`alloc[`ctx_] := 
   Return[Svf`process`type`alloc[]];


Util`edge[`ctx_, x_] := Module[{ ret }, 
   ret = (x && (getValue[`ctx, "pre"] == False));
   setValue[`ctx,"pre",x];
   Return[ret];
]

Util`change[`ctx_, x_] := Module[{ v }, 
   v = (getValue[`ctx, "pre_x"] != x);
   setValue[`ctx,"pre_x",x];
   Return[v];
]

Util`map[x_, x0_, x1_, y0_, y1_] := 
   Return[(y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))];


Util`dcblock[`ctx_, x0_] := Module[{ y0 }, 
   y0 = (x0 + ((-getValue[`ctx, "x1"]) + (0.995 * getValue[`ctx, "y1"])));
   setValue[`ctx,"x1",x0];
   setValue[`ctx,"y1",y0];
   Return[y0];
]

Util`smooth[`ctx_, input_] := Module[{  }, 
   setValue[`ctx,"x",((0.005 * (input + (-getValue[`ctx, "x"]))) + getValue[`ctx, "x"])];
   Return[getValue[`ctx, "x"]];
]

Util`average2[`ctx_, x1_] := Module[{ result }, 
   result = (0.5 * (x1 + getValue[`ctx, "x0"]));
   setValue[`ctx,"x0",x1];
   Return[result];
]

Util`cubic`clipper[x_] := 
   If[(x <= -0.666667), 
      Return[-0.666667];, 
      If[(x >= 0.666666), 
         Return[0.666666];, 
         Return[(x + (-0.333334 * (x * (x * x))))];];];


