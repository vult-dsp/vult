
// Runtime functions (simple builtins like eps, pi, clip, real, int_, sin, cos, etc. are inlined)
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
this.Array_dimension_total = function (data) {
   var acc = 0.0;
   var i__1 = (0|0);
   while ((i__1 < this.size(data))) {
      {
         acc = (acc + data[i__1]);
         i__1 = ((1|0) + i__1);
      }
   }
   return acc;
};

this.Array_dimension_sum = function (data1, data2) {
   var acc = 0.0;
   var i__1 = (0|0);
   while ((i__1 < this.size(data1))) {
      {
         acc = (acc + (data1[i__1] + data2[i__1]));
         i__1 = ((1|0) + i__1);
      }
   }
   return acc;
};

this.Array_dimension_main = function () {
   var x = [1.0, 2.0];
   var y = [1.0, 2.0, 3.0];
   var z = (this.Array_dimension_total(x) + this.Array_dimension_total(y));
   var k = this.Array_dimension_sum(x, y);
};

