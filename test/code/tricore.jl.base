function Tricore_process(_ctx, cv, reset, disable)
   out = Float32(0.0)
   if Util_change(_ctx.inst_1b03c, cv)
      _ctx.rate = (Float32(4.0) * Util_cvToRate_1024(cv))
   end
   new_phase = Float32(0.0)
   _if_temp_0 = Float32(0.0)
   if _ctx.direction
      _if_temp_0 = _ctx.rate
   else
      _if_temp_0 = (-_ctx.rate)
   end
   new_phase = (_if_temp_0 + _ctx.phase)
   bdisable = (disable > Float32(0.5))
   if (Util_edge(_ctx.inst_2043c, (reset > Float32(0.0))) || Util_edge(_ctx.inst_3043c, bdisable))
      begin
         _ctx.reset_phase = _ctx.phase
         _ctx.reset_state = true
         new_phase = Float32(0.0)
      end
   end
   if (new_phase > Float32(1024.0))
      begin
         new_phase = (Float32(2048.0) + (-new_phase))
         _ctx.direction = false
      end
   else
      if (new_phase < Float32(-1024.0))
         _ctx.direction = true
      end
   end
   if bdisable
      _ctx.phase = Float32(0.0)
   else
      _ctx.phase = new_phase
   end
   if _ctx.reset_state
      begin
         if ((abs(_ctx.reset_phase) > Float32(10.0)) || bdisable)
            begin
               reset_speed = Float32(0.0)
               if bdisable
                  reset_speed = Float32(0.01)
               else
                  reset_speed = Float32(0.5)
               end
               _ctx.reset_phase = ((-(reset_speed * _ctx.reset_phase)) + _ctx.reset_phase)
            end
         else
            begin
               if (_ctx.reset_phase > Float32(10.0))
                  _ctx.reset_phase = _ctx.reset_phase
               else
                  _ctx.reset_phase = Float32(0.0)
               end
               _ctx.reset_state = false
               _ctx.direction = true
            end
         end
         out = _ctx.reset_phase
      end
   end
   out = (out + _ctx.phase)
   return (Float32(0.000976) * out)
end

function Tricore_noteOn(_ctx, note, velocity, channel)
end

