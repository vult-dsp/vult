function Util_cvToRate(cv)
   index = clamp(trunc(Int32, (cv * Float32(141.111111))), Int32(0), Int32(127))
   return (@inbounds Util_cvToRate_c0[index + 1] + (cv * (@inbounds Util_cvToRate_c1[index + 1] + (@inbounds Util_cvToRate_c2[index + 1] * cv))))
end

function Util_pitchToCv(pitch)
   return (Float32(-0.2) + (Float32(0.008333) * pitch))
end

