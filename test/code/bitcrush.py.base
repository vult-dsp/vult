import math
import random as random_module

def eps():
    return 1e-18

def pi():
    return 3.1415926535897932384

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def clip(x, low, high):
    return low if x < low else (high if x > high else x)

def not_(x):
    return 0 if x != 0 else 1

def real(x):
    return float(x)

def int_(x):
    return int(x)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

Bitcrush_factor_c0 = {}
Bitcrush_factor_c1 = {}
Bitcrush_factor_c2 = {}
def Bitcrush_factor_raw_c0(index):
   return Bitcrush_factor_c0[index]

def Bitcrush_factor_raw_c1(index):
   return Bitcrush_factor_c1[index]

def Bitcrush_factor_raw_c2(index):
   return Bitcrush_factor_c2[index]

def Bitcrush_factor(cv):
   index = clip(float_to_int((cv * 127.0)), 0, 127)
   return (Bitcrush_factor_c0[index] + (cv * (Bitcrush_factor_c1[index] + (Bitcrush_factor_c2[index] * cv))))


def Bitcrush_process(i, cv):
   out = i
   if (cv == 0.0):
      out = i
   else:
      b = Bitcrush_factor(cv)
      x = int((b * i))
      out = (real(x) / b)

   return out


def Bitcrush_noteOn(note, velocity, channel):
   pass

def Bitcrush_noteOff(note, channel):
   pass

def Bitcrush_controlChange(control, value, channel):
   pass

def Bitcrush_default():
   pass

