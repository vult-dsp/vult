

function Match_foo1(x)
   if (x == 0) then
      return 0
   else
      if (x == 1) then
         return 1
      else
         return 2
      end
   end
end

function Match_foo2(x, y)
   if ((x == 1) and (y == "e")) then
      return (1 + x)
   else
      if (x == 3) then
         return 1
      else
         return 2
      end
   end
end

function Match_foo3(x)
   if (x == 0) then
      return 1
   else
      if (x == 1) then
         return 2
      else
         return 0
      end
   end
end

