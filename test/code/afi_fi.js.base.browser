function vultProcess() {

// Runtime functions (simple builtins like eps, pi, clip, real, int_, sin, cos, etc. are inlined)
this.random = function()         { return Math.random(); };
this.irandom = function()        { return Math.floor(Math.random() * 4294967296); };
this.int_to_float = function(i)  { return i; };
this.float_to_int = function(i)  { return Math.floor(i); };
this.initializeArray = function(v, size){ var a = new Array(size); for(var i=0;i<size;i++) a[i]=v; return a; };
this.Afi_fi_process_type_alloc = function () {
   var _ctx = {};
   _ctx.Afi_fi_process_ret_0 = 0.0;
   _ctx.Afi_fi_process_ret_1 = (0|0);
   _ctx.x = (0|0);
   return _ctx;
};

this.Afi_fi_noteOn_type_alloc = function (_ctx) {
   return this.Afi_fi_process_type_alloc();
};

this.Afi_fi_noteOff_type_alloc = function (_ctx) {
   return this.Afi_fi_process_type_alloc();
};

this.Afi_fi_controlChange_type_alloc = function (_ctx) {
   return this.Afi_fi_process_type_alloc();
};

this.Afi_fi_default_type_alloc = function (_ctx) {
   return this.Afi_fi_process_type_alloc();
};

this.Afi_fi_process = function (_ctx, a, b) {
   _ctx.x = ((1|0) + _ctx.x);
   _ctx.Afi_fi_process_ret_0 = a;
   _ctx.Afi_fi_process_ret_1 = b;
   return ;
};

this.Afi_fi_noteOn = function (_ctx, note, velocity, channel) {
};

this.Afi_fi_noteOff = function (_ctx, note, channel) {
};

this.Afi_fi_controlChange = function (_ctx, control, value, channel) {
};

this.Afi_fi_default = function (_ctx) {
};


   if(this.Afi_fi_process_type_alloc)  this.context =  this.Afi_fi_process_type_alloc(); else this.context = {};
   if(this.Afi_fi_default)      this.Afi_fi_default(this.context);
   this.liveNoteOn        = function(note,velocity,channel) { if(this.Afi_fi_noteOn)        this.Afi_fi_noteOn(this.context,note,velocity,channel); };
   this.liveNoteOff       = function(note,velocity,channel) { if(this.Afi_fi_noteOff)       this.Afi_fi_noteOff(this.context,note,velocity,channel); };
   this.liveControlChange = function(note,velocity,channel) { if(this.Afi_fi_controlChange) this.Afi_fi_controlChange(this.context,note,velocity,channel); };
   this.liveProcess       = function(input)         { if(this.Afi_fi_process)       return this.Afi_fi_process(this.context,input); else return 0; };
   this.liveDefault       = function() { if(this.Afi_fi_default)      return this.Afi_fi_default(this.context); };
   }