import math

# Runtime functions

def float_to_int(i):
    return int(math.floor(i))

Tables_sineTable1_c = {}
def Tables_sineTable1_raw_c0(index):
   return Tables_sineTable1_c[(index * 3)]

def Tables_sineTable1_raw_c1(index):
   return Tables_sineTable1_c[((index * 3) + 1)]

def Tables_sineTable1_raw_c2(index):
   return Tables_sineTable1_c[((index * 3) + 2)]

def Tables_sineTable1(x):
   value = (((0.0) if (x) < (0.0) else ((1.0) if (x) > (1.0) else (x))) * 32.0)
   cell = ((0) if (float_to_int(value)) < (0) else ((31) if (float_to_int(value)) > (31) else (float_to_int(value))))
   u = (value - float(cell))
   index = (cell * 3)
   return (Tables_sineTable1_c[index] + (u * (Tables_sineTable1_c[(index + 1)] + (Tables_sineTable1_c[(index + 2)] * u))))


Tables_sineTable2_c = {}
def Tables_sineTable2_raw_c0(index):
   return Tables_sineTable2_c[(index * 2)]

def Tables_sineTable2_raw_c1(index):
   return Tables_sineTable2_c[((index * 2) + 1)]

def Tables_sineTable2(x):
   value = (((0.0) if (x) < (0.0) else ((1.0) if (x) > (1.0) else (x))) * 32.0)
   cell = ((0) if (float_to_int(value)) < (0) else ((31) if (float_to_int(value)) > (31) else (float_to_int(value))))
   u = (value - float(cell))
   index = (cell * 2)
   return (Tables_sineTable2_c[index] + (u * Tables_sineTable2_c[(index + 1)]))


Tables_sineTable3_c = {}
def Tables_sineTable3_raw_c0(index):
   return Tables_sineTable3_c[(index * 2)]

def Tables_sineTable3_raw_c1(index):
   return Tables_sineTable3_c[((index * 2) + 1)]

def Tables_sineTable3(x):
   value = (((0.0) if (x) < (0.0) else ((1.0) if (x) > (1.0) else (x))) * 33.0)
   index = (int(value) * 2)
   decimal = (value - math.floor(value))
   return (Tables_sineTable3_c[index] + (Tables_sineTable3_c[(index + 1)] * decimal))


