

function Array_dimension_total(data)
   local acc = 0.0
   local i__1 = 0
   while (i__1 < size(data)) do
      do
         acc = (acc + data[(i__1) + 1])
         i__1 = (1 + i__1)
      end
   end
   return acc
end

function Array_dimension_sum(data1, data2)
   local acc = 0.0
   local i__1 = 0
   while (i__1 < size(data1)) do
      do
         acc = (acc + (data1[(i__1) + 1] + data2[(i__1) + 1]))
         i__1 = (1 + i__1)
      end
   end
   return acc
end

function Array_dimension_main()
   local x = {1.0, 2.0}
   local y = {1.0, 2.0, 3.0}
   local z = (Array_dimension_total(x) + Array_dimension_total(y))
   local k = Array_dimension_sum(x, y)
end

