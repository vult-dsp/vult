def Ahr_do(_ctx, gate, a, h, r):
   release = 0
   attack = 1
   hold = 2
   reset = 3
   bgate = (gate > 0.0)
   if Util_edge(_ctx.inst_104d8, bgate):
      _ctx.state = reset
   resetting = 0.0
   if (_ctx.state == reset):
      resetting = 1.0
   else:
      resetting = 0.0
   if Util_edge(_ctx.inst_204d8, (_ctx.out > 1024.0)):
      _ctx.hold_phase = 0.0
      _ctx.state = hold

   if ((_ctx.out < 10.0) and (_ctx.state == reset)):
      _ctx.state = attack
   if ((_ctx.hold_phase > 100.0) and (_ctx.state == hold)):
      _ctx.state = release
   if (_ctx.state == reset):
      _ctx.rate = 0.990099
      _ctx.target = 0.0

   if (_ctx.state == attack):
      _ctx.rate = (1.0 / (0.01 + (100.0 * a)))
      _ctx.target = 1228.8

   if (_ctx.state == hold):
      hrate = (1.0 / (0.01 + (100.0 * h)))
      _ctx.hold_phase = (hrate + _ctx.hold_phase)

   if (_ctx.state == release):
      _ctx.rate = (1.0 / (0.01 + (100.0 * r)))
      _ctx.target = 0.0

   _ctx.out = ((0.005 * (((-_ctx.out) + _ctx.target) * _ctx.rate)) + _ctx.out)
   _ctx.Ahr_do_ret_0 = ((0.0) if ((0.000976 * _ctx.out)) < (0.0) else ((1.0) if ((0.000976 * _ctx.out)) > (1.0) else ((0.000976 * _ctx.out))))
   _ctx.Ahr_do_ret_1 = resetting
   return None


