   if (control == 30):
      _ctx["odecay"] = (0.007874 * real(value))
   if (control == 31):
      _ctx["pitch"] = Util_map(real(value), 0.0, 127.0, 0.0, 0.1)
   if (control == 32):
      _ctx["swept"] = (0.007874 * real(value))
   if (control == 33):
      _ctx["noise"] = (0.007874 * real(value))


