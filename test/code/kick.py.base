def Tricore_process(_ctx, cv, reset, disable):
   out = 0.0
   if Util_change(_ctx.inst_1b03c, cv):
      _ctx.rate = (4.0 * Util_cvToRate_1024(cv))
   new_phase = ((_ctx.rate if _ctx.direction else (-_ctx.rate)) + _ctx.phase)
   bdisable = (disable > 0.5)
   if (Util_edge(_ctx.inst_2043c, (reset > 0.0)) or Util_edge(_ctx.inst_3043c, bdisable)):
      _ctx.reset_phase = _ctx.phase
      _ctx.reset_state = True
      new_phase = 0.0

   if (new_phase > 1024.0):
      new_phase = (2048.0 + (-new_phase))
      _ctx.direction = False

   else:
      if (new_phase < -1024.0):
         _ctx.direction = True
   if bdisable:
      _ctx.phase = 0.0
   else:
      _ctx.phase = new_phase
   if _ctx.reset_state:
      if ((abs(_ctx.reset_phase) > 10.0) or bdisable):
         reset_speed = 0.0
         if bdisable:
            reset_speed = 0.01
         else:
            reset_speed = 0.5
         _ctx.reset_phase = ((-(reset_speed * _ctx.reset_phase)) + _ctx.reset_phase)

      else:
         if (_ctx.reset_phase > 10.0):
            _ctx.reset_phase = _ctx.reset_phase
         else:
            _ctx.reset_phase = 0.0
         _ctx.reset_state = False
         _ctx.direction = True

      out = _ctx.reset_phase

   out = (out + _ctx.phase)
   return (0.000976 * out)


