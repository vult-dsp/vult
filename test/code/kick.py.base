def Kick_do(_ctx, gate, odecay, pitch, swept, noise):
   _ = Ahr_do(_ctx.inst_1d863, gate, 0.005, (0.1 + odecay), (0.01 + odecay))
   osc_env = _ctx.inst_1d863.Ahr_do_ret_0
   env_reset = _ctx.inst_1d863.Ahr_do_ret_1
   cv = Swept_process(_ctx.inst_20263, (1.0 + (-env_reset)), (pitch + (0.4 * swept)), pitch, 0.1)
   osc = Tricore_process(_ctx.inst_33c63, cv, 0.0, env_reset)
   osc_sat = Saturate_process((1.5 * osc))
   _ = Ahr_do(_ctx.inst_4d863, gate, 0.001, 0.01, (0.001 + (0.01 * noise)))
   noise_env = _ctx.inst_4d863.Ahr_do_ret_0
   noise_osc = (0.333333 * (noise * Noise_process(_ctx.inst_53d63, 1.0)))
   return ((noise_env * noise_osc) + (osc_env * osc_sat))


def Kick_process(_ctx, gate):
   return Kick_do(_ctx.inst_16352, gate, _ctx.odecay, _ctx.pitch, _ctx.swept, _ctx.noise)

def Kick_noteOn(_ctx, note, velocity, channel):
   pass

def Kick_noteOff(_ctx, note, channel):
   pass

def Kick_controlChange(_ctx, control, value, channel):
   if (control == 30):
      _ctx.odecay = (0.007874 * float(value))
   if (control == 31):
      _ctx.pitch = Util_map(float(value), 0.0, 127.0, 0.0, 0.1)
   if (control == 32):
      _ctx.swept = (0.007874 * float(value))
   if (control == 33):
      _ctx.noise = (0.007874 * float(value))


def Kick_default(_ctx):
   pass

