def Swept_process(_ctx, gate, start, end, rate):
   a_rate = (1.0 / (0.01 + (100.0 * rate)))
   bgate = (gate > 0.5)
   _ctx["out"] = ((0.004 * (rate * ((-_ctx["out"]) + (1024.0 * end)))) + _ctx["out"])
   if Util_edge(_ctx["inst_10402"], bgate):
      _ctx["out"] = (1024.0 * start)
   return (0.000976 * _ctx["out"])


