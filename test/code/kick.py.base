   _ctx.w1 = w0
   return y0


def Noise_process(_ctx, color):
   _ctx.x1 = ((7919 + (17389 * _ctx.x1)) % 32768)
   y1 = (3e-05 * float(_ctx.x1))
   _ctx.x2 = ((12553 + (27449 * _ctx.x2)) % 32768)
   y2 = (3e-05 * float(_ctx.x2))
   out = 0.0
   if (color > 0.5):
      out = Noise_pinker(_ctx.inst_16d3d, (y1 + (-y2)))
   else:
      out = (y1 + (-y2))
   return (2.0 * out)


