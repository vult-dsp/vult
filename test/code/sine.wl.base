Tables`nsine[x_] := Module[{ index }, 
   index = Clip[Floor[(x * 127.)], {0, 127}];
   Return[(Tables`nsine`c0[[index + 1]] + (x * (Tables`nsine`c1[[index + 1]] + (Tables`nsine`c2[[index + 1]] * x))))];
]

Sine`process[`ctx_, cv_, reset_] := Module[{ phase }, 
   If[Util`edge[getValue[`ctx, "inst_104ba"], (reset > 0.5)], 
      setValue[`ctx,"trig",True];];
   phase = Phase`process[getValue[`ctx, "p"], cv, 0.];
   If[((phase < eps[]) && getValue[`ctx, "trig"]), 
      Module[{  }, 
         setValue[`ctx,"trig",False];
         Phase`process[getValue[`ctx, "p"], cv, 0.];
      ];];
   Return[Tables`nsine[phase]];
]

