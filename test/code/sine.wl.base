
IntegerDivision[a_, b_] := Floor[a / b];
newEmptyObject[] := CreateDataStructure["HashTable"];
setValue[var_, key_, value_] := var["Insert", key -> value];
getValue[var_, key_] := var["Lookup", key];
newObject[elems_] := Module[{t = newEmptyObject[]}, Map[t["Insert", #] &, elems]; t];
newArray[v_, n_] := Table[v, n];

Util`edge`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"pre",False];
   Return[`ctx];
]

Util`change`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"pre_x",0.];
   Return[`ctx];
]

Util`dcblock`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x1",0.];
   setValue[`ctx,"y1",0.];
   Return[`ctx];
]

Util`smooth`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x",0.];
   Return[`ctx];
]

Util`average2`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x0",0.];
   Return[`ctx];
]

Util`cvToPitch[cv_] := 
   Return[(24. + (120. * cv))];


Util`pitchToRaten`n1024`c0 = {};
Util`pitchToRaten`n1024`c1 = {};
Util`pitchToRaten`n1024`c2 = {};
Util`pitchToRaten`n1024`raw`c0[index_] := 
   Return[Util`pitchToRaten`n1024`c0[[index + 1]]];


Util`pitchToRaten`n1024`raw`c1[index_] := 
   Return[Util`pitchToRaten`n1024`c1[[index + 1]]];


Util`pitchToRaten`n1024`raw`c2[index_] := 
   Return[Util`pitchToRaten`n1024`c2[[index + 1]]];


Util`pitchToRaten`n1024[pitch_] := Module[{ index }, 
   index = Clip[Floor[(pitch * 0.244094)], {0, 31}];
   Return[(Util`pitchToRaten`n1024`c0[[index + 1]] + (pitch * (Util`pitchToRaten`n1024`c1[[index + 1]] + (Util`pitchToRaten`n1024`c2[[index + 1]] * pitch))))];
]

Util`cvToRaten`n1024`c0 = {};
Util`cvToRaten`n1024`c1 = {};
Util`cvToRaten`n1024`c2 = {};
Util`cvToRaten`n1024`raw`c0[index_] := 
   Return[Util`cvToRaten`n1024`c0[[index + 1]]];


Util`cvToRaten`n1024`raw`c1[index_] := 
   Return[Util`cvToRaten`n1024`c1[[index + 1]]];


Util`cvToRaten`n1024`raw`c2[index_] := 
   Return[Util`cvToRaten`n1024`c2[[index + 1]]];


Util`cvToRaten`n1024[cv_] := Module[{ index }, 
   index = Clip[Floor[(cv * 34.444444)], {0, 31}];
   Return[(Util`cvToRaten`n1024`c0[[index + 1]] + (cv * (Util`cvToRaten`n1024`c1[[index + 1]] + (Util`cvToRaten`n1024`c2[[index + 1]] * cv))))];
]

Phase`default[`ctx_] := 
   setValue[`ctx,"rate",Util`cvToRaten`n1024[0.]];


Phase`process`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"inst_1b08a",Util`change`type`alloc[]];
   setValue[`ctx,"inst_2048a",Util`edge`type`alloc[]];
   setValue[`ctx,"phase",0.];
   setValue[`ctx,"rate",0.];
   Phase`default[`ctx];
   Return[`ctx];
]

Phase`noteOn`type`alloc[`ctx_] := 
