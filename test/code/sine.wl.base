Sine`process`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"inst_104ba",Util`edge`type`alloc[]];
   setValue[`ctx,"p",Phase`process`type`alloc[]];
   setValue[`ctx,"trig",False];
   Return[`ctx];
]

Sine`noteOn`type`alloc[`ctx_] := 
