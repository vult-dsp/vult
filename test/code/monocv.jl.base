
# High-performance Vult Runtime for Julia with typed arrays

mutable struct Util_edge_type
       pre::Bool
end

# Default constructor for Util_edge_type
function Util_edge_type()
    return Util_edge_type(false)
end

mutable struct Util_change_type
       pre_x::Float32
end

# Default constructor for Util_change_type
function Util_change_type()
    return Util_change_type(Float32(0.0))
end

mutable struct Util_dcblock_type
       x1::Float32
       y1::Float32
end

# Default constructor for Util_dcblock_type
function Util_dcblock_type()
    return Util_dcblock_type(Float32(0.0), Float32(0.0))
end

mutable struct Util_smooth_type
       x::Float32
end

# Default constructor for Util_smooth_type
function Util_smooth_type()
    return Util_smooth_type(Float32(0.0))
end

mutable struct Util_average2_type
       x0::Float32
end

# Default constructor for Util_average2_type
function Util_average2_type()
    return Util_average2_type(Float32(0.0))
end

mutable struct Monocv_mono_noteOn_type
       count::Int32
       notes::Vector{Int32}
       pre::Int32
end

# Default constructor for Monocv_mono_noteOn_type
function Monocv_mono_noteOn_type()
    return Monocv_mono_noteOn_type(Int32(0), fill(Int32(0), 4), Int32(0))
end

mutable struct Monocv_process_type
       Monocv_process_ret_0::Float32
       Monocv_process_ret_1::Float32
       Monocv_process_ret_2::Float32
       active_note::Int32
       channel_in::Int32
       cv::Float32
       gate::Float32
       inst_1b0d6::Util_change_type
       notes::Monocv_mono_noteOn_type
       vel::Float32
end

# Default constructor for Monocv_process_type
function Monocv_process_type()
    return Monocv_process_type(Float32(0.0), Float32(0.0), Float32(0.0), Int32(0), Int32(0), Float32(0.0), Float32(0.0), Util_change_type(), Monocv_mono_noteOn_type(), Float32(0.0))
end

function Util_edge_type_alloc()
   _ctx = Util_edge_type()
   _ctx.pre = false
   return _ctx
end

function Util_change_type_alloc()
   _ctx = Util_change_type()
   _ctx.pre_x = Float32(0.0)
   return _ctx
end

function Util_dcblock_type_alloc()
   _ctx = Util_dcblock_type()
   _ctx.x1 = Float32(0.0)
   _ctx.y1 = Float32(0.0)
   return _ctx
end

function Util_smooth_type_alloc()
   _ctx = Util_smooth_type()
   _ctx.x = Float32(0.0)
   return _ctx
end

function Util_average2_type_alloc()
   _ctx = Util_average2_type()
   _ctx.x0 = Float32(0.0)
   return _ctx
end

function Monocv_mono_noteOn_type_alloc()
   _ctx = Monocv_mono_noteOn_type()
   _ctx.count = Int32(0)
   i_0 = Int32(0)
   temp_1 = fill(Int32(0), Int32(4))
   while (i_0 < Int32(4))
      begin
         @inbounds temp_1[i_0 + 1] = Int32(0)
         i_0 = (Int32(1) + i_0)
      end
   end
   _ctx.notes = temp_1
   _ctx.pre = Int32(0)
   return _ctx
end

function Monocv_mono_noteOff_type_alloc(_ctx)
   return Monocv_mono_noteOn_type_alloc()
end

function Monocv_mono_isGateOn_type_alloc(_ctx)
   return Monocv_mono_noteOn_type_alloc()
end

function Monocv_process_type_alloc()
   _ctx = Monocv_process_type()
   _ctx.Monocv_process_ret_0 = Float32(0.0)
   _ctx.Monocv_process_ret_1 = Float32(0.0)
   _ctx.Monocv_process_ret_2 = Float32(0.0)
   _ctx.active_note = Int32(0)
   _ctx.channel_in = Int32(0)
   _ctx.cv = Float32(0.0)
   _ctx.gate = Float32(0.0)
   _ctx.inst_1b0d6 = Util_change_type_alloc()
   _ctx.notes = Monocv_mono_noteOn_type_alloc()
   _ctx.vel = Float32(0.0)
   return _ctx
end

function Monocv_noteOn_type_alloc(_ctx)
   return Monocv_process_type_alloc()
end

function Monocv_noteOff_type_alloc(_ctx)
   return Monocv_process_type_alloc()
end

function Monocv_controlChange_type_alloc(_ctx)
   return Monocv_process_type_alloc()
end

function Monocv_default_type_alloc(_ctx)
   return Monocv_process_type_alloc()
end

function Util_edge(_ctx, x)
   ret = (x && (_ctx.pre == false))
   _ctx.pre = x
   return ret
end

function Util_change(_ctx, x)
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v
end

function Util_map(x, x0, x1, y0, y1)
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))
end

function Util_dcblock(_ctx, x0)
   y0 = (x0 + ((-_ctx.x1) + (Float32(0.995) * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0
end

function Util_smooth(_ctx, input)
   _ctx.x = ((Float32(0.005) * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Util_average2(_ctx, x1)
   result = (Float32(0.5) * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result
end

function Util_cubic_clipper(x)
   if (x <= Float32(-0.666667))
      return Float32(-0.666667)
   else
      if (x >= Float32(0.666666))
         return Float32(0.666666)
      else
         return (x + (Float32(-0.333334) * (x * (x * x))))
      end
   end
end

Util_pitchToRate_1024_c0 = nothing
Util_pitchToRate_1024_c1 = nothing
Util_pitchToRate_1024_c2 = nothing
function Util_pitchToRate_1024_raw_c0(index)
   return @inbounds Util_pitchToRate_1024_c0[index + 1]
end

function Util_pitchToRate_1024_raw_c1(index)
   return @inbounds Util_pitchToRate_1024_c1[index + 1]
end

function Util_pitchToRate_1024_raw_c2(index)
   return @inbounds Util_pitchToRate_1024_c2[index + 1]
end

function Util_pitchToRate_1024(pitch)
   index = clamp(trunc(Int32, (pitch * Float32(0.251968))), Int32(0), Int32(31))
   return (@inbounds Util_pitchToRate_1024_c0[index + 1] + (pitch * (@inbounds Util_pitchToRate_1024_c1[index + 1] + (@inbounds Util_pitchToRate_1024_c2[index + 1] * pitch))))
end

Util_pitchToRate_c0 = nothing
Util_pitchToRate_c1 = nothing
Util_pitchToRate_c2 = nothing
function Util_pitchToRate_raw_c0(index)
   return @inbounds Util_pitchToRate_c0[index + 1]
end

function Util_pitchToRate_raw_c1(index)
   return @inbounds Util_pitchToRate_c1[index + 1]
end

function Util_pitchToRate_raw_c2(index)
   return @inbounds Util_pitchToRate_c2[index + 1]
end

function Util_pitchToRate(pitch)
   index = clamp(trunc(Int32, (pitch * Float32(0.251968))), Int32(0), Int32(31))
   return (@inbounds Util_pitchToRate_c0[index + 1] + (pitch * (@inbounds Util_pitchToRate_c1[index + 1] + (@inbounds Util_pitchToRate_c2[index + 1] * pitch))))
end

function Util_cvToPitch(cv)
   return (Float32(24.0) + (Float32(120.0) * cv))
end

