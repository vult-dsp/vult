function Monocv_mono_noteOn(_ctx, n)
   if (_ctx.count < Int32(4))
      begin
         @inbounds _ctx.notes[_ctx.count + 1] = n
         _ctx.pre = n
         if (_ctx.count < Int32(4))
            _ctx.count = (Int32(1) + _ctx.count)
         end
      end
   end
   return _ctx.pre
end

function Monocv_mono_noteOff(_ctx, n)
   found = false
   i = Int32(0)
   pos = Int32(0)
   if (_ctx.count == Int32(0))
      return _ctx.pre
   end
   while ((i < Int32(4)) && (found == false))
      begin
         if (@inbounds _ctx.notes[i + 1] == n)
            begin
               pos = i
               found = true
            end
         end
         i = (Int32(1) + i)
      end
   end
   if found
      begin
         k = (Int32(1) + pos)
         while (k < Int32(4))
            begin
               @inbounds _ctx.notes[(Int32(-1) + k) + 1] = @inbounds _ctx.notes[k + 1]
               k = (Int32(1) + k)
            end
         end
         if (found && (_ctx.count > Int32(0)))
            begin
               _ctx.count = (Int32(-1) + _ctx.count)
               _ctx.pre = @inbounds _ctx.notes[(Int32(-1) + _ctx.count) + 1]
            end
         end
      end
   end
   return _ctx.pre
end

function Monocv_mono_isGateOn(_ctx)
   return (_ctx.count > Int32(0))
end

function Monocv_process(_ctx, c)
   _ctx.channel_in = c
   if Monocv_mono_isGateOn(_ctx.notes)
      _ctx.gate = _ctx.vel
   else
      _ctx.gate = Float32(0.0)
   end
   note = Float32(_ctx.active_note)
   if Util_change(_ctx.inst_1b0d6, note)
      _ctx.cv = Util_pitchToCv(note)
   end
   _ctx.Monocv_process_ret_0 = _ctx.cv
   _ctx.Monocv_process_ret_1 = _ctx.vel
   _ctx.Monocv_process_ret_2 = _ctx.gate
   return 
end

function Monocv_noteOn(_ctx, note, velocity, channel)
   if (_ctx.channel_in == channel)
      if (velocity > Int32(0))
         begin
            _ctx.active_note = Monocv_mono_noteOn(_ctx.notes, note)
            _ctx.vel = (Float32(0.007874) * Float32(velocity))
         end
      else
         _ctx.active_note = Monocv_mono_noteOff(_ctx.notes, note)
      end
   end
end

function Monocv_noteOff(_ctx, note, channel)
   if (_ctx.channel_in == channel)
      _ctx.active_note = Monocv_mono_noteOff(_ctx.notes, note)
   end
end

function Monocv_controlChange(_ctx, control, value, channel)
end

function Monocv_default(_ctx)
end

