function Util_cvToRate_1024_raw_c2(index)
   return @inbounds Util_cvToRate_1024_c2[index + 1]
end

function Util_cvToRate_1024(cv)
   index = clamp(trunc(Int32, (cv * Float32(35.555555))), Int32(0), Int32(31))
   return (@inbounds Util_cvToRate_1024_c0[index + 1] + (cv * (@inbounds Util_cvToRate_1024_c1[index + 1] + (@inbounds Util_cvToRate_1024_c2[index + 1] * cv))))
end

Util_cvToRate_c0 = nothing
Util_cvToRate_c1 = nothing
Util_cvToRate_c2 = nothing
function Util_cvToRate_raw_c0(index)
