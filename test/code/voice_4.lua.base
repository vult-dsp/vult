function Voice_4_controlChange(_ctx, control, value, channel)
   if (control == 30) then
      _ctx.level1 = (0.007874 * real(value))
   end
   if (control == 31) then
      _ctx.level2 = (0.007874 * real(value))
   end
   if (control == 32) then
      _ctx.level3 = (0.007874 * real(value))
   end
   if (control == 33) then
      _ctx.level4 = (0.007874 * real(value))
   end
   if (control == 34) then
      _ctx.pw1 = (0.007874 * real(value))
   end
   if (control == 35) then
      _ctx.pw2 = (0.007874 * real(value))
   end
   if (control == 36) then
      _ctx.pw3 = (0.000787 * real(value))
   end
   if (control == 37) then
      _ctx.pw4 = (0.007874 * real(value))
   end
   if (control == 38) then
      _ctx.lfo_rate = Util_map(real(value), 0.0, 127.0, -0.4, 0.1)
   end
   if (control == 39) then
      _ctx.lfo_shape = (0.023622 * real(value))
   end
   if (control == 40) then
      _ctx.lfo_pw = Util_map(real(value), 0.0, 127.0, -1.0, 1.0)
   end
   if (control == 41) then
      _ctx.lfo_cv = Util_map(real(value), 0.0, 127.0, -0.1, 0.1)
   end
   if (control == 42) then
      _ctx.lfo_flt = Util_map(real(value), 0.0, 127.0, -0.3, 0.3)
   end
   if (control == 43) then
      if (value > 0) then
         _ctx.lfo_reset = 1.0
      else
         _ctx.lfo_reset = 0.0
      end
   end
   if (control == 44) then
      _ctx.flt_cut = Util_map(real(value), 0.0, 127.0, -0.2, 0.5)
   end
   if (control == 45) then
      _ctx.flt_res = (0.007874 * real(value))
   end
   if (control == 46) then
      _ctx.flt_shape = intDiv(lshift(value, 2), 127)
   end
   if (control == 47) then
      _ctx.attack = (0.007874 * real(value))
   end
   if (control == 48) then
      _ctx.decay = (0.007874 * real(value))
   end
   if (control == 49) then
      _ctx.sustain = (0.007874 * real(value))
   end
   if (control == 50) then
      _ctx.release = (0.007874 * real(value))
   end
end

