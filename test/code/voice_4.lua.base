function Saturate_soft_tanh_table(x)
   local index = clip(math.floor(((x + 24.0) * 5.0)), 0, 240)
   return (Saturate_soft_tanh_table_c0[index + 1] + (x * (Saturate_soft_tanh_table_c1[index + 1] + (Saturate_soft_tanh_table_c2[index + 1] * x))))
end

