
IntegerDivision[a_, b_] := Floor[a / b];
newEmptyObject[] := CreateDataStructure["HashTable"];
setValue[var_, key_, value_] := var["Insert", key -> value];
getValue[var_, key_] := var["Lookup", key];
newObject[elems_] := Module[{t = newEmptyObject[]}, Map[t["Insert", #] &, elems]; t];
newArray[v_, n_] := Table[v, n];

Array`instance`counter`type`alloc[] := Module[{ `ctx }, 
   `ctx = newEmptyObject[];
   setValue[`ctx,"x",0];
   Return[`ctx];
]

Array`instance`foo`type`alloc[] := Module[{ `ctx, temp, in`n0 }, 
   in`n0 = 0;
   temp = Table[0, { i, 1, 2}];
   `ctx = newEmptyObject[];
   While[(in`n0 < 2), 
      Module[{  }, 
         temp[[in`n0 + 1]] = Array`instance`counter`type`alloc[];
         in`n0 = (1 + in`n0);
      ];];
   setValue[`ctx,"x",temp];
   Return[`ctx];
]

Array`instance`counter[`ctx_] := Module[{  }, 
   setValue[`ctx,"x",(1 + getValue[`ctx, "x"])];
   Return[getValue[`ctx, "x"]];
]

Array`instance`incr[ctx_] := Module[{  }, 
   setValue[ctx,"x",(1 + getValue[ctx, "x"])];
   Return[getValue[ctx, "x"]];
]

Array`instance`foo[`ctx_] := Module[{ i`n`n1 }, 
   i`n`n1 = 0;
   While[(i`n`n1 < 2), 
      Module[{  }, 
         Array`instance`counter[getValue[`ctx, "x"][[i`n`n1 + 1]]];
         i`n`n1 = (1 + i`n`n1);
      ];];
   Return[getValue[getValue[`ctx, "x"][[2]], "x"]];
]

