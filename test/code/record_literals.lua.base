

-- Math functions
local modf = math.modf

function Record_literals_point_alloc()
   local _ctx = {};
   _ctx.x = 0.0
   _ctx.y = 0.0
   return _ctx
end

function Record_literals_ipoint_alloc()
   local _ctx = {};
   _ctx.x = 0
   _ctx.y = 0
   return _ctx
end

function Record_literals_point3_alloc()
   local _ctx = {};
   _ctx.x = 0.0
   _ctx.y = 0.0
   _ctx.z = 0.0
   return _ctx
end

function Record_literals_pair_alloc()
   local _ctx = {};
   _ctx.first = Record_literals_point_alloc()
   _ctx.second = Record_literals_point_alloc()
   return _ctx
end

function Record_literals_norm(p)
   return ((p.x * p.x) + (p.y * p.y))
end

function Record_literals_make(a, b)
   local _record_0 = { x = a, y = b }
   return _record_0
end

function Record_literals_main()
   local a = { x = 1.0, y = 2.0 }
   local b = { x = 3, y = 4 }
   local c = { x = 1.0, y = 2.0, z = 3.0 }
   local d = { first = { x = 5.0, y = 0.0 }, second = a }
   local e = Record_literals_make(10, 20)
   local total = (Record_literals_norm(a) + (c.z + (d.first.x + d.second.y)))
   return ((1000 * (modf(total))) + (b.x + (b.y + (e.x + e.y))))
end

