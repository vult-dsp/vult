

Waves_sineTable1_chan_0 = {};
function Waves_sineTable1_samples()
   return 256
end

function Waves_sineTable1(channel, index)
   if (channel == 0) then
      return Waves_sineTable1_chan_0[((index % 256)) + 1]
   end
   return 0.0
end

Waves_sineTable2_c = {};
function Waves_sineTable2_samples()
   return 256
end

function Waves_sineTable2_raw_c0(index)
   return Waves_sineTable2_c[((index * 3)) + 1]
end

function Waves_sineTable2_raw_c1(index)
   return Waves_sineTable2_c[(((index * 3) + 1)) + 1]
end

function Waves_sineTable2_raw_c2(index)
   return Waves_sineTable2_c[(((index * 3) + 2)) + 1]
end

function Waves_sineTable2(position)
   local value = (((position) > (1.0) and (1.0) or ((position) < (0.0) and (0.0) or (position))) * 255.0)
   local cell = ((math.floor(value)) > (254) and (254) or ((math.floor(value)) < (0) and (0) or (math.floor(value))))
   local u = (value - (cell))
   local index = (cell * 3)
   return (Waves_sineTable2_c[(index) + 1] + (u * (Waves_sineTable2_c[((index + 1)) + 1] + (Waves_sineTable2_c[((index + 2)) + 1] * u))))
end

function Waves_test1()
   local n = Waves_sineTable1_samples()
   local i__1 = 0
   while (i__1 < n) do
      do
         Waves_sineTable1(0, i__1)
         i__1 = (1 + i__1)
      end
   end
end

function Waves_test2()
   local result = Waves_sineTable2(0.5)
end

