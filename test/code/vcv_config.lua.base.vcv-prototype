

-- Core runtime functions
local function clipValue(x, low, high) if x > high then return high elseif x < low then return low else return x end end


-- VCV Prototype functions
local global_block = {}

function stringAppend(s1, s2)
   return s1 .. s2
end

function getKnob(i)
   if i > 6 or i < 1 then
      return 0.0
   else
      return global_block.knobs[i]
   end
end

function getSwitch(i)
   if i > 6 or i < 1 then
      return false
   else
      return global_block.switches[i]
   end
end

function setLight(i, r, g, b)
   if not(i > 6 or i < 1) then
      global_block.lights[i][1] = r
      global_block.lights[i][2] = g
      global_block.lights[i][3] = b
   end
end

function setSwitchLight(i, r, g, b)
   if not(i > 6 or i < 1) then
      global_block.switchLights[i][1] = r
      global_block.switchLights[i][2] = g
      global_block.switchLights[i][3] = b
   end
end

function samplerate()
   return global_block.sampleRate
end

function sampletime()
   return global_block.sampleTime
end

config.frameDivider = 8
config.bufferSize = 64
function Vcv_config_process_type_alloc()
   local _ctx = {};
   _ctx.out = 0.0
   return _ctx
end

function Vcv_config_update_type_alloc(_ctx)
   return Vcv_config_process_type_alloc()
end

function Vcv_config_process(_ctx, in1)
   _ctx.out = clipValue((in1 * getKnob(1)), -1.0, 1.0)
   return _ctx.out
end

function Vcv_config_update(_ctx)
   display(("knob = " .. tostring(getKnob(1))))
end


-- 'display' is provided by the host. This is only a fallback for running the
-- generated code outside VCV Rack.
if display == nil then
   function display(s)
      print(s)
   end
end

local processor = Vcv_config_process_type_alloc()


function process(block)
   global_block = block
   Vcv_config_update(processor)
   for i=1,block.bufferSize do
      local in1 = block.inputs[1][i] / 10.0
      block.outputs[1][i] = 10.0 * Vcv_config_process(processor, in1)
   end
end
