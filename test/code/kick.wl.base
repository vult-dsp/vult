Noise`pinker[`ctx_, x_] := Module[{ y0, w0, a1, b1, b0 }, 
   b0 = 0.027712;
   b1 = 0.027712;
   a1 = -0.944575;
   w0 = (x + (-(a1 * getValue[`ctx, "w1"])));
   y0 = ((b0 * w0) + (b1 * getValue[`ctx, "w1"]));
   setValue[`ctx,"w1",w0];
   Return[y0];
]

Noise`process[`ctx_, color_] := Module[{ out, y2, y1 }, 
   setValue[`ctx,"x1",Mod[(7919 + (17389 * getValue[`ctx, "x1"])), 32768]];
   y1 = (3 10^-05 * N[getValue[`ctx, "x1"]]);
   setValue[`ctx,"x2",Mod[(12553 + (27449 * getValue[`ctx, "x2"])), 32768]];
   y2 = (3 10^-05 * N[getValue[`ctx, "x2"]]);
   out = 0.;
   If[(color > 0.5), 
      out = Noise`pinker[getValue[`ctx, "inst_16d3d"], (y1 + (-y2))];, 
      out = (y1 + (-y2));];
   Return[(2. * out)];
]

