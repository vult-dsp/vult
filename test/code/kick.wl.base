Ahr`do[`ctx_, gate_, a_, h_, r_] := Module[{ resetting, bgate, reset, hold, attack, release }, 
   release = 0;
   attack = 1;
   hold = 2;
   reset = 3;
   bgate = (gate > 0.);
   If[Util`edge[getValue[`ctx, "inst_104d8"], bgate], 
      setValue[`ctx,"state",reset];];
   resetting = 0.;
   If[(getValue[`ctx, "state"] == reset), 
      resetting = 1.;, 
      resetting = 0.;];
   If[Util`edge[getValue[`ctx, "inst_204d8"], (getValue[`ctx, "out"] > 1024.)], 
      Module[{  }, 
         setValue[`ctx,"hold_phase",0.];
         setValue[`ctx,"state",hold];
      ];];
   If[((getValue[`ctx, "out"] < 10.) && (getValue[`ctx, "state"] == reset)), 
      setValue[`ctx,"state",attack];];
   If[((getValue[`ctx, "hold_phase"] > 100.) && (getValue[`ctx, "state"] == hold)), 
      setValue[`ctx,"state",release];];
   If[(getValue[`ctx, "state"] == reset), 
      Module[{  }, 
         setValue[`ctx,"rate",0.990099];
         setValue[`ctx,"target",0.];
      ];];
   If[(getValue[`ctx, "state"] == attack), 
      Module[{  }, 
         setValue[`ctx,"rate",(1. / (0.01 + (100. * a)))];
         setValue[`ctx,"target",1228.8];
      ];];
   If[(getValue[`ctx, "state"] == hold), 
      Module[{ hrate }, 
         hrate = (1. / (0.01 + (100. * h)));
         setValue[`ctx,"hold_phase",(hrate + getValue[`ctx, "hold_phase"])];
      ];];
   If[(getValue[`ctx, "state"] == release), 
      Module[{  }, 
         setValue[`ctx,"rate",(1. / (0.01 + (100. * r)))];
         setValue[`ctx,"target",0.];
      ];];
   setValue[`ctx,"out",((0.005 * (((-getValue[`ctx, "out"]) + getValue[`ctx, "target"]) * getValue[`ctx, "rate"])) + getValue[`ctx, "out"])];
   setValue[`ctx,"Ahr_do_ret_0",Clip[(0.000976 * getValue[`ctx, "out"]), {0., 1.}]];
   setValue[`ctx,"Ahr_do_ret_1",resetting];
   Return[];
]

Ahr`process[`ctx_, gate_] := Module[{ `call`tempn`n1, `call`tempn`n0 }, 
   Ahr`do[getValue[`ctx, "inst_1d84b"], gate, getValue[`ctx, "knob1"], getValue[`ctx, "knob2"], getValue[`ctx, "knob3"]];
   `call`tempn`n0 = getValue[getValue[`ctx, "inst_1d84b"], "Ahr_do_ret_0"];
   `call`tempn`n1 = getValue[getValue[`ctx, "inst_1d84b"], "Ahr_do_ret_1"];
   setValue[`ctx,"Ahr_process_ret_0",`call`tempn`n0];
   setValue[`ctx,"Ahr_process_ret_1",`call`tempn`n1];
