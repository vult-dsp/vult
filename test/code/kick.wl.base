Tricore`process[`ctx_, cv_, reset_, disable_] := Module[{ bdisable, `if`tempn`n0, new`phase, out }, 
   out = 0.;
   If[Util`change[getValue[`ctx, "inst_1b03c"], cv], 
      setValue[`ctx,"rate",(4. * Util`cvToRaten`n1024[cv])];];
   new`phase = 0.;
   `if`tempn`n0 = 0.;
   If[getValue[`ctx, "direction"], 
      `if`tempn`n0 = getValue[`ctx, "rate"];, 
      `if`tempn`n0 = (-getValue[`ctx, "rate"]);];
   new`phase = (`if`tempn`n0 + getValue[`ctx, "phase"]);
   bdisable = (disable > 0.5);
   If[(Util`edge[getValue[`ctx, "inst_2043c"], (reset > 0.)] || Util`edge[getValue[`ctx, "inst_3043c"], bdisable]), 
      Module[{  }, 
         setValue[`ctx,"reset_phase",getValue[`ctx, "phase"]];
         setValue[`ctx,"reset_state",True];
         new`phase = 0.;
      ];];
   If[(new`phase > 1024.), 
      Module[{  }, 
         new`phase = (2048. + (-new`phase));
         setValue[`ctx,"direction",False];
      ];, 
      If[(new`phase < -1024.), 
         setValue[`ctx,"direction",True];];];
   If[bdisable, 
      setValue[`ctx,"phase",0.];, 
      setValue[`ctx,"phase",new`phase];];
   If[getValue[`ctx, "reset_state"], 
      Module[{  }, 
         If[((abs[getValue[`ctx, "reset_phase"]] > 10.) || bdisable), 
            Module[{ reset`speed }, 
               reset`speed = 0.;
               If[bdisable, 
                  reset`speed = 0.01;, 
                  reset`speed = 0.5;];
               setValue[`ctx,"reset_phase",((-(reset`speed * getValue[`ctx, "reset_phase"])) + getValue[`ctx, "reset_phase"])];
            ];, 
            Module[{  }, 
               If[(getValue[`ctx, "reset_phase"] > 10.), 
                  setValue[`ctx,"reset_phase",getValue[`ctx, "reset_phase"]];, 
                  setValue[`ctx,"reset_phase",0.];];
               setValue[`ctx,"reset_state",False];
               setValue[`ctx,"direction",True];
            ];];
         out = getValue[`ctx, "reset_phase"];
      ];];
   out = (out + getValue[`ctx, "phase"]);
   Return[(0.000976 * out)];
]

