Swept`process[`ctx_, gate_, start_, end_, rate_] := Module[{ bgate, a`rate }, 
   a`rate = (1. / (0.01 + (100. * rate)));
   bgate = (gate > 0.5);
   setValue[`ctx,"out",((0.004 * (rate * ((-getValue[`ctx, "out"]) + (1024. * end)))) + getValue[`ctx, "out"])];
   If[Util`edge[getValue[`ctx, "inst_10402"], bgate], 
      setValue[`ctx,"out",(1024. * start)];];
   Return[(0.000976 * getValue[`ctx, "out"])];
]

