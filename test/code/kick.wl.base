Kick`do[`ctx_, gate_, odecay_, pitch_, swept_, noise_] := Module[{ noise`osc, noise`env, osc`sat, osc, cv, env`reset, osc`env }, 
   Ahr`do[getValue[`ctx, "inst_1d863"], gate, 0.005, (0.1 + odecay), (0.01 + odecay)];
   osc`env = getValue[getValue[`ctx, "inst_1d863"], "Ahr_do_ret_0"];
   env`reset = getValue[getValue[`ctx, "inst_1d863"], "Ahr_do_ret_1"];
   cv = Swept`process[getValue[`ctx, "inst_20263"], (1. + (-env`reset)), (pitch + (0.4 * swept)), pitch, 0.1];
   osc = Tricore`process[getValue[`ctx, "inst_33c63"], cv, 0., env`reset];
   osc`sat = Saturate`process[(1.5 * osc)];
   Ahr`do[getValue[`ctx, "inst_4d863"], gate, 0.001, 0.01, (0.001 + (0.01 * noise))];
   noise`env = getValue[getValue[`ctx, "inst_4d863"], "Ahr_do_ret_0"];
   noise`osc = (0.333333 * (noise * Noise`process[getValue[`ctx, "inst_53d63"], 1.]));
   Return[((noise`env * noise`osc) + (osc`env * osc`sat))];
]

