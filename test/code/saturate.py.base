import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

Saturate_tanh_table_c = {}
def Saturate_tanh_table_raw_c0(index):
   return Saturate_tanh_table_c[(index * 3)]

def Saturate_tanh_table_raw_c1(index):
   return Saturate_tanh_table_c[((index * 3) + 1)]

def Saturate_tanh_table_raw_c2(index):
   return Saturate_tanh_table_c[((index * 3) + 2)]

def Saturate_tanh_table(x):
   value = ((0.0) if (((x + 24.0) * 5.020833)) < (0.0) else ((241.0) if (((x + 24.0) * 5.020833)) > (241.0) else (((x + 24.0) * 5.020833))))
   cell = ((0) if (float_to_int(value)) < (0) else ((240) if (float_to_int(value)) > (240) else (float_to_int(value))))
   u = (value - float(cell))
   index = (cell * 3)
   return (Saturate_tanh_table_c[index] + (u * (Saturate_tanh_table_c[(index + 1)] + (Saturate_tanh_table_c[(index + 2)] * u))))


def Saturate_process(x):
   return Saturate_tanh_table(x)

