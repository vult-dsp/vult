
# High-performance Vult Runtime for Julia with typed arrays

Waves_sineTable1_chan_0 = nothing
function Waves_sineTable1_samples()
   return Int32(256)
end

function Waves_sineTable1(channel, index)
   if (channel == Int32(0))
      return @inbounds Waves_sineTable1_chan_0[(index % Int32(256)) + 1]
   end
   return Float32(0.0)
end

Waves_sineTable2_c = nothing
function Waves_sineTable2_samples()
   return Int32(256)
end

function Waves_sineTable2_raw_c0(index)
   return @inbounds Waves_sineTable2_c[(index * Int32(3)) + 1]
end

function Waves_sineTable2_raw_c1(index)
   return @inbounds Waves_sineTable2_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Waves_sineTable2_raw_c2(index)
   return @inbounds Waves_sineTable2_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Waves_sineTable2(position)
   value = (clamp(position, Float32(0.0), Float32(1.0)) * Float32(255.0))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(254))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Waves_sineTable2_c[index + 1] + (u * (@inbounds Waves_sineTable2_c[(index + Int32(1)) + 1] + (@inbounds Waves_sineTable2_c[(index + Int32(2)) + 1] * u))))
end

function Waves_test1()
   n = Waves_sineTable1_samples()
   i__1 = Int32(0)
   while (i__1 < n)
      begin
         Waves_sineTable1(Int32(0), i__1)
         i__1 = (Int32(1) + i__1)
      end
   end
end

function Waves_test2()
   Waves_sineTable2(Float32(0.5))
end

