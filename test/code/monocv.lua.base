end

function Monocv_mono_noteOn(_ctx, n)
   if (_ctx.count < 4) then
      do
         _ctx.notes[_ctx.count + 1] = n
         _ctx.pre = n
         if (_ctx.count < 4) then
            _ctx.count = (1 + _ctx.count)
         end
      end
   end
   return _ctx.pre
end

function Monocv_mono_noteOff(_ctx, n)
   local found = false
   local i = 0
   local pos = 0
   if (_ctx.count == 0) then
      return _ctx.pre
   end
   while ((i < 4) and (found == false)) do
      do
         if (_ctx.notes[(i) + 1] == n) then
            do
               pos = i
               found = true
            end
         end
         i = (1 + i)
      end
   end
   if found then
      do
         local k = (1 + pos)
         while (k < 4) do
            do
               _ctx.notes[(-1 + k) + 1] = _ctx.notes[(k) + 1]
               k = (1 + k)
            end
         end
         if (found and (_ctx.count > 0)) then
            do
               _ctx.count = (-1 + _ctx.count)
               _ctx.pre = _ctx.notes[((-1 + _ctx.count)) + 1]
            end
         end
      end
   end
   return _ctx.pre
end

function Monocv_mono_isGateOn(_ctx)
   return (_ctx.count > 0)
end

function Monocv_process(_ctx, c)
   _ctx.channel_in = c
   if Monocv_mono_isGateOn(_ctx.notes) then
      _ctx.gate = _ctx.vel
   else
      _ctx.gate = 0.0
   end
   local note = (_ctx.active_note)
   if Util_change(_ctx.inst_1b0d6, note) then
      _ctx.cv = Util_pitchToCv(note)
   end
   _ctx.Monocv_process_ret_0 = _ctx.cv
   _ctx.Monocv_process_ret_1 = _ctx.vel
   _ctx.Monocv_process_ret_2 = _ctx.gate
   return 
end

function Monocv_noteOn(_ctx, note, velocity, channel)
   if (_ctx.channel_in == channel) then
      if (velocity > 0) then
         do
            _ctx.active_note = Monocv_mono_noteOn(_ctx.notes, note)
            _ctx.vel = (0.007874 * (velocity))
         end
      else
         _ctx.active_note = Monocv_mono_noteOff(_ctx.notes, note)
      end
   end
end

function Monocv_noteOff(_ctx, note, channel)
   if (_ctx.channel_in == channel) then
      _ctx.active_note = Monocv_mono_noteOff(_ctx.notes, note)
   end
end

function Monocv_controlChange(_ctx, control, value, channel)
end

function Monocv_default(_ctx)
end

