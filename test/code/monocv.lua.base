
-- LuaJIT detection
local isLuaJIT = type(jit) == "table" and jit.version


-- Numeric arrays use FFI storage under LuaJIT, tables everywhere else.
local initializeArray
if isLuaJIT then
    local ffi = require("ffi")
    function initializeArray(v, n)
        if type(v) == "number" then
            -- One-based, so element zero is unused. This is cdata, not a
            -- table: indexing works, '#' and pairs() do not.
            local a = ffi.new("double[?]", n + 1)
            for i = 1, n do a[i] = v end
            return a
        else
            local a = {}
            for i = 1, n do a[i] = v end
            return a
        end
    end
else
    function initializeArray(v, n)
        local a = {}
        for i = 1, n do a[i] = v end
        return a
    end
end


-- Math functions
local floor = math.floor

-- Core runtime functions
local function clipValue(x, low, high) if x > high then return high elseif x < low then return low else return x end end

function Util_edge_type_alloc()
   local _ctx = {};
   _ctx.pre = false
   return _ctx
end

function Util_change_type_alloc()
   local _ctx = {};
   _ctx.pre_x = 0.0
   return _ctx
end

function Util_dcblock_type_alloc()
   local _ctx = {};
   _ctx.x1 = 0.0
   _ctx.y1 = 0.0
   return _ctx
end

function Util_smooth_type_alloc()
   local _ctx = {};
   _ctx.x = 0.0
   return _ctx
end

function Util_average2_type_alloc()
   local _ctx = {};
   _ctx.x0 = 0.0
   return _ctx
end

function Monocv_mono_noteOn_type_alloc()
   local _ctx = {};
   _ctx.count = 0
   local i_0 = 0
   local temp_1 = initializeArray(0, 4)
   while (i_0 < 4) do
      do
         temp_1[i_0 + 1] = 0
         i_0 = (1 + i_0)
      end
   end
   _ctx.notes = temp_1
   _ctx.pre = 0
   return _ctx
end

function Monocv_mono_noteOff_type_alloc(_ctx)
   return Monocv_mono_noteOn_type_alloc()
end

function Monocv_mono_isGateOn_type_alloc(_ctx)
   return Monocv_mono_noteOn_type_alloc()
end

function Monocv_process_type_alloc()
   local _ctx = {};
   _ctx.Monocv_process_ret_0 = 0.0
   _ctx.Monocv_process_ret_1 = 0.0
   _ctx.Monocv_process_ret_2 = 0.0
   _ctx.active_note = 0
   _ctx.channel_in = 0
   _ctx.cv = 0.0
   _ctx.gate = 0.0
   _ctx.inst_1b0d6 = Util_change_type_alloc()
   _ctx.notes = Monocv_mono_noteOn_type_alloc()
   _ctx.vel = 0.0
   return _ctx
end

function Monocv_noteOn_type_alloc(_ctx)
   return Monocv_process_type_alloc()
end

function Monocv_noteOff_type_alloc(_ctx)
   return Monocv_process_type_alloc()
end

function Monocv_controlChange_type_alloc(_ctx)
   return Monocv_process_type_alloc()
end

function Monocv_default_type_alloc(_ctx)
   return Monocv_process_type_alloc()
end

function Util_edge(_ctx, x)
   local ret = (x and (_ctx.pre == false))
   _ctx.pre = x
   return ret
end

function Util_change(_ctx, x)
   local v = (_ctx.pre_x ~= x)
   _ctx.pre_x = x
   return v
end

function Util_map(x, x0, x1, y0, y1)
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))
end

function Util_dcblock(_ctx, x0)
   local y0 = (x0 + ((-_ctx.x1) + (0.995 * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0
end

function Util_smooth(_ctx, input)
   _ctx.x = ((0.005 * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Util_average2(_ctx, x1)
   local result = (0.5 * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result
end

function Util_cubic_clipper(x)
   if (x <= -0.666667) then
      return -0.666667
   else
      if (x >= 0.666666) then
         return 0.666666
      else
         return (x + (-0.333334 * (x * (x * x))))
      end
   end
end

Util_pitchToRate_1024_c = {};
function Util_pitchToRate_1024_raw_c0(index)
   return Util_pitchToRate_1024_c[((index * 3)) + 1]
end

function Util_pitchToRate_1024_raw_c1(index)
   return Util_pitchToRate_1024_c[(((index * 3) + 1)) + 1]
end

function Util_pitchToRate_1024_raw_c2(index)
   return Util_pitchToRate_1024_c[(((index * 3) + 2)) + 1]
end

function Util_pitchToRate_1024(pitch)
   local value = (((pitch) > (127.0) and (127.0) or ((pitch) < (0.0) and (0.0) or (pitch))) * 0.251968)
   local cell = clipValue(floor(value), 0, 31)
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_pitchToRate_1024_c[(index) + 1] + (u * (Util_pitchToRate_1024_c[((index + 1)) + 1] + (Util_pitchToRate_1024_c[((index + 2)) + 1] * u))))
end

Util_pitchToRate_c = {};
function Util_pitchToRate_raw_c0(index)
   return Util_pitchToRate_c[((index * 3)) + 1]
end

function Util_pitchToRate_raw_c1(index)
   return Util_pitchToRate_c[(((index * 3) + 1)) + 1]
end

function Util_pitchToRate_raw_c2(index)
   return Util_pitchToRate_c[(((index * 3) + 2)) + 1]
end

function Util_pitchToRate(pitch)
   local value = (((pitch) > (127.0) and (127.0) or ((pitch) < (0.0) and (0.0) or (pitch))) * 0.251968)
   local cell = clipValue(floor(value), 0, 31)
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_pitchToRate_c[(index) + 1] + (u * (Util_pitchToRate_c[((index + 1)) + 1] + (Util_pitchToRate_c[((index + 2)) + 1] * u))))
end

function Util_cvToPitch(cv)
   return (24.0 + (120.0 * cv))
end

