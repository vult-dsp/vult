function Util_cvToperiod(cv)
   local value = (((cv) > (1.0) and (1.0) or ((cv) < (0.0) and (0.0) or (cv))) * 32.0)
   local cell = clipValue(floor(value), 0, 31)
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_cvToperiod_c[(index) + 1] + (u * (Util_cvToperiod_c[((index + 1)) + 1] + (Util_cvToperiod_c[((index + 2)) + 1] * u))))
end

