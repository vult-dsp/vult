function Util_cvToRate_raw_c2(index)
   return Util_cvToRate_c[(((index * 3) + 2)) + 1]
end

function Util_cvToRate(cv)
   local value = (((cv) > (0.9) and (0.9) or ((cv) < (0.0) and (0.0) or (cv))) * 142.222222)
   local cell = clipValue(floor(value), 0, 127)
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_cvToRate_c[(index) + 1] + (u * (Util_cvToRate_c[((index + 1)) + 1] + (Util_cvToRate_c[((index + 2)) + 1] * u))))
end

function Util_pitchToCv(pitch)
   return (-0.2 + (0.008333 * pitch))
end

