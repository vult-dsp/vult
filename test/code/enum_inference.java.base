
package vult.com.enum_inference;

import java.util.Arrays;
import java.util.Random;
import vult.com.external.*;

public class Enum_inference {

private int Enum_inference_code(int c) {
   return c;
}

private boolean Enum_inference_isOn(int l) {
   return (l != 0);
}

private int Enum_inference_describe(int c) {
   if ((c == 1)) {
      return 10;
   } else {
      if ((c == 0)) {
         return 20;
      }
   }
   return 0;
}

private int Enum_inference_main() {
   int a = 1;
   int b = 2;
   boolean on = ((b == 2) && Enum_inference_isOn(b));
   int c = Enum_inference_code(1);
   int d = Enum_inference_describe(1);
   int e = 0;
   if (on) {
      e = 1;
   } else {
      e = 0;
   }
   return (d + (e + ((100 * c) + ((1000 * a) + (10000 * b)))));
}


}
