
package vult.com.bool_casts;

import java.util.Arrays;
import java.util.Random;
import vult.com.external.*;

public class Bool_casts {

static float bool_to_float(boolean x) {
    return x ? 1.0f : 0.0f;
}

static int bool_to_int(boolean x) {
    return x ? 1 : 0;
}

static short int16(int x) {
    return (short)Math.max(-32768, Math.min(32767, x));
}

static short int16(float x) {
    return (short)Math.max(-32768, Math.min(32767, (int)x));
}

static short int16(boolean x) {
    return (short)(x ? 1 : 0);
}

private int Bool_casts_toInt(boolean b) {
   return bool_to_int(b);
}

private short Bool_casts_toInt16(boolean b) {
   return int16(b);
}

private float Bool_casts_toReal(boolean b) {
   return bool_to_float(b);
}

private float Bool_casts_toFix(boolean b) {
   return bool_to_float(b);
}


}
