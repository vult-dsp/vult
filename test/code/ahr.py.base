   _ctx = {}
   _ctx["Ahr_do_ret_0"] = 0.0
   _ctx["Ahr_do_ret_1"] = 0.0
   _ctx["hold_phase"] = 0.0
   _ctx["inst_104d8"] = Util_edge_type_alloc()
   _ctx["inst_204d8"] = Util_edge_type_alloc()
   _ctx["out"] = 0.0
   _ctx["rate"] = 0.0
   _ctx["state"] = 0
   _ctx["target"] = 0.0
   return _ctx


