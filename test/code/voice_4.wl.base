Util`cubic`clipper[x_] := 
   If[(x <= -0.666667), 
      Return[-0.666667];, 
      If[(x >= 0.666666), 
         Return[0.666666];, 
         Return[(x + (-0.333334 * (x * (x * x))))];];];


