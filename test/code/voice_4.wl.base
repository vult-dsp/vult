Lfo`soft[`ctx_, x1_] := Module[{ `t`tempn`n2, `t`tempn`n1, `t`tempn`n0, o }, 
   o = (0.25 * (x1 + (getValue[`ctx, "x2"] + (getValue[`ctx, "x3"] + getValue[`ctx, "x4"]))));
   `t`tempn`n0 = x1;
   `t`tempn`n1 = getValue[`ctx, "x2"];
   `t`tempn`n2 = getValue[`ctx, "x3"];
   setValue[`ctx,"x2",`t`tempn`n0];
   setValue[`ctx,"x3",`t`tempn`n1];
   setValue[`ctx,"x4",`t`tempn`n2];
   Return[o];
]

Lfo`process[`ctx_, cv_, shape_, reset_] := Module[{ o, tmp, breset }, 
   If[Util`change[getValue[`ctx, "inst_1b0d6"], cv], 
      setValue[`ctx,"rate",Util`cvToRate[(-0.3 + cv)]];];
   setValue[`ctx,"phase",(getValue[`ctx, "phase"] + getValue[`ctx, "rate"])];
   If[(getValue[`ctx, "phase"] > 2.), 
      setValue[`ctx,"phase",(-2. + getValue[`ctx, "phase"])];, 
      setValue[`ctx,"phase",getValue[`ctx, "phase"]];];
   breset = (reset > 0.);
   If[Util`edge[getValue[`ctx, "inst_204d6"], breset], 
      setValue[`ctx,"phase",0.];];
   tmp = (-1. + getValue[`ctx, "phase"]);
   o = 0.;
   If[(shape < 1.), 
      o = tmp;, 
      If[(shape < 2.), 
         o = (-1. + (2. * abs[tmp]));, 
         If[(tmp > 0.), 
            o = 1.;, 
            o = 0.;];];];
   Return[Lfo`soft[getValue[`ctx, "inst_337d6"], o]];
]

