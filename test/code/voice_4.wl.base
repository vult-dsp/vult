Svf`process[`ctx_, x_, cv_, q_, sel_] := Module[{ output, notch, low, band, high }, 
   q = (0.5 + q);
   If[(Util`change[getValue[`ctx, "inst_1b0a2"], cv] || Util`change[getValue[`ctx, "inst_2b0a2"], q]), 
      Module[{  }, 
         setValue[`ctx,"g",Svf`calc`g[cv]];
         setValue[`ctx,"r",(1. / (2. * (q + eps[])))];
         setValue[`ctx,"inv_den",(1. / (1. + ((2. * (getValue[`ctx, "r"] * getValue[`ctx, "g"])) + (getValue[`ctx, "g"] * getValue[`ctx, "g"]))))];
      ];];
   high = ((x + ((-(((2. * getValue[`ctx, "r"]) + getValue[`ctx, "g"]) * getValue[`ctx, "z1"])) + (-getValue[`ctx, "z2"]))) * getValue[`ctx, "inv_den"]);
   band = ((high * getValue[`ctx, "g"]) + getValue[`ctx, "z1"]);
   low = ((band * getValue[`ctx, "g"]) + getValue[`ctx, "z2"]);
   notch = (high + low);
   setValue[`ctx,"z1",(band + (high * getValue[`ctx, "g"]))];
   setValue[`ctx,"z2",(low + (band * getValue[`ctx, "g"]))];
   output = 0.;
   Switch[sel, 0, output = low;, 1, output = high;, 2, output = band;, _, output = notch;];
   Return[Saturate`soft`process[output]];
]

