Tables`nsine`c0 = {};
Tables`nsine`c1 = {};
Tables`nsine`c2 = {};
Tables`nsine`raw`c0[index_] := 
   Return[Tables`nsine`c0[[index + 1]]];


Tables`nsine`raw`c1[index_] := 
   Return[Tables`nsine`c1[[index + 1]]];


Tables`nsine`raw`c2[index_] := 
   Return[Tables`nsine`c2[[index + 1]]];


Tables`nsine[x_] := Module[{ index }, 
   index = Clip[Floor[(x * 127.)], {0, 127}];
   Return[(Tables`nsine`c0[[index + 1]] + (x * (Tables`nsine`c1[[index + 1]] + (Tables`nsine`c2[[index + 1]] * x))))];
]

Phase`process[`ctx_, cv_, reset_] := Module[{  }, 
   If[Util`change[getValue[`ctx, "inst_1b08a"], cv], 
      setValue[`ctx,"rate",Util`cvToRaten`n1024[cv]];];
   If[Util`edge[getValue[`ctx, "inst_2048a"], (reset > 0.5)], 
      setValue[`ctx,"phase",0.];, 
      setValue[`ctx,"phase",(getValue[`ctx, "phase"] + getValue[`ctx, "rate"])];];
   If[(getValue[`ctx, "phase"] > 1024.), 
      setValue[`ctx,"phase",(-1024. + getValue[`ctx, "phase"])];, 
      setValue[`ctx,"phase",getValue[`ctx, "phase"]];];
   Return[(0.000976 * getValue[`ctx, "phase"])];
]

