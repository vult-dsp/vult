Adsr`do[`ctx_, gate_, a_, d_, s_, r_] := Module[{ bgate, r`rate, d`rate, a`rate }, 
   a`rate = (1. / (0.01 + (100. * a)));
   d`rate = (1. / (0.01 + (100. * d)));
   r`rate = (1. / (0.01 + (100. * r)));
   setValue[`ctx,"out",((0.004 * (((-getValue[`ctx, "out"]) + getValue[`ctx, "target"]) * getValue[`ctx, "rate"])) + getValue[`ctx, "out"])];
   bgate = (gate > 0.);
   If[(getValue[`ctx, "state"] == 0), 
      Module[{  }, 
         If[Util`edge[getValue[`ctx, "inst_104a0"], bgate], 
            Module[{  }, 
               setValue[`ctx,"state",1];
               setValue[`ctx,"scale",(0.2 * gate)];
            ];];
         setValue[`ctx,"rate",r`rate];
         setValue[`ctx,"target",0.];
      ];];
   If[(getValue[`ctx, "state"] == 1), 
      Module[{  }, 
         If[(bgate == False), 
            setValue[`ctx,"state",0];];
         If[(getValue[`ctx, "out"] > 1024.), 
            setValue[`ctx,"state",2];];
         setValue[`ctx,"rate",a`rate];
         setValue[`ctx,"target",1228.8];
      ];];
   If[(getValue[`ctx, "state"] == 2), 
      Module[{  }, 
         If[(bgate == False), 
            setValue[`ctx,"state",0];];
         setValue[`ctx,"rate",d`rate];
         setValue[`ctx,"target",(1024. * s)];
      ];];
   Return[(Util`smooth[getValue[`ctx, "inst_295a0"], getValue[`ctx, "scale"]] * Clip[(0.000976 * getValue[`ctx, "out"]), {0., 1.}])];
]

