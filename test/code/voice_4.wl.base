Voicen`n4`process[`ctx_, cv_, vel_, gate_] := Module[{ env, f, o, sub, o3, o2, o1, mod`flt, mod`cv, mod`pw, lfo }, 
   lfo = Lfo`process[getValue[`ctx, "inst_1d695"], getValue[`ctx, "lfo_rate"], getValue[`ctx, "lfo_shape"], (gate * getValue[`ctx, "lfo_reset"])];
   mod`pw = (lfo * getValue[`ctx, "lfo_pw"]);
   mod`cv = (lfo * getValue[`ctx, "lfo_cv"]);
   mod`flt = (lfo * getValue[`ctx, "lfo_flt"]);
   o1 = Blit`process[getValue[`ctx, "inst_28b95"], (0.0001 + (cv + mod`cv)), (mod`pw + getValue[`ctx, "pw1"]), 0.];
   o2 = Blit`process[getValue[`ctx, "inst_38b95"], (0.0002 + (cv + mod`cv)), (mod`pw + getValue[`ctx, "pw2"]), 1.];
   o3 = Blit`process[getValue[`ctx, "inst_48b95"], (cv + (mod`cv + getValue[`ctx, "pw3"])), (mod`pw + getValue[`ctx, "pw1"]), 0.];
   sub = Saturate`process[((2. + (5. * getValue[`ctx, "pw4"])) * Tricore`process[getValue[`ctx, "inst_53c95"], (cv + mod`cv), 0., 1.])];
   o = ((o1 * getValue[`ctx, "level1"]) + ((o2 * getValue[`ctx, "level2"]) + ((o3 * getValue[`ctx, "level3"]) + (sub * getValue[`ctx, "level4"]))));
   f = Svf`process[getValue[`ctx, "inst_6a295"], o, (mod`flt + getValue[`ctx, "flt_cut"]), getValue[`ctx, "flt_res"], getValue[`ctx, "flt_shape"]];
   env = Adsr`do[getValue[`ctx, "inst_7a095"], gate, getValue[`ctx, "attack"], getValue[`ctx, "decay"], getValue[`ctx, "sustain"], getValue[`ctx, "release"]];
   Return[(env * f)];
]

