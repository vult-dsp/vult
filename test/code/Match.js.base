this.Match_foo1 = function (x) {
   if ((x == (0|0))) {
      return (0|0);
   } else {
      if ((x == (1|0))) {
         return (1|0);
      } else {
         return (2|0);
      }
   }
};

this.Match_foo2 = function (x, y) {
   if (((x == (1|0)) && (y == "e"))) {
      return ((1|0) + x);
   } else {
      if ((x == (3|0))) {
         return (1|0);
      } else {
         return (2|0);
      }
   }
};

this.Match_foo3 = function (x) {
   if ((x == (0|0))) {
      return (1|0);
   } else {
      if ((x == (1|0))) {
         return (2|0);
      } else {
         return (0|0);
      }
   }
};

