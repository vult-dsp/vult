class Ladder_process_euler_type:
    __slots__ = ['e', 'fh', 'inst_1b099']
    def __init__(self, e=Ladder_euler_type(), fh=0.0, inst_1b099=Util_change_type()):
        self.e = e
        self.fh = fh
        self.inst_1b099 = inst_1b099

class Ladder_process_heun_type:
    __slots__ = ['fh', 'h', 'inst_1b0a0']
