import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

def Array_instance_counter_type_alloc():
   _ctx = {}
   _ctx["x"] = 0
   return _ctx


def Array_instance_foo_type_alloc():
   i_0 = 0
   temp = None
   _ctx = {}
   while (i_0 < 2):
      temp[i_0] = Array_instance_counter_type_alloc()
      i_0 = (1 + i_0)

   _ctx["x"] = temp
   return _ctx


def Array_instance_counter(_ctx):
   _ctx["x"] = (1 + _ctx["x"])
   return _ctx["x"]


def Array_instance_incr(ctx):
   ctx["x"] = (1 + ctx["x"])
   return ctx["x"]


def Array_instance_foo(_ctx):
   i__1 = 0
   while (i__1 < 2):
      _ = Array_instance_counter(_ctx["x"][i__1])
      i__1 = (1 + i__1)

   return _ctx["x"][1]["x"]


