
class Array_instance_counter_type:
    __slots__ = ['x']
    def __init__(self, x=0):
        self.x = x

class Array_instance_foo_type:
    __slots__ = ['x']
    def __init__(self, x=[0.0] * 2):
        self.x = x

def Array_instance_counter_type_alloc():
   _ctx = Array_instance_counter_type()
   _ctx.x = 0
   return _ctx


def Array_instance_foo_type_alloc():
   i_0 = 0
   temp_1 = None
   _ctx = Array_instance_foo_type()
   while (i_0 < 2):
      temp_1[i_0] = Array_instance_counter_type_alloc()
      i_0 = (1 + i_0)

   _ctx.x = temp_1
   return _ctx


def Array_instance_counter(_ctx):
   _ctx.x = (1 + _ctx.x)
   return _ctx.x


def Array_instance_incr(ctx):
   ctx.x = (1 + ctx.x)
   return ctx.x


def Array_instance_foo(_ctx):
   i__1 = 0
   while (i__1 < 2):
      _ = Array_instance_counter(_ctx.x[i__1])
      i__1 = (1 + i__1)

   return _ctx.x[1].x


