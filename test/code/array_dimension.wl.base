
IntegerDivision[a_, b_] := Floor[a / b];
newEmptyObject[] := CreateDataStructure["HashTable"];
setValue[var_, key_, value_] := var["Insert", key -> value];
getValue[var_, key_] := var["Lookup", key];
newObject[elems_] := Module[{t = newEmptyObject[]}, Map[t["Insert", #] &, elems]; t];
initializeArray[v_, n_] := Table[v, n];
eps[] := $MinMachineNumber
Array`dimension`total[data_] := Module[{ i`n`n1, acc }, 
   acc = 0.;
   i`n`n1 = 0;
   While[(i`n`n1 < Length[data]), 
      Module[{  }, 
         acc = (acc + data[[i`n`n1 + 1]]);
         i`n`n1 = (1 + i`n`n1);
      ];];
   Return[acc];
]

Array`dimension`sum[data1_, data2_] := Module[{ i`n`n1, acc }, 
   acc = 0.;
   i`n`n1 = 0;
   While[(i`n`n1 < Length[data1]), 
      Module[{  }, 
         acc = (acc + (data1[[i`n`n1 + 1]] + data2[[i`n`n1 + 1]]));
         i`n`n1 = (1 + i`n`n1);
      ];];
   Return[acc];
]

Array`dimension`main[] := Module[{ k, z, y, x }, 
   x = {1., 2.};
   y = {1., 2., 3.};
   z = (Array`dimension`total[x] + Array`dimension`total[y]);
   k = Array`dimension`sum[x, y];
]

