

function EmptyTypes_foo_type_alloc()
   local _ctx = {};
   _ctx.screen = {}
   _ctx.settings = {}
   return _ctx
end

function EmptyTypes_setSettings_type_alloc(_ctx)
   return EmptyTypes_foo_type_alloc()
end

function EmptyTypes_setScreen_type_alloc(_ctx)
   return EmptyTypes_foo_type_alloc()
end

function EmptyTypes_foo(_ctx)
   setSomething(_ctx.settings)
   drawSomething(_ctx.screen)
end

function EmptyTypes_setSettings(_ctx, s)
   _ctx.settings = s
end

function EmptyTypes_setScreen(_ctx, s)
   _ctx.settings = s
end

