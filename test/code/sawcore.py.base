   _ctx["Sawcore_ptr_w2_ret_1"] = 0.0
   return _ctx


def Util_cvToPitch(cv):
   return (24.0 + (120.0 * cv))

Util_pitchToRate_1024_c0 = {}
Util_pitchToRate_1024_c1 = {}
Util_pitchToRate_1024_c2 = {}
def Util_pitchToRate_1024_raw_c0(index):
   return Util_pitchToRate_1024_c0[index]

def Util_pitchToRate_1024_raw_c1(index):
   return Util_pitchToRate_1024_c1[index]

def Util_pitchToRate_1024_raw_c2(index):
   return Util_pitchToRate_1024_c2[index]

def Util_pitchToRate_1024(pitch):
   index = ((0) if (float_to_int((pitch * 0.244094))) < (0) else ((31) if (float_to_int((pitch * 0.244094))) > (31) else (float_to_int((pitch * 0.244094)))))
   return (Util_pitchToRate_1024_c0[index] + (pitch * (Util_pitchToRate_1024_c1[index] + (Util_pitchToRate_1024_c2[index] * pitch))))


