import math

# Runtime functions

def float_to_int(i):
    return int(math.floor(i))

class Util_edge_type:
    __slots__ = ['pre']
    def __init__(self, pre=False):
        self.pre = pre

class Util_change_type:
    __slots__ = ['pre_x']
    def __init__(self, pre_x=0.0):
        self.pre_x = pre_x

class Util_dcblock_type:
    __slots__ = ['x1', 'y1']
    def __init__(self, x1=0.0, y1=0.0):
        self.x1 = x1
        self.y1 = y1

class Util_smooth_type:
    __slots__ = ['x']
    def __init__(self, x=0.0):
        self.x = x

class Util_average2_type:
    __slots__ = ['x0']
    def __init__(self, x0=0.0):
        self.x0 = x0

class Sawcore_ptr_w2_type:
    __slots__ = ['Sawcore_ptr_w2_ret_0', 'Sawcore_ptr_w2_ret_1']
    def __init__(self, Sawcore_ptr_w2_ret_0=False, Sawcore_ptr_w2_ret_1=0.0):
        self.Sawcore_ptr_w2_ret_0 = Sawcore_ptr_w2_ret_0
        self.Sawcore_ptr_w2_ret_1 = Sawcore_ptr_w2_ret_1

class Sawcore_process_type:
    __slots__ = ['inst_1b0dd', 'inst_204dd', 'inst_324dd', 'phase', 'rate', 'reset_phase', 'reset_state']
    def __init__(self, inst_1b0dd=Util_change_type(), inst_204dd=Util_edge_type(), inst_324dd=Sawcore_ptr_w2_type(), phase=0.0, rate=0.0, reset_phase=0.0, reset_state=False):
        self.inst_1b0dd = inst_1b0dd
        self.inst_204dd = inst_204dd
        self.inst_324dd = inst_324dd
        self.phase = phase
        self.rate = rate
        self.reset_phase = reset_phase
        self.reset_state = reset_state

