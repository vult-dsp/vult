def Sawcore_ptr_w2(_ctx, phase, rate):
   s1 = rate
   s2 = (rate + s1)
   out2 = 0.0
   out1 = False
   if (phase < s1):
      d = (phase / rate)
      t2 = (0.000976 * s2)
      out1 = False
      out2 = (1.0 + (d * (t2 + (-d))))

   else:
      if (phase < s2):
         d = (phase / rate)
         t2 = (0.000976 * s2)
         out1 = False
         out2 = (3.0 + (d * (-4.0 + (d + t2))))

      else:
         out1 = True
         out2 = 0.0

   _ctx["Sawcore_ptr_w2_ret_0"] = out1
   _ctx["Sawcore_ptr_w2_ret_1"] = out2
   return None


def Sawcore_process(_ctx, cv, reset):
   transition = 0.0
   out = 0.0
   if Util_change(_ctx["inst_1b0dd"], cv):
      _ctx["rate"] = Util_cvToRate_1024(cv)
   new_phase = (_ctx["phase"] + _ctx["rate"])
   do_reset = Util_edge(_ctx["inst_204dd"], (reset > 0.0))
   do_wrap = (new_phase > 1024.0)
   if (do_reset or do_wrap):
      _ctx["reset_phase"] = _ctx["phase"]
      if do_wrap:
         new_phase = (-1024.0 + new_phase)
      else:
         new_phase = 0.0
      _ctx["reset_state"] = True

   _ctx["phase"] = new_phase
   out = _ctx["phase"]
   if _ctx["reset_state"]:
      _ = Sawcore_ptr_w2(_ctx["inst_324dd"], _ctx["phase"], _ctx["rate"])
      done = _ctx["inst_324dd"]["Sawcore_ptr_w2_ret_0"]
      ptr = _ctx["inst_324dd"]["Sawcore_ptr_w2_ret_1"]
      transition = (0.5 * ((1.0 + ptr) * _ctx["reset_phase"]))
      if done:
         _ctx["reset_state"] = False
      else:
         out = transition

   return (-1.0 + (0.001953 * out))


