def Util_cvToRate_1024_raw_c2(index):
   return Util_cvToRate_1024_c2[index]

def Util_cvToRate_1024(cv):
   index = ((0) if (float_to_int((cv * 34.444444))) < (0) else ((31) if (float_to_int((cv * 34.444444))) > (31) else (float_to_int((cv * 34.444444)))))
   return (Util_cvToRate_1024_c0[index] + (cv * (Util_cvToRate_1024_c1[index] + (Util_cvToRate_1024_c2[index] * cv))))


def Sawcore_default(_ctx):
   _ctx["rate"] = Util_cvToRate_1024(0.0)

def Sawcore_process_type_alloc():
   _ctx = {}
   _ctx["inst_1b0dd"] = Util_change_type_alloc()
   _ctx["inst_204dd"] = Util_edge_type_alloc()
   _ctx["inst_324dd"] = Sawcore_ptr_w2_type_alloc()
   _ctx["phase"] = 0.0
   _ctx["rate"] = 0.0
   _ctx["reset_phase"] = 0.0
   _ctx["reset_state"] = False
   _ = Sawcore_default(_ctx)
   return _ctx


def Sawcore_noteOn_type_alloc(_ctx):
   return Sawcore_process_type_alloc()

def Sawcore_noteOff_type_alloc(_ctx):
   return Sawcore_process_type_alloc()

def Sawcore_controlChange_type_alloc(_ctx):
   return Sawcore_process_type_alloc()

def Sawcore_default_type_alloc(_ctx):
   return Sawcore_process_type_alloc()

def Util_edge(_ctx, x):
   ret = (x and (_ctx["pre"] == False))
   _ctx["pre"] = x
   return ret


def Util_change(_ctx, x):
   v = (_ctx["pre_x"] != x)
   _ctx["pre_x"] = x
   return v


def Util_map(x, x0, x1, y0, y1):
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))

def Util_dcblock(_ctx, x0):
   y0 = (x0 + ((-_ctx["x1"]) + (0.995 * _ctx["y1"])))
   _ctx["x1"] = x0
   _ctx["y1"] = y0
   return y0


def Util_smooth(_ctx, input):
   _ctx["x"] = ((0.005 * (input + (-_ctx["x"]))) + _ctx["x"])
   return _ctx["x"]


def Util_average2(_ctx, x1):
   result = (0.5 * (x1 + _ctx["x0"]))
   _ctx["x0"] = x1
   return result


def Util_cubic_clipper(x):
   if (x <= -0.666667):
      return -0.666667
   else:
      if (x >= 0.666666):
         return 0.666666
      else:
         return (x + (-0.333334 * (x * (x * x))))

