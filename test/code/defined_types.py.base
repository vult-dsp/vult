import math
import random as random_module

# Runtime functions (simple builtins like eps, pi, clip, sin, cos, etc. are inlined)

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

class Defined_types_dot:
    __slots__ = ['x', 'y']
    def __init__(self, x=0.0, y=0.0):
        self.x = x
        self.y = y

class Defined_types_foo_type:
    __slots__ = ['p1']
    def __init__(self, p1=Defined_types_dot()):
        self.p1 = p1

class Defined_types_process_type:
    __slots__ = ['inst_1a5d1']
    def __init__(self, inst_1a5d1=Defined_types_foo_type()):
        self.inst_1a5d1 = inst_1a5d1

class Defined_types_micro:
    __slots__ = ['dot_0', 'dot_1']
    def __init__(self, dot_0=Defined_types_dot(), dot_1=Defined_types_dot()):
        self.dot_0 = dot_0
        self.dot_1 = dot_1

def Defined_types_dot_alloc():
   _ctx = Defined_types_dot()
   _ctx.x = 0.0
   _ctx.y = 0.0
   return _ctx


def Defined_types_foo_type_alloc():
   _ctx = Defined_types_foo_type()
   _ctx.p1 = Defined_types_dot_alloc()
   return _ctx


def Defined_types_process_type_alloc():
   _ctx = Defined_types_process_type()
   _ctx.inst_1a5d1 = Defined_types_foo_type_alloc()
   return _ctx


def Defined_types_noteOn_type_alloc(_ctx):
   return Defined_types_process_type_alloc()

def Defined_types_noteOff_type_alloc(_ctx):
   return Defined_types_process_type_alloc()

def Defined_types_controlChange_type_alloc(_ctx):
   return Defined_types_process_type_alloc()

def Defined_types_default_type_alloc(_ctx):
   return Defined_types_process_type_alloc()

def Defined_types_micro_alloc():
   _ctx = Defined_types_micro()
   _ctx.dot_0 = Defined_types_dot_alloc()
   _ctx.dot_1 = Defined_types_dot_alloc()
   return _ctx


def Defined_types_foo(_ctx):
   pass

def Defined_types_process(_ctx, input):
   _ = Defined_types_foo(_ctx.inst_1a5d1)
   return input


def Defined_types_noteOn(_ctx, note, velocity, channel):
   pass

def Defined_types_noteOff(_ctx, note, channel):
   pass

def Defined_types_controlChange(_ctx, control, value, channel):
   pass

def Defined_types_default(_ctx):
   pass

