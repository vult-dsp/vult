function Kick_do(_ctx, gate, odecay, pitch, swept, noise)
   Ahr_do(_ctx.inst_1d863, gate, 0.005, (0.1 + odecay), (0.01 + odecay))
   local osc_env = _ctx.inst_1d863.Ahr_do_ret_0
   local env_reset = _ctx.inst_1d863.Ahr_do_ret_1
   local cv = Swept_process(_ctx.inst_20263, (1.0 + (-env_reset)), (pitch + (0.4 * swept)), pitch, 0.1)
   local osc = Tricore_process(_ctx.inst_33c63, cv, 0.0, env_reset)
   local osc_sat = Saturate_process((1.5 * osc))
   Ahr_do(_ctx.inst_4d863, gate, 0.001, 0.01, (0.001 + (0.01 * noise)))
   local noise_env = _ctx.inst_4d863.Ahr_do_ret_0
   local noise_osc = (0.333333 * (noise * Noise_process(_ctx.inst_53d63, 1.0)))
   return ((noise_env * noise_osc) + (osc_env * osc_sat))
end

