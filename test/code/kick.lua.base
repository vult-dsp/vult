function Ahr_do(_ctx, gate, a, h, r)
   local release = 0
   local attack = 1
   local hold = 2
   local reset = 3
   local bgate = (gate > 0.0)
   if Util_edge(_ctx.inst_104d8, bgate) then
      _ctx.state = reset
   end
   local resetting = 0.0
   if (_ctx.state == reset) then
      resetting = 1.0
   else
      resetting = 0.0
   end
   if Util_edge(_ctx.inst_204d8, (_ctx.out > 1024.0)) then
      do
         _ctx.hold_phase = 0.0
         _ctx.state = hold
      end
   end
   if ((_ctx.out < 10.0) and (_ctx.state == reset)) then
      _ctx.state = attack
   end
   if ((_ctx.hold_phase > 100.0) and (_ctx.state == hold)) then
      _ctx.state = release
   end
   if (_ctx.state == reset) then
      do
         _ctx.rate = 0.990099
         _ctx.target = 0.0
      end
   end
   if (_ctx.state == attack) then
      do
         _ctx.rate = (1.0 / (0.01 + (100.0 * a)))
         _ctx.target = 1228.8
      end
   end
   if (_ctx.state == hold) then
      do
         local hrate = (1.0 / (0.01 + (100.0 * h)))
         _ctx.hold_phase = (hrate + _ctx.hold_phase)
      end
   end
   if (_ctx.state == release) then
      do
         _ctx.rate = (1.0 / (0.01 + (100.0 * r)))
         _ctx.target = 0.0
      end
   end
   _ctx.out = ((0.005 * (((-_ctx.out) + _ctx.target) * _ctx.rate)) + _ctx.out)
   _ctx.Ahr_do_ret_0 = clip((0.000976 * _ctx.out), 0.0, 1.0)
   _ctx.Ahr_do_ret_1 = resetting
   return 
end

function Ahr_process(_ctx, gate)
   Ahr_do(_ctx.inst_1d84b, gate, _ctx.knob1, _ctx.knob2, _ctx.knob3)
   local _call_temp_0 = _ctx.inst_1d84b.Ahr_do_ret_0
   local _call_temp_1 = _ctx.inst_1d84b.Ahr_do_ret_1
   _ctx.Ahr_process_ret_0 = _call_temp_0
   _ctx.Ahr_process_ret_1 = _call_temp_1
   return 
end

function Ahr_noteOn(_ctx, note, velocity, channel)
end

function Ahr_noteOff(_ctx, note, channel)
end

function Ahr_controlChange(_ctx, control, value, channel)
   if (control == 1) then
      _ctx.knob1 = (0.007874 * real(value))
   end
   if (control == 2) then
      _ctx.knob2 = (0.007874 * real(value))
   end
   if (control == 3) then
      _ctx.knob3 = (0.007874 * real(value))
   end
end

function Ahr_default(_ctx)
   _ctx.knob1 = 0.0
   _ctx.knob2 = 0.5
   _ctx.knob3 = 0.5
end

function Kick_do(_ctx, gate, odecay, pitch, swept, noise)
   Ahr_do(_ctx.inst_1d863, gate, 0.005, (0.1 + odecay), (0.01 + odecay))
   local osc_env = _ctx.inst_1d863.Ahr_do_ret_0
   local env_reset = _ctx.inst_1d863.Ahr_do_ret_1
   local cv = Swept_process(_ctx.inst_20263, (1.0 + (-env_reset)), (pitch + (0.4 * swept)), pitch, 0.1)
   local osc = Tricore_process(_ctx.inst_33c63, cv, 0.0, env_reset)
   local osc_sat = Saturate_process((1.5 * osc))
   Ahr_do(_ctx.inst_4d863, gate, 0.001, 0.01, (0.001 + (0.01 * noise)))
   local noise_env = _ctx.inst_4d863.Ahr_do_ret_0
   local noise_osc = (0.333333 * (noise * Noise_process(_ctx.inst_53d63, 1.0)))
   return ((noise_env * noise_osc) + (osc_env * osc_sat))
end

function Kick_process(_ctx, gate)
   return Kick_do(_ctx.inst_16352, gate, _ctx.odecay, _ctx.pitch, _ctx.swept, _ctx.noise)
end

function Kick_noteOn(_ctx, note, velocity, channel)
end

function Kick_noteOff(_ctx, note, channel)
end

function Kick_controlChange(_ctx, control, value, channel)
   if (control == 30) then
      _ctx.odecay = (0.007874 * real(value))
   end
   if (control == 31) then
      _ctx.pitch = Util_map(real(value), 0.0, 127.0, 0.0, 0.1)
   end
   if (control == 32) then
      _ctx.swept = (0.007874 * real(value))
   end
   if (control == 33) then
      _ctx.noise = (0.007874 * real(value))
   end
end

function Kick_default(_ctx)
end

