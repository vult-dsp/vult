end

function Swept_process(_ctx, gate, start, end_, rate)
   local a_rate = (1.0 / (0.01 + (100.0 * rate)))
   local bgate = (gate > 0.5)
   _ctx.out = ((0.004 * (rate * ((-_ctx.out) + (1024.0 * end_)))) + _ctx.out)
   if Util_edge(_ctx.inst_10402, bgate) then
      _ctx.out = (1024.0 * start)
   end
   return (0.000976 * _ctx.out)
end

