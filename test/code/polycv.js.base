this.Util_cubic_clipper = function (x) {
   if ((x <= -0.666667)) {
      return -0.666667;
   } else {
      if ((x >= 0.666666)) {
         return 0.666666;
      } else {
         return (x + (-0.333334 * (x * (x * x))));
      }
   }
};

