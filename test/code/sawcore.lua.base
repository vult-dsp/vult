   return _ctx
end

function Util_cvToPitch(cv)
   return (24.0 + (120.0 * cv))
end

Util_pitchToRate_1024_c = {};
function Util_pitchToRate_1024_raw_c0(index)
   return Util_pitchToRate_1024_c[((index * 3)) + 1]
end

function Util_pitchToRate_1024_raw_c1(index)
   return Util_pitchToRate_1024_c[(((index * 3) + 1)) + 1]
end

function Util_pitchToRate_1024_raw_c2(index)
   return Util_pitchToRate_1024_c[(((index * 3) + 2)) + 1]
end

function Util_pitchToRate_1024(pitch)
   local value = (((pitch) > (127.0) and (127.0) or ((pitch) < (0.0) and (0.0) or (pitch))) * 0.251968)
   local cell = ((math.floor(value)) > (31) and (31) or ((math.floor(value)) < (0) and (0) or (math.floor(value))))
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_pitchToRate_1024_c[(index) + 1] + (u * (Util_pitchToRate_1024_c[((index + 1)) + 1] + (Util_pitchToRate_1024_c[((index + 2)) + 1] * u))))
end

Util_cvToRate_1024_c = {};
function Util_cvToRate_1024_raw_c0(index)
   return Util_cvToRate_1024_c[((index * 3)) + 1]
end

function Util_cvToRate_1024_raw_c1(index)
   return Util_cvToRate_1024_c[(((index * 3) + 1)) + 1]
end

function Util_cvToRate_1024_raw_c2(index)
   return Util_cvToRate_1024_c[(((index * 3) + 2)) + 1]
end

function Util_cvToRate_1024(cv)
   local value = (((cv) > (0.9) and (0.9) or ((cv) < (0.0) and (0.0) or (cv))) * 35.555555)
   local cell = ((math.floor(value)) > (31) and (31) or ((math.floor(value)) < (0) and (0) or (math.floor(value))))
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_cvToRate_1024_c[(index) + 1] + (u * (Util_cvToRate_1024_c[((index + 1)) + 1] + (Util_cvToRate_1024_c[((index + 2)) + 1] * u))))
end

function Sawcore_default(_ctx)
   _ctx.rate = Util_cvToRate_1024(0.0)
end

function Sawcore_process_type_alloc()
   local _ctx = {};
   _ctx.inst_1b0dd = Util_change_type_alloc()
   _ctx.inst_204dd = Util_edge_type_alloc()
   _ctx.inst_324dd = Sawcore_ptr_w2_type_alloc()
   _ctx.phase = 0.0
   _ctx.rate = 0.0
   _ctx.reset_phase = 0.0
   _ctx.reset_state = false
   Sawcore_default(_ctx)
   return _ctx
end

function Sawcore_noteOn_type_alloc(_ctx)
   return Sawcore_process_type_alloc()
end

function Sawcore_noteOff_type_alloc(_ctx)
   return Sawcore_process_type_alloc()
end

function Sawcore_controlChange_type_alloc(_ctx)
   return Sawcore_process_type_alloc()
end

function Sawcore_default_type_alloc(_ctx)
   return Sawcore_process_type_alloc()
end

function Util_edge(_ctx, x)
   local ret = (x and (_ctx.pre == false))
   _ctx.pre = x
   return ret
end

function Util_change(_ctx, x)
   local v = (_ctx.pre_x ~= x)
   _ctx.pre_x = x
   return v
end

function Util_map(x, x0, x1, y0, y1)
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))
end

function Util_dcblock(_ctx, x0)
   local y0 = (x0 + ((-_ctx.x1) + (0.995 * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0
end

function Util_smooth(_ctx, input)
   _ctx.x = ((0.005 * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Util_average2(_ctx, x1)
   local result = (0.5 * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result
end

function Util_cubic_clipper(x)
   if (x <= -0.666667) then
      return -0.666667
   else
      if (x >= 0.666666) then
         return 0.666666
      else
         return (x + (-0.333334 * (x * (x * x))))
      end
   end
end

