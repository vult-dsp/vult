function Sawcore_ptr_w2(_ctx, phase, rate)
   local s1 = rate
   local s2 = (rate + s1)
   local out2 = 0.0
   local out1 = false
   if (phase < s1) then
      do
         local d = (phase / rate)
         local t2 = (0.000976 * s2)
         out1 = false
         out2 = (1.0 + (d * (t2 + (-d))))
      end
   else
      if (phase < s2) then
         do
            local d = (phase / rate)
            local t2 = (0.000976 * s2)
            out1 = false
            out2 = (3.0 + (d * (-4.0 + (d + t2))))
         end
      else
         do
            out1 = true
            out2 = 0.0
         end
      end
   end
   _ctx.Sawcore_ptr_w2_ret_0 = out1
   _ctx.Sawcore_ptr_w2_ret_1 = out2
   return 
end

function Sawcore_process(_ctx, cv, reset)
   local transition = 0.0
   local out = 0.0
   if Util_change(_ctx.inst_1b0dd, cv) then
      _ctx.rate = Util_cvToRate_1024(cv)
   end
   local new_phase = (_ctx.phase + _ctx.rate)
   local do_reset = Util_edge(_ctx.inst_204dd, (reset > 0.0))
   local do_wrap = (new_phase > 1024.0)
   if (do_reset or do_wrap) then
      do
         _ctx.reset_phase = _ctx.phase
         if do_wrap then
            new_phase = (-1024.0 + new_phase)
         else
            new_phase = 0.0
         end
         _ctx.reset_state = true
      end
   end
   _ctx.phase = new_phase
   out = _ctx.phase
   if _ctx.reset_state then
      do
         Sawcore_ptr_w2(_ctx.inst_324dd, _ctx.phase, _ctx.rate)
         local done = _ctx.inst_324dd.Sawcore_ptr_w2_ret_0
         local ptr = _ctx.inst_324dd.Sawcore_ptr_w2_ret_1
         transition = (0.5 * ((1.0 + ptr) * _ctx.reset_phase))
         if done then
            _ctx.reset_state = false
         else
            out = transition
         end
      end
   end
   return (-1.0 + (0.001953 * out))
end

