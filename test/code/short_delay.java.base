private float Short_delay_do(Short_delay_do_type _ctx, float x, float time_in, float feedback_in) {
   float time = clip(time_in, 0.0f, 1.0f);
   float feedback = clip(feedback_in, 0.0f, 1.0f);
   float index_r = (22050.0f * time);
   int index_i = (int)(floor(index_r));
   int delta = ((-index_i) + _ctx.write_pos);
   int read_pos = 0;
   if ((delta < 0)) {
      read_pos = (22050 + delta);
   } else {
      read_pos = delta;
   }
   float decimal = (index_r + (-(float)(index_i)));
   float x1 = _ctx.buffer[read_pos];
   float x2 = _ctx.buffer[((1 + read_pos) % 22050)];
   float ret = (x1 + (decimal * (x2 + (-x1))));
   _ctx.write_pos = ((1 + _ctx.write_pos) % 22050);
   _ctx.buffer[_ctx.write_pos] = Saturate_process((x + (feedback * ret)));
   return ret;
}

