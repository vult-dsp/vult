
// Runtime functions
this.float_to_int = function(i)  { return Math.floor(i); };
var Saturate_soft_tanh_table_c = {};
this.Saturate_soft_tanh_table_raw_c0 = function (index) {
   return Saturate_soft_tanh_table_c[(index * (3|0))];
};

this.Saturate_soft_tanh_table_raw_c1 = function (index) {
   return Saturate_soft_tanh_table_c[((index * (3|0)) + (1|0))];
};

this.Saturate_soft_tanh_table_raw_c2 = function (index) {
   return Saturate_soft_tanh_table_c[((index * (3|0)) + (2|0))];
};

this.Saturate_soft_tanh_table = function (x) {
   var value = ((((x) < (-24.0) ? (-24.0) : ((x) > (24.0) ? (24.0) : (x))) + 24.0) * 5.020833);
   var cell = ((this.float_to_int(value)) < ((0|0)) ? ((0|0)) : ((this.float_to_int(value)) > ((240|0)) ? ((240|0)) : (this.float_to_int(value))));
   var u = (value - (cell));
   var index = (cell * (3|0));
   return (Saturate_soft_tanh_table_c[index] + (u * (Saturate_soft_tanh_table_c[(index + (1|0))] + (Saturate_soft_tanh_table_c[(index + (2|0))] * u))));
};

this.Saturate_soft_process = function (x) {
   return this.Saturate_soft_tanh_table(x);
};

this.Saturate_soft_noteOn = function (note, velocity, channel) {
};

this.Saturate_soft_noteOff = function (note, channel) {
};

this.Saturate_soft_controlChange = function (control, value, channel) {
};

this.Saturate_soft_default = function () {
};

