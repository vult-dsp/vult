private float Phasedist_smooth(Phasedist_smooth_type _ctx, float input) {
   _ctx.x = ((0.005f * (input + (-_ctx.x))) + _ctx.x);
   return _ctx.x;
}

private boolean Phasedist_change(Phasedist_change_type _ctx, float x) {
   boolean v = (_ctx.pre_x != x);
   _ctx.pre_x = x;
   return v;
}

private float Phasedist_pitchToRate(float d) {
   return (0.000185f * exp((0.057762f * d)));
}

private float Phasedist_phasor(Phasedist_phasor_type _ctx, float pitch, boolean reset) {
   if (Phasedist_change(_ctx.inst_1e817, pitch)) {
      _ctx.rate = Phasedist_pitchToRate(pitch);
   }
   if (reset) {
      _ctx.phase = 0.0f;
   } else {
      _ctx.phase = (_ctx.phase + _ctx.rate);
   }
   if ((_ctx.phase > 1.0f)) {
      _ctx.phase = (-1.0f + _ctx.phase);
   } else {
      _ctx.phase = _ctx.phase;
   }
   return _ctx.phase;
}

private float Phasedist_process(Phasedist_process_type _ctx, float input) {
   float phase1 = Phasedist_phasor(_ctx.inst_117e9, _ctx.pitch, false);
   float comp = (1.0f + (-phase1));
   boolean reset = (((-phase1) + _ctx.pre_phase1) > 0.5f);
   _ctx.pre_phase1 = phase1;
   float phase2 = Phasedist_phasor(_ctx.inst_317e9, ((32.0f * Phasedist_smooth(_ctx.inst_275e9, _ctx.detune)) + _ctx.pitch), reset);
   float sine = sin((6.283185f * phase2));
   return (comp * (sine * Phasedist_smooth(_ctx.inst_475e9, _ctx.volume)));
}

private void Phasedist_noteOn(Phasedist_process_type _ctx, int note, int velocity, int channel) {
   _ctx.pitch = (float)(note);
}

private void Phasedist_noteOff(Phasedist_process_type _ctx, int note, int channel) {
}

private void Phasedist_controlChange(Phasedist_process_type _ctx, int control, int value, int channel) {
   if ((control == 30)) {
      _ctx.volume = (0.007874f * (float)(value));
   }
   if ((control == 31)) {
      _ctx.detune = (0.007874f * (float)(value));
   }
}

private void Phasedist_default(Phasedist_process_type _ctx) {
   _ctx.volume = 1.0f;
   _ctx.pitch = 45.0f;
   _ctx.detune = 0.0f;
}


