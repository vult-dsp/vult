Util`cvTokHz`raw`c2[index_] := 
   Return[Util`cvTokHz`c2[[index + 1]]];


Util`cvTokHz[cv_] := Module[{ index }, 
   index = Clip[Floor[(cv * 31.)], {0, 31}];
   Return[(Util`cvTokHz`c0[[index + 1]] + (cv * (Util`cvTokHz`c1[[index + 1]] + (Util`cvTokHz`c2[[index + 1]] * cv))))];
]

Phase`process[`ctx_, cv_, reset_] := Module[{  }, 
   If[Util`change[getValue[`ctx, "inst_1b08a"], cv], 
      setValue[`ctx,"rate",Util`cvToRaten`n1024[cv]];];
   If[Util`edge[getValue[`ctx, "inst_2048a"], (reset > 0.5)], 
      setValue[`ctx,"phase",0.];, 
      setValue[`ctx,"phase",(getValue[`ctx, "phase"] + getValue[`ctx, "rate"])];];
   If[(getValue[`ctx, "phase"] > 1024.), 
      setValue[`ctx,"phase",(-1024. + getValue[`ctx, "phase"])];, 
      setValue[`ctx,"phase",getValue[`ctx, "phase"]];];
   Return[(0.000976 * getValue[`ctx, "phase"])];
]

Phase`noteOn[`ctx_, note_, velocity_, channel_] := Null

Phase`noteOff[`ctx_, note_, channel_] := Null

Phase`controlChange[`ctx_, control_, value_, channel_] := Null

Tables`nsine`c0 = {};
Tables`nsine`c1 = {};
Tables`nsine`c2 = {};
Tables`nsine`raw`c0[index_] := 
   Return[Tables`nsine`c0[[index + 1]]];


Tables`nsine`raw`c1[index_] := 
   Return[Tables`nsine`c1[[index + 1]]];


Tables`nsine`raw`c2[index_] := 
   Return[Tables`nsine`c2[[index + 1]]];


Tables`nsine[x_] := Module[{ index }, 
   index = Clip[Floor[(x * 127.)], {0, 127}];
   Return[(Tables`nsine`c0[[index + 1]] + (x * (Tables`nsine`c1[[index + 1]] + (Tables`nsine`c2[[index + 1]] * x))))];
]

Blit`pulse`train[`ctx_, cv_, phase_] := Module[{ out, denominator, pi`phase }, 
   If[Util`change[getValue[`ctx, "inst_1b05e"], cv], 
      Module[{  }, 
         setValue[`ctx,"m",(1 + (2 * Floor[Util`cvToperiod[cv]]))];
         setValue[`ctx,"scale",(2. * Util`cvToperiod[cv])];
      ];];
   pi`phase = (0.5 * phase);
   denominator = Tables`nsine[pi`phase];
   out = 0.;
   If[(denominator <= eps[]), 
      out = 1.;, 
      Module[{ numerator, m`phase }, 
         m`phase = ((pi`phase * N[getValue[`ctx, "m"]]) % 1.);
         numerator = Tables`nsine[m`phase];
         out = (numerator / (denominator * getValue[`ctx, "scale"]));
      ];];
   Return[out];
]

Blit`osc`blit[`ctx_, cv_, pw_, wave_] := Module[{ pulse2, pulse1, shift, shift05, phase, fixed`cv }, 
   fixed`cv = 0.;
   If[(wave < 1.), 
      fixed`cv = cv;, 
      fixed`cv = (-0.1 + cv);];
   If[Util`change[getValue[`ctx, "inst_1b026"], fixed`cv], 
      setValue[`ctx,"rate",Util`cvToRate[fixed`cv]];];
   phase = Phase`process[getValue[`ctx, "inst_28a26"], fixed`cv, 0.];
   shift05 = (0.5 + (0.49 * pw));
   shift = (phase + shift05);
   If[(shift > 1.), 
      shift = (-1. + shift);];
   pulse1 = Blit`pulse`train[getValue[`ctx, "inst_35e26"], fixed`cv, phase];
   pulse2 = Blit`pulse`train[getValue[`ctx, "inst_45e26"], fixed`cv, shift];
   setValue[`ctx,"state_pulse",(pulse1 + ((-pulse2) + (0.9995 * getValue[`ctx, "state_pulse"])))];
   setValue[`ctx,"state_saw",((0.5 * ((pulse1 + (pulse2 + (-2. * getValue[`ctx, "rate"]))) / shift05)) + (0.9995 * getValue[`ctx, "state_saw"]))];
   If[(wave < 1.), 
      setValue[`ctx,"output",getValue[`ctx, "state_pulse"]];, 
      setValue[`ctx,"output",(2. * getValue[`ctx, "state_saw"])];];
   setValue[`ctx,"output",Util`dcblock[getValue[`ctx, "inst_56426"], getValue[`ctx, "output"]]];
   Return[getValue[`ctx, "output"]];
]

Blit`process[`ctx_, cv_, pw_, wave_] := 
   Return[Blit`osc`blit[getValue[`ctx, "inst_1268b"], cv, pw, wave]];


