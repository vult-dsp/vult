   return Rescomb_toneCurve_c[(index * 3)];
}

private float Rescomb_toneCurve_raw_c1(int index) {
   return Rescomb_toneCurve_c[((index * 3) + 1)];
}

private float Rescomb_toneCurve_raw_c2(int index) {
   return Rescomb_toneCurve_c[((index * 3) + 2)];
}

private float Rescomb_toneCurve(float tone) {
   float value = ((clip(tone, -1.2f, 1.2f) + 1.2f) * 26.666666f);
   int cell = clip(float_to_int(value), 0, 63);
   float u = (value - (float)(cell));
   int index = (cell * 3);
   return (Rescomb_toneCurve_c[index] + (u * (Rescomb_toneCurve_c[(index + 1)] + (Rescomb_toneCurve_c[(index + 2)] * u))));
}

private float Rescomb_do(Rescomb_do_type _ctx, float in, float cv, float tone, float res) {
   if (Util_change(_ctx.inst_1b000, tone)) {
      _ctx.stone = Rescomb_toneCurve(tone);
   }
   float feedback = Util_dcblock(_ctx.inst_26400, (res * _ctx.output));
   float saturated_input = Saturate_soft_process((feedback + in));
   _ctx.output = (in + (Rescomb_delay(_ctx.inst_3a900, saturated_input, cv) * _ctx.stone));
   return Saturate_soft_process(_ctx.output);
}

private float Rescomb_process(Rescomb_process_type _ctx, float in, float cv, float tone, float res) {
   return Rescomb_do(_ctx.inst_100b6, in, cv, tone, res);
}

