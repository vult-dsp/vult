
-- LuaJIT detection
local isLuaJIT = type(jit) == "table" and jit.version


-- Numeric arrays use FFI storage under LuaJIT, tables everywhere else.
local initializeArray
if isLuaJIT then
    local ffi = require("ffi")
    function initializeArray(v, n)
        if type(v) == "number" then
            -- One-based, so element zero is unused. This is cdata, not a
            -- table: indexing works, '#' and pairs() do not.
            local a = ffi.new("double[?]", n + 1)
            for i = 1, n do a[i] = v end
            return a
        else
            local a = {}
            for i = 1, n do a[i] = v end
            return a
        end
    end
else
    function initializeArray(v, n)
        local a = {}
        for i = 1, n do a[i] = v end
        return a
    end
end


function Array_return_foo3_type_alloc()
   local _ctx = {};
   _ctx.y = 0
   return _ctx
end

function Array_return_foo4_type_alloc()
   local _ctx = {};
   _ctx.y = 0
   return _ctx
end

function Array_return_foo5_type_alloc()
   local _ctx = {};
   _ctx.Array_return_foo5_ret_0 = 0
   local i_0 = 0
   local temp_1 = initializeArray(0, 3)
   while (i_0 < 3) do
      do
         temp_1[i_0 + 1] = 0
         i_0 = (1 + i_0)
      end
   end
   _ctx.Array_return_foo5_ret_1 = temp_1
   return _ctx
end

function Array_return_foo6_type_alloc()
   local _ctx = {};
   _ctx.Array_return_foo6_ret_0 = 0
   local i_0 = 0
   local temp_1 = initializeArray(0, 3)
   while (i_0 < 3) do
      do
         temp_1[i_0 + 1] = 0
         i_0 = (1 + i_0)
      end
   end
   _ctx.Array_return_foo6_ret_1 = temp_1
   return _ctx
end

function Array_return_s1_alloc()
   local _ctx = {};
   _ctx.x = 0
   _ctx.y = 0
   return _ctx
end

function Array_return_foo7_type_alloc()
   local _ctx = {};
   _ctx.Array_return_foo7_ret_0 = 0
   _ctx.Array_return_foo7_ret_1 = Array_return_s1_alloc()
   return _ctx
end

