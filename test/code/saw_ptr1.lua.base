function Util_cvToRate(cv)
   local value = (((cv) > (0.9) and (0.9) or ((cv) < (0.0) and (0.0) or (cv))) * 142.222222)
   local cell = ((math.floor(value)) > (127) and (127) or ((math.floor(value)) < (0) and (0) or (math.floor(value))))
   local u = (value - (cell))
   local index = (cell * 3)
   return (Util_cvToRate_c[(index) + 1] + (u * (Util_cvToRate_c[((index + 1)) + 1] + (Util_cvToRate_c[((index + 2)) + 1] * u))))
end

function Saw_ptr1_default(_ctx)
   _ctx.rate = Util_cvToRate(0.0)
end

function Saw_ptr1_process_type_alloc()
   local _ctx = {};
   _ctx.inst_1b06f = Util_change_type_alloc()
   _ctx.phase = 0.0
   _ctx.rate = 0.0
   Saw_ptr1_default(_ctx)
   return _ctx
end

function Saw_ptr1_noteOn_type_alloc(_ctx)
   return Saw_ptr1_process_type_alloc()
end

function Saw_ptr1_noteOff_type_alloc(_ctx)
   return Saw_ptr1_process_type_alloc()
end

function Saw_ptr1_controlChange_type_alloc(_ctx)
   return Saw_ptr1_process_type_alloc()
end

function Saw_ptr1_default_type_alloc(_ctx)
   return Saw_ptr1_process_type_alloc()
end

function Util_edge(_ctx, x)
   local ret = (x and (_ctx.pre == false))
   _ctx.pre = x
   return ret
end

function Util_change(_ctx, x)
   local v = (_ctx.pre_x ~= x)
   _ctx.pre_x = x
   return v
end

function Util_map(x, x0, x1, y0, y1)
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))
end

function Util_dcblock(_ctx, x0)
   local y0 = (x0 + ((-_ctx.x1) + (0.995 * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0
end

function Util_smooth(_ctx, input)
   _ctx.x = ((0.005 * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Util_average2(_ctx, x1)
   local result = (0.5 * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result
end

function Util_cubic_clipper(x)
   if (x <= -0.666667) then
      return -0.666667
   else
      if (x >= 0.666666) then
         return 0.666666
      else
         return (x + (-0.333334 * (x * (x * x))))
      end
   end
end

