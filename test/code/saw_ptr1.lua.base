function Saw_ptr1_process(_ctx, cv)
   if Util_change(_ctx.inst_1b06f, cv) then
      _ctx.rate = Util_cvToRate(cv)
   end
   local s1 = _ctx.rate
   local dc = -1.0
   _ctx.phase = (_ctx.phase + _ctx.rate)
   local out = 0.0
   if (_ctx.phase > 1.0) then
      _ctx.phase = (-1.0 + _ctx.phase)
   else
      _ctx.phase = _ctx.phase
   end
   if (_ctx.phase < s1) then
      do
         local d = (_ctx.phase / _ctx.rate)
         out = (2.0 + (dc + (-2.0 * d)))
      end
   else
      out = ((-dc) + (2.0 * _ctx.phase))
   end
   return out
end

