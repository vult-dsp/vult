import math
import random as random_module

def eps():
    return 1e-18

def pi():
    return 3.1415926535897932384

def random():
    return random_module.random()

def irandom():
    return int(random_module.random() * 4294967296)

def clip(x, low, high):
    return low if x < low else (high if x > high else x)

def not_(x):
    return 0 if x != 0 else 1

def real(x):
    return float(x)

def int_(x):
    return int(x)

def int_to_float(i):
    return float(i)

def float_to_int(i):
    return int(math.floor(i))

def initializeArray(v, size):
    return [v for _ in range(size)]

def InstanceArray_counter_type_alloc():
   _ctx = {}
   _ctx["total"] = 0.0
   return _ctx


def InstanceArray_test1_type_alloc():
   i_0 = 0
   temp = None
   _ctx = {}
   while (i_0 < 4):
      temp[i_0] = InstanceArray_counter_type_alloc()
      i_0 = (1 + i_0)

   _ctx["instances"] = temp
   return _ctx


def InstanceArray_test2_type_alloc():
   _ctx = {}
   _ctx["case1"] = InstanceArray_counter_type_alloc()
   _ctx["case2"] = InstanceArray_counter_type_alloc()
   return _ctx


def InstanceArray_counter(_ctx):
   _ctx["total"] = (1.0 + _ctx["total"])
   return _ctx["total"]


def InstanceArray_test1(_ctx):
   sum = 0.0
   i__1 = 0
   while (i__1 < 4):
      sum = (sum + InstanceArray_counter(_ctx["instances"][i__1]))
      i__1 = (1 + i__1)

   return sum


def InstanceArray_test2(_ctx):
   _ = InstanceArray_counter(_ctx["case1"])
   _ = InstanceArray_counter(_ctx["case2"])


