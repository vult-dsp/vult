
# High-performance Vult Runtime for Julia with typed arrays

mutable struct Util_edge_type
       pre::Bool
end

# Default constructor for Util_edge_type
function Util_edge_type()
    return Util_edge_type(false)
end

mutable struct Util_change_type
       pre_x::Float32
end

# Default constructor for Util_change_type
function Util_change_type()
    return Util_change_type(Float32(0.0))
end

mutable struct Util_dcblock_type
       x1::Float32
       y1::Float32
end

# Default constructor for Util_dcblock_type
function Util_dcblock_type()
    return Util_dcblock_type(Float32(0.0), Float32(0.0))
end

mutable struct Util_smooth_type
       x::Float32
end

# Default constructor for Util_smooth_type
function Util_smooth_type()
    return Util_smooth_type(Float32(0.0))
end

mutable struct Util_average2_type
       x0::Float32
end

# Default constructor for Util_average2_type
function Util_average2_type()
    return Util_average2_type(Float32(0.0))
end

mutable struct Lfo_soft_type
       x2::Float32
       x3::Float32
       x4::Float32
end

# Default constructor for Lfo_soft_type
function Lfo_soft_type()
    return Lfo_soft_type(Float32(0.0), Float32(0.0), Float32(0.0))
end

mutable struct Lfo_process_type
       inst_1b0d6::Util_change_type
       inst_204d6::Util_edge_type
       inst_337d6::Lfo_soft_type
       phase::Float32
       rate::Float32
end

# Default constructor for Lfo_process_type
function Lfo_process_type()
    return Lfo_process_type(Util_change_type(), Util_edge_type(), Lfo_soft_type(), Float32(0.0), Float32(0.0))
end

function Util_edge_type_alloc()
   _ctx = Util_edge_type()
   _ctx.pre = false
   return _ctx
end

function Util_change_type_alloc()
   _ctx = Util_change_type()
   _ctx.pre_x = Float32(0.0)
   return _ctx
end

function Util_dcblock_type_alloc()
   _ctx = Util_dcblock_type()
   _ctx.x1 = Float32(0.0)
   _ctx.y1 = Float32(0.0)
   return _ctx
end

function Util_smooth_type_alloc()
   _ctx = Util_smooth_type()
   _ctx.x = Float32(0.0)
   return _ctx
end

function Util_average2_type_alloc()
   _ctx = Util_average2_type()
   _ctx.x0 = Float32(0.0)
   return _ctx
end

function Lfo_soft_type_alloc()
   _ctx = Lfo_soft_type()
   _ctx.x2 = Float32(0.0)
   _ctx.x3 = Float32(0.0)
   _ctx.x4 = Float32(0.0)
   return _ctx
end

function Lfo_process_type_alloc()
   _ctx = Lfo_process_type()
   _ctx.inst_1b0d6 = Util_change_type_alloc()
   _ctx.inst_204d6 = Util_edge_type_alloc()
   _ctx.inst_337d6 = Lfo_soft_type_alloc()
   _ctx.phase = Float32(0.0)
   _ctx.rate = Float32(0.0)
   return _ctx
end

function Lfo_noteOn_type_alloc(_ctx)
   return Lfo_process_type_alloc()
end

function Lfo_noteOff_type_alloc(_ctx)
   return Lfo_process_type_alloc()
end

function Lfo_controlChange_type_alloc(_ctx)
   return Lfo_process_type_alloc()
end

function Lfo_default_type_alloc(_ctx)
   return Lfo_process_type_alloc()
end

function Util_edge(_ctx, x)
   ret = (x && (_ctx.pre == false))
   _ctx.pre = x
   return ret
end

function Util_change(_ctx, x)
   v = (_ctx.pre_x != x)
   _ctx.pre_x = x
   return v
end

function Util_map(x, x0, x1, y0, y1)
   return (y0 + (((x + (-x0)) * (y1 + (-y0))) / (x1 + (-x0))))
end

function Util_dcblock(_ctx, x0)
   y0 = (x0 + ((-_ctx.x1) + (Float32(0.995) * _ctx.y1)))
   _ctx.x1 = x0
   _ctx.y1 = y0
   return y0
end

function Util_smooth(_ctx, input)
   _ctx.x = ((Float32(0.005) * (input + (-_ctx.x))) + _ctx.x)
   return _ctx.x
end

function Util_average2(_ctx, x1)
   result = (Float32(0.5) * (x1 + _ctx.x0))
   _ctx.x0 = x1
   return result
end

function Util_cubic_clipper(x)
   if (x <= Float32(-0.666667))
      return Float32(-0.666667)
   else
      if (x >= Float32(0.666666))
         return Float32(0.666666)
      else
         return (x + (Float32(-0.333334) * (x * (x * x))))
      end
   end
end

Util_pitchToRate_1024_c = nothing
function Util_pitchToRate_1024_raw_c0(index)
   return @inbounds Util_pitchToRate_1024_c[(index * Int32(3)) + 1]
end

function Util_pitchToRate_1024_raw_c1(index)
   return @inbounds Util_pitchToRate_1024_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Util_pitchToRate_1024_raw_c2(index)
   return @inbounds Util_pitchToRate_1024_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Util_pitchToRate_1024(pitch)
   value = (clamp(pitch, Float32(0.0), Float32(127.0)) * Float32(0.251968))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_pitchToRate_1024_c[index + 1] + (u * (@inbounds Util_pitchToRate_1024_c[(index + Int32(1)) + 1] + (@inbounds Util_pitchToRate_1024_c[(index + Int32(2)) + 1] * u))))
end

Util_pitchToRate_c = nothing
function Util_pitchToRate_raw_c0(index)
   return @inbounds Util_pitchToRate_c[(index * Int32(3)) + 1]
end

function Util_pitchToRate_raw_c1(index)
   return @inbounds Util_pitchToRate_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Util_pitchToRate_raw_c2(index)
   return @inbounds Util_pitchToRate_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Util_pitchToRate(pitch)
   value = (clamp(pitch, Float32(0.0), Float32(127.0)) * Float32(0.251968))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_pitchToRate_c[index + 1] + (u * (@inbounds Util_pitchToRate_c[(index + Int32(1)) + 1] + (@inbounds Util_pitchToRate_c[(index + Int32(2)) + 1] * u))))
end

function Util_cvToPitch(cv)
   return (Float32(24.0) + (Float32(120.0) * cv))
end

Util_cvToRate_1024_c = nothing
function Util_cvToRate_1024_raw_c0(index)
   return @inbounds Util_cvToRate_1024_c[(index * Int32(3)) + 1]
end

function Util_cvToRate_1024_raw_c1(index)
   return @inbounds Util_cvToRate_1024_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Util_cvToRate_1024_raw_c2(index)
   return @inbounds Util_cvToRate_1024_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Util_cvToRate_1024(cv)
   value = (clamp(cv, Float32(0.0), Float32(0.9)) * Float32(35.555555))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(31))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_cvToRate_1024_c[index + 1] + (u * (@inbounds Util_cvToRate_1024_c[(index + Int32(1)) + 1] + (@inbounds Util_cvToRate_1024_c[(index + Int32(2)) + 1] * u))))
end

Util_cvToRate_c = nothing
function Util_cvToRate_raw_c0(index)
   return @inbounds Util_cvToRate_c[(index * Int32(3)) + 1]
end

function Util_cvToRate_raw_c1(index)
   return @inbounds Util_cvToRate_c[((index * Int32(3)) + Int32(1)) + 1]
end

function Util_cvToRate_raw_c2(index)
   return @inbounds Util_cvToRate_c[((index * Int32(3)) + Int32(2)) + 1]
end

function Util_cvToRate(cv)
   value = (clamp(cv, Float32(0.0), Float32(0.9)) * Float32(142.222222))
   cell = clamp(trunc(Int32, value), Int32(0), Int32(127))
   u = (value - Float32(cell))
   index = (cell * Int32(3))
   return (@inbounds Util_cvToRate_c[index + 1] + (u * (@inbounds Util_cvToRate_c[(index + Int32(1)) + 1] + (@inbounds Util_cvToRate_c[(index + Int32(2)) + 1] * u))))
end

function Util_pitchToCv(pitch)
   return (Float32(-0.2) + (Float32(0.008333) * pitch))
end

