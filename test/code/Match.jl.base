
# High-performance Vult Runtime for Julia with typed arrays

function Match_foo1(x)
   if (x == Int32(0))
      return Int32(0)
   else
      if (x == Int32(1))
         return Int32(1)
      else
         return Int32(2)
      end
   end
end

function Match_foo2(x, y)
   if ((x == Int32(1)) && (y == "e"))
      return (Int32(1) + x)
   else
      if (x == Int32(3))
         return Int32(1)
      else
         return Int32(2)
      end
   end
end

function Match_foo3(x)
   if (x == Int32(0))
      return Int32(1)
   else
      if (x == Int32(1))
         return Int32(2)
      else
         return Int32(0)
      end
   end
end

