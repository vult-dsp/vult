// Regression fixture for the generated lookup tables. The functions are compiled with the C++
// backend and evaluated by tables_regression_main.cpp, which asserts their values at the edges
// of the tables instead of only snapshotting the generated code.

// Tables without bound checks must still return the value at the exact upper endpoint: an
// input of exactly max selects the cell after the fitted ones, which holds the endpoint.
fun order1_nocheck(x) @[table(min = 0.0, max = 1.0, size = 8, order = 1, bound_check = false)] {
  return tanh(2.0 * x);
}

fun order2_nocheck(x) @[table(min = 0.0, max = 1.0, size = 8, order = 2, bound_check = false)] {
  return tanh(2.0 * x);
}

// Mixed precision: a fix16 input with a real output. With bound checks enabled the raw input
// must be clamped before it is scaled, otherwise the scaling wraps for large inputs and the
// wrong edge of the table is returned.
fun mixed_checked(x:fix16) : real @[table(min = 0.0, max = 1.0, size = 4, order = 1)] {
  return real(x);
}

// The raw samples and the interpolated wavetable of the same file: the n samples span n - 1
// cells, so reading the wavetable at i / (n - 1) must land on sample i.
external wave_raw(channel:int, index:int) : real @[wave(channels = 1, file = "wave.wav")];
external wavetable(position:real) : real @[wavetable(file = "wave.wav")];

// Fixed-point tables default to linear interpolation but honor an explicit order = 2. At the
// same size the quadratic table must follow the curvature much closer than the linear one.
fun fix_o1(x:fix16) : fix16 @[table(min = 0.0, max = 1.0, size = 8)] {
  return tanh(2.0x * x);
}

fun fix_o2(x:fix16) : fix16 @[table(min = 0.0, max = 1.0, size = 8, order = 2)] {
  return tanh(2.0x * x);
}

// Fixed-point tables honor bound_check = false: nothing is clamped, and an input of exactly
// max must read the guard point holding the endpoint value.
fun fix_nocheck(x:fix16) : fix16 @[table(min = 0.0, max = 1.0, size = 8, bound_check = false)] {
  return tanh(2.0x * x);
}

// A parameter named like one of the temporaries the lookup declares ("value", "cell", "u",
// "index", and "decimal" in the fixed-point path) must not be shadowed by them: the generated
// code has to compile and still evaluate the table at the argument.
fun shadow_value(value:real) : real @[table(min = 0.0, max = 1.0, size = 8, order = 2)] {
  return tanh(2.0 * value);
}

fun shadow_u(u:real) : real @[table(min = 0.0, max = 1.0, size = 8, order = 1)] {
  return tanh(2.0 * u);
}

fun shadow_cell(cell:real) : real @[table(min = 0.0, max = 1.0, size = 8, order = 2)] {
  return tanh(2.0 * cell);
}

fun shadow_index(index:real) : real @[table(min = 0.0, max = 1.0, size = 8, order = 2)] {
  return tanh(2.0 * index);
}

fun shadow_decimal(decimal:fix16) : fix16 @[table(min = 0.0, max = 1.0, size = 8)] {
  return tanh(2.0x * decimal);
}
