(library
 (name generators)
 (modules
  Lua
  Js
  Cpp
  Java
  Julia
  Python
  Zig
  Common
  Tocode
  Usage
  Vultin_embedded
  Tables
  T_pd
  T_performance
  T_mathematica
  T_browser
  T_webaudio
  T_worklet
  T_vcv_prototype
  Replacements)
 (libraries core pparser pla str util)
 (flags
  (:standard -w -30))
 (preprocess
  (pps pla.ppx))
 (ocamlopt_flags -O3 -unbox-closures)
 (instrumentation
  (backend bisect_ppx)))

(rule
 (targets vultin_embedded.ml)
 (deps ../../runtime/vultin.hpp ../../runtime/vultin.cpp)
 (action
  (with-stdout-to
   vultin_embedded.ml
   (progn
    (echo
     "(* Generated from the files in the runtime directory. Do not edit. *)\n")
    (echo "let hpp =\n  {vultin_embedded|")
    (cat ../../runtime/vultin.hpp)
    (echo "|vultin_embedded}\n\n")
    (echo "let cpp =\n  {vultin_embedded|")
    (cat ../../runtime/vultin.cpp)
    (echo "|vultin_embedded}\n")))))
