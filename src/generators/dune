(library
 (name generators)
 (modules
  Lua
  Js
  Cpp
  Java
  Julia
  Python
  Zig
  Common
  Tocode
  Usage
  Vultin_embedded
  Tables
  T_pd
  T_performance
  T_mathematica
  T_browser
  T_webaudio
  T_worklet
  T_vcv_prototype
  Replacements)
 (libraries core pparser pla str util)
 (flags
  (:standard -w -30))
 (preprocess
  (pps pla.ppx))
 (ocamlopt_flags -O3 -unbox-closures)
 (instrumentation
  (backend bisect_ppx)))

(rule
 (targets vultin_embedded.ml)
 (deps
  ../../runtime/vultin.hpp
  ../../runtime/vultin.cpp
  ../../runtime/vultin_string.hpp
  ../../runtime/vultin_tuple.hpp
  ../../runtime/vultin_list.hpp
  ../../runtime/vultin_serialization.hpp)
 (action
  (with-stdout-to
   vultin_embedded.ml
   (progn
    (echo
     "(* Generated from the files in the runtime directory. Do not edit. *)\n\n")
    (echo "(* The runtime files as (file name, contents). *)\nlet files =\n")
    (echo "  [ ( \"vultin.hpp\"\n    , {vultin_embedded|")
    (cat ../../runtime/vultin.hpp)
    (echo "|vultin_embedded} )\n")
    (echo "  ; ( \"vultin.cpp\"\n    , {vultin_embedded|")
    (cat ../../runtime/vultin.cpp)
    (echo "|vultin_embedded} )\n")
    (echo "  ; ( \"vultin_string.hpp\"\n    , {vultin_embedded|")
    (cat ../../runtime/vultin_string.hpp)
    (echo "|vultin_embedded} )\n")
    (echo "  ; ( \"vultin_tuple.hpp\"\n    , {vultin_embedded|")
    (cat ../../runtime/vultin_tuple.hpp)
    (echo "|vultin_embedded} )\n")
    (echo "  ; ( \"vultin_list.hpp\"\n    , {vultin_embedded|")
    (cat ../../runtime/vultin_list.hpp)
    (echo "|vultin_embedded} )\n")
    (echo "  ; ( \"vultin_serialization.hpp\"\n    , {vultin_embedded|")
    (cat ../../runtime/vultin_serialization.hpp)
    (echo "|vultin_embedded} ) ]\n")))))
